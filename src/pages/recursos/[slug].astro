---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
import { resourceGuides } from '../../data/v3-commercial';

export function getStaticPaths() {
  return Object.entries(resourceGuides).map(([slug, guide]) => ({ params: { slug }, props: { guide, slug } }));
}

const { guide, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
const contact = `${base}contacto/`;
const resources = `${base}recursos/`;
const guideMedia = {
  'orden-trabajo-util': ['media/v5/work-order-closeout-pump.webp', 'Técnico documentando el resultado de una intervención en una bomba'],
  'mantenimiento-preventivo-pequena-empresa': ['media/v5/preventive-planning-pump-room.webp', 'Responsable y técnico planificando mantenimiento preventivo en una sala de bombas'],
  'qr-activos-mantenimiento': ['media/v5/qr-equipment-identification.webp', 'Técnico identificando mediante QR una unidad de tratamiento de aire'],
  'organizar-activos-instalaciones': ['media/v5/electrical-maintenance-inspection.webp', 'Electricista identificando y comprobando elementos de un cuadro eléctrico'],
  'dejar-whatsapp-excel-mantenimiento': ['media/v5/maintenance-notice-coordination.webp', 'Coordinadora ordenando avisos, fotografías y prioridades de mantenimiento'],
  'organizar-avisos-mantenimiento': ['media/v5/independent-technician-service-van.webp', 'Técnico preparando documentación y medios antes de atender un aviso'],
  'cerrar-ot-historico-util': ['media/v5/facility-manager-plant-room.webp', 'Responsable y técnico revisando documentación e histórico en una sala de máquinas'],
  'piloto-mantenimiento-digital': ['media/v5/maintenance-company-workshop-team.webp', 'Equipo de mantenimiento revisando un proceso piloto sobre planos y equipos reales'],
};
const [guideImage, guideImageAlt] = guideMedia[slug as keyof typeof guideMedia];
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title={`${guide.title} · IsiVoltPro`} description={guide.description} path={`${base}recursos/${slug}/`} />
  <style is:inline>
    .guide-hero{padding:76px 0 68px;background:radial-gradient(circle at 78% 30%,rgba(102,83,220,.13),transparent 28%),radial-gradient(circle at 92% 70%,rgba(43,184,142,.09),transparent 22%),#fff}.guide-hero__grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:62px;align-items:center}.guide-hero h1{margin:14px 0 18px;font:800 clamp(43px,4.8vw,67px)/1 var(--v3-font-display,system-ui);letter-spacing:-.055em}.guide-hero p{max-width:590px;color:#717d91;line-height:1.72}.guide-photo{margin:0;border:1px solid #e3e7f0;border-radius:28px;background:#fff;box-shadow:0 30px 75px rgba(57,65,111,.14);overflow:hidden}.guide-photo img{display:block;width:100%;aspect-ratio:16/10;object-fit:cover}.guide-photo figcaption{padding:14px 18px;color:#667286;font-size:12px;font-weight:800}.guide-visual-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:20px;align-items:stretch}.guide-visual-card{padding:0;border:1px solid #e5e8f0;border-radius:24px;background:#fff;box-shadow:0 14px 36px rgba(54,64,103,.06);overflow:hidden}.guide-visual-card img{display:block;width:100%;height:100%;min-height:430px;object-fit:cover}.guide-check{display:grid;gap:10px}.guide-check article{display:grid;grid-template-columns:34px 1fr;gap:11px;align-items:start;padding:13px;border:1px solid #edf0f5;border-radius:13px;background:#fafbfe}.guide-check b{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:#f1efff;color:#6544e8}.guide-check strong{display:block;margin:1px 0 4px;font-size:13px}.guide-check p{margin:0;color:#7b8698;font-size:11px;line-height:1.45}@media(max-width:900px){.guide-hero__grid,.guide-visual-grid{grid-template-columns:1fr}.guide-photo img{aspect-ratio:16/9}.guide-visual-card img{min-height:320px}}@media(max-width:580px){.guide-hero{padding:54px 0}.guide-hero h1{font-size:clamp(39px,12vw,53px)}.guide-visual-card img{min-height:260px}}
  </style>
</head>
<body>
<V3CommercialHeader />
<main class="page-main">
  <section class="guide-hero"><div class="page-shell guide-hero__grid"><div><span class="eyebrow">Guía práctica de mantenimiento</span><h1>{guide.title}</h1><p>{guide.description}</p><div class="page-hero__actions"><a class="btn" href={resources}>← Todos los recursos</a><a class="btn btn--primary" href={contact}>Compartir un problema →</a></div></div><figure class="guide-photo"><img src={`${base}${guideImage}`} alt={guideImageAlt} width="1600" height="900" loading="eager" decoding="async"/><figcaption>Aplicación práctica · contexto y trabajo real</figcaption></figure></div></section>

  <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Paso a paso</span><h2>Lo esencial,<br/><span class="gradient-text">sin burocracia.</span></h2></div><p>Estas pautas están pensadas para autónomos y equipos pequeños. Puedes aplicarlas independientemente de la herramienta que utilices.</p></div><div class="feature-grid">{guide.points.map(([heading, text], index) => <article class="feature-card"><i>{String(index + 1).padStart(2,'0')}</i><h3>{heading}</h3><p>{text}</p></article>)}</div></div></section>

  <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Del consejo al trabajo</span><h2>Una guía sirve cuando<br/><span class="gradient-text">puedes aplicarla mañana.</span></h2></div><p>La idea es pasar de principios generales a una secuencia concreta que puedas probar sobre un aviso, una OT, un activo o un pequeño piloto.</p></div><div class="guide-visual-grid"><article class="guide-visual-card"><img src={`${base}${guideImage}`} alt={guideImageAlt} loading="lazy" width="1600" height="900" /></article><div class="guide-check"><article><b>01</b><div><strong>Elige un caso real</strong><p>No empieces por migrar todo. Escoge una situación repetitiva y visible.</p></div></article><article><b>02</b><div><strong>Reduce campos</strong><p>Conserva solo la información que ayuda a actuar o entender después qué ocurrió.</p></div></article><article><b>03</b><div><strong>Prueba en campo</strong><p>Comprueba el flujo con fotos y contexto en el lugar donde sucede el trabajo.</p></div></article><article><b>04</b><div><strong>Mide si mejora</strong><p>Si añade más pasos de los que elimina, simplifica antes de ampliar.</p></div></article></div></div></div></section>

  <section class="page-section page-section--soft"><div class="page-shell"><div class="callout"><div><h2>{guide.takeaway}</h2><p>El objetivo es reducir fricción, utilizar mejor el contexto y conservar únicamente la información que ayudará en la siguiente decisión.</p></div><a class="btn btn--primary" href={contact}>Compartir un problema →</a></div></div></section>
</main>
<V3CommercialFooter />
</body></html>

---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const contact = `${base}contacto/`;
const appMaintenance = `${base}app-mantenimiento/`;
const solutions = `${base}soluciones/`;
const pilot = `${base}piloto/`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Implantación · IsiVoltPro" description="Cómo poner en marcha IsiVoltPro en un negocio pequeño: elegir un problema, ordenar datos mínimos, configurar App Mantenimiento, importar activos, QR/NFC, probar con un piloto y ampliar después." path={`${base}implantacion/`} />
  <style is:inline>
    .launch-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.launch-step{padding:26px;border:1px solid var(--line);border-radius:25px;background:#fff;box-shadow:var(--shadow-soft)}.launch-step b{display:grid;width:38px;height:38px;place-items:center;border-radius:12px;background:#eef3ff;color:var(--blue);font-size:12px}.launch-step h3{margin:22px 0 9px;font-size:21px}.launch-step p{margin:0;color:var(--muted);line-height:1.65}.launch-step small{display:block;margin-top:15px;color:#53617c;font-weight:800}.before-after{display:grid;grid-template-columns:1fr auto 1fr;gap:22px;align-items:center}.before-after article{padding:30px;border-radius:28px;border:1px solid var(--line);background:#fff}.before-after article:first-child{background:#fafbfe}.before-after article:last-child{background:linear-gradient(145deg,#f4f8ff,#f6f2ff)}.before-after h3{margin:0 0 18px;font-size:24px}.before-after ul{list-style:none;padding:0;margin:0;display:grid;gap:12px;color:#53617c}.before-after li{display:flex;gap:10px;line-height:1.55}.before-after__arrow{width:44px;height:44px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--violet));color:#fff;font-weight:900}.journey{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;counter-reset:journey}.journey article{position:relative;min-height:220px;padding:24px;border:1px solid var(--line);border-radius:24px;background:#fff;box-shadow:var(--shadow-soft);counter-increment:journey;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease,background .2s ease}.journey article::before{content:"0" counter(journey);display:grid;width:38px;height:38px;place-items:center;margin-bottom:22px;border-radius:12px;background:linear-gradient(135deg,#eef3ff,#f5efff);color:var(--blue);font-size:12px;font-weight:900}.journey h3{margin:0 0 10px;font-size:19px}.journey p{margin:0;color:var(--muted);line-height:1.62}.journey small{display:block;margin-top:15px;color:#53617c;font-weight:800}.journey[data-interactive="true"] article{cursor:pointer}.journey[data-interactive="true"] article:hover{transform:translateY(-3px);border-color:#cad7ff}.journey[data-interactive="true"] article:focus-visible{outline:3px solid rgba(23,92,255,.2);outline-offset:3px}.journey[data-interactive="true"] article.is-active{border-color:#9ab3ff;background:linear-gradient(145deg,#fff,#f4f7ff);box-shadow:0 18px 45px rgba(40,74,160,.13);transform:translateY(-5px)}.journey-panel{display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:center;margin-top:18px;padding:22px 24px;border:1px solid #dbe4ff;border-radius:22px;background:linear-gradient(120deg,#f8faff,#fff 55%,#fbf7ff);box-shadow:var(--shadow-soft)}.journey-panel__index{display:grid;width:48px;height:48px;place-items:center;border-radius:15px;background:linear-gradient(135deg,var(--blue),var(--violet));color:#fff;font-size:13px;font-weight:900}.journey-panel strong{display:block;margin-bottom:4px;color:#17213e;font-size:17px}.journey-panel p{margin:0;color:#65718a;line-height:1.55}.journey-panel__hint{color:#6c7891;font-size:12px;font-weight:800;text-align:right}.guardrail{margin-top:18px;padding:18px 20px;border:1px solid #dce5ff;border-radius:18px;background:#f7f9ff;color:#4f5f7b;line-height:1.65}.guardrail strong{color:#182444}.pilot-band{display:grid;grid-template-columns:1fr .9fr;gap:36px;padding:38px;border-radius:32px;background:linear-gradient(125deg,#0b1430,#172852 60%,#243c81);color:#fff}.pilot-band h2{margin:0;font-size:clamp(36px,5vw,58px);line-height:1.03;letter-spacing:-.05em}.pilot-band p{color:#c5cfea;line-height:1.7}.pilot-checks{display:grid;gap:12px;align-content:center}.pilot-checks div{padding:14px 16px;border:1px solid rgba(255,255,255,.12);border-radius:15px;background:rgba(255,255,255,.06);font-size:14px}.pilot-checks strong{display:block;margin-bottom:4px}.pilot-checks small{color:#c1cae4}@media(max-width:1050px){.journey{grid-template-columns:repeat(3,1fr)}}@media(max-width:900px){.launch-grid{grid-template-columns:repeat(2,1fr)}.pilot-band{grid-template-columns:1fr}.journey-panel{grid-template-columns:auto 1fr}.journey-panel__hint{grid-column:2;text-align:left}}@media(max-width:680px){.launch-grid,.journey{grid-template-columns:1fr}.before-after{grid-template-columns:1fr}.before-after__arrow{transform:rotate(90deg);margin:auto}.pilot-band{padding:28px 22px}.pilot-band .btn{width:100%}.journey article{min-height:auto}.journey-panel{grid-template-columns:1fr;padding:20px}.journey-panel__hint{grid-column:auto;text-align:left}}@media(prefers-reduced-motion:reduce){.journey article{transition:none}.journey[data-interactive="true"] article:hover,.journey[data-interactive="true"] article.is-active{transform:none}}
  </style>
</head>
<body>
  <V3CommercialHeader />
  <main class="page-main">
    <section class="page-hero"><div class="page-shell page-hero__grid"><div><span class="eyebrow">Puesta en marcha sin convertirla en otro proyecto enorme</span><h1>Empieza con lo mínimo.<br/><span class="gradient-text">Hazlo útil desde el primer flujo.</span></h1><p>La implantación de IsiVoltPro para autónomos y pequeñas empresas parte de un problema concreto, no de rellenar una base de datos perfecta. Primero hacemos útil el trabajo diario; después ampliamos.</p><div class="page-hero__actions"><a class="btn btn--primary" href={pilot}>Ver cómo planteamos el piloto →</a><a class="btn" href={appMaintenance}>Ver App Mantenimiento</a></div></div><div class="page-hero__visual" aria-hidden="true"><div class="page-orbit"></div><div class="page-core">EMPEZAR<small>PEQUEÑO → ÚTIL</small></div><div class="page-pill page-pill--a">1 problema<small>El más urgente</small></div><div class="page-pill page-pill--b">Datos mínimos<small>Sin limpiar todo</small></div><div class="page-pill page-pill--c">Piloto<small>Trabajo real</small></div><div class="page-pill page-pill--d">Ampliar<small>Solo si aporta</small></div></div></div></section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Cuatro pasos</span><h2>De “lo tengo en Excel” a<br/><span class="gradient-text">trabajar con contexto.</span></h2></div><p>No necesitas migrar toda la historia de tu empresa para comprobar si el sistema funciona. La primera implantación debe ser pequeña, reversible y medible.</p></div><div class="launch-grid"><article class="launch-step"><b>01</b><h3>Elegir el problema</h3><p>Avisos desordenados, OT sin seguimiento, preventivos olvidados o activos sin histórico.</p><small>Objetivo: una fricción real.</small></article><article class="launch-step"><b>02</b><h3>Ordenar lo mínimo</h3><p>Clientes, ubicaciones y los activos necesarios para que ese primer flujo tenga sentido.</p><small>Objetivo: no limpiar datos de más.</small></article><article class="launch-step"><b>03</b><h3>Trabajar un piloto</h3><p>Usar IsiVoltPro con trabajos reales y comprobar qué aporta y qué estorba antes de ampliar.</p><small>Objetivo: aprender con uso real.</small></article><article class="launch-step"><b>04</b><h3>Ampliar con criterio</h3><p>Añadir QR/NFC, más técnicos, inspecciones, inventario o nuevas ubicaciones solo cuando compense.</p><small>Objetivo: crecer sin burocracia.</small></article></div></div></section>

    <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Qué ocurre después de interesarte</span><h2>Un recorrido comercial<br/><span class="gradient-text">sin saltos ni letra pequeña.</span></h2></div><p>Antes de contratar o desplegar nada, el objetivo es entender si IsiVoltPro encaja en tu forma de trabajar. Cada etapa tiene una decisión clara y se puede detener si no aporta valor.</p></div><div class="journey" aria-label="Etapas de implantación"><article><h3>Diagnóstico breve</h3><p>Partimos de cómo gestionas hoy avisos, activos, preventivos y documentación y detectamos el cuello de botella más importante.</p><small>Sin migrar datos todavía.</small></article><article><h3>Demo enfocada</h3><p>La demostración se centra en ese flujo concreto, no en recorrer funciones que no necesitas.</p><small>Ver antes de configurar.</small></article><article><h3>Piloto acotado</h3><p>Si tiene sentido, se define un alcance pequeño con usuarios, activos y un criterio de éxito comprensible.</p><small>Trabajo real, alcance controlado.</small></article><article><h3>Propuesta</h3><p>Solo después del piloto se concretan alcance, soporte, implantación y condiciones aplicables al caso real.</p><small>Sin precios ficticios en la web.</small></article><article><h3>Puesta en marcha</h3><p>Se amplía únicamente lo validado: más equipo, ubicaciones, QR/NFC, inspecciones, inventario u otros módulos.</p><small>Crecer cuando compensa.</small></article></div><div class="journey-panel" data-journey-panel aria-live="polite"><span class="journey-panel__index">01</span><div><strong>Diagnóstico breve</strong><p>Empezamos por una fricción real y acotada. No necesitas preparar una migración completa para descubrir si IsiVoltPro encaja.</p></div><span class="journey-panel__hint">Pulsa una etapa para explorarla</span></div><p class="guardrail"><strong>Importante:</strong> esta web no activa una contratación automática ni recoge todavía solicitudes reales desde el formulario. El canal definitivo de contacto, las condiciones comerciales, privacidad y datos jurídicos se habilitarán cuando estén cerrados y validados.</p><div class="page-hero__actions"><a class="btn" href={pilot}>Ver fases y criterios del piloto →</a></div></div></section>

    <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Importación inicial</span><h2>No hace falta tirar<br/><span class="gradient-text">lo que ya tienes.</span></h2></div><p>Hojas de cálculo, listados de activos, carpetas de documentos y sistemas de códigos pueden servir como punto de partida. La idea es aprovechar información útil, no copiar desorden al sistema nuevo.</p></div><div class="before-after"><article><h3>Lo que suele existir</h3><ul><li><span>→</span>Clientes en contactos, Excel o facturación.</li><li><span>→</span>Equipos en listados o inventarios separados.</li><li><span>→</span>Fotos y manuales en carpetas o móviles.</li><li><span>→</span>Preventivos en calendario o memoria.</li><li><span>→</span>Avisos por teléfono y WhatsApp.</li></ul></article><div class="before-after__arrow">→</div><article><h3>Lo que queremos conseguir</h3><ul><li><span>✓</span>Cliente e instalación claramente identificados.</li><li><span>✓</span>Activos que merecen histórico propio.</li><li><span>✓</span>Documentos asociados al contexto correcto.</li><li><span>✓</span>Trabajo pendiente visible y accionable.</li><li><span>✓</span>Un flujo que el técnico realmente usa.</li></ul></article></div></div></section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Servicios de puesta en marcha</span><h2>Software y ayuda<br/><span class="gradient-text">cuando haga falta.</span></h2></div><p>La oferta definitiva se concretará con los pilotos, pero la implantación está diseñada para poder incluir acompañamiento en los puntos que suelen consumir más tiempo a una empresa pequeña.</p></div><div class="value-grid"><article class="value-card"><i>⇧</i><h3>Importación de datos</h3><p>Preparación inicial de clientes, instalaciones y activos a partir de los registros que ya utilizas.</p></article><article class="value-card" style="--icon:#e37427;--icon-bg:#fff4ea"><i>⌁</i><h3>QR / NFC y etiquetado</h3><p>Definición de identificadores y asociación de etiquetas a activos o ubicaciones cuando tenga sentido.</p></article><article class="value-card" style="--icon:#159f71;--icon-bg:#eaf9f3"><i>✓</i><h3>Configuración y formación</h3><p>Ajuste del flujo inicial y acompañamiento para que las personas que trabajan lo adopten sin añadir pasos innecesarios.</p></article></div></div></section>

    <section class="page-section"><div class="page-shell"><div class="pilot-band"><div><span class="eyebrow" style="color:#9eb6ff">Piloto antes de escalar</span><h2>Probar con trabajo real es parte del producto.</h2><p>No queremos fijar precios, límites y procesos basándonos solo en hipótesis. Un piloto pequeño permite comprobar valor, descubrir fricción y decidir qué debe quedarse.</p><div class="page-hero__actions"><a class="btn btn--primary" href={pilot}>Ver el proceso completo →</a><a class="btn" style="background:#fff;color:#14213d" href={solutions}>Elegir primero mi problema</a></div></div><div class="pilot-checks"><div><strong>Alcance limitado</strong><small>Un flujo, pocos usuarios y activos representativos.</small></div><div><strong>Criterio de éxito</strong><small>Menos búsquedas, menos pérdida de información y más trazabilidad.</small></div><div><strong>Revisión real</strong><small>Qué se usa, qué sobra y qué necesita cambiar.</small></div></div></div></div></section>
  </main>
  <V3CommercialFooter />
  <script is:inline>
    (() => {
      const journey = document.querySelector('.journey');
      const panel = document.querySelector('[data-journey-panel]');
      if (!journey || !panel) return;
      const cards = Array.from(journey.querySelectorAll('article'));
      const details = [
        'Empezamos por una fricción real y acotada. No necesitas preparar una migración completa para descubrir si IsiVoltPro encaja.',
        'La demo recorre únicamente el flujo que importa a tu equipo para que puedas valorar utilidad antes de configurar nada.',
        'El piloto usa trabajo real con un alcance pequeño y un criterio de éxito claro. Sirve para detectar valor y fricción sin comprometer toda la operación.',
        'Solo después de validar el piloto se concretan alcance, soporte, implantación y condiciones aplicables al caso real.',
        'Se amplía únicamente lo que haya demostrado aportar valor: más equipo, ubicaciones, QR/NFC, inspecciones, inventario u otros módulos.'
      ];
      const activate = (index) => {
        cards.forEach((card, i) => {
          card.classList.toggle('is-active', i === index);
          card.setAttribute('aria-pressed', String(i === index));
        });
        const card = cards[index];
        const indexEl = panel.querySelector('.journey-panel__index');
        const titleEl = panel.querySelector('strong');
        const textEl = panel.querySelector('p');
        if (indexEl) indexEl.textContent = String(index + 1).padStart(2, '0');
        if (titleEl) titleEl.textContent = card.querySelector('h3')?.textContent || '';
        if (textEl) textEl.textContent = details[index] || '';
      };
      journey.setAttribute('data-interactive', 'true');
      cards.forEach((card, index) => {
        card.setAttribute('role', 'button');
        card.setAttribute('tabindex', '0');
        card.addEventListener('click', () => activate(index));
        card.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            activate(index);
          }
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
            event.preventDefault();
            const next = (index + 1) % cards.length;
            cards[next].focus();
            activate(next);
          }
          if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
            event.preventDefault();
            const prev = (index - 1 + cards.length) % cards.length;
            cards[prev].focus();
            activate(prev);
          }
        });
      });
      activate(0);
    })();
  </script>
</body>
</html>

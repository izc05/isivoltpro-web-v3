---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
import { sectorLandings } from '../../data/v3-commercial';

export function getStaticPaths() {
  return Object.entries(sectorLandings).map(([slug, data]) => ({ params: { slug }, props: { data, slug } }));
}

const { data, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
const contact = `${base}contacto/`;
const sectorsUrl = `${base}sectores/`;
const appMaintenance = `${base}app-mantenimiento/`;
const implementation = `${base}implantacion/`;
const sectorVisual = `${base}media/sectores-escenas.svg`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title={`${data.name} · IsiVoltPro`} description={data.description} path={`${base}sectores/${slug}/`} />
  <style is:inline>
    .sector-detail-hero{padding:78px 0 76px;background:radial-gradient(circle at 78% 28%,rgba(100,82,226,.12),transparent 28%),radial-gradient(circle at 94% 63%,rgba(43,184,142,.09),transparent 21%),#fff}.sector-detail-hero__grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:64px;align-items:center}.sector-detail-hero h1{margin:15px 0 18px;font:800 clamp(48px,4.7vw,68px)/.99 var(--v3-font-display,system-ui);letter-spacing:-.06em}.sector-detail-hero p{max-width:560px;color:#727d90;line-height:1.72}.sector-workspace{position:relative;min-height:460px}.sector-workspace::before{content:'';position:absolute;inset:8% 2% 1% 9%;border-radius:42px;background:linear-gradient(135deg,rgba(100,82,226,.14),rgba(73,158,213,.08) 50%,rgba(43,184,142,.11));filter:blur(28px)}.sector-window{position:absolute;inset:20px 18px 28px 38px;border:1px solid #e4e8f1;border-radius:27px;background:#fff;box-shadow:0 32px 78px rgba(54,64,105,.15);overflow:hidden}.sector-window__bar{height:45px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;border-bottom:1px solid #edf0f5;color:#7c8799;font-size:9px}.sector-window__body{display:grid;grid-template-columns:108px 1fr;height:calc(100% - 45px)}.sector-rail{padding:17px 10px;background:#11192f;color:#b9c2d5}.sector-rail strong{display:block;margin:0 8px 15px;color:#fff;font-size:10px}.sector-rail span{display:block;margin:5px 0;padding:8px;border-radius:8px;font-size:8px}.sector-rail span:first-of-type{background:linear-gradient(90deg,rgba(91,102,235,.35),rgba(113,82,220,.28));color:#fff}.sector-main{padding:18px;background:linear-gradient(180deg,#fcfdff,#f8faff)}.sector-main__top{display:flex;align-items:end;justify-content:space-between;gap:12px}.sector-main__top small{color:#8993a4;font-size:7px}.sector-main__top strong{display:block;margin-top:4px;font-size:18px}.sector-status{padding:6px 8px;border-radius:999px;background:#eaf9f3;color:#158f68;font-size:7px;font-weight:900}.sector-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0}.sector-kpis div{padding:11px;border:1px solid #e9edf3;border-radius:11px;background:#fff}.sector-kpis small{display:block;color:#8b95a6;font-size:7px}.sector-kpis b{display:block;margin-top:4px;font-size:17px}.sector-cases{display:grid;gap:7px}.sector-case{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:9px 10px;border:1px solid #e9edf3;border-radius:9px;background:#fff}.sector-case strong{display:block;font-size:9px}.sector-case small{display:block;margin-top:2px;color:#8b95a5;font-size:7px}.sector-case span{padding:5px 7px;border-radius:999px;background:#f1efff;color:#6751d7;font-size:7px;font-weight:900}.sector-miniart{position:absolute;right:-2px;bottom:-2px;width:160px;padding:7px;border:1px solid #e4e8f1;border-radius:19px;background:#fff;box-shadow:0 18px 40px rgba(50,61,103,.14);transform:rotate(2deg)}.sector-miniart img{display:block;width:100%;height:auto;border-radius:13px}.sector-float{position:absolute;left:0;bottom:45px;z-index:3;padding:10px 12px;border:1px solid #e3e8f1;border-radius:13px;background:#fff;box-shadow:0 15px 34px rgba(50,61,103,.13)}.sector-float strong{display:block;color:#5d55d7;font-size:9px}.sector-float small{display:block;margin-top:3px;color:#8b95a6;font-size:7px}.sector-proof{display:grid;grid-template-columns:1.15fr .85fr;gap:22px;align-items:stretch}.sector-proof__visual{padding:24px;border:1px solid #e4e9f1;border-radius:28px;background:linear-gradient(145deg,#fff,#f8f7ff 48%,#f2fbf7);box-shadow:0 16px 40px rgba(54,64,103,.06)}.sector-proof__visual img{display:block;width:100%;height:auto}.sector-proof__copy{display:grid;align-content:center;gap:12px;padding:28px;border-radius:28px;background:#111827;color:#fff}.sector-proof__copy h3{margin:0;font-size:28px;letter-spacing:-.04em}.sector-proof__copy p{margin:0;color:#c6d0df;line-height:1.65}.sector-proof__copy ul{list-style:none;margin:5px 0 0;padding:0;display:grid;gap:9px}.sector-proof__copy li{display:grid;grid-template-columns:20px 1fr;gap:8px;color:#e2e8f2;font-size:13px}.sector-proof__copy li span{color:#5ee0b0;font-weight:900}@media(max-width:920px){.sector-detail-hero__grid,.sector-proof{grid-template-columns:1fr}.sector-workspace{min-height:420px}}@media(max-width:580px){.sector-detail-hero{padding:56px 0}.sector-detail-hero h1{font-size:clamp(42px,12vw,55px)}.sector-workspace{min-height:355px}.sector-window{inset:15px 4px 22px 10px}.sector-window__body{grid-template-columns:72px 1fr}.sector-rail{padding:13px 6px}.sector-main{padding:12px}.sector-kpis{grid-template-columns:1fr 1fr}.sector-kpis div:last-child{display:none}.sector-miniart{width:115px}.sector-float{display:none}.sector-proof__visual,.sector-proof__copy{padding:20px}}
  </style>
</head>
<body>
  <V3CommercialHeader />
  <main class="page-main">
    <section class="sector-detail-hero">
      <div class="page-shell sector-detail-hero__grid">
        <div><span class="eyebrow">{data.eyebrow}</span><h1>{data.title}</h1><p>{data.description}</p><div class="page-hero__actions"><a class="btn btn--primary" href={contact}>Cuéntanos tu caso →</a><a class="btn" href={appMaintenance}>Ver App Mantenimiento</a></div></div>
        <div class="sector-workspace" aria-label={`Vista conceptual de IsiVoltPro para ${data.name}`}>
          <div class="sector-window"><div class="sector-window__bar"><strong>IsiVoltPro · {data.name}</strong><span>Datos ficticios de demostración</span></div><div class="sector-window__body"><aside class="sector-rail"><strong>IsiVoltPro</strong><span>Resumen</span><span>Avisos</span><span>OT</span><span>Activos</span><span>Preventivo</span></aside><div class="sector-main"><div class="sector-main__top"><div><small>OPERACIÓN · HOY</small><strong>{data.name}</strong></div><span class="sector-status">● Flujo conectado</span></div><div class="sector-kpis"><div><small>Trabajos</small><b>12</b></div><div><small>Activos</small><b>48</b></div><div><small>Pendientes</small><b>3</b></div></div><div class="sector-cases">{data.examples.slice(0,4).map((item, i) => <div class="sector-case"><div><strong>{item}</strong><small>{['Contexto disponible','Trabajo trazable','Revisión planificada','Histórico conectado'][i]}</small></div><span>{['HOY','OT','PLAN','OK'][i]}</span></div>)}</div></div></div></div>
          <div class="sector-miniart"><img src={sectorVisual} alt="" loading="eager" decoding="async" /></div>
          <div class="sector-float"><strong>Un único contexto</strong><small>Aviso → OT → activo → histórico</small></div>
        </div>
      </div>
    </section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Lo que suele doler</span><h2>Problemas pequeños que<br/><span class="gradient-text">roban mucho tiempo.</span></h2></div><p>IsiVoltPro se plantea desde situaciones cotidianas, no desde procesos corporativos sobredimensionados.</p></div><div class="feature-grid">{data.pains.map((pain, i) => <article class="feature-card"><i>{i+1}</i><h3>{pain}</h3><p>La plataforma busca mantener este punto dentro del mismo flujo para que no dependa de recordar, preguntar o buscar en varias aplicaciones.</p></article>)}</div></div></section>

    <section class="page-section"><div class="page-shell"><div class="sector-proof"><div class="sector-proof__visual"><img src={sectorVisual} alt={`Escenas conceptuales de trabajo relacionadas con ${data.name}`} loading="lazy" decoding="async" /></div><div class="sector-proof__copy"><span class="eyebrow" style="color:#9db6ff">Trabajo real, contexto real</span><h3>La herramienta debe adaptarse al tamaño del equipo.</h3><p>El mismo núcleo puede servir para empezar con un flujo pequeño y crecer solo cuando la operación lo justifique.</p><ul>{data.wins.slice(0,3).map((win) => <li><span>✓</span><div>{win}</div></li>)}</ul></div></div></div></section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">El resultado buscado</span><h2>Más control sin<br/><span class="gradient-text">más burocracia.</span></h2></div><p>La tecnología debe quitar fricción. Si para usarla hay que duplicar el trabajo, no sirve al tipo de empresa para el que estamos construyendo IsiVoltPro.</p></div><div class="value-grid">{data.wins.map((win, i) => <article class="value-card" style={`--accent:${['rgba(23,92,255,.10)','rgba(109,74,255,.10)','rgba(36,197,140,.11)','rgba(242,56,169,.10)'][i]}`}><i>✓</i><h3>{win}</h3><p>Información clara, vinculada al contexto correcto y disponible cuando hace falta.</p></article>)}</div></div></section>

    <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Una forma de empezar</span><h2>Primero un flujo.<br/><span class="gradient-text">Después el resto.</span></h2></div><p>La implantación no tiene que comenzar migrando toda la empresa. Elegimos un problema representativo y usamos trabajo real para comprobar si el sistema aporta valor.</p></div><div class="flow-board"><article class="flow-step"><b>01</b><strong>Cliente / sede</strong><small>Empieza por el contexto.</small></article><article class="flow-step"><b>02</b><strong>Activo</strong><small>Identifica el equipo.</small></article><article class="flow-step"><b>03</b><strong>Necesidad</strong><small>Aviso o revisión.</small></article><article class="flow-step"><b>04</b><strong>Trabajo</strong><small>Asignar y ejecutar.</small></article><article class="flow-step"><b>05</b><strong>Evidencia</strong><small>Fotos, notas y resultado.</small></article><article class="flow-step"><b>06</b><strong>Histórico</strong><small>Queda disponible.</small></article></div><div class="home-more"><a class="btn" href={implementation}>Ver cómo empezar sin migrarlo todo →</a><a class="btn" href={sectorsUrl}>Ver otros perfiles</a></div></div></section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="callout"><div><h2>La demo debe parecerse a tu trabajo, no al de una gran multinacional.</h2><p>Cuéntanos cómo recibes avisos, cómo organizas clientes y qué información pierdes hoy. A partir de ahí evaluamos si App Mantenimiento o una configuración distinta encaja.</p></div><div class="page-hero__actions" style="margin-top:0"><a class="btn btn--primary" href={contact}>Solicitar demo →</a><a class="btn" href={appMaintenance}>Conocer la app</a></div></div></div></section>
  </main>
  <V3CommercialFooter />
</body>
</html>

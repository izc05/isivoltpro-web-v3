---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const contact = `${base}contacto/`;
const solutions = `${base}soluciones/`;
const moduleUrl = (slug: string) => `${base}modulos/${slug}/`;
---
<!doctype html><html lang="es"><head>
<V3Seo title="App Mantenimiento · IsiVoltPro" description="App de mantenimiento IsiVoltPro para autónomos y pequeñas empresas: avisos, órdenes de trabajo, activos, preventivos, fotos, documentación e histórico desde móvil y escritorio." path={`${base}app-mantenimiento/`} />
<style is:inline>
.app-stage{position:relative;min-height:500px}.app-stage::before{content:'';position:absolute;inset:12% 0 0 12%;border-radius:42px;background:linear-gradient(135deg,rgba(91,91,228,.13),rgba(61,161,210,.08) 52%,rgba(43,184,140,.12));filter:blur(28px)}.app-window{position:absolute;inset:22px 10px 32px 42px;border:1px solid #e4e8f1;border-radius:28px;background:#fff;box-shadow:0 34px 82px rgba(42,58,98,.16);overflow:hidden}.app-window__bar{height:48px;padding:0 18px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #edf0f5;font-size:11px;color:#73809a}.app-window__body{display:grid;grid-template-columns:110px 1fr;min-height:398px}.app-rail{padding:18px 11px;background:#10182f;color:#b8c1d6}.app-rail strong{display:block;margin:0 8px 14px;color:#fff;font-size:10px}.app-rail span{display:block;margin:5px 0;padding:8px 9px;border-radius:9px;font-size:8px}.app-rail span.active{color:#fff;background:linear-gradient(90deg,rgba(91,102,235,.34),rgba(117,82,219,.28))}.app-main{padding:20px}.app-main__top{display:flex;justify-content:space-between;align-items:flex-end;gap:16px}.app-main h3{margin:3px 0 0;font-size:24px}.app-main__top small{color:#8d96a6}.app-main__top em{font-style:normal;padding:6px 9px;border-radius:999px;background:#eaf9f3;color:#148c65;font-size:8px;font-weight:800}.app-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:16px}.app-metric{padding:12px;border:1px solid #eceff4;border-radius:13px;background:linear-gradient(180deg,#fff,#fbfcff)}.app-metric small{color:#8e97a7;font-size:8px}.app-metric strong{display:block;margin-top:4px;font-size:20px}.app-main__grid{display:grid;grid-template-columns:1.35fr .65fr;gap:11px;margin-top:12px}.app-list,.app-activity{border:1px solid #eceff4;border-radius:15px;background:#fff;overflow:hidden}.app-list__head,.app-activity__head{padding:10px 12px;border-bottom:1px solid #eef1f5;font-size:9px;font-weight:800;color:#657187}.app-row{display:grid;grid-template-columns:1fr auto;gap:12px;padding:10px 12px;border-bottom:1px solid #eef1f6}.app-row:last-child{border-bottom:0}.app-row strong{font-size:10px}.app-row small{color:#8b95a5;font-size:8px}.app-status{align-self:center;padding:5px 7px;border-radius:999px;background:#f2efff;color:#6544e8;font-size:7px;font-weight:900}.app-status.high{background:#fff1eb;color:#d36b28}.app-status.done{background:#eaf9f3;color:#168e67}.activity-item{padding:10px 12px;border-bottom:1px solid #eef1f6}.activity-item:last-child{border-bottom:0}.activity-item strong{display:block;font-size:9px}.activity-item small{display:block;margin-top:3px;color:#8d96a6;font-size:7px;line-height:1.4}.app-phone{position:absolute;right:-4px;bottom:-5px;width:148px;padding:11px;border:5px solid #101a35;border-radius:29px;background:#fff;box-shadow:0 24px 54px rgba(31,47,90,.22);transform:rotate(4deg)}.app-phone__screen{min-height:270px;border-radius:18px;background:linear-gradient(180deg,#f7faff,#fff);padding:11px}.app-phone strong{display:block;font-size:14px}.app-phone small{color:#7f8a9d;font-size:8px}.app-phone__card{margin-top:9px;padding:9px;border-radius:11px;background:#fff;border:1px solid #e8ecf3}.app-phone__tag{display:inline-flex;margin-top:9px;padding:5px 7px;border-radius:999px;background:#eaf9f3;color:#148c65;font-size:7px;font-weight:900}.app-phone__action{margin-top:9px;padding:9px;border-radius:10px;text-align:center;background:linear-gradient(100deg,#5369e8,#7a56df);color:#fff;font-size:9px;font-weight:800}.app-cap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.app-cap{padding:23px;border:1px solid #e6e9f1;border-radius:25px;background:#fff;box-shadow:0 15px 36px rgba(54,64,102,.07)}.app-cap__top{display:flex;align-items:center;justify-content:space-between;gap:10px}.app-cap i{width:44px;height:44px;display:grid;place-items:center;border-radius:14px;background:var(--tone,#eef3ff);color:var(--ink,#4869dc);font-style:normal;font-weight:900}.app-cap__top span{padding:5px 7px;border-radius:999px;background:#f5f6f9;color:#758094;font-size:7px;font-weight:800}.app-cap h3{margin:17px 0 7px;font-size:20px}.app-cap p{margin:0;color:#768195;line-height:1.6;font-size:13px}.cap-preview{margin-top:17px;padding:11px;border:1px solid #edf0f5;border-radius:12px;background:#fafbfe}.cap-preview div{display:grid;grid-template-columns:1fr auto;gap:8px;padding:6px 0;border-bottom:1px solid #edf0f5;font-size:8px;color:#7b8597}.cap-preview div:last-child{border-bottom:0}.cap-preview b{color:#273146}.app-day{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.app-day article{position:relative;padding:23px;border-radius:23px;border:1px solid #e6e9f1;background:#fff;box-shadow:0 12px 30px rgba(54,64,102,.05)}.app-day article:not(:last-child)::after{content:'→';position:absolute;right:-12px;top:50%;z-index:2;width:24px;height:24px;display:grid;place-items:center;border-radius:50%;background:#fff;border:1px solid #e6e9f1;color:#8c95a5;transform:translateY(-50%)}.app-day b{display:block;color:#526bd5;font-size:11px}.app-day strong{display:block;margin-top:16px;font-size:18px}.app-day p{margin:7px 0 0;color:#768195;line-height:1.55;font-size:13px}.app-note{margin-top:20px;padding:16px 18px;border-radius:16px;background:#f7f9fd;color:#66738d;font-size:13px;line-height:1.6}@media(max-width:900px){.app-cap-grid{grid-template-columns:repeat(2,1fr)}.app-day{grid-template-columns:repeat(2,1fr)}.app-day article::after{display:none}.app-window__body{grid-template-columns:84px 1fr}.app-main__grid{grid-template-columns:1fr}.app-activity{display:none}}@media(max-width:680px){.app-stage{min-height:390px}.app-window{left:0;right:20px;top:18px}.app-window__body{grid-template-columns:1fr}.app-rail{display:none}.app-main{padding:14px}.app-main h3{font-size:20px}.app-metrics{grid-template-columns:1fr 1fr}.app-metric:nth-child(n+3){display:none}.app-phone{width:126px;right:-2px;bottom:-8px}.app-phone__screen{min-height:220px}.app-cap-grid,.app-day{grid-template-columns:1fr}}@media(max-width:420px){.app-stage{min-height:355px}.app-window{right:14px}.app-row{font-size:12px}.app-phone{width:116px}.app-phone__screen{min-height:200px}}
</style></head><body><V3CommercialHeader /><main class="page-main">
<section class="page-hero"><div class="page-shell page-hero__grid"><div><span class="eyebrow">App Mantenimiento IsiVoltPro</span><h1>El trabajo de mantenimiento,<br/><span class="gradient-text">en el móvil y bajo control.</span></h1><p>Una aplicación pensada para el día a día de autónomos y pequeños equipos: avisos, equipos, OT, preventivos, fotos y documentación alrededor de una misma operación.</p><div class="page-hero__actions"><a class="btn btn--primary" href={contact}>Ver una demo →</a><a class="btn" href={solutions}>Ver qué problemas resuelve</a></div></div><div class="app-stage" aria-label="Dashboard conceptual de App Mantenimiento"><div class="app-window"><div class="app-window__bar"><strong>IsiVoltPro · Mantenimiento</strong><span>Datos ficticios de demostración</span></div><div class="app-window__body"><aside class="app-rail"><strong>IsiVoltPro</strong><span class="active">Resumen</span><span>Avisos</span><span>OT</span><span>Activos</span><span>Preventivos</span><span>Documentos</span></aside><div class="app-main"><div class="app-main__top"><div><small>HOY · OPERACIÓN</small><h3>Trabajo pendiente</h3></div><em>● Demo activa</em></div><div class="app-metrics"><div class="app-metric"><small>OT abiertas</small><strong>12</strong></div><div class="app-metric"><small>Preventivos</small><strong>8</strong></div><div class="app-metric"><small>Avisos</small><strong>3</strong></div><div class="app-metric"><small>Activos</small><strong>148</strong></div></div><div class="app-main__grid"><div class="app-list"><div class="app-list__head">PRÓXIMOS TRABAJOS</div><div class="app-row"><span><strong>Revisión UTA-02</strong><br/><small>Preventivo · Planta 1</small></span><span class="app-status">En curso</span></div><div class="app-row"><span><strong>Fuga de agua</strong><br/><small>Aviso · Zona común</small></span><span class="app-status high">Alta</span></div><div class="app-row"><span><strong>Cuadro QG-01</strong><br/><small>Inspección visual</small></span><span class="app-status">Pendiente</span></div><div class="app-row"><span><strong>Cambio filtro FC-04</strong><br/><small>Preventivo mensual</small></span><span class="app-status done">Listo</span></div></div><div class="app-activity"><div class="app-activity__head">ACTIVIDAD</div><div class="activity-item"><strong>OT-0148 actualizada</strong><small>Foto y nota añadidas · 10:42</small></div><div class="activity-item"><strong>Activo UTA-02</strong><small>Histórico consultado · 10:18</small></div><div class="activity-item"><strong>Aviso recibido</strong><small>Zona común · 09:56</small></div></div></div></div></div></div><div class="app-phone"><div class="app-phone__screen"><small>ACTIVO · UTA-02</small><strong>Zona técnica</strong><span class="app-phone__tag">● En servicio</span><div class="app-phone__card"><small>Próximo preventivo</small><strong style="font-size:11px">12 septiembre</strong></div><div class="app-phone__card"><small>Última OT</small><strong style="font-size:11px">Revisión preventiva</strong></div><div class="app-phone__card"><small>Documentos</small><strong style="font-size:11px">4 archivos</strong></div><div class="app-phone__action">ABRIR OT</div></div></div></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Una herramienta de campo</span><h2>Menos pasos entre<br/><span class="gradient-text">ver el problema y resolverlo.</span></h2></div><p>La aplicación reúne el contexto que normalmente queda repartido entre llamadas, WhatsApp, calendario, galería de fotos y hojas de cálculo.</p></div><div class="app-cap-grid">
<a class="app-cap" href={moduleUrl('avisos-incidencias')}><div class="app-cap__top"><i>!</i><span>Entrada</span></div><h3>Avisos</h3><p>Qué ocurre, dónde y con qué prioridad.</p><div class="cap-preview"><div><b>Fuga de agua</b><span>Alta</span></div><div><b>Ubicación</b><span>Zona común</span></div><div><b>Evidencias</b><span>2 fotos</span></div></div></a>
<a class="app-cap" href={moduleUrl('ordenes-de-trabajo')} style="--tone:#f2efff;--ink:#6544e8"><div class="app-cap__top"><i>✓</i><span>Trabajo</span></div><h3>Órdenes de trabajo</h3><p>Asignación, estado, notas, fotos y cierre.</p><div class="cap-preview"><div><b>OT-0148</b><span>En curso</span></div><div><b>Técnico</b><span>Asignado</span></div><div><b>Fotos</b><span>3</span></div></div></a>
<a class="app-cap" href={moduleUrl('activos')}><div class="app-cap__top"><i>▣</i><span>Contexto</span></div><h3>Activos</h3><p>Ficha, ubicación, documentación e histórico.</p><div class="cap-preview"><div><b>UTA-02</b><span>Activa</span></div><div><b>Histórico</b><span>12 OT</span></div><div><b>Documentos</b><span>4</span></div></div></a>
<a class="app-cap" href={moduleUrl('mantenimiento-preventivo')} style="--tone:#eaf9f3;--ink:#159f71"><div class="app-cap__top"><i>⚙</i><span>Planificación</span></div><h3>Preventivo</h3><p>Qué toca revisar, cuándo y con qué resultado.</p><div class="cap-preview"><div><b>UTA-02</b><span>12 sep</span></div><div><b>FC-04</b><span>Mensual</span></div><div><b>Pendientes</b><span>8</span></div></div></a>
<a class="app-cap" href={moduleUrl('qr-nfc')} style="--tone:#fff3e9;--ink:#d96c20"><div class="app-cap__top"><i>⌁</i><span>Campo</span></div><h3>QR / NFC</h3><p>Escanea y abre el contexto correcto.</p><div class="cap-preview"><div><b>Etiqueta</b><span>UTA-02</span></div><div><b>Acción</b><span>Abrir ficha</span></div><div><b>Tiempo</b><span>Inmediato</span></div></div></a>
<a class="app-cap" href={moduleUrl('documentacion')} style="--tone:#eafafd;--ink:#139db9"><div class="app-cap__top"><i>▤</i><span>Evidencia</span></div><h3>Fotos y documentos</h3><p>Archivos asociados al trabajo y equipo correctos.</p><div class="cap-preview"><div><b>Fotos OT</b><span>3</span></div><div><b>Manual</b><span>PDF</span></div><div><b>Informe</b><span>Disponible</span></div></div></a>
</div></div></section>
<section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Un día normal</span><h2>Diseñada alrededor de<br/><span class="gradient-text">cómo trabaja un técnico.</span></h2></div><p>El sistema acompaña la intervención y conserva el resultado sin obligar a salir del flujo de trabajo.</p></div><div class="app-day"><article><b>08:10</b><strong>Entra un aviso</strong><p>Cliente, ubicación y activo quedan vinculados desde el inicio.</p></article><article><b>09:00</b><strong>Se crea la OT</strong><p>Prioridad, responsable y contexto viajan juntos.</p></article><article><b>10:15</b><strong>Trabajo en campo</strong><p>Fotos, notas y materiales se registran desde el móvil.</p></article><article><b>11:05</b><strong>Cierre e histórico</strong><p>El resultado queda preparado para la siguiente visita.</p></article></div><div class="app-note">Todos los datos mostrados en esta página son ficticios y sirven únicamente para demostrar la dirección funcional de la App Mantenimiento. Las capacidades reales se confirman antes de cualquier piloto.</div></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">No se queda aislada</span><h2>Empieza con mantenimiento.<br/><span class="gradient-text">Conecta cuando lo necesites.</span></h2></div><p>Activos, inspecciones, inventario, QR/NFC, documentación y soluciones especializadas comparten el mismo contexto.</p></div><div class="value-grid"><article class="value-card"><i>1</i><h3>Empieza pequeño</h3><p>Avisos, OT y preventivos pueden ser suficientes para obtener valor desde el primer flujo.</p></article><article class="value-card" style="--icon:#6544e8;--icon-bg:#f2efff"><i>2</i><h3>Conecta activos</h3><p>Cada intervención empieza a construir histórico técnico alrededor del equipo.</p></article><article class="value-card" style="--icon:#159f71;--icon-bg:#eaf9f3"><i>3</i><h3>Amplía por necesidad</h3><p>QR/NFC, inventario, inspecciones o especializadas entran cuando aportan una mejora concreta.</p></article></div></div></section>
<section class="page-section"><div class="page-shell"><div class="callout"><div><h2>¿Tu mantenimiento sigue dependiendo de memoria, mensajes y hojas sueltas?</h2><p>La demo parte de tu forma de trabajar y enseña cómo convertir ese flujo en una operación más clara.</p></div><a class="btn btn--primary" href={contact}>Ver App Mantenimiento →</a></div></div></section>
</main><V3CommercialFooter /></body></html>
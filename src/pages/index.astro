---
import '../styles/v3-pages.css';
import '../styles/v3-home-reference.css';
import '../styles/v3-home-fidelity.css';
import '../styles/v3-entry-home-transition.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
import V3Entry3D from '../components/V3Entry3D.astro';
import V3HomeDailySolutions from '../components/V3HomeDailySolutions.astro';

const base = import.meta.env.BASE_URL;
const access = `${base}acceso/`;
const solutions = `${base}soluciones/`;
const resources = `${base}recursos/`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Mantenimiento técnico · Problemas, soluciones y conocimiento" description="Información práctica sobre averías, preventivo, activos, seguridad, documentación, energía, repuestos y coordinación del mantenimiento." path={base} />
  <script is:inline>
    try { if (sessionStorage.getItem('isivoltpro-intro-seen') === '1') document.documentElement.classList.add('skip-intro'); } catch (_) {}
  </script>
  <style is:inline>html.skip-intro .intro{display:none}</style>
</head>
<body class="intro-lock">
  <V3Entry3D accessHref={access} demoHref={solutions} />

  <V3CommercialHeader />

  <main class="saas-home">
    <section class="saas-hero" id="inicio">
      <div class="saas-shell saas-hero__grid">
        <div class="saas-hero__copy reveal">
          <span class="saas-badge"><i aria-hidden="true"></i> Mantenimiento técnico · personas, equipos y decisiones</span>
          <h1>Mantener es anticiparse.<span>No solo reparar.</span></h1>
          <p class="saas-hero__lead">Hablamos de los problemas que condicionan el mantenimiento real: averías, preventivos, seguridad, documentación, repuestos, coordinación, energía y conocimiento técnico.</p>
          <div class="saas-actions"><a class="btn btn--primary" href={solutions}>Explorar problemas</a><a class="btn" href={resources}>Consultar recursos</a></div>
          <div class="saas-trust"><small>Una visión práctica para quienes mantienen instalaciones cada día</small><div class="saas-trust__row"><span>Climatización</span><span>Electricidad</span><span>Instalaciones</span><span>Industria</span></div></div>
        </div>

        <figure class="saas-hero-photo reveal"><img src={`${base}media/v5/maintenance-hvac-inspection.webp`} alt="Técnico de mantenimiento inspeccionando una unidad de tratamiento de aire y comprobando su funcionamiento" width="1600" height="900" loading="eager" decoding="async"/><figcaption><strong>Diagnosticar antes de intervenir</strong><span>Observación, medición y conocimiento del equipo</span></figcaption></figure>
      </div>
    </section>

    <section class="saas-benefits" aria-label="Claves del mantenimiento"><div class="saas-shell saas-benefits__grid reveal"><article class="saas-benefit"><i>◇</i><div><strong>Fiabilidad</strong><span>Evitar que el fallo se repita</span></div></article><article class="saas-benefit"><i>✦</i><div><strong>Seguridad</strong><span>Intervenir con método y control</span></div></article><article class="saas-benefit"><i>▣</i><div><strong>Planificación</strong><span>Priorizar recursos y tiempos</span></div></article><article class="saas-benefit"><i>✓</i><div><strong>Conocimiento</strong><span>Conservar lo aprendido en cada actuación</span></div></article></div></section>

    <V3HomeDailySolutions />

    <section class="saas-modules" id="frentes"><div class="saas-shell"><header class="saas-modules__head reveal"><h2>Los frentes del mantenimiento.</h2><p>Una operación fiable depende de muchas disciplinas conectadas. Cada una tiene riesgos, decisiones y problemas propios que merecen ser entendidos antes de elegir cualquier herramienta.</p></header><div class="saas-modules__body"><div class="reveal"><div class="saas-module-grid">
      <article class="saas-module"><i>▣</i><h3>Activos</h3><p>Estado, criticidad, ubicación e histórico.</p></article>
      <article class="saas-module"><i>⚙</i><h3>Preventivo</h3><p>Frecuencias, tareas y cumplimiento real.</p></article>
      <article class="saas-module"><i>!</i><h3>Averías</h3><p>Diagnóstico, prioridad y recurrencia.</p></article>
      <article class="saas-module"><i>⌁</i><h3>Energía</h3><p>Consumos anómalos y rendimiento.</p></article>
      <article class="saas-module"><i>▦</i><h3>Repuestos</h3><p>Disponibilidad, rotación y obsolescencia.</p></article>
      <article class="saas-module"><i>☑</i><h3>Inspecciones</h3><p>Seguridad, calidad y cumplimiento.</p></article>
      <article class="saas-module"><i>▤</i><h3>Documentación</h3><p>Planos, manuales y conocimiento técnico.</p></article>
    </div><a class="saas-modules__link" href={solutions}>Explorar los problemas →</a></div><figure class="saas-field-photo reveal"><img src={`${base}media/v5/preventive-planning-pump-room.webp`} alt="Responsable y técnico planificando mantenimiento preventivo junto a una sala de bombas" width="1600" height="900" loading="lazy" decoding="async"/><figcaption><strong>Planificar con contexto</strong><span>Equipo, documentación y experiencia en el mismo lugar</span></figcaption></figure></div></div></section>

    <section class="saas-flow" aria-label="Flujo del aviso al histórico"><div class="saas-shell reveal"><h2>Del aviso al cierre. Todo el ciclo en control.</h2><p>Un flujo de trabajo claro, trazable y fácil de seguir.</p><div class="saas-flow__track"><article class="saas-flow-step"><i>!</i><strong>Incidencia</strong><span>Se detecta y registra el problema</span></article><article class="saas-flow-step"><i>✓</i><strong>Orden de trabajo</strong><span>Se planifica la intervención</span></article><article class="saas-flow-step"><i>♙</i><strong>Técnico asignado</strong><span>Recibe el contexto y ejecuta</span></article><article class="saas-flow-step"><i>✦</i><strong>Actuación</strong><span>Registra notas, tiempos y evidencias</span></article><article class="saas-flow-step"><i>▤</i><strong>Informe</strong><span>La información queda preparada</span></article><article class="saas-flow-step"><i>⌁</i><strong>Histórico</strong><span>Todo queda unido al activo</span></article></div></div></section>

  </main>

  <V3CommercialFooter />
  <script is:inline>
    const intro=document.getElementById('intro');const skip=document.getElementById('skip-intro');const body=document.body;const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;let finished=false;
    const finishIntro=()=>{if(finished)return;finished=true;try{sessionStorage.setItem('isivoltpro-intro-seen','1')}catch(_){}if(reduced){intro?.classList.add('is-done');body.classList.remove('intro-lock');intro?.setAttribute('aria-hidden','true');return}intro?.classList.add('is-leaving');window.setTimeout(()=>body.classList.remove('intro-lock'),180);window.setTimeout(()=>{intro?.classList.add('is-done');intro?.classList.remove('is-leaving')},620);window.setTimeout(()=>intro?.setAttribute('aria-hidden','true'),760)};
    let seen=false;try{seen=sessionStorage.getItem('isivoltpro-intro-seen')==='1'}catch(_){}if(seen||reduced||document.documentElement.classList.contains('skip-intro')){intro?.classList.add('is-done');body.classList.remove('intro-lock')}else window.setTimeout(finishIntro,3100);skip?.addEventListener('click',finishIntro);
    const observer=new IntersectionObserver((entries)=>{entries.forEach((entry)=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target)}})},{threshold:.12});document.querySelectorAll('.reveal').forEach((el)=>observer.observe(el));
  </script>
</body>
</html>

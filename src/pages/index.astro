---
import Intro from '../components/home/Intro.astro';
import LoaderV2 from '../components/home/LoaderV2.astro';
import DigitalFacilityHero from '../components/home/DigitalFacilityHero.astro';
import '../styles/global.css';
import '../styles/home.css';
import '../styles/home/loader-v2.css';
import '../styles/home/hero-v2.css';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="IsiVoltPro conecta activos, mantenimiento, órdenes de trabajo, recursos y trazabilidad en un único ecosistema técnico." />
  <meta name="theme-color" content="#02060a" />
  <title>IsiVoltPro · Gestión técnica conectada</title>
</head>
<body class="has-intro">
  <LoaderV2 />
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <main id="contenido">
    <DigitalFacilityHero />
  </main>
  <Intro />
</body>
</html>

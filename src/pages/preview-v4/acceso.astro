---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
const base=import.meta.env.BASE_URL;
const security=`${base}preview-v4/seguridad/`;
const privacy=`${base}preview-v4/privacidad/`;
const demo=`${base}preview-v4/demo/`;
const fieldPhoto=`${base}media/v4/home-maintenance-tablet.webp`;
---
<!doctype html><html lang="es"><head>
<V3Seo title="Acceso V4 · IsiVoltPro" description="Preview V4 no indexada de la futura entrada segura a IsiVoltPro, separada de la web comercial y sin simular autenticación en GitHub Pages." path={`${base}preview-v4/acceso/`} noindex={true}/>
<style is:inline>
.strip{background:#0c1630;color:#fff}.strip .page-shell{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:14px;font-size:12px}.strip a{color:#dce7ff;font-weight:800}.hero{padding:86px 0 70px;background:radial-gradient(circle at 79% 14%,rgba(55,104,232,.13),transparent 28%),radial-gradient(circle at 92% 58%,rgba(109,74,255,.11),transparent 22%),#fff}.grid{display:grid;grid-template-columns:minmax(0,.88fr) minmax(480px,1.12fr);gap:58px;align-items:center}.hero h1{margin:18px 0 20px;font:800 clamp(52px,5.8vw,82px)/.97 Manrope,sans-serif;letter-spacing:-.064em}.hero p{max-width:650px;color:#68748a;font-size:18px;line-height:1.72}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:28px}.portal{padding:24px;border:1px solid #e4e8f1;border-radius:30px;background:linear-gradient(145deg,#fff,#f8faff);box-shadow:0 30px 82px rgba(45,59,98,.14)}.portal-bar{display:flex;align-items:center;justify-content:space-between;padding-bottom:15px;border-bottom:1px solid #e9edf4}.portal-bar strong{font-size:13px}.safe{padding:6px 9px;border-radius:999px;background:#eef9f5;color:#168965;font-size:9px;font-weight:900}.portal-body{display:grid;grid-template-columns:118px 1fr;gap:15px;padding-top:16px}.portal-nav{padding:14px;border-radius:18px;background:#111b36;color:#aebbd5}.portal-nav small{display:block;margin-bottom:12px;color:#7f8dab}.portal-nav span{display:block;padding:9px;border-radius:9px;font-size:9px}.portal-nav span:first-of-type{background:rgba(83,111,239,.25);color:#fff}.login{padding:18px;border:1px solid #e6eaf2;border-radius:18px;background:#fff}.login small{color:#8893a5}.login h2{margin:5px 0 15px;font-size:23px}.fake-field{margin-top:9px;padding:12px;border:1px solid #e0e5ee;border-radius:12px;background:#f6f8fb;color:#9aa3b1;font-size:11px}.disabled{margin-top:12px;padding:12px;border-radius:12px;background:#18233e;color:#fff;text-align:center;font-size:11px;font-weight:900;opacity:.68}.notice{margin-top:11px;color:#7b879b;font-size:10px;line-height:1.5}.arch{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.arch article{padding:23px;border:1px solid #e5e9f2;border-radius:22px;background:#fff}.arch b{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:#eef3ff;color:#3768e8}.arch h3{margin:16px 0 8px;font-size:18px}.arch p{margin:0;color:#758197;font-size:12px;line-height:1.55}.reality{display:grid;grid-template-columns:1.04fr .96fr;gap:42px;align-items:center}.photo{overflow:hidden;border-radius:30px;box-shadow:0 27px 72px rgba(45,59,98,.14)}.photo img{display:block;width:100%;height:400px;object-fit:cover}.copy h2{margin:14px 0;font:800 clamp(38px,4.5vw,58px)/1.03 Manrope,sans-serif;letter-spacing:-.052em}.copy p{color:#718096;line-height:1.72}.private{display:grid;grid-template-columns:1.05fr .95fr;gap:18px}.private-main{padding:34px;border-radius:30px;background:linear-gradient(125deg,#0d1730,#1b2d58 58%,#342676);color:#fff}.private-main h2{margin:14px 0 12px;font:800 clamp(36px,4.3vw,55px)/1.03 Manrope,sans-serif;letter-spacing:-.05em}.private-main p{color:#c6d1e6;line-height:1.7}.private-side{display:grid;gap:11px}.private-side article{padding:21px;border:1px solid #e5e9f2;border-radius:21px;background:#fff}.private-side strong{display:block}.private-side p{margin:7px 0 0;color:#788499;font-size:12px;line-height:1.55}.cta{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;padding:40px;border-radius:30px;background:linear-gradient(115deg,#f2f7ff,#f4f0ff 48%,#effaf6)}.cta h2{margin:0;font:800 clamp(34px,4vw,50px)/1.04 Manrope,sans-serif;letter-spacing:-.048em}.cta p{margin:11px 0 0;color:#6f7b90;line-height:1.65}@media(max-width:980px){.grid,.reality,.private,.cta{grid-template-columns:1fr}.arch{grid-template-columns:repeat(2,1fr)}}@media(max-width:680px){.hero{padding:58px 0 48px}.hero h1{font-size:clamp(44px,13vw,62px)}.portal-body{grid-template-columns:1fr}.portal-nav{display:none}.arch{grid-template-columns:1fr}.photo img{height:320px}.strip .page-shell{padding:8px 0;flex-direction:column;align-items:flex-start}.private-main,.cta{padding:28px 22px}}
</style></head><body><V3CommercialHeader/><div class="strip"><div class="page-shell"><strong>Preview V4 · Fase 9 · Acceso</strong><span>Web comercial ≠ zona privada · <a href={`${base}preview-v4/`}>Mapa V4</a></span></div></div><main class="page-main">
<section class="hero"><div class="page-shell grid"><div><span class="eyebrow">Entrada central y separada</span><h1>Accede a tu entorno.<br/><span class="gradient-text">Sin mezclar venta y operación.</span></h1><p>La futura entrada central llevará al usuario autenticado hacia su organización y sus aplicaciones. Esta preview no valida credenciales ni crea sesiones: GitHub Pages sigue siendo solo una superficie estática de revisión.</p><div class="actions"><a class="btn btn--primary" href={security}>Ver Seguridad V4 →</a><a class="btn" href={demo}>Volver a Demo V4</a></div></div><aside class="portal" aria-label="Vista conceptual del futuro acceso, no funcional"><div class="portal-bar"><strong>IsiVoltPro · Acceso</strong><span class="safe">Preview estática</span></div><div class="portal-body"><nav class="portal-nav" aria-hidden="true"><small>ENTRADA</small><span>Acceso</span><span>Organización</span><span>Mis apps</span><span>Cuenta</span></nav><div class="login"><small>Acceso central</small><h2>Bienvenido de nuevo</h2><div class="fake-field">Correo corporativo</div><div class="fake-field">Contraseña</div><div class="disabled">Entrar · no activo en preview</div><p class="notice">No introduzcas credenciales reales. Esta maqueta no autentica, no envía ni almacena información.</p></div></div></aside></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Arquitectura de acceso</span><h2>Identidad, organización y permiso.<br/><span class="gradient-text">En ese orden.</span></h2></div><p>La interfaz puede guiar al usuario, pero la autorización real debe verificarse en backend para cada recurso y operación sensible.</p></div><div class="arch"><article><b>1</b><h3>Identidad</h3><p>Sesión válida y usuario activo antes de entrar en una superficie privada.</p></article><article><b>2</b><h3>Organización</h3><p>El usuario entra en un ámbito empresarial concreto, no en datos globales.</p></article><article><b>3</b><h3>Membresía</h3><p>La relación activa con esa organización determina el acceso efectivo.</p></article><article><b>4</b><h3>Rol y aplicación</h3><p>Cada función recibe únicamente el alcance que necesita.</p></article></div></div></section>
<section class="page-section"><div class="page-shell reality"><figure class="photo"><img src={fieldPhoto} alt="Técnico de mantenimiento usando una tablet junto a una instalación técnica" width="1400" height="788" loading="lazy"/></figure><div class="copy"><span class="eyebrow">La seguridad debe acompañar al trabajo real</span><h2>Campo rápido.<br/>Permisos estrictos.</h2><p>El técnico necesita entrar rápido al activo, a la OT y a sus evidencias. Esa agilidad no implica ampliar permisos: el backend debe limitar qué organización, datos y operaciones puede utilizar cada cuenta.</p><div class="actions"><a class="btn btn--primary" href={privacy}>Privacidad V4 →</a></div></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell private"><div class="private-main"><span class="eyebrow">Superficies privadas</span><h2>No publicaremos una falsa app privada dentro de Pages.</h2><p>El laboratorio puede enseñar diseño y navegación, pero autenticación, persistencia, administración y operaciones reales solo se habilitarán cuando exista infraestructura autenticada y controles server-side.</p></div><div class="private-side"><article><strong>Dashboard privado</strong><p>Disponible solo detrás de sesión y organización válidas.</p></article><article><strong>Administración</strong><p>Roles elevados y acciones sensibles separados del usuario normal.</p></article><article><strong>Datos empresariales</strong><p>Nunca usados como contenido estático ni embebidos en el frontend público.</p></article></div></div></section>
<section class="page-section"><div class="page-shell"><div class="cta"><div><h2>Fase 9 · Acceso preparado como arquitectura, no como simulación.</h2><p>El siguiente bloque de esta fase cierra seguridad, privacidad y límites antes de la revisión final.</p></div><a class="btn btn--primary" href={security}>Seguridad V4 →</a></div></div></section>
</main><V3CommercialFooter/></body></html>
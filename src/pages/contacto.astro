---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const demo = `${base}demo/`;
const pilot = `${base}piloto/`;
const security = `${base}seguridad/`;
---
<!doctype html><html lang="es"><head>
<V3Seo title="Contacto · IsiVoltPro" description="Vista segura del futuro canal de contacto de IsiVoltPro, con recogida de datos personales desactivada hasta completar privacidad, consentimiento y backend." path={`${base}contacto/`} />
<style is:inline>
.contact-board{min-height:100svh;background:radial-gradient(circle at 15% 66%,rgba(65,199,153,.08),transparent 25%),radial-gradient(circle at 58% 22%,rgba(109,88,225,.10),transparent 24%),radial-gradient(circle at 88% 46%,rgba(43,158,214,.07),transparent 22%),#fff}.contact-main{padding:62px 0 78px}.contact-layout{display:grid;grid-template-columns:.78fr 1.22fr;gap:64px;align-items:center}.contact-left h1{margin:14px 0 17px;font:800 clamp(42px,4.35vw,64px)/.98 var(--v3-font-display,system-ui);letter-spacing:-.064em}.contact-left h1 span{display:block;color:transparent;background:linear-gradient(90deg,#6658de,#49a9d1 52%,#35bd8e);-webkit-background-clip:text;background-clip:text}.contact-left>p{max-width:470px;margin:0;color:#747f91;font-size:14px;line-height:1.72}.contact-kicker{display:inline-flex;padding:7px 10px;border:1px solid #e9ecf3;border-radius:999px;background:rgba(255,255,255,.82);color:#70798a;font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 8px 22px rgba(60,70,110,.04)}.contact-methods{display:grid;gap:11px;margin:24px 0}.contact-method{display:grid;grid-template-columns:38px 1fr;gap:12px;align-items:center;padding:10px 12px;border:1px solid rgba(231,234,242,.88);border-radius:14px;background:rgba(255,255,255,.72)}.contact-method i{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;background:#f1efff;color:#6854db;font-style:normal;box-shadow:inset 0 0 0 1px rgba(103,84,219,.05)}.contact-method:nth-child(2) i{background:#eaf9f3;color:#22a777}.contact-method:nth-child(3) i{background:#eef7fb;color:#2c9ab5}.contact-method strong{display:block;font-size:11px}.contact-method small{display:block;margin-top:3px;color:#8992a1;font-size:9px;line-height:1.4}.contact-links{display:flex;gap:9px;flex-wrap:wrap;margin-top:19px}.contact-links .btn{min-height:46px;border-radius:11px;font-size:11px;padding-inline:17px}.contact-links .btn--primary{background:#111827;border-color:#111827;color:#fff;box-shadow:0 13px 30px rgba(17,24,39,.16)}
.contact-workspace{position:relative;min-height:570px}.contact-glow{position:absolute;z-index:0;inset:10% -7% 2% 10%;border-radius:48px;background:linear-gradient(135deg,rgba(78,104,235,.18),rgba(117,82,225,.13) 40%,rgba(239,80,170,.08) 67%,rgba(51,190,145,.12));filter:blur(34px)}.contact-window{position:relative;z-index:2;margin:20px 36px 26px 0;padding:20px;border:1px solid rgba(226,230,240,.96);border-radius:28px;background:rgba(255,255,255,.92);box-shadow:0 34px 90px rgba(52,61,101,.16),0 10px 30px rgba(91,72,180,.07);backdrop-filter:blur(16px)}.contact-window__bar{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:2px 3px 17px;border-bottom:1px solid #edf0f5}.contact-brand{display:flex;align-items:center;gap:10px}.contact-brand i{width:29px;height:29px;display:grid;place-items:center;border-radius:9px;background:linear-gradient(145deg,#18b9d7,#175cff 38%,#6d4aff 68%,#f238a9);color:#fff;font-style:normal;font-size:10px;font-weight:900;box-shadow:0 8px 18px rgba(83,72,205,.20)}.contact-brand strong{font-size:12px;letter-spacing:-.02em}.contact-window__bar small{color:#929aaa;font-size:8px}.contact-window__body{display:grid;grid-template-columns:150px 1fr;gap:15px;padding-top:16px}.contact-sidebar{padding:13px;border-radius:17px;background:linear-gradient(155deg,#10182f,#202e51);color:#d8e2f7}.contact-sidebar small{display:block;margin-bottom:12px;color:#8492b3;font-size:7px;text-transform:uppercase;letter-spacing:.08em}.contact-sidebar span{display:block;margin:6px 0;padding:8px 9px;border-radius:9px;color:#aeb9d3;font-size:8px}.contact-sidebar span.active{background:linear-gradient(90deg,rgba(69,102,242,.27),rgba(117,80,225,.22));color:#fff}.contact-canvas{min-width:0}.contact-canvas__head{display:flex;justify-content:space-between;align-items:flex-end;gap:14px}.contact-canvas__head small{color:#8b95a5;font-size:8px}.contact-canvas__head strong{display:block;margin-top:4px;font-size:18px}.contact-state{display:inline-flex;align-items:center;gap:6px;padding:7px 9px;border-radius:999px;background:#eaf9f3;color:#1e9f70;font-size:7px;font-weight:850}.contact-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:14px}.contact-kpi{padding:12px;border:1px solid #e8ebf2;border-radius:13px;background:linear-gradient(145deg,#fff,#f8f9fd)}.contact-kpi:nth-child(2){background:linear-gradient(145deg,#fff,#f5f1ff)}.contact-kpi:nth-child(3){background:linear-gradient(145deg,#fff,#effbf6)}.contact-kpi small{display:block;color:#8a94a5;font-size:7px}.contact-kpi strong{display:block;margin-top:5px;font-size:15px}.contact-card{margin-top:12px;padding:17px;border:1px solid #e7eaf2;border-radius:17px;background:#fff;box-shadow:0 13px 32px rgba(56,64,103,.06)}.contact-card__top{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:13px}.contact-card h2{margin:0;font-size:14px}.contact-card__top p{margin:4px 0 0;color:#8a93a2;font-size:8px;line-height:1.5}.contact-lock{display:flex;gap:9px;align-items:flex-start;margin-bottom:13px;padding:9px 10px;border:1px solid #e7eaf2;border-radius:11px;background:linear-gradient(90deg,#f8faff,#f8f6ff);color:#68748a;font-size:7px;line-height:1.45}.contact-lock i{width:25px;height:25px;display:grid;place-items:center;flex:0 0 auto;border-radius:8px;background:#efedff;color:#6650d8;font-style:normal}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.form-preview{border:0;padding:0;margin:0}.field{display:grid;gap:4px}.field--wide{grid-column:1/-1}.field label{font-size:7px;font-weight:800;color:#566176}.field input,.field select,.field textarea{width:100%;padding:8px 9px;border:1px solid #e2e6ee;border-radius:7px;background:#f8f9fc;color:#7b8597;font-size:8px;outline:0;-webkit-text-fill-color:#7b8597}.field textarea{min-height:68px;resize:none}.contact-actions{margin-top:10px}.contact-actions .btn{width:100%;min-height:39px;background:#111827!important;border-color:#111827!important;color:#fff!important;font-size:9px}.contact-actions button[disabled]{opacity:.78;cursor:not-allowed}.contact-float{position:absolute;z-index:4;padding:12px 14px;border:1px solid #e4e8f0;border-radius:15px;background:rgba(255,255,255,.96);box-shadow:0 17px 40px rgba(58,67,107,.15)}.contact-float strong{display:block;font-size:10px}.contact-float small{display:block;margin-top:3px;color:#8992a2;font-size:7px}.contact-float--a{right:0;top:54px}.contact-float--a strong{color:#6656dc}.contact-float--b{left:-24px;bottom:52px}.contact-float--b strong{color:#22a777}.contact-float--c{right:10px;bottom:6px}.contact-float--c strong{color:#2d9bb5}.contact-progress{display:flex;gap:5px;margin-top:7px}.contact-progress i{display:block;width:22px;height:4px;border-radius:99px;background:#e7eaf2}.contact-progress i:first-child,.contact-progress i:nth-child(2){background:linear-gradient(90deg,#6357dc,#41a6cc)}
@media(max-width:980px){.contact-main{padding:64px 0 80px}.contact-layout{grid-template-columns:1fr;gap:42px}.contact-left{max-width:680px}.contact-left h1{font-size:clamp(48px,8vw,66px)}.contact-workspace{min-height:555px;max-width:760px}.contact-window{margin-right:28px}.contact-float--b{left:8px}}@media(max-width:620px){.contact-main{padding:54px 0 66px}.contact-layout{gap:30px}.contact-left h1{font-size:clamp(43px,12vw,56px)}.contact-left>p{font-size:13px}.contact-links{flex-direction:column}.contact-links .btn{width:100%}.contact-workspace{min-height:auto}.contact-glow,.contact-float{display:none}.contact-window{margin:0;padding:14px;border-radius:20px}.contact-window__body{grid-template-columns:1fr}.contact-sidebar{display:none}.contact-kpis{grid-template-columns:1fr 1fr}.contact-kpi:nth-child(3){grid-column:1/-1}.contact-card{padding:14px}.form-grid{grid-template-columns:1fr}.field--wide{grid-column:auto}.contact-canvas__head{align-items:flex-start;flex-direction:column}.contact-state{align-self:flex-start}}
</style></head><body class="contact-board"><V3CommercialHeader />
<main class="contact-main"><div class="page-shell contact-layout">
<section class="contact-left"><span class="contact-kicker">Contacto</span><h1>Hablemos de<span>tu proyecto.</span></h1><p>Antes de pedirte datos, queremos que puedas entender IsiVoltPro. Explora la demo, comprueba el enfoque del piloto y revisa cómo se plantea la seguridad. El canal real seguirá cerrado hasta disponer de privacidad, consentimiento y backend seguros.</p><div class="contact-methods"><div class="contact-method"><i aria-hidden="true">▣</i><div><strong>Demo del producto</strong><small>Recorre el producto con información ficticia y sin registro.</small></div></div><div class="contact-method"><i aria-hidden="true">✓</i><div><strong>Piloto acotado</strong><small>Valida un problema concreto antes de hablar de contratación.</small></div></div><div class="contact-method"><i aria-hidden="true">◇</i><div><strong>Privacidad primero</strong><small>No recogemos datos personales mientras el canal no esté listo.</small></div></div></div><div class="contact-links"><a class="btn btn--primary" href={demo}>Ver demo</a><a class="btn" href={pilot}>Ver piloto</a><a class="btn" href={security}>Seguridad</a></div></section>
<section class="contact-workspace" aria-label="Vista conceptual del futuro flujo comercial"><div class="contact-glow" aria-hidden="true"></div><div class="contact-window"><div class="contact-window__bar"><div class="contact-brand"><i aria-hidden="true">IV</i><strong>IsiVoltPro</strong></div><small>Workspace comercial · vista conceptual</small></div><div class="contact-window__body"><aside class="contact-sidebar" aria-hidden="true"><small>Recorrido</small><span class="active">Resumen</span><span>Necesidad</span><span>Piloto</span><span>Alcance</span><span>Contacto</span></aside><div class="contact-canvas"><div class="contact-canvas__head"><div><small>Siguiente paso</small><strong>Entender tu caso sin fricción.</strong></div><span class="contact-state">● Canal protegido</span></div><div class="contact-kpis" aria-hidden="true"><div class="contact-kpi"><small>Exploración</small><strong>Demo 60 s</strong></div><div class="contact-kpi"><small>Validación</small><strong>Piloto</strong></div><div class="contact-kpi"><small>Datos reales</small><strong>0</strong></div></div><section class="contact-card" aria-labelledby="contact-title"><div class="contact-card__top"><div><h2 id="contact-title">Cuéntanos qué necesitas</h2><p>Vista previa del futuro formulario de contacto.</p></div></div><div class="contact-lock" id="form-state" role="status"><i aria-hidden="true">🔒</i><span><strong>No introduzcas datos personales todavía.</strong> Los campos están desactivados y esta página no envía ni almacena información.</span></div><form aria-describedby="form-state"><fieldset class="form-preview" disabled aria-label="Vista previa del futuro formulario de contacto"><div class="form-grid"><div class="field"><label for="name">Nombre</label><input id="name" autocomplete="name" placeholder="Nombre" /></div><div class="field"><label for="business">Empresa</label><input id="business" autocomplete="organization" placeholder="Empresa / actividad" /></div><div class="field"><label for="email">Email</label><input id="email" type="email" autocomplete="email" placeholder="nombre@empresa.com" /></div><div class="field"><label for="phone">Teléfono</label><input id="phone" inputmode="tel" autocomplete="tel" placeholder="Opcional" /></div><div class="field field--wide"><label for="profile">Perfil</label><select id="profile"><option>Selecciona un perfil</option><option>Autónomo</option><option>Pequeño equipo</option><option>Empresa mantenedora</option><option>Instalaciones propias</option></select></div><div class="field field--wide"><label for="need">¿En qué podemos ayudarte?</label><textarea id="need" placeholder="Describe brevemente qué quieres organizar mejor"></textarea></div></div></fieldset><div class="contact-actions"><button class="btn" type="button" disabled>Enviar mensaje · próximamente</button></div></form></section></div></div></div><div class="contact-float contact-float--a" aria-hidden="true"><strong>1 · Explora</strong><small>Demo sin registro</small><div class="contact-progress"><i></i><i></i><i></i></div></div><div class="contact-float contact-float--b" aria-hidden="true"><strong>2 · Valida</strong><small>Piloto con alcance claro</small></div><div class="contact-float contact-float--c" aria-hidden="true"><strong>3 · Decide</strong><small>Solo cuando haya encaje</small></div></section>
</div></main><V3CommercialFooter /></body></html>
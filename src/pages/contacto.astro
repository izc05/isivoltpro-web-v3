---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Solicitar demo · IsiVoltPro" description="Solicita una demo de IsiVoltPro y cuéntanos cómo gestionas clientes, equipos, mantenimiento, avisos y órdenes de trabajo en tu negocio." path={`${base}contacto/`} />
  <style is:inline>
    .contact-page{min-height:100svh;background:radial-gradient(circle at 85% 12%,rgba(109,74,255,.12),transparent 23%),radial-gradient(circle at 10% 85%,rgba(36,197,140,.08),transparent 25%),#fff}.contact-hero{padding:82px 0 100px}.contact-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:70px;align-items:start}.contact-copy{min-width:0}.contact-copy h1{font-family:Manrope,sans-serif;font-size:clamp(50px,6vw,78px);line-height:.98;letter-spacing:-.065em;margin:18px 0 22px;overflow-wrap:break-word}.contact-copy>p{color:var(--muted);font-size:18px;line-height:1.7;max-width:520px}.contact-points{display:grid;gap:13px;margin-top:32px}.contact-points div{display:flex;gap:11px;align-items:flex-start;color:#41506c;font-size:14px}.contact-points i{width:26px;height:26px;display:grid;place-items:center;border-radius:9px;background:#eef8f4;color:#159f71;font-style:normal;flex:0 0 auto}.contact-card{border:1px solid var(--line);border-radius:30px;background:rgba(255,255,255,.94);box-shadow:var(--shadow);padding:34px;position:relative;overflow:hidden;min-width:0}.contact-card:before{content:'';position:absolute;width:210px;height:210px;border-radius:50%;right:-100px;top:-100px;background:linear-gradient(135deg,rgba(23,92,255,.16),rgba(242,56,169,.15),rgba(255,139,61,.15));filter:blur(10px)}.contact-card h2{font-family:Manrope,sans-serif;font-size:28px;letter-spacing:-.035em;margin:0 0 8px;position:relative}.contact-card>p{position:relative;margin:0 0 22px;color:var(--muted);line-height:1.6}.contact-lock{position:relative;display:flex;gap:12px;align-items:flex-start;margin:0 0 22px;padding:14px 15px;border:1px solid #e7eaf3;border-radius:15px;background:linear-gradient(135deg,#f8faff,#fbf9ff);color:#53617c;font-size:13px;line-height:1.55}.contact-lock i{width:30px;height:30px;display:grid;place-items:center;flex:0 0 auto;border-radius:10px;background:#f0edff;color:#6748df;font-style:normal}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;position:relative}.form-preview{margin:0;padding:0;border:0;min-width:0}.field{display:grid;gap:7px;min-width:0}.field--wide{grid-column:1/-1}.field label{font-size:12px;font-weight:700;color:#46536e}.field input,.field textarea,.field select{width:100%;border:1px solid var(--line);border-radius:13px;padding:13px 14px;background:#fbfcfe;color:#1c2944;outline:none}.form-preview:disabled .field input,.form-preview:disabled .field textarea,.form-preview:disabled .field select{opacity:1;color:#78849b;background:#f5f7fb;cursor:not-allowed;-webkit-text-fill-color:#78849b}.field textarea{min-height:124px;resize:none}.contact-state{margin-top:18px;padding:13px 15px;border-radius:13px;background:#f7f9fd;color:#65718b;font-size:12px;line-height:1.55}.contact-actions{display:flex;gap:12px;margin-top:20px;align-items:center}.contact-actions .btn{flex:1;min-height:48px}.contact-actions button[disabled]{opacity:.72;cursor:not-allowed;transform:none;box-shadow:none}.contact-back{display:inline-flex;align-items:center;gap:8px;color:#53617c;font-size:13px;margin-top:28px;min-height:44px}.contact-back:hover{text-decoration:underline;text-underline-offset:4px}@media(max-width:850px){.contact-grid{grid-template-columns:1fr;gap:42px}.form-grid{grid-template-columns:1fr}.field--wide{grid-column:auto}}@media(max-width:560px){.contact-hero{padding:52px 0 64px}.contact-copy h1{font-size:clamp(40px,12vw,50px);line-height:1.01;letter-spacing:-.052em}.contact-copy>p{font-size:16px;line-height:1.62}.contact-points{margin-top:26px}.contact-card{padding:24px 20px;border-radius:24px}.contact-card h2{font-size:25px}.contact-lock{padding:13px}.contact-actions{flex-direction:column}.contact-actions .btn{width:100%}.contact-state{font-size:11px}}@media(max-width:390px){.contact-copy h1{font-size:clamp(38px,11vw,44px)}.contact-card{padding-inline:17px}.field input,.field textarea,.field select{padding:12px}.contact-lock{gap:10px}.contact-lock i{width:28px;height:28px}}
  </style>
</head>
<body class="contact-page">
  <V3CommercialHeader />
  <main class="contact-hero" id="main-content">
    <div class="contact-grid page-shell">
      <section class="contact-copy">
        <span class="eyebrow">Demo adaptada a tu forma de trabajar</span>
        <h1>Cuéntanos qué quieres <span class="gradient-text">poner bajo control.</span></h1>
        <p>No hace falta tener una gran empresa. Si gestionas clientes, equipos, avisos, revisiones o trabajos técnicos, la demo se centrará en comprobar cómo podría encajar IsiVoltPro en ese día a día.</p>
        <div class="contact-points">
          <div><i aria-hidden="true">✓</i><span>Demo centrada en problemas reales, no en un catálogo genérico.</span></div>
          <div><i aria-hidden="true">✓</i><span>Enfoque para autónomos, pequeños equipos y empresas mantenedoras.</span></div>
          <div><i aria-hidden="true">✓</i><span>Primero comprobamos encaje y utilidad antes de hablar de contratación.</span></div>
        </div>
        <a class="contact-back" href={base}><span aria-hidden="true">←</span> Volver a IsiVoltPro</a>
      </section>
      <section class="contact-card" aria-labelledby="demo-title">
        <h2 id="demo-title">Solicitar demo</h2>
        <p>Estamos preparando el canal comercial definitivo. Hasta que estén conectados el consentimiento, la política de privacidad y el destino seguro de los mensajes, esta pantalla funciona únicamente como vista previa.</p>
        <div class="contact-lock" id="form-state" role="status">
          <i aria-hidden="true">🔒</i>
          <span><strong>No introduzcas datos personales todavía.</strong> Los campos están desactivados deliberadamente y esta página no envía ni almacena información.</span>
        </div>
        <form aria-describedby="form-state">
          <fieldset class="form-preview" disabled aria-label="Vista previa del formulario de solicitud de demo">
            <div class="form-grid">
              <div class="field"><label for="name">Nombre</label><input id="name" name="name" autocomplete="name" placeholder="Tu nombre" /></div>
              <div class="field"><label for="business">Empresa / actividad</label><input id="business" name="business" autocomplete="organization" placeholder="Ej. Autónomo climatización" /></div>
              <div class="field"><label for="email">Correo</label><input id="email" name="email" type="email" autocomplete="email" placeholder="nombre@empresa.com" /></div>
              <div class="field"><label for="phone">Teléfono</label><input id="phone" name="phone" inputmode="tel" autocomplete="tel" placeholder="Opcional" /></div>
              <div class="field field--wide"><label for="profile">¿Qué perfil describe mejor tu caso?</label><select id="profile" name="profile"><option>Selecciona un perfil</option><option>Autónomo</option><option>Pequeña empresa / equipo técnico</option><option>Empresa mantenedora</option><option>Negocio con instalaciones propias</option><option>Otro</option></select></div>
              <div class="field field--wide"><label for="need">¿Qué necesitas organizar mejor?</label><textarea id="need" name="need" placeholder="Por ejemplo: avisos por WhatsApp, preventivos, historial de equipos, OT de técnicos..."></textarea></div>
            </div>
          </fieldset>
          <div class="contact-actions"><button class="btn btn--primary" type="button" disabled>Canal comercial en preparación <span aria-hidden="true">→</span></button></div>
        </form>
      </section>
    </div>
  </main>
  <V3CommercialFooter />
</body>
</html>

---
interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  noindex = false,
  image = `${import.meta.env.BASE_URL}images/home/isivoltpro-industrial-core.webp`,
  imageAlt = 'IsiVoltPro · mantenimiento bajo control',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(path, siteOrigin);
const socialImage = new URL(image, siteOrigin);
const rssFeed = new URL('/rss.xml', siteOrigin);
const fullTitle = title.includes('IsiVoltPro') ? title : `${title} · IsiVoltPro`;
const csp = "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self'; base-uri 'self'; form-action 'self'";
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta http-equiv="Content-Security-Policy" content={csp} />
<script is:inline>document.documentElement.classList.add('js');</script>
<meta name="theme-color" content="#071638" />
<meta name="color-scheme" content="light" />
<meta name="application-name" content="IsiVoltPro" />
<meta name="apple-mobile-web-app-title" content="IsiVoltPro" />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="es" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
<link rel="alternate" type="application/rss+xml" title="IsiVoltPro · Blog y noticias" href={rssFeed} />
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
<link rel="apple-touch-icon" href={`${base}brand/isivoltpro-touch-icon-180.png`} sizes="180x180" />
<link rel="manifest" href={`${base}site.webmanifest`} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content="IsiVoltPro" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:type" content="image/webp" />
<meta property="og:image:width" content="744" />
<meta property="og:image:height" content="296" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={imageAlt} />
<title>{fullTitle}</title>

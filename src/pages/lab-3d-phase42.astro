---
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#02050a" />
    <meta name="description" content="ISIVOLTPRO phase 4.2 ecosystem map: physical systems, software layers and AI over the wide facility journey." />
    <link rel="prefetch" href={`${base}lab-3d-phase41/`} />
    <title>ISIVOLTPRO · Phase 4.2 Ecosystem Map</title>
  </head>
  <body>
    <iframe id="journey-frame" src={`${base}lab-3d-phase41/`} title="IsiVoltPro wide ecosystem journey" aria-hidden="true"></iframe>

    <div class="ecosystem-layer" aria-hidden="true">
      <svg class="routes" viewBox="0 0 1000 620" preserveAspectRatio="none">
        <path class="route mechanical" data-route="MECHANICAL" d="M95 455 C210 410 260 440 350 390 S500 360 570 390" />
        <path class="route hvac" data-route="HVAC" d="M120 215 C250 180 390 200 520 245 S650 280 735 245" />
        <path class="route climate" data-route="CLIMATE" d="M755 330 C700 320 650 350 595 380" />
        <path class="route electrical" data-route="ELECTRICAL" d="M875 470 C790 445 710 435 625 402" />
        <path class="route water" data-route="WATER" d="M80 520 C190 500 315 520 410 470 S520 430 585 410" />
        <circle class="hub" cx="596" cy="394" r="7" />
      </svg>

      <div class="system-key">
        <span data-key="MECHANICAL"><i></i>Mechanical</span>
        <span data-key="HVAC"><i></i>HVAC</span>
        <span data-key="CLIMATE"><i></i>Climate</span>
        <span data-key="ELECTRICAL"><i></i>Electrical</span>
        <span data-key="WATER"><i></i>Water</span>
      </div>

      <div class="asset-pins">
        <div class="pin p1"><b>P-04</b><span>PUMP</span></div>
        <div class="pin p2"><b>AHU-02</b><span>HVAC</span></div>
        <div class="pin p3"><b>CU-01</b><span>CLIMATE</span></div>
        <div class="pin p4"><b>DB-01</b><span>POWER</span></div>
        <div class="pin p5"><b>W-07</b><span>WATER</span></div>
      </div>

      <div class="software-card maintenance-card">
        <div class="card-top"><span>MAINTENANCE</span><strong>01 ACTIVE</strong></div>
        <b>OT · P-04</b>
        <p>Inspection due · priority normal</p>
        <div class="card-line"><i></i><span>Asset → task → technician</span></div>
      </div>

      <div class="software-card operations-card">
        <div class="card-top"><span>OPERATIONS</span><strong>LIVE</strong></div>
        <div class="op-row"><span>Mechanical</span><b>Normal</b></div>
        <div class="op-row"><span>HVAC</span><b>Normal</b></div>
        <div class="op-row"><span>Electrical</span><b class="attention">Attention</b></div>
        <div class="op-row"><span>Water</span><b>Normal</b></div>
      </div>

      <div class="software-card ai-card">
        <div class="ai-orbit"><i></i><i></i><i></i></div>
        <div>
          <div class="card-top"><span>ISIVOLTPRO AI</span><strong>ANALYSIS</strong></div>
          <b>Context across systems.</b>
          <p>Assets, state, maintenance history and technical data converge before recommendations are surfaced.</p>
        </div>
      </div>
    </div>

    <header class="topbar">
      <a class="brand" href={base}>ISIVOLT<strong>PRO</strong></a>
      <span class="phase">FASE 4.2 / ECOSYSTEM MAP</span>
      <a class="back" href={`${base}lab-3d-phase41/`}>WIDE JOURNEY 4.1</a>
    </header>

    <aside class="metrics" aria-live="polite">
      <div><span>LAYER</span><strong id="layer">PHYSICAL</strong></div>
      <div><span>FOCUS</span><strong id="focus">FACILITY</strong></div>
      <div><span>CORE</span><strong>3.1</strong></div>
      <div><span>JOURNEY</span><strong id="journey">00%</strong></div>
    </aside>

    <main id="story">
      <section class="chapter active" data-layer="PHYSICAL" data-focus="FACILITY">
        <div class="copy">
          <p class="eyebrow">PHYSICAL INSTALLATION</p>
          <h1>Systems first.<br />Software second.</h1>
          <p class="body-copy">The facility remains the primary visual layer. IsiVoltPro starts with the real technical installation instead of hiding it behind dashboards.</p>
          <span class="scroll-hint">MAP THE ECOSYSTEM <i>↓</i></span>
        </div>
      </section>

      <section class="chapter" data-layer="PHYSICAL" data-focus="WATER">
        <div class="copy right-copy">
          <p class="index">02 / WATER</p><p class="eyebrow">DISTRIBUTION · FLOW · CONDITION</p>
          <h2>Add the fifth<br />physical system.</h2>
          <p class="body-copy">Water joins mechanical, ventilation, climate and power as another technical discipline connected to the same operational context.</p>
        </div>
      </section>

      <section class="chapter" data-layer="PHYSICAL" data-focus="ALL SYSTEMS">
        <div class="copy">
          <p class="index">03 / SYSTEM MAP</p><p class="eyebrow">MECHANICAL · HVAC · CLIMATE · POWER · WATER</p>
          <h2>Different systems.<br />One installation.</h2>
          <p class="body-copy">Each route appears only when useful. The map is deliberately restrained so the equipment still reads before the digital layer.</p>
        </div>
      </section>

      <section class="chapter" data-layer="DIGITAL" data-focus="ASSETS">
        <div class="copy right-copy">
          <p class="index">04 / ASSETS</p><p class="eyebrow">IDENTITY · LOCATION · HISTORY</p>
          <h2>The equipment<br />gets an identity.</h2>
          <p class="body-copy">Pumps, air-handling equipment, climate units, electrical distribution and water assets become addressable objects without replacing their physical context.</p>
        </div>
      </section>

      <section class="chapter" data-layer="DIGITAL" data-focus="MAINTENANCE">
        <div class="copy">
          <p class="index">05 / MAINTENANCE</p><p class="eyebrow">WORK · PEOPLE · HISTORY</p>
          <h2>State becomes<br />work.</h2>
          <p class="body-copy">A condition on an asset can become a work order, assignment or inspection while remaining linked to the equipment that generated it.</p>
        </div>
      </section>

      <section class="chapter" data-layer="DIGITAL" data-focus="OPERATIONS">
        <div class="copy right-copy">
          <p class="index">06 / OPERATIONS</p><p class="eyebrow">STATUS · PRIORITY · CONTEXT</p>
          <h2>One operating<br />picture.</h2>
          <p class="body-copy">Technical disciplines can be read together without pretending they are the same system. IsiVoltPro provides the common operational layer.</p>
        </div>
      </section>

      <section class="chapter" data-layer="INTELLIGENCE" data-focus="AI">
        <div class="copy">
          <p class="index">07 / AI</p><p class="eyebrow">CONTEXT BEFORE ANSWERS</p>
          <h2>Intelligence sits<br />on real context.</h2>
          <p class="body-copy">AI is the final layer, not the foundation: it receives assets, state, maintenance history and technical information before assisting the operator.</p>
        </div>
      </section>

      <section class="chapter" data-layer="ECOSYSTEM" data-focus="ISIVOLTPRO">
        <div class="copy end-copy">
          <p class="index">08 / CONVERGENCE</p><p class="eyebrow">PHYSICAL → DIGITAL → INTELLIGENCE</p>
          <h2>The whole facility.<br />Connected with purpose.</h2>
          <p class="body-copy">This is the visual hierarchy we can later turn into the commercial Home: installation first, platform second, intelligence last.</p>
          <a class="lab-button" href={`${base}lab-3d-phase41/`}>COMPARE WITH 4.1 <span>→</span></a>
        </div>
      </section>
    </main>

    <script>
      const frame = document.querySelector('#journey-frame');
      const layerEl = document.querySelector('#layer');
      const focusEl = document.querySelector('#focus');
      const journeyEl = document.querySelector('#journey');
      const chapters = Array.from(document.querySelectorAll<HTMLElement>('.chapter'));
      const routes = Array.from(document.querySelectorAll<SVGPathElement>('[data-route]'));
      const keys = Array.from(document.querySelectorAll<HTMLElement>('[data-key]'));
      const assetPins = document.querySelector('.asset-pins');
      const maintenanceCard = document.querySelector('.maintenance-card');
      const operationsCard = document.querySelector('.operations-card');
      const aiCard = document.querySelector('.ai-card');

      let frameReady = false;
      let progress = 0;
      let raf = 0;

      if (frame instanceof HTMLIFrameElement) {
        frame.addEventListener('load', () => {
          try {
            const doc = frame.contentDocument;
            if (!doc) return;
            const style = doc.createElement('style');
            style.textContent = `
              html { scrollbar-width: none !important; }
              html::-webkit-scrollbar, body::-webkit-scrollbar { display: none !important; }
              .topbar, .metrics { visibility: hidden !important; }
              #story { opacity: 0 !important; pointer-events: none !important; }
            `;
            doc.head.appendChild(style);
            frameReady = true;
            sync();
          } catch (error) {
            console.error('Phase 4.2 journey frame setup failed', error);
          }
        });
      }

      function clamp(value: number, min = 0, max = 1) { return Math.min(max, Math.max(min, value)); }

      function scrollFrame(frameProgress: number) {
        if (!(frame instanceof HTMLIFrameElement) || !frameReady) return;
        try {
          const win = frame.contentWindow;
          const doc = frame.contentDocument;
          if (!win || !doc) return;
          const maxScroll = Math.max(0, doc.documentElement.scrollHeight - frame.clientHeight);
          win.scrollTo(0, clamp(frameProgress) * maxScroll);
        } catch (error) {
          console.error('Phase 4.2 frame sync failed', error);
          frameReady = false;
        }
      }

      function setOverlay(focus: string, layer: string) {
        const physicalFocus = ['WATER', 'ALL SYSTEMS'].includes(focus);
        routes.forEach((route) => {
          const system = route.dataset.route || '';
          route.classList.toggle('visible', focus === 'ALL SYSTEMS' || focus === system || (focus === 'WATER' && system === 'WATER'));
        });
        keys.forEach((key) => {
          const system = key.dataset.key || '';
          key.classList.toggle('visible', focus === 'ALL SYSTEMS' || focus === system || layer !== 'PHYSICAL');
        });
        assetPins?.classList.toggle('visible', ['ASSETS', 'MAINTENANCE', 'OPERATIONS', 'AI', 'ISIVOLTPRO'].includes(focus));
        maintenanceCard?.classList.toggle('visible', ['MAINTENANCE', 'AI', 'ISIVOLTPRO'].includes(focus));
        operationsCard?.classList.toggle('visible', ['OPERATIONS', 'AI', 'ISIVOLTPRO'].includes(focus));
        aiCard?.classList.toggle('visible', ['AI', 'ISIVOLTPRO'].includes(focus));
        document.body.classList.toggle('show-physical-map', physicalFocus || layer !== 'PHYSICAL');
      }

      function sync() {
        const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        progress = clamp(window.scrollY / maxScroll);
        scrollFrame(progress);

        const active = Math.min(chapters.length - 1, Math.floor(progress * chapters.length));
        chapters.forEach((chapter, index) => chapter.classList.toggle('active', index === active));
        const current = chapters[active];
        const layer = current?.dataset.layer || 'PHYSICAL';
        const focus = current?.dataset.focus || 'FACILITY';
        if (layerEl) layerEl.textContent = layer;
        if (focusEl) focusEl.textContent = focus;
        if (journeyEl) journeyEl.textContent = `${Math.round(progress * 100).toString().padStart(2, '0')}%`;
        setOverlay(focus, layer);
      }

      function requestSync() {
        if (raf) return;
        raf = requestAnimationFrame(() => { raf = 0; sync(); });
      }

      window.addEventListener('scroll', requestSync, { passive: true });
      window.addEventListener('resize', requestSync, { passive: true });
      sync();
    </script>
  </body>
</html>

<style is:global>
  :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #fff; background: #02050a; color-scheme: dark; }
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: #02050a; overflow-x: hidden; }
  body { min-width: 320px; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  #journey-frame { position: fixed; inset: 0; z-index: 0; width: 100%; height: 100%; border: 0; pointer-events: none; }
  body::after { content: ''; position: fixed; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(90deg, rgba(2,5,10,.56), transparent 34%, transparent 69%, rgba(2,5,10,.42)), linear-gradient(180deg, rgba(2,5,10,.1), transparent 54%, rgba(2,5,10,.62)); }
  .topbar { position: fixed; inset: 0 0 auto; z-index: 30; height: 74px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 clamp(22px, 4.5vw, 74px); border-bottom: 1px solid rgba(125,187,211,.1); background: linear-gradient(180deg, rgba(2,5,10,.84), rgba(2,5,10,.08)); backdrop-filter: blur(8px); }
  .brand { justify-self: start; font-size: 17px; font-weight: 700; letter-spacing: .04em; }
  .brand strong { color: #00dcff; }
  .phase, .back { color: #8aa0ae; font-size: 9px; font-weight: 800; letter-spacing: .16em; }
  .back { justify-self: end; }
  .metrics { position: fixed; z-index: 28; right: clamp(22px, 3vw, 48px); top: 96px; width: 200px; padding: 10px 13px; border: 1px solid rgba(126,187,211,.12); background: rgba(3,8,13,.67); backdrop-filter: blur(8px); }
  .metrics div { display: flex; justify-content: space-between; gap: 10px; padding: 5px 0; border-bottom: 1px solid rgba(126,187,211,.07); }
  .metrics div:last-child { border: 0; }
  .metrics span, .metrics strong { font-size: 8px; letter-spacing: .11em; }
  .metrics span { color: #667e8c; }
  .metrics strong { color: #00d9ff; text-align: right; }

  #story { position: relative; z-index: 5; }
  .chapter { min-height: 118vh; position: relative; display: flex; align-items: center; padding: 110px clamp(26px, 6vw, 104px) 70px; pointer-events: none; }
  .copy { width: min(680px, 49vw); opacity: .09; transform: translateY(24px); transition: opacity .5s ease, transform .5s ease; }
  .chapter.active .copy { opacity: 1; transform: translateY(0); }
  .right-copy { margin-left: auto; width: min(600px, 44vw); }
  .end-copy { width: min(790px, 69vw); }
  .eyebrow, .index { margin: 0 0 14px; color: #00d9ff; font-size: 9px; font-weight: 850; letter-spacing: .22em; }
  .index { color: #657c89; }
  h1, h2 { margin: 0; font-weight: 510; letter-spacing: -.06em; line-height: .91; }
  h1 { font-size: clamp(54px, 7vw, 118px); }
  h2 { font-size: clamp(48px, 6vw, 98px); }
  .body-copy { max-width: 535px; margin: 24px 0 0; color: #93a5af; font-size: 13px; line-height: 1.7; }
  .scroll-hint { display: inline-flex; gap: 13px; margin-top: 34px; color: #6f8591; font-size: 9px; font-weight: 800; letter-spacing: .16em; }
  .scroll-hint i, .lab-button span { color: #00d9ff; font-style: normal; }
  .lab-button { pointer-events: auto; display: inline-flex; gap: 18px; margin-top: 30px; padding: 13px 17px; border: 1px solid rgba(0,217,255,.27); color: #dffaff; font-size: 9px; font-weight: 800; letter-spacing: .13em; }

  .ecosystem-layer { position: fixed; inset: 0; z-index: 4; pointer-events: none; }
  .routes { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .route { fill: none; stroke-width: 1.45; vector-effect: non-scaling-stroke; opacity: 0; filter: drop-shadow(0 0 5px currentColor); stroke-dasharray: 7 8; transition: opacity .5s ease; }
  .route.visible { opacity: .54; animation: dash 3.8s linear infinite; }
  .mechanical { stroke: #51c7dc; color: #51c7dc; }
  .hvac { stroke: #8eddf2; color: #8eddf2; }
  .climate { stroke: #b5eaff; color: #b5eaff; }
  .electrical { stroke: #ffbd51; color: #ffbd51; }
  .water { stroke: #3d9cff; color: #3d9cff; }
  .hub { fill: #00d9ff; opacity: 0; filter: drop-shadow(0 0 12px #00d9ff); transition: opacity .5s ease; }
  .show-physical-map .hub { opacity: .72; }
  @keyframes dash { to { stroke-dashoffset: -30; } }

  .system-key { position: absolute; left: 50%; bottom: 28px; transform: translateX(-50%); display: flex; gap: 9px; flex-wrap: wrap; justify-content: center; width: min(760px, 78vw); }
  .system-key span { display: flex; gap: 7px; align-items: center; padding: 6px 9px; border: 1px solid rgba(126,187,211,.1); background: rgba(3,8,13,.62); color: #7f929d; font-size: 7px; font-weight: 800; letter-spacing: .13em; opacity: 0; transform: translateY(6px); transition: .35s ease; backdrop-filter: blur(6px); }
  .system-key span.visible { opacity: .84; transform: translateY(0); }
  .system-key i { width: 5px; height: 5px; border-radius: 50%; background: #00d9ff; box-shadow: 0 0 8px rgba(0,217,255,.55); }
  [data-key="ELECTRICAL"] i { background: #ffbd51; box-shadow: 0 0 8px rgba(255,189,81,.55); }
  [data-key="WATER"] i { background: #3d9cff; box-shadow: 0 0 8px rgba(61,156,255,.55); }

  .asset-pins { position: absolute; inset: 0; opacity: 0; transition: opacity .45s ease; }
  .asset-pins.visible { opacity: 1; }
  .pin { position: absolute; display: grid; gap: 2px; min-width: 70px; padding: 7px 8px; border: 1px solid rgba(0,217,255,.2); background: rgba(2,8,13,.72); backdrop-filter: blur(7px); transform: translate(-50%, -50%); }
  .pin::after { content: ''; position: absolute; left: 50%; top: 100%; width: 1px; height: 28px; background: linear-gradient(#00d9ff, transparent); opacity: .55; }
  .pin b { color: #e7fbff; font-size: 9px; letter-spacing: .1em; }
  .pin span { color: #6e8793; font-size: 6px; font-weight: 800; letter-spacing: .16em; }
  .p1 { left: 24%; top: 66%; } .p2 { left: 46%; top: 32%; } .p3 { left: 75%; top: 52%; } .p4 { left: 83%; top: 69%; } .p5 { left: 16%; top: 77%; }

  .software-card { position: absolute; width: 260px; padding: 14px 15px; border: 1px solid rgba(126,187,211,.16); background: rgba(2,8,13,.8); backdrop-filter: blur(11px); opacity: 0; transform: translateY(12px); transition: opacity .45s ease, transform .45s ease; }
  .software-card.visible { opacity: 1; transform: translateY(0); }
  .maintenance-card { left: 52%; top: 57%; }
  .operations-card { right: 7%; top: 38%; }
  .ai-card { left: 50%; top: 48%; width: 430px; transform: translate(-50%, -40%); display: grid; grid-template-columns: 88px 1fr; gap: 15px; align-items: center; }
  .ai-card.visible { transform: translate(-50%, -50%); }
  .card-top { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
  .card-top span, .card-top strong { font-size: 6px; font-weight: 850; letter-spacing: .15em; }
  .card-top span { color: #657f8d; } .card-top strong { color: #00d9ff; }
  .software-card > b, .ai-card b { display: block; color: #e8f9fc; font-size: 13px; letter-spacing: -.01em; }
  .software-card p { margin: 6px 0 0; color: #78909c; font-size: 8px; line-height: 1.55; }
  .card-line { display: flex; gap: 7px; align-items: center; margin-top: 11px; color: #68808d; font-size: 7px; }
  .card-line i { width: 5px; height: 5px; border-radius: 50%; background: #00d9ff; box-shadow: 0 0 9px #00d9ff; }
  .op-row { display: flex; justify-content: space-between; padding: 5px 0; border-top: 1px solid rgba(126,187,211,.08); color: #738a96; font-size: 7px; }
  .op-row b { color: #9cd9d1; font-size: 7px; } .op-row b.attention { color: #ffbd51; }
  .ai-orbit { width: 76px; height: 76px; border: 1px solid rgba(0,217,255,.18); border-radius: 50%; position: relative; box-shadow: inset 0 0 25px rgba(0,217,255,.05); }
  .ai-orbit::before, .ai-orbit::after { content: ''; position: absolute; border-radius: 50%; border: 1px solid rgba(0,217,255,.15); inset: 10px; }
  .ai-orbit::after { inset: 25px; background: rgba(0,217,255,.12); box-shadow: 0 0 18px rgba(0,217,255,.25); }
  .ai-orbit i { position: absolute; width: 5px; height: 5px; border-radius: 50%; background: #00d9ff; box-shadow: 0 0 8px #00d9ff; }
  .ai-orbit i:nth-child(1) { left: 5px; top: 34px; } .ai-orbit i:nth-child(2) { right: 10px; top: 14px; } .ai-orbit i:nth-child(3) { right: 15px; bottom: 9px; }

  @media (max-width: 760px) {
    .topbar { grid-template-columns: 1fr auto; padding: 0 18px; height: 66px; }
    .phase { display: none; }
    .brand { font-size: 14px; }
    .back { font-size: 7px; }
    .metrics { top: 78px; right: 14px; width: 160px; }
    .chapter { min-height: 112vh; padding: 100px 22px 50px; align-items: flex-end; }
    .copy, .right-copy, .end-copy { width: min(100%, 560px); margin-left: 0; }
    h1 { font-size: clamp(48px, 15vw, 72px); }
    h2 { font-size: clamp(44px, 13vw, 66px); }
    .body-copy { max-width: 92%; font-size: 12px; }
    .routes { opacity: .72; }
    .pin { transform: translate(-50%, -50%) scale(.82); }
    .software-card { width: 210px; transform: translateY(10px) scale(.88); transform-origin: center; }
    .software-card.visible { transform: translateY(0) scale(.88); }
    .maintenance-card { left: 8%; top: 44%; }
    .operations-card { right: 5%; top: 31%; }
    .ai-card { width: min(86vw, 360px); grid-template-columns: 62px 1fr; left: 50%; top: 36%; transform: translate(-50%, -40%) scale(.9); }
    .ai-card.visible { transform: translate(-50%, -50%) scale(.9); }
    .ai-orbit { width: 58px; height: 58px; }
    .system-key { bottom: 14px; width: 92vw; gap: 5px; }
    .system-key span { padding: 5px 6px; font-size: 6px; }
  }
</style>

---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#02040a" />
    <meta name="description" content="ISIVOLTPRO phase 2.4 modular industrial pipe infrastructure." />
    <title>ISIVOLTPRO · Phase 2.4</title>
  </head>
  <body>
    <canvas id="webgl" aria-hidden="true"></canvas>

    <header class="topbar">
      <a class="brand" href={base}>ISIVOLT<strong>PRO</strong></a>
      <span class="phase">FASE 2.4 / PIPE INFRASTRUCTURE</span>
      <a class="back" href={`${base}lab-3d-phase23/`}>BACK TO 2.3</a>
    </header>

    <aside class="metrics" aria-live="polite">
      <div><span>PIPE NETWORK</span><strong id="asset-status">LOADING</strong></div>
      <div><span>REAL PIECES</span><strong id="piece-count">--</strong></div>
      <div><span>FPS</span><strong id="fps">--</strong></div>
      <div><span>TRIS</span><strong id="tris">--</strong></div>
    </aside>

    <main id="story">
      <section class="chapter active">
        <div class="copy">
          <p class="eyebrow">INDUSTRIAL DIGITAL TWIN</p>
          <h1>From asset<br />to infrastructure.</h1>
          <p class="body-copy">The first real 3D kit is no longer displayed as a sample. Its pieces now build the mechanical network.</p>
          <span class="scroll-hint">SCROLL THROUGH THE PLANT <i>↓</i></span>
        </div>
      </section>

      <section class="chapter">
        <div class="copy right-copy">
          <p class="index">02 / CORE</p>
          <p class="eyebrow">CENTRAL INTELLIGENCE</p>
          <h2>The Core reads<br />the whole system.</h2>
          <p class="body-copy">The central layer stays deliberately simple while the physical plant gains engineering structure around it.</p>
        </div>
      </section>

      <section class="chapter">
        <div class="copy">
          <p class="index">03 / MECHANICAL</p>
          <p class="eyebrow">SUPPLY · RETURN · RISERS</p>
          <h2>A network,<br />not a prop.</h2>
          <p class="body-copy">Real modular pipe meshes form parallel mains, vertical risers, tank drops and a pump manifold.</p>
        </div>
      </section>

      <section class="chapter">
        <div class="copy right-copy">
          <p class="index">04 / EQUIPMENT</p>
          <p class="eyebrow">TANKS · PUMPS · CONNECTIONS</p>
          <h2>Equipment starts<br />to belong together.</h2>
          <p class="body-copy">The pipe rack now has a technical reason to exist: feeding and returning through the mechanical zone.</p>
        </div>
      </section>

      <section class="chapter">
        <div class="copy end-copy">
          <p class="index">05 / CHECKPOINT</p>
          <p class="eyebrow">PHASE 2.4</p>
          <h2>Real geometry.<br />Real routing logic.</h2>
          <a class="lab-button" href={`${base}lab-3d-pipes/`}>OPEN SOURCE KIT <span>→</span></a>
        </div>
      </section>
    </main>

    <script>
      import * as THREE from 'three';
      import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
      import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
      import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
      import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';
      import { OutputPass } from 'three/examples/jsm/postprocessing/OutputPass.js';
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const ASSET_URL = 'https://raw.githubusercontent.com/KrazIvan/GodotVR_Test/6dc918140151c3235406a3f616a765e11293285a/Ivan%20VR/models/props/pipe/modular_industrial_pipes_01_4k.gltf';
      const PIXEL = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Y9Zf6AAAAAASUVORK5CYII=';

      const canvas = document.querySelector('#webgl');
      const assetStatus = document.querySelector('#asset-status');
      const pieceCountEl = document.querySelector('#piece-count');
      const fpsEl = document.querySelector('#fps');
      const trisEl = document.querySelector('#tris');

      if (!(canvas instanceof HTMLCanvasElement)) throw new Error('3D canvas missing');

      const mobile = window.matchMedia('(max-width: 760px)').matches;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: false, powerPreference: 'high-performance', stencil: false });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, mobile ? 1.15 : 1.5));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 0.92;
      renderer.shadowMap.enabled = !mobile;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x02040a);
      scene.fog = new THREE.FogExp2(0x02040a, 0.029);

      const camera = new THREE.PerspectiveCamera(42, window.innerWidth / window.innerHeight, 0.1, 120);
      camera.position.set(-14, 8, 19);

      const composer = new EffectComposer(renderer);
      composer.addPass(new RenderPass(scene, camera));
      composer.addPass(new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), mobile ? 0.34 : 0.56, 0.46, 0.84));
      composer.addPass(new OutputPass());

      const world = new THREE.Group();
      scene.add(world);

      const darkMetal = new THREE.MeshStandardMaterial({ color: 0x111925, metalness: 0.74, roughness: 0.36 });
      const darkPanel = new THREE.MeshStandardMaterial({ color: 0x07101a, metalness: 0.48, roughness: 0.54 });
      const concrete = new THREE.MeshStandardMaterial({ color: 0x090e14, metalness: 0.08, roughness: 0.9 });
      const supplyMaterial = new THREE.MeshStandardMaterial({ color: 0x71818b, metalness: 0.9, roughness: 0.28 });
      const returnMaterial = new THREE.MeshStandardMaterial({ color: 0x445863, metalness: 0.82, roughness: 0.34 });
      const valveMaterial = new THREE.MeshStandardMaterial({ color: 0x9a542d, metalness: 0.66, roughness: 0.38 });
      const cyanGlow = new THREE.MeshStandardMaterial({ color: 0x063b50, emissive: 0x00d9ff, emissiveIntensity: 3.0, metalness: 0.5, roughness: 0.22 });
      const blueGlow = new THREE.MeshStandardMaterial({ color: 0x031b38, emissive: 0x0879ff, emissiveIntensity: 2.15, metalness: 0.62, roughness: 0.24 });

      const floor = new THREE.Mesh(new THREE.PlaneGeometry(58, 42), concrete);
      floor.rotation.x = -Math.PI / 2;
      floor.position.y = -0.05;
      floor.receiveShadow = true;
      world.add(floor);

      const grid = new THREE.GridHelper(58, 58, 0x17455b, 0x0b1c27);
      grid.position.y = 0.01;
      grid.material.transparent = true;
      grid.material.opacity = 0.19;
      world.add(grid);

      function makeBuilding(x: number, z: number, w: number, d: number, h: number) {
        const group = new THREE.Group();
        group.position.set(x, 0, z);
        const body = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), darkPanel);
        body.position.y = h / 2;
        body.castShadow = !mobile;
        body.receiveShadow = true;
        group.add(body);
        const strip = new THREE.Mesh(new THREE.BoxGeometry(w * 0.7, 0.05, 0.04), cyanGlow);
        strip.position.set(0, h * 0.7, d / 2 + 0.025);
        group.add(strip);
        world.add(group);
        return group;
      }

      const modules = [
        makeBuilding(-8.2, -2.7, 5.0, 4.2, 3.1),
        makeBuilding(-7.4, 5.2, 5.8, 4.4, 2.6),
        makeBuilding(7.8, -4.7, 5.2, 5.0, 3.7),
        makeBuilding(7.2, 4.5, 6.0, 4.2, 2.8),
        makeBuilding(0.4, 8.3, 6.6, 3.0, 2.2),
      ];

      // Mechanical equipment that the real network will actually serve.
      const tankGroup = new THREE.Group();
      tankGroup.position.set(-1.0, 0, -8.0);
      world.add(tankGroup);
      const tankPositions = [-3.0, -1.45, 0.1, 1.65, 3.2];
      tankPositions.forEach((x, index) => {
        const tank = new THREE.Mesh(new THREE.CylinderGeometry(0.52 + (index % 2) * 0.08, 0.52 + (index % 2) * 0.08, 2.45 + (index % 3) * 0.22, 24), darkMetal);
        tank.position.set(x, 1.28, 0);
        tank.castShadow = !mobile;
        tankGroup.add(tank);
        const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.23, 0.23, 0.16, 18), valveMaterial);
        cap.position.set(x, 2.56 + (index % 3) * 0.1, 0);
        tankGroup.add(cap);
      });

      const pumpGroup = new THREE.Group();
      pumpGroup.position.set(-0.6, 0, -4.1);
      world.add(pumpGroup);
      [-2.7, -0.9, 0.9, 2.7].forEach((x, index) => {
        const skid = new THREE.Group();
        const basePlate = new THREE.Mesh(new THREE.BoxGeometry(1.35, 0.18, 0.86), darkMetal);
        basePlate.position.y = 0.09;
        skid.add(basePlate);
        const motor = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.3, 0.8, 18), darkPanel);
        motor.rotation.z = Math.PI / 2;
        motor.position.set(-0.16, 0.5, 0);
        skid.add(motor);
        const head = new THREE.Mesh(new THREE.CylinderGeometry(0.23, 0.23, 0.42, 18), valveMaterial);
        head.rotation.z = Math.PI / 2;
        head.position.set(0.48, 0.5, 0);
        skid.add(head);
        const led = new THREE.Mesh(new THREE.SphereGeometry(0.05, 10, 10), index % 2 ? blueGlow : cyanGlow);
        led.position.set(0.5, 0.55, 0.35);
        skid.add(led);
        skid.position.x = x;
        pumpGroup.add(skid);
      });

      // Structural pipe rack: deliberately simple so the imported meshes remain the visual focus.
      const rack = new THREE.Group();
      rack.position.set(-4.7, 0, -6.1);
      world.add(rack);
      [-3.7, -1.25, 1.25, 3.7].forEach((x) => {
        const post = new THREE.Mesh(new THREE.BoxGeometry(0.12, 4.5, 0.12), darkMetal);
        post.position.set(x, 2.25, 0);
        rack.add(post);
      });
      [1.1, 2.35, 3.6].forEach((y) => {
        const beam = new THREE.Mesh(new THREE.BoxGeometry(7.6, 0.1, 0.1), darkMetal);
        beam.position.set(0, y, 0);
        rack.add(beam);
      });

      let realPieceCount = 0;
      const network = new THREE.Group();
      world.add(network);

      const manager = new THREE.LoadingManager();
      manager.setURLModifier((url) => url.includes('/textures/') ? PIXEL : url);
      const loader = new GLTFLoader(manager);

      loader.load(
        ASSET_URL,
        (gltf) => {
          const source = new Map<string, THREE.Object3D>();
          gltf.scene.children.forEach((child) => source.set(child.name, child));

          function addPiece(
            name: string,
            position: [number, number, number],
            rotation: [number, number, number],
            scale: number,
            material: THREE.Material,
          ) {
            const original = source.get(name);
            if (!original) return;
            const piece = original.clone(true);
            piece.position.set(...position);
            piece.rotation.set(...rotation);
            piece.scale.setScalar(scale);
            piece.traverse((object) => {
              if (object instanceof THREE.Mesh) {
                object.material = material;
                object.castShadow = !mobile;
                object.receiveShadow = true;
              }
            });
            network.add(piece);
            realPieceCount += 1;
          }

          // Main supply line — long real straight pieces, high on the rack.
          [-7.55, -5.15, -2.75, -0.35].forEach((x) => {
            addPiece('modular_industrial_pipes_01_pipe02', [x, 3.45, -6.1], [0, 0, Math.PI / 2], 1.22, supplyMaterial);
          });
          // Main return line, parallel and lower.
          [-7.55, -5.15, -2.75, -0.35].forEach((x) => {
            addPiece('modular_industrial_pipes_01_pipe02', [x, 2.35, -5.78], [0, 0, Math.PI / 2], 1.22, returnMaterial);
          });

          // End risers joining the two levels.
          [-8.7, 0.82].forEach((x) => {
            addPiece('modular_industrial_pipes_01_pipe02', [x, 1.35, -6.1], [0, 0, 0], 1.1, supplyMaterial);
            addPiece('modular_industrial_pipes_01_pipe03', [x, 3.38, -6.0], [0, Math.PI / 2, 0], 1.12, valveMaterial);
          });

          // Five real drops toward the tanks. Short pieces keep the repeated pattern readable.
          const drops = [-4.0, -2.45, -0.9, 0.65, 2.2];
          drops.forEach((x, index) => {
            addPiece('modular_industrial_pipes_01_pipe01', [x, 2.05, -7.15], [0, 0, 0], 1.05, index % 2 ? returnMaterial : supplyMaterial);
            addPiece('modular_industrial_pipes_01_pipe05', [x, 1.2, -7.55], [0, Math.PI / 2, Math.PI / 2], 0.95, valveMaterial);
          });

          // Pump manifold: two horizontal banks plus four drops to the pump skids.
          [-3.3, -1.0, 1.3].forEach((x) => {
            addPiece('modular_industrial_pipes_01_pipe02', [x, 1.45, -4.45], [0, 0, Math.PI / 2], 1.12, supplyMaterial);
            addPiece('modular_industrial_pipes_01_pipe02', [x, 0.95, -3.88], [0, 0, Math.PI / 2], 1.12, returnMaterial);
          });
          [-3.3, -1.5, 0.3, 2.1].forEach((x, index) => {
            addPiece('modular_industrial_pipes_01_pipe01', [x, 0.78, -4.12], [0, 0, 0], 0.82, index % 2 ? returnMaterial : supplyMaterial);
          });

          // Two elbows visually connect rack direction with the equipment direction.
          addPiece('modular_industrial_pipes_01_pipe04', [-0.2, 3.35, -6.05], [Math.PI / 2, 0, Math.PI / 2], 1.08, valveMaterial);
          addPiece('modular_industrial_pipes_01_pipe04', [-0.25, 2.3, -5.75], [Math.PI / 2, Math.PI, Math.PI / 2], 1.08, valveMaterial);

          if (assetStatus) assetStatus.textContent = 'READY';
          if (pieceCountEl) pieceCountEl.textContent = String(realPieceCount);
        },
        undefined,
        (error) => {
          console.error('Phase 2.4 pipe infrastructure failed to load', error);
          if (assetStatus) assetStatus.textContent = 'ERROR';
        },
      );

      // CORE stays intentionally procedural during Phase 2.
      const core = new THREE.Group();
      world.add(core);
      const plinth = new THREE.Mesh(new THREE.CylinderGeometry(2.25, 2.55, 0.45, 56), darkMetal);
      plinth.position.y = 0.22;
      core.add(plinth);
      const coreBody = new THREE.Mesh(new THREE.CylinderGeometry(0.72, 0.96, 4.4, 42), darkMetal);
      coreBody.position.y = 2.65;
      core.add(coreBody);
      const energyColumn = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 3.55, 24), cyanGlow);
      energyColumn.position.y = 2.7;
      core.add(energyColumn);
      const rings: THREE.Mesh[] = [];
      [1.2, 2.35, 3.5, 4.55].forEach((y, index) => {
        const ring = new THREE.Mesh(new THREE.TorusGeometry(1.08 + index * 0.06, 0.035, 8, 64), index % 2 ? blueGlow : cyanGlow);
        ring.rotation.x = Math.PI / 2;
        ring.position.y = y;
        core.add(ring);
        rings.push(ring);
      });
      const halo = new THREE.Mesh(new THREE.TorusGeometry(2, 0.055, 10, 80), cyanGlow);
      halo.rotation.x = Math.PI / 2;
      halo.position.y = 0.55;
      core.add(halo);
      const beacon = new THREE.PointLight(0x00d9ff, mobile ? 14 : 23, 16, 1.65);
      beacon.position.set(0, 3, 0);
      core.add(beacon);

      scene.add(new THREE.HemisphereLight(0x6ebfe0, 0x02050b, 1.3));
      const key = new THREE.DirectionalLight(0xa9dfff, 3.0);
      key.position.set(-7, 13, 9);
      key.castShadow = !mobile;
      scene.add(key);
      const warm = new THREE.PointLight(0xffa85b, 8, 17, 2);
      warm.position.set(-8, 5, -5);
      scene.add(warm);
      const pipeAccent = new THREE.PointLight(0x00d9ff, 10, 13, 2);
      pipeAccent.position.set(-4.4, 3.7, -5.1);
      scene.add(pipeAccent);
      const equipmentAccent = new THREE.PointLight(0xff9a54, 6, 9, 2);
      equipmentAccent.position.set(-0.8, 2.4, -7.2);
      scene.add(equipmentAccent);

      function createConnection(start: THREE.Vector3, end: THREE.Vector3, height = 1) {
        const mid = start.clone().lerp(end, 0.5);
        mid.y += height;
        const curve = new THREE.CatmullRomCurve3([start, mid, end]);
        const tube = new THREE.Mesh(new THREE.TubeGeometry(curve, 28, 0.023, 7, false), cyanGlow);
        world.add(tube);
        const pulse = new THREE.Mesh(new THREE.SphereGeometry(0.058, 10, 10), cyanGlow);
        world.add(pulse);
        return { curve, pulse, offset: Math.random() };
      }

      const connections = [
        createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(-7.6, 0.65, -3.3), 1.35),
        createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(-4.7, 1.0, -5.8), 1.1),
        createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(7.4, 0.65, -4.6), 1.5),
        createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(7.1, 0.65, 4.4), 1.2),
      ];

      const particleCount = mobile ? 160 : 360;
      const positions = new Float32Array(particleCount * 3);
      for (let i = 0; i < particleCount; i += 1) {
        positions[i * 3] = (Math.random() - 0.5) * 44;
        positions[i * 3 + 1] = Math.random() * 10 + 0.3;
        positions[i * 3 + 2] = (Math.random() - 0.5) * 32;
      }
      const particleGeometry = new THREE.BufferGeometry();
      particleGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      const particles = new THREE.Points(particleGeometry, new THREE.PointsMaterial({ color: 0x5fcde8, size: 0.024, transparent: true, opacity: 0.3, depthWrite: false }));
      world.add(particles);

      const cameraPath = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-14, 8.2, 19),
        new THREE.Vector3(-7.6, 5.8, 12.2),
        new THREE.Vector3(-7.2, 4.4, 2.4),
        new THREE.Vector3(-4.8, 3.3, -2.5),
        new THREE.Vector3(2.2, 3.0, -7.2),
        new THREE.Vector3(7.0, 4.6, -9.2),
      ]);
      const targetPath = new THREE.CatmullRomCurve3([
        new THREE.Vector3(0, 1.8, 0),
        new THREE.Vector3(0, 2.7, 0),
        new THREE.Vector3(-4.7, 2.6, -6.0),
        new THREE.Vector3(-2.5, 1.8, -5.2),
        new THREE.Vector3(-1.0, 1.8, -7.6),
        new THREE.Vector3(0, 2.8, 0),
      ]);

      const state = { progress: 0 };
      const chapters = Array.from(document.querySelectorAll('.chapter'));
      ScrollTrigger.create({
        trigger: '#story',
        start: 'top top',
        end: 'bottom bottom',
        scrub: reducedMotion ? false : 1.05,
        onUpdate: (self) => {
          state.progress = self.progress;
          const active = Math.min(chapters.length - 1, Math.floor(self.progress * chapters.length));
          chapters.forEach((chapter, index) => chapter.classList.toggle('active', index === active));
        },
      });

      const clock = new THREE.Clock();
      let frames = 0;
      let fpsStart = performance.now();
      let raf = 0;
      let visible = true;

      function render(now = performance.now()) {
        const elapsed = clock.getElapsedTime();
        const progress = reducedMotion ? 0.53 : THREE.MathUtils.clamp(state.progress, 0.001, 0.999);
        const camPos = cameraPath.getPointAt(progress);
        const target = targetPath.getPointAt(progress);
        camera.position.lerp(camPos, reducedMotion ? 1 : 0.075);
        camera.lookAt(target);

        core.rotation.y = elapsed * 0.05;
        halo.rotation.z = elapsed * 0.16;
        rings.forEach((ring, index) => ring.rotation.z = elapsed * (0.11 + index * 0.02) * (index % 2 ? -1 : 1));
        particles.rotation.y = elapsed * 0.004;
        modules.forEach((module, index) => module.position.y = Math.sin(elapsed * 0.5 + index) * 0.009);
        connections.forEach(({ curve, pulse, offset }, index) => pulse.position.copy(curve.getPointAt((elapsed * (0.11 + index * 0.01) + offset) % 1)));

        composer.render();

        frames += 1;
        if (now - fpsStart >= 1000) {
          if (fpsEl) fpsEl.textContent = String(Math.round((frames * 1000) / (now - fpsStart)));
          if (trisEl) trisEl.textContent = renderer.info.render.triangles.toLocaleString();
          frames = 0;
          fpsStart = now;
        }

        if (visible) raf = requestAnimationFrame(render);
      }

      function resize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, window.innerWidth <= 760 ? 1.15 : 1.5));
        renderer.setSize(window.innerWidth, window.innerHeight);
        composer.setSize(window.innerWidth, window.innerHeight);
      }

      window.addEventListener('resize', resize, { passive: true });
      document.addEventListener('visibilitychange', () => {
        visible = !document.hidden;
        if (visible) {
          cancelAnimationFrame(raf);
          clock.getDelta();
          fpsStart = performance.now();
          frames = 0;
          render();
        }
      });

      render();
    </script>
  </body>
</html>

<style is:global>
  :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #fff; background: #02040a; color-scheme: dark; }
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: #02040a; overflow-x: hidden; }
  body { min-width: 320px; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  #webgl { position: fixed; inset: 0; width: 100%; height: 100%; display: block; z-index: 0; }
  body::after { content: ''; position: fixed; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgba(2,4,10,.46), transparent 34%, transparent 68%, rgba(2,4,10,.32)), linear-gradient(180deg, rgba(2,4,10,.12), transparent 54%, rgba(2,4,10,.6)), radial-gradient(circle at 50% 46%, transparent 0 42%, rgba(2,4,10,.23) 75%, rgba(2,4,10,.58) 100%); }
  .topbar { position: fixed; inset: 0 0 auto; z-index: 20; height: 74px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 clamp(22px, 4.5vw, 74px); border-bottom: 1px solid rgba(125,187,211,.11); background: linear-gradient(180deg, rgba(2,4,10,.78), rgba(2,4,10,.08)); backdrop-filter: blur(8px); }
  .brand { justify-self: start; font-size: 17px; font-weight: 700; letter-spacing: .04em; }
  .brand strong { color: #00dcff; }
  .phase, .back { color: #8aa0ae; font-size: 9px; font-weight: 800; letter-spacing: .16em; }

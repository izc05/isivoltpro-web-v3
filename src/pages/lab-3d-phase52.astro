---
const base = import.meta.env.BASE_URL;
const heroImage = `${base}images/home/isivoltpro-industrial-core.webp`;
const ecosystemUrl = `${base}lab-3d-ecosystem-v1/`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#010308" />
    <meta name="description" content="ISIVOLTPRO Phase 5.2: seamless eclipse entry into Ecosystem Base V1." />
    <link rel="preload" href={heroImage} as="image" type="image/webp" />
    <link rel="preconnect" href="https://raw.githubusercontent.com" crossorigin />
    <title>ISIVOLTPRO · Phase 5.2 Seamless Entry</title>
  </head>
  <body>
    <section class="ecosystem-stage" id="ecosystem-stage" data-state="waiting" aria-hidden="true">
      <iframe id="ecosystem-frame" title="IsiVoltPro Ecosystem Base V1" allow="fullscreen"></iframe>
      <div class="handoff-veil" aria-hidden="true"></div>
    </section>

    <main class="entry" id="entry" data-state="idle">
      <img class="facility" src={heroImage} alt="Instalación industrial IsiVoltPro" width="1000" height="531" fetchpriority="high" decoding="async" />
      <div class="night" aria-hidden="true"></div>
      <div class="grain" aria-hidden="true"></div>
      <div class="horizon" aria-hidden="true"></div>

      <div class="eclipse-wrap" aria-hidden="true">
        <div class="corona corona--outer"></div>
        <div class="corona corona--inner"></div>
        <div class="eclipse"></div>
        <div class="arc"></div>
      </div>

      <header class="topbar">
        <a class="brand" href={base}>ISIVOLT<strong>PRO</strong></a>
        <span class="phase">FASE 5.2 · SEAMLESS HANDOFF</span>
        <a class="compare" href={`${base}lab-3d-phase51/`}>ENTRY 5.1 ↗</a>
      </header>

      <section class="intro" aria-labelledby="entry-title">
        <p class="eyebrow"><i></i> FACILITY INTELLIGENCE</p>
        <h1 id="entry-title">THE FACILITY<br /><em>WAKES UP.</em></h1>
        <p class="lead">La instalación se prepara detrás de la portada. Cuando entras, la experiencia ya está ahí.</p>
        <button class="enter-button" id="enter-button" type="button">
          <span class="enter-button__label">ENTRAR</span>
          <span class="enter-button__icon">→</span>
        </button>
      </section>

      <section class="loader" id="loader" aria-live="polite" aria-hidden="true">
        <div class="loader__head">
          <span id="loader-stage">PREPARANDO INSTALACIÓN</span>
          <strong id="loader-percent">00</strong>
        </div>
        <div class="loader__track"><i id="loader-bar"></i></div>
        <div class="loader__meta">
          <span id="loader-resource">Inicializando</span>
          <span>ECOSYSTEM BASE V1</span>
        </div>
      </section>

      <div class="status-rail" aria-hidden="true">
        <span>ENTRY</span><i></i><span>LIVE SCENE</span>
      </div>

      <button class="skip" id="skip" type="button">ENTRAR SIN TRANSICIÓN</button>
    </main>

    <script is:inline define:vars={{ ecosystemUrl }}>
      const PIPE_ASSET_URL = 'https://raw.githubusercontent.com/KrazIvan/GodotVR_Test/6dc918140151c3235406a3f616a765e11293285a/Ivan%20VR/models/props/pipe/modular_industrial_pipes_01_4k.gltf';
      const HVAC_ASSET_URL = 'https://raw.githubusercontent.com/Hona/daxship/d63856c6af9aba445a4fe8bf832d0e0ecf2572e5/apps/web/public/assets/models/environment/poly-haven/modular_airduct_circular_01/modular_airduct_circular_01_1k.gltf';
      const ELECTRICAL_ASSET_URL = 'https://raw.githubusercontent.com/adamkhatib/PeakBrake/87be08e1b90a6cfc59cd7364488cdca9053a16a3/public/assets/3d/polyhaven/utility_box_01/utility_box_01_1k.gltf';
      const AIRCON_ASSET_URL = 'https://raw.githubusercontent.com/VoxogoBrusch/the-levels/1e7c37785504d23d9a2f669b3b922eac14cedb01/public/assets/models/exterior_aircon_unit/exterior_aircon_unit_1k.gltf';

      const entry = document.querySelector('#entry');
      const stage = document.querySelector('#ecosystem-stage');
      const frame = document.querySelector('#ecosystem-frame');
      const enterButton = document.querySelector('#enter-button');
      const skip = document.querySelector('#skip');
      const loader = document.querySelector('#loader');
      const loaderStage = document.querySelector('#loader-stage');
      const loaderPercent = document.querySelector('#loader-percent');
      const loaderBar = document.querySelector('#loader-bar');
      const loaderResource = document.querySelector('#loader-resource');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let started = false;
      let done = 0;

      const resources = [
        { label: 'Red mecánica', url: PIPE_ASSET_URL },
        { label: 'Ventilación HVAC', url: HVAC_ASSET_URL },
        { label: 'Distribución eléctrica', url: ELECTRICAL_ASSET_URL },
        { label: 'Climatización exterior', url: AIRCON_ASSET_URL },
      ];
      const totalSteps = resources.length + 1;

      function setProgress(label) {
        const progress = Math.round((done / totalSteps) * 100);
        if (loaderPercent) loaderPercent.textContent = String(progress).padStart(2, '0');
        if (loaderBar instanceof HTMLElement) loaderBar.style.width = `${progress}%`;
        if (loaderResource) loaderResource.textContent = label;
      }

      function advance(label) {
        done = Math.min(done + 1, totalSteps);
        setProgress(label);
      }

      async function warm(url) {
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 12000);
        try {
          await fetch(url, { cache: 'force-cache', mode: 'cors', signal: controller.signal });
        } finally {
          clearTimeout(timer);
        }
      }

      function loadLiveScene() {
        return new Promise((resolve) => {
          if (!(frame instanceof HTMLIFrameElement)) {
            resolve(false);
            return;
          }

          let settled = false;
          const finish = (ok) => {
            if (settled) return;
            settled = true;
            window.clearTimeout(timer);
            advance(ok ? 'Escena 3D inicializada' : 'Escena 3D en modo directo');
            resolve(ok);
          };

          const timer = window.setTimeout(() => finish(false), 15000);
          frame.addEventListener('load', () => finish(true), { once: true });
          frame.src = ecosystemUrl;
        });
      }

      async function enterExperience() {
        if (started) return;
        started = true;

        if (entry instanceof HTMLElement) entry.dataset.state = 'loading';
        if (stage instanceof HTMLElement) stage.dataset.state = 'primed';
        if (enterButton instanceof HTMLButtonElement) enterButton.disabled = true;
        if (loader instanceof HTMLElement) loader.setAttribute('aria-hidden', 'false');
        setProgress('Conectando con la instalación');

        const liveScenePromise = loadLiveScene();
        const warmPromises = resources.map(async (resource) => {
          try {
            await warm(resource.url);
          } catch (error) {
            console.warn('Warm cache skipped', resource.label, error);
          }
          advance(resource.label);
        });

        const [sceneReady] = await Promise.all([
          liveScenePromise,
          Promise.all(warmPromises),
        ]);

        if (!sceneReady) {
          window.location.assign(ecosystemUrl);
          return;
        }

        if (loaderStage) loaderStage.textContent = 'INSTALACIÓN PREPARADA';
        if (loaderResource) loaderResource.textContent = 'Transfiriendo control';
        if (entry instanceof HTMLElement) entry.dataset.state = 'ready';

        await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));

        if (reducedMotion) {
          if (stage instanceof HTMLElement) stage.dataset.state = 'revealed';
          if (entry instanceof HTMLElement) entry.dataset.state = 'open';
        } else {
          window.setTimeout(() => {
            if (stage instanceof HTMLElement) stage.dataset.state = 'revealed';
            if (entry instanceof HTMLElement) entry.dataset.state = 'open';
          }, 280);
        }

        window.setTimeout(() => {
          entry?.setAttribute('aria-hidden', 'true');
          stage?.setAttribute('aria-hidden', 'false');
          if (frame instanceof HTMLIFrameElement) {
            try { frame.contentWindow?.scrollTo(0, 0); } catch {}
            frame.focus();
          }
        }, reducedMotion ? 30 : 1100);
      }

      enterButton?.addEventListener('click', enterExperience);
      skip?.addEventListener('click', () => window.location.assign(ecosystemUrl));
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #010308; color: #f6fbff; }
  * { box-sizing: border-box; }
  html, body { margin: 0; width: 100%; min-width: 320px; min-height: 100%; background: #010308; }
  body { overflow: hidden; }
  button, a { font: inherit; }
  a { color: inherit; text-decoration: none; }

  .ecosystem-stage { position: fixed; inset: 0; z-index: 0; overflow: hidden; background: #010308; opacity: 0; transform: scale(1.025); filter: brightness(.38) saturate(.72); pointer-events: none; transition: opacity .95s ease, transform 1.15s cubic-bezier(.2,.72,.18,1), filter 1.05s ease; }
  .ecosystem-stage iframe { display: block; width: 100%; height: 100%; border: 0; background: #010308; }
  .ecosystem-stage[data-state="primed"] { opacity: .001; }
  .ecosystem-stage[data-state="revealed"] { opacity: 1; transform: scale(1); filter: brightness(1) saturate(1); pointer-events: auto; }
  .handoff-veil { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 64% 43%, rgba(26,194,255,.12), transparent 23%), #010308; opacity: 1; transition: opacity .95s ease .08s; }
  .ecosystem-stage[data-state="revealed"] .handoff-veil { opacity: 0; }

  .entry { position: relative; z-index: 5; min-height: 100svh; overflow: hidden; isolation: isolate; background: #010308; opacity: 1; transition: opacity .95s ease, visibility .95s step-end; }
  .entry[data-state="open"] { opacity: 0; pointer-events: none; visibility: hidden; }
  .facility { position: absolute; inset: 0; z-index: -8; width: 100%; height: 100%; object-fit: cover; object-position: 50% 49%; filter: saturate(.72) contrast(1.12) brightness(.38); transform: scale(1.035); transition: filter 1.2s ease, transform 1.4s cubic-bezier(.2,.7,.2,1), opacity .9s ease; }
  .night, .grain, .horizon { position: absolute; inset: 0; pointer-events: none; }
  .night { z-index: -7; background: radial-gradient(circle at 64% 45%, rgba(0,0,0,.05) 0 10%, rgba(1,4,8,.2) 25%, rgba(1,4,8,.76) 66%, #010308 100%), linear-gradient(90deg, rgba(1,3,7,.9) 0%, rgba(1,3,7,.5) 38%, rgba(1,3,7,.18) 62%, rgba(1,3,7,.66) 100%); transition: opacity 1s ease; }
  .grain { z-index: 8; opacity: .06; mix-blend-mode: screen; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.42'/%3E%3C/svg%3E"); }
  .horizon { z-index: -2; top: auto; height: 42%; background: linear-gradient(180deg, transparent, rgba(3,19,30,.08) 32%, rgba(0,170,255,.06) 70%, transparent); filter: blur(12px); }

  .eclipse-wrap { position: absolute; z-index: -1; left: 64%; top: 43%; width: min(34vw, 520px); aspect-ratio: 1; transform: translate(-50%, -50%); }
  .eclipse, .corona, .arc { position: absolute; inset: 50%; border-radius: 50%; transform: translate(-50%, -50%); }
  .eclipse { width: 58%; height: 58%; background: radial-gradient(circle at 43% 40%, #03070b 0 42%, #000 78%, #020306 100%); box-shadow: inset -18px -22px 36px rgba(0,0,0,.72), 0 0 10px rgba(0,0,0,.9); transition: transform 1.05s cubic-bezier(.22,.75,.18,1), opacity .9s ease; }
  .corona--outer { width: 82%; height: 82%; background: radial-gradient(circle, transparent 37%, rgba(56,188,255,.08) 45%, rgba(29,151,255,.22) 48%, rgba(4,80,128,.07) 58%, transparent 71%); filter: blur(13px); animation: breathe 4.8s ease-in-out infinite; }
  .corona--inner { width: 66%; height: 66%; border: 1px solid rgba(151,228,255,.32); box-shadow: 0 0 16px rgba(56,190,255,.25), inset 0 0 15px rgba(77,201,255,.15); animation: breathe 3.7s ease-in-out infinite reverse; }
  .arc { width: 61%; height: 61%; border: 2px solid transparent; border-top-color: rgba(206,246,255,.72); border-right-color: rgba(0,180,255,.28); transform: translate(-50%, -50%) rotate(-34deg); filter: drop-shadow(0 0 6px rgba(90,214,255,.62)); animation: arcDrift 7s linear infinite; }

  .topbar { position: absolute; z-index: 20; inset: 0 0 auto; height: 72px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 clamp(20px, 4vw, 68px); border-bottom: 1px solid rgba(143,202,224,.1); background: linear-gradient(180deg, rgba(1,3,8,.72), transparent); }
  .brand { font-size: 16px; font-weight: 800; letter-spacing: .05em; }
  .brand strong { color: #19c9ff; }
  .phase, .compare { font-size: 8px; font-weight: 800; letter-spacing: .18em; color: #718a98; }
  .compare { justify-self: end; }

  .intro { position: absolute; z-index: 10; left: clamp(28px, 7vw, 118px); top: 50%; width: min(650px, 46vw); transform: translateY(-46%); transition: opacity .65s ease, transform .75s ease; }
  .eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 19px; color: #6c8795; font-size: 9px; font-weight: 800; letter-spacing: .22em; }
  .eyebrow i { width: 38px; height: 1px; background: linear-gradient(90deg, #18ccff, transparent); box-shadow: 0 0 8px rgba(24,204,255,.65); }
  h1 { margin: 0; font-size: clamp(58px, 6.9vw, 116px); font-weight: 470; line-height: .88; letter-spacing: -.067em; }
  h1 em { color: transparent; font-style: normal; -webkit-text-stroke: 1px rgba(137,220,255,.72); text-shadow: 0 0 28px rgba(0,154,255,.12); }
  .lead { width: min(490px, 90%); margin: 27px 0 0; color: #8ca1ac; font-size: 13px; line-height: 1.7; }

  .enter-button { position: relative; display: inline-flex; align-items: center; gap: 35px; margin-top: 34px; padding: 14px 15px 14px 18px; border: 1px solid rgba(61,192,238,.32); background: rgba(3,13,20,.58); color: #eafaff; cursor: pointer; backdrop-filter: blur(10px); transition: border-color .25s ease, background .25s ease, transform .25s ease; }
  .enter-button::before { content: ''; position: absolute; left: -1px; bottom: -1px; width: 38%; height: 1px; background: #1dd7ff; box-shadow: 0 0 12px rgba(29,215,255,.7); }
  .enter-button:hover { transform: translateY(-2px); border-color: rgba(77,214,255,.62); background: rgba(4,24,34,.72); }
  .enter-button:disabled { cursor: default; }
  .enter-button__label { font-size: 9px; font-weight: 850; letter-spacing: .2em; }
  .enter-button__icon { display: grid; place-items: center; width: 27px; height: 27px; border: 1px solid rgba(67,200,244,.24); color: #1ed4ff; }

  .loader { position: absolute; z-index: 12; left: clamp(28px, 7vw, 118px); bottom: clamp(54px, 8vh, 94px); width: min(520px, 52vw); opacity: 0; transform: translateY(18px); pointer-events: none; transition: opacity .55s ease .15s, transform .65s ease .15s; }
  .loader__head, .loader__meta { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .loader__head span, .loader__meta { color: #69828e; font-size: 8px; font-weight: 800; letter-spacing: .17em; }
  .loader__head strong { color: #dff9ff; font-size: 25px; font-weight: 430; letter-spacing: -.04em; }
  .loader__track { height: 1px; margin: 13px 0 11px; background: rgba(132,188,207,.16); overflow: visible; }
  .loader__track i { display: block; width: 0; height: 1px; background: linear-gradient(90deg, #087dff, #23dcff); box-shadow: 0 0 12px rgba(32,213,255,.65); transition: width .32s ease; }
  .loader__meta span:first-child { color: #9bb0ba; }

  .status-rail { position: absolute; right: clamp(26px, 4vw, 72px); bottom: clamp(28px, 5vh, 52px); z-index: 10; display: flex; align-items: center; gap: 12px; color: #526b78; font-size: 7px; font-weight: 850; letter-spacing: .18em; transform: rotate(-90deg) translateX(100%); transform-origin: right bottom; }
  .status-rail i { width: 74px; height: 1px; background: linear-gradient(90deg, rgba(83,121,139,.24), #1acfff); }
  .skip { position: absolute; z-index: 18; right: clamp(20px, 4vw, 68px); bottom: clamp(20px, 4vh, 38px); border: 0; padding: 8px 0; color: #526974; background: transparent; font-size: 7px; font-weight: 800; letter-spacing: .18em; cursor: pointer; }
  .skip:hover { color: #8db7c8; }

  .entry[data-state="loading"] .intro { opacity: .13; transform: translateY(-46%) translateX(-12px); }
  .entry[data-state="loading"] .loader { opacity: 1; transform: translateY(0); }
  .entry[data-state="loading"] .facility { filter: saturate(.84) contrast(1.1) brightness(.49); transform: scale(1.02); }
  .entry[data-state="loading"] .eclipse { transform: translate(-50%, -50%) scale(.86); }
  .entry[data-state="loading"] .corona--outer { animation-duration: 1.6s; }
  .entry[data-state="ready"] .facility { filter: saturate(1.02) contrast(1.04) brightness(.82); transform: scale(1); }
  .entry[data-state="ready"] .night { opacity: .18; }
  .entry[data-state="ready"] .eclipse { transform: translate(-50%, -50%) scale(.08); opacity: 0; }
  .entry[data-state="ready"] .corona--inner { transform: translate(-50%, -50%) scale(3.35); opacity: 0; transition: transform .8s cubic-bezier(.2,.75,.2,1), opacity .75s ease; }
  .entry[data-state="ready"] .corona--outer { transform: translate(-50%, -50%) scale(4); opacity: 0; transition: transform .85s cubic-bezier(.2,.75,.2,1), opacity .8s ease; }
  .entry[data-state="ready"] .intro, .entry[data-state="ready"] .loader, .entry[data-state="ready"] .topbar, .entry[data-state="ready"] .status-rail, .entry[data-state="ready"] .skip { opacity: 0; transition: opacity .6s ease; }

  @keyframes breathe { 0%, 100% { opacity: .62; transform: translate(-50%, -50%) scale(.98); } 50% { opacity: 1; transform: translate(-50%, -50%) scale(1.035); } }
  @keyframes arcDrift { to { transform: translate(-50%, -50%) rotate(326deg); } }

  @media (max-width: 760px) {
    .topbar { height: 64px; grid-template-columns: 1fr auto; padding: 0 18px; }
    .phase { display: none; }
    .brand { font-size: 14px; }
    .compare { font-size: 7px; }
    .facility { object-position: 55% 50%; }
    .eclipse-wrap { left: 68%; top: 33%; width: min(72vw, 410px); }
    .intro { left: 22px; top: auto; bottom: 155px; width: calc(100vw - 44px); transform: none; }
    .entry[data-state="loading"] .intro { transform: translateX(-8px); }
    h1 { font-size: clamp(50px, 15vw, 72px); }
    .lead { font-size: 12px; max-width: 92%; }
    .loader { left: 22px; bottom: 74px; width: calc(100vw - 44px); }
    .status-rail { display: none; }
    .skip { right: 18px; bottom: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: .01ms !important; }
  }
</style>

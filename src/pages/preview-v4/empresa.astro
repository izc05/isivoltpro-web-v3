---
import heroPhotoPayload from '../../../public/media/v4/team-plant-review.webp.b64?raw';
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const demo = `${base}preview-v4/demo/`;
const resources = `${base}preview-v4/recursos/`;
const product = `${base}preview-v4/producto/`;
const sectors = `${base}preview-v4/sectores/`;
const heroPhoto = `data:image/webp;base64,${heroPhotoPayload.trim()}`;
const fieldPhoto = `${base}media/v4/app-qr-mobile.webp`;
const principles = [
  ['01','El trabajo manda','La interfaz debe adaptarse a la operación técnica y reducir pasos, no obligar al técnico a trabajar para el software.'],
  ['02','El activo conserva el contexto','Avisos, OT, fotos, documentos y revisiones ganan valor cuando permanecen vinculados al equipo correcto.'],
  ['03','El histórico es conocimiento','Cada intervención cerrada debe facilitar la siguiente, no desaparecer entre chats, carpetas o memoria personal.'],
];
---
<!doctype html>
<html lang="es"><head>
<V3Seo title="Empresa V4 · IsiVoltPro" description="Empresa V4: visión, principios, transparencia y confianza de IsiVoltPro como plataforma y conocimiento para mantenimiento técnico." path={`${base}preview-v4/empresa/`} noindex={true}/>
<style is:inline>
.strip{background:#0d1730;color:#fff}.strip .page-shell{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:12px}.strip a{color:#dfe7ff;font-weight:800}.hero{padding:86px 0 72px;background:radial-gradient(circle at 78% 10%,rgba(23,92,255,.12),transparent 28%),radial-gradient(circle at 92% 58%,rgba(109,74,255,.12),transparent 22%),#fff}.hero-grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(480px,1.08fr);gap:58px;align-items:center}.hero h1{margin:18px 0 20px;font:800 clamp(52px,5.8vw,82px)/.97 Manrope,sans-serif;letter-spacing:-.065em}.hero p{max-width:670px;margin:0;color:#68748a;font-size:18px;line-height:1.72}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.hero-photo{position:relative;overflow:hidden;border-radius:32px;background:#eef2f7;box-shadow:0 32px 86px rgba(45,59,98,.16)}.hero-photo img{display:block;width:100%;height:470px;object-fit:cover}.hero-photo figcaption{position:absolute;left:18px;bottom:18px;padding:9px 12px;border-radius:999px;background:rgba(13,23,48,.84);color:#fff;font-size:10px;font-weight:850;backdrop-filter:blur(8px)}.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.principle{padding:27px;border:1px solid #e5e9f2;border-radius:24px;background:#fff;box-shadow:0 15px 40px rgba(54,64,102,.055)}.principle b{display:inline-flex;padding:6px 8px;border-radius:9px;background:#f1efff;color:#6552da;font-size:10px}.principle h3{margin:17px 0 9px;font-size:22px;letter-spacing:-.025em}.principle p{margin:0;color:#778398;font-size:13px;line-height:1.62}.story{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(420px,.95fr);gap:46px;align-items:center}.story-copy h2{margin:16px 0;font:800 clamp(40px,4.7vw,62px)/1.02 Manrope,sans-serif;letter-spacing:-.055em}.story-copy p{color:#718096;line-height:1.72}.story-photo{overflow:hidden;border-radius:30px;box-shadow:0 26px 70px rgba(45,59,98,.14)}.story-photo img{display:block;width:100%;height:390px;object-fit:cover}.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.trust{padding:22px;border:1px solid #e6eaf2;border-radius:21px;background:#fff}.trust strong{display:block;font-size:16px}.trust p{margin:8px 0 0;color:#788499;font-size:12px;line-height:1.55}.state{display:grid;grid-template-columns:1.08fr .92fr;gap:18px}.state-main{padding:34px;border-radius:30px;background:linear-gradient(125deg,#0e1830,#1b2d58 58%,#342676);color:#fff}.state-main h2{margin:14px 0 12px;font:800 clamp(38px,4.5vw,58px)/1.03 Manrope,sans-serif;letter-spacing:-.052em}.state-main p{margin:0;color:#c8d2e7;line-height:1.7}.state-list{display:grid;gap:10px;margin-top:24px}.state-list span{padding:12px 14px;border:1px solid rgba(255,255,255,.13);border-radius:14px;background:rgba(255,255,255,.055);color:#dbe4f2;font-size:12px}.state-side{display:grid;grid-template-columns:1fr 1fr;gap:12px}.state-side article{padding:22px;border:1px solid #e6eaf2;border-radius:22px;background:#fff}.state-side b{display:block;color:#6256d8;font-size:11px}.state-side strong{display:block;margin-top:10px}.state-side p{margin:7px 0 0;color:#788499;font-size:12px;line-height:1.55}.knowledge{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.knowledge article{padding:23px;border:1px solid #e5e9f2;border-radius:22px;background:linear-gradient(145deg,#fff,#fafbff)}.knowledge strong{display:block;font-size:18px}.knowledge p{margin:8px 0 0;color:#778398;font-size:13px;line-height:1.58}.cta{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;padding:40px;border-radius:30px;background:linear-gradient(115deg,#f2f7ff,#f3efff 48%,#effaf6)}.cta h2{margin:0;font:800 clamp(34px,4vw,50px)/1.04 Manrope,sans-serif;letter-spacing:-.048em}.cta p{margin:11px 0 0;color:#6f7b90;line-height:1.65}@media(max-width:980px){.hero-grid,.story,.state,.cta{grid-template-columns:1fr}.principles{grid-template-columns:1fr}.trust-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:680px){.hero{padding:58px 0 48px}.hero h1{font-size:clamp(44px,13vw,62px)}.hero-photo img,.story-photo img{height:320px}.trust-grid,.state-side,.knowledge{grid-template-columns:1fr}.strip .page-shell{padding:8px 0;flex-direction:column;align-items:flex-start;gap:4px}.state-main,.cta{padding:28px 22px}}
</style></head><body>
<V3CommercialHeader/>
<div class="strip"><div class="page-shell"><strong>Preview V4 · Fase 7 · Empresa + confianza</strong><span>Experiencia → método → transparencia · <a href={`${base}preview-v4/`}>Mapa V4</a></span></div></div>
<main class="page-main">
<section class="hero"><div class="page-shell hero-grid"><div><span class="eyebrow">Mantenimiento primero · software después</span><h1>Una plataforma creada<br/><span class="gradient-text">desde la lógica del trabajo técnico.</span></h1><p>IsiVoltPro quiere unir dos cosas que normalmente viven separadas: herramientas digitales fáciles de usar y conocimiento práctico de mantenimiento. La confianza no debe venir de frases grandilocuentes, sino de explicar bien qué resolvemos, cómo trabajamos y qué está realmente disponible.</p><div class="actions"><a class="btn btn--primary" href={demo}>Conocer IsiVoltPro →</a><a class="btn" href={product}>Ver Producto V4</a></div></div><figure class="hero-photo"><img src={heroPhoto} alt="Dos técnicos de mantenimiento revisando juntos una instalación y una orden de trabajo en una tablet" width="600" height="450" loading="eager"/><figcaption>Coordinación técnica · trabajo compartido en campo</figcaption></figure></div></section>

<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Principios de producto</span><h2>Primero resolver.<br/><span class="gradient-text">Después impresionar.</span></h2></div><p>La V4 convierte estos principios en parte visible de la marca porque son también una promesa de producto.</p></div><div class="principles">{principles.map(([n,title,copy])=><article class="principle"><b>{n}</b><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>

<section class="page-section"><div class="page-shell story"><div class="story-copy"><span class="eyebrow">Por qué existe IsiVoltPro</span><h2>Demasiadas herramientas.<br/><span class="gradient-text">Muy poco contexto compartido.</span></h2><p>Un aviso puede entrar por teléfono, la información estar en un chat, el inventario en Excel, las fotos en un móvil y los manuales en otra carpeta. IsiVoltPro nace para construir una capa común alrededor del activo y del trabajo realizado, sin exigir cambiarlo todo de golpe.</p><div class="actions"><a class="btn btn--primary" href={sectors}>Ver Sectores V4 →</a></div></div><figure class="story-photo"><img src={fieldPhoto} alt="Técnico identificando un equipo mediante QR con un teléfono móvil" width="700" height="525" loading="lazy"/></figure></div></section>

<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Confianza sin decoración</span><h2>Lo que decimos debe poder<br/><span class="gradient-text">comprobarse o explicarse.</span></h2></div><p>No vamos a llenar esta página de logotipos de clientes, certificaciones, porcentajes o premios que no existan. La confianza de esta fase se construye con límites claros.</p></div><div class="trust-grid"><article class="trust"><strong>Datos demo visibles</strong><p>Las cifras ilustrativas se identifican como ejemplos y no como métricas reales de clientes.</p></article><article class="trust"><strong>Sin clientes inventados</strong><p>Casos y testimonios solo aparecerán cuando sean reales, autorizados y verificables.</p></article><article class="trust"><strong>Seguridad por capas</strong><p>Separamos arquitectura prevista, controles implementados y capacidades todavía pendientes.</p></article><article class="trust"><strong>Alcance claro</strong><p>Producto actual, laboratorio V4 y futuras capacidades se presentan como estados diferentes.</p></article></div></div></section>

<section class="page-section"><div class="page-shell state"><div class="state-main"><span class="eyebrow">Estado público de la propuesta</span><h2>La transparencia también vende.</h2><p>Un comprador técnico valora saber qué está viendo. Por eso distinguimos la web comercial, las vistas conceptuales, el laboratorio de diseño y las futuras superficies privadas.</p><div class="state-list"><span>Web pública: información comercial y recursos.</span><span>Preview V4: laboratorio no indexado para revisión.</span><span>Datos de ejemplo: siempre etiquetados como ilustrativos.</span><span>Autenticación y persistencia: nunca simuladas en GitHub Pages.</span></div></div><div class="state-side"><article><b>PRODUCTO</b><strong>Explicar antes de prometer</strong><p>Flujos y capacidades se presentan desde problemas reales.</p></article><article><b>CONOCIMIENTO</b><strong>Enseñar antes de vender</strong><p>Guías y artículos deben aportar valor por sí mismos.</p></article><article><b>SEGURIDAD</b><strong>Claims verificables</strong><p>No se confunde una intención arquitectónica con un control ya validado.</p></article><article><b>EVOLUCIÓN</b><strong>Mejora por fases</strong><p>Cada pantalla pasa por revisión visual, móvil, rendimiento y contenido.</p></article></div></div></section>

<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Software + conocimiento</span><h2>La marca no termina<br/><span class="gradient-text">cuando acaba la aplicación.</span></h2></div><p>La propuesta de IsiVoltPro incluye producto, metodología y contenido técnico para ayudar a pequeñas operaciones a trabajar con más orden.</p></div><div class="knowledge"><article><strong>Producto</strong><p>Activos, avisos, OT, preventivo, fotos, documentos y trabajo de campo conectados.</p></article><article><strong>Método</strong><p>Flujos simples para registrar, actuar, cerrar y conservar el contexto útil.</p></article><article><strong>Conocimiento</strong><p>Recursos, guías y actualidad técnica que ayudan a decidir mejor.</p></article></div><div class="actions"><a class="btn btn--primary" href={resources}>Explorar Recursos V4 →</a></div></div></section>

<section class="page-section"><div class="page-shell"><div class="cta"><div><h2>Fase 7 · Empresa + confianza.</h2><p>La siguiente fase se centrará en Demo, Planes y Contacto para convertir esta credibilidad en una ruta comercial sencilla.</p></div><a class="btn btn--primary" href={demo}>Siguiente: Demo V4 →</a></div></div></section>
</main><V3CommercialFooter/>
</body></html>
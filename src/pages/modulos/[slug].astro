---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
import { moduleLandings } from '../../data/v3-commercial';

export function getStaticPaths() {
  return Object.entries(moduleLandings).map(([slug, data]) => ({ params: { slug }, props: { data, slug } }));
}

const { data, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
const contact = `${base}contacto/`;
const appsUrl = `${base}aplicaciones/`;
const appMaintenance = `${base}app-mantenimiento/`;
const solutions = `${base}soluciones/`;
const seoDescription = `${data.name} en IsiVoltPro: ${data.description} Enfoque práctico para autónomos y pequeñas empresas.`;
const sampleRows = data.flow.slice(0, 4);
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title={`${data.name} · IsiVoltPro`} description={seoDescription} path={`${base}modulos/${slug}/`} />
  <style is:inline>
    .module-stage{position:relative;min-height:470px}.module-stage::before{content:'';position:absolute;inset:10% 0 4% 8%;border-radius:42px;background:linear-gradient(135deg,color-mix(in srgb,var(--module-color) 18%,transparent),rgba(84,105,225,.08),rgba(42,190,142,.10));filter:blur(30px)}.module-window{position:absolute;inset:18px 16px 28px 36px;border:1px solid #e4e8f1;border-radius:27px;background:#fff;box-shadow:0 32px 78px rgba(45,58,98,.15);overflow:hidden}.module-window__bar{height:46px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;border-bottom:1px solid #edf0f5;color:#7b879a;font-size:9px}.module-window__bar b{color:#1d2739}.module-window__body{display:grid;grid-template-columns:108px 1fr;min-height:365px}.module-rail{padding:17px 10px;background:#10182f;color:#b9c2d5}.module-rail strong{display:block;margin:0 7px 14px;color:#fff;font-size:10px}.module-rail span{display:block;margin:5px 0;padding:8px;border-radius:8px;font-size:8px}.module-rail span.active{color:#fff;background:linear-gradient(90deg,color-mix(in srgb,var(--module-color) 55%,#263058),rgba(108,81,220,.35))}.module-main{padding:18px;background:linear-gradient(180deg,#fcfdff,#f8faff)}.module-top{display:flex;align-items:end;justify-content:space-between;gap:14px}.module-top small{color:#8b95a6;font-size:7px}.module-top strong{display:block;margin-top:4px;font-size:19px}.module-state{padding:6px 9px;border-radius:999px;background:#eaf9f3;color:#168e67;font-size:7px;font-weight:900}.module-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0}.module-kpis div{padding:11px;border:1px solid #e9edf3;border-radius:11px;background:#fff}.module-kpis small{display:block;color:#8b95a5;font-size:7px}.module-kpis b{display:block;margin-top:4px;font-size:17px}.module-list{display:grid;gap:7px}.module-list div{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:9px 10px;border:1px solid #e9edf3;border-radius:10px;background:#fff}.module-list strong{font-size:9px}.module-list small{display:block;margin-top:2px;color:#8a94a5;font-size:7px}.module-list span{padding:5px 7px;border-radius:999px;background:color-mix(in srgb,var(--module-color) 10%,#fff);color:var(--module-color);font-size:7px;font-weight:900}.module-float{position:absolute;z-index:3;padding:10px 12px;border:1px solid #e4e8f0;border-radius:14px;background:#fff;box-shadow:0 15px 35px rgba(49,61,101,.14)}.module-float strong{display:block;font-size:9px;color:var(--module-color)}.module-float small{display:block;margin-top:3px;color:#8a94a4;font-size:7px}.module-float--a{left:0;top:82px}.module-float--b{right:0;bottom:40px}.module-proof{display:grid;grid-template-columns:1.05fr .95fr;gap:22px;align-items:stretch;margin-top:24px}.module-proof__visual,.module-proof__copy{padding:27px;border:1px solid #e5e9f1;border-radius:25px;background:#fff}.module-proof__visual{background:linear-gradient(145deg,#fff,color-mix(in srgb,var(--module-color) 5%,#fff))}.module-proof__visual small{color:#8b95a6;font-size:9px;font-weight:800}.module-proof__track{display:grid;gap:10px;margin-top:17px}.module-proof__track div{display:grid;grid-template-columns:38px 1fr auto;gap:10px;align-items:center;padding:10px;border:1px solid #e9edf3;border-radius:11px;background:#fff}.module-proof__track b{width:38px;height:38px;display:grid;place-items:center;border-radius:11px;background:color-mix(in srgb,var(--module-color) 10%,#fff);color:var(--module-color)}.module-proof__track strong{font-size:11px}.module-proof__track span{font-size:8px;color:#8590a3}.module-proof__copy h3{margin:9px 0 10px;font-size:25px;letter-spacing:-.04em}.module-proof__copy p{color:#748094;line-height:1.65}.module-proof__copy ul{display:grid;gap:9px;margin:18px 0 0;padding:0;list-style:none}.module-proof__copy li{padding:10px 12px;border-radius:11px;background:#f7f9fd;color:#536078;font-size:12px}.module-proof__copy li::before{content:'✓';margin-right:8px;color:#159f71;font-weight:900}@media(max-width:900px){.module-proof{grid-template-columns:1fr}.module-window__body{grid-template-columns:82px 1fr}}@media(max-width:620px){.module-stage{min-height:365px}.module-window{inset:16px 8px 20px}.module-window__body{grid-template-columns:1fr}.module-rail{display:none}.module-main{padding:13px}.module-kpis{grid-template-columns:1fr 1fr}.module-kpis div:last-child{display:none}.module-float--a{display:none}.module-float--b{right:4px}.module-proof__visual,.module-proof__copy{padding:20px}}
  </style>
</head>
<body>
  <V3CommercialHeader />
  <main class="page-main" style={`--module-color:${data.color}`}>
    <section class="page-hero">
      <div class="page-shell page-hero__grid">
        <div>
          <span class="eyebrow">{data.eyebrow}</span>
          <h1>{data.title}</h1>
          <p>{data.description}</p>
          <div class="page-hero__actions"><a class="btn btn--primary" href={contact}>Verlo sobre mi caso →</a><a class="btn" href={appsUrl}>Ver todas las apps</a></div>
        </div>
        <div class="module-stage" aria-label={`Vista conceptual de ${data.name} en IsiVoltPro`}>
          <div class="module-window"><div class="module-window__bar"><b>IsiVoltPro · {data.name}</b><span>Datos ficticios de demostración</span></div><div class="module-window__body"><aside class="module-rail"><strong>IsiVoltPro</strong><span>Resumen</span><span class="active">{data.short}</span><span>Activos</span><span>OT</span><span>Histórico</span></aside><div class="module-main"><div class="module-top"><div><small>OPERACIÓN · HOY</small><strong>{data.name}</strong></div><span class="module-state">● Demo activa</span></div><div class="module-kpis"><div><small>Pendientes</small><b>8</b></div><div><small>En curso</small><b>3</b></div><div><small>Completadas</small><b>24</b></div></div><div class="module-list">{sampleRows.map((step, index) => <div><span><strong>{step}</strong><small>{index === 0 ? 'Contexto preparado' : index === sampleRows.length - 1 ? 'Resultado trazable' : 'Siguiente paso conectado'}</small></span><span>{index === sampleRows.length - 1 ? 'Listo' : index === 1 ? 'En curso' : 'Pendiente'}</span></div>)}</div></div></div></div>
          <div class="module-float module-float--a"><strong>{data.short}</strong><small>Dentro del mismo contexto</small></div><div class="module-float module-float--b"><strong>Histórico conectado</strong><small>Sin otra isla de datos</small></div>
        </div>
      </div>
    </section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">El problema cotidiano</span><h2>Menos tiempo persiguiendo <span class="gradient-text">información.</span></h2></div><p>Esta capacidad está planteada para reducir tareas administrativas alrededor del trabajo técnico, no para añadir burocracia.</p></div><div class="feature-grid">{data.pains.map((pain, index) => <article class="feature-card" style={`--accent:${data.color}18;--icon:${data.color};--icon-bg:${data.color}12`}><i>{index + 1}</i><h3>{pain}</h3><p>IsiVoltPro mantiene este punto dentro del mismo contexto operativo para que no dependa de memoria, mensajes o archivos aislados.</p></article>)}</div></div></section>

    <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Cómo se ve en producto</span><h2>Contexto antes que<br/><span class="gradient-text">más pantallas.</span></h2></div><p>La capacidad tiene sentido cuando el siguiente paso puede empezar con información ya preparada.</p></div><div class="module-proof"><div class="module-proof__visual"><small>RECORRIDO DE TRABAJO</small><div class="module-proof__track">{data.flow.slice(0,4).map((step,index)=><div><b>{String(index+1).padStart(2,'0')}</b><strong>{step}</strong><span>{index===3?'Trazable':'Conectado'}</span></div>)}</div></div><div class="module-proof__copy"><span class="eyebrow">Una sola operación</span><h3>Lo importante viaja con el trabajo.</h3><p>Cliente, activo, estado, evidencias y resultado permanecen relacionados para reducir búsquedas y reconstrucciones posteriores.</p><ul><li>El contexto se reutiliza.</li><li>Los cambios quedan asociados al mismo trabajo.</li><li>El cierre alimenta el histórico.</li></ul></div></div></div></section>

    <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Qué debe conseguir</span><h2>Información útil <span class="gradient-text">en el momento correcto.</span></h2></div><p>El valor no está en tener más pantallas. Está en poder saber qué pasa, actuar y encontrar después lo que ocurrió.</p></div><div class="value-grid">{data.outcomes.map((outcome, index) => <article class="value-card" style={`--accent:${data.color}18;--icon:${data.color};--icon-bg:${data.color}12`}><i>{data.icon}</i><h3>{outcome}</h3><p>{index === 0 ? 'La información principal queda visible sin tener que reconstruir el contexto.' : index === 1 ? 'Cada persona puede trabajar con la información asociada a la misma operación.' : index === 2 ? 'El resultado queda documentado en el lugar donde será útil después.' : 'La siguiente intervención empieza con más información que la anterior.'}</p></article>)}</div></div></section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Flujo sencillo</span><h2>De principio a fin,<br /><span class="gradient-text">sin saltos.</span></h2></div><p>Un proceso corto y entendible ayuda a que el sistema se adapte al trabajo real de un autónomo o equipo pequeño.</p></div><div class="flow-board">{data.flow.map((step, index) => <article class="flow-step"><b>{String(index + 1).padStart(2,'0')}</b><strong>{step}</strong><small>{index === data.flow.length - 1 ? 'El resultado queda disponible para la próxima vez.' : 'La información pasa al siguiente paso sin volver a empezar.'}</small></article>)}</div></div></section>

    <section class="page-section"><div class="page-shell"><div class="callout"><div><h2>Una capacidad útil no debería convertirse en otra isla.</h2><p>{data.name} forma parte del mismo contexto de clientes, activos, trabajo y documentación. App Mantenimiento reúne el núcleo operativo; otras apps pueden añadirse cuando el flujo lo necesite. La disponibilidad exacta se confirma en demo.</p></div><div class="page-hero__actions" style="margin-top:0"><a class="btn btn--primary" href={contact}>Probar este flujo →</a><a class="btn" href={appMaintenance}>Ver App Mantenimiento</a><a class="btn" href={solutions}>Ver soluciones</a></div></div></div></section>
  </main>
  <V3CommercialFooter />
</body>
</html>
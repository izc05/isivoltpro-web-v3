---
import '../styles/v3-entry-3d.css';
import '../styles/v3-entry-3d-fidelity.css';

interface Props {
  accessHref: string;
  demoHref: string;
}

const { accessHref, demoHref } = Astro.props;
const qrCells = Array.from({ length: 49 }, (_, index) => index);
---
<div class="intro entry3d" id="intro" aria-label="Presentación 3D de IsiVoltPro">
  <button class="intro__skip entry3d__skip" id="skip-intro" type="button">Saltar intro</button>

  <div class="entry3d__ambient" aria-hidden="true">
    <span class="entry3d__particle entry3d__particle--1"></span><span class="entry3d__particle entry3d__particle--2"></span><span class="entry3d__particle entry3d__particle--3"></span><span class="entry3d__particle entry3d__particle--4"></span><span class="entry3d__particle entry3d__particle--5"></span><span class="entry3d__particle entry3d__particle--6"></span><span class="entry3d__particle entry3d__particle--7"></span>
  </div>

  <div class="entry3d__shell">
    <header class="entry3d__heading">
      <div class="entry3d__brand" aria-label="IsiVoltPro"><i class="entry3d__brand-mark" aria-hidden="true"><span></span></i><strong>ISI VOLTPRO</strong></div>
      <h1>Conectando <span>tu trabajo diario</span></h1>
      <p>Clientes, equipos, avisos y mantenimiento en un único ecosistema inteligente.</p>
    </header>

    <div class="entry3d__scene" id="entry3d-scene">
      <div class="entry3d__network" aria-hidden="true"><i class="entry3d__line entry3d__line--1"></i><i class="entry3d__line entry3d__line--2"></i><i class="entry3d__line entry3d__line--3"></i><i class="entry3d__line entry3d__line--4"></i><i class="entry3d__line entry3d__line--5"></i><i class="entry3d__line entry3d__line--6"></i></div>

      <div class="entry3d__core" aria-hidden="true">
        <div class="entry3d__glass-shell"><i></i><i></i><i></i></div>
        <canvas id="entry3d-canvas" class="entry3d__canvas"></canvas>
        <div class="entry3d__pedestal"><i></i><i></i><i></i></div>
      </div>

      <article class="entry3d__phone entry3d__float" aria-label="Incidencia de ejemplo"><div class="entry3d__phone-screen"><small>Incidencia #INC-1047 <b>NUEVO</b></small><span>Estado</span><strong>En curso</strong><span>Asignado a</span><strong>Técnico · ejemplo</strong><span>Ubicación</span><strong>Almacén · Zona Este</strong><button type="button" tabindex="-1">Ver detalles</button></div></article>

      <article class="entry3d__orders entry3d__float" aria-label="Órdenes de trabajo de ejemplo"><div class="entry3d__panel-title"><strong>Órdenes de trabajo</strong><span>•••</span></div><div class="entry3d__order"><i>✓</i><span>Chequeo rutinario</span><b>12</b><em>↗ 24%</em></div><div class="entry3d__order"><i>♙</i><span>Reparación preventiva</span><b>8</b><em>↗ 16%</em></div><div class="entry3d__order"><i>!</i><span>Incidencias</span><b>3</b><em class="is-down">↘ 12%</em></div><small>Ver todas →</small></article>

      <article class="entry3d__analytics entry3d__float" aria-label="Rendimiento operativo ilustrativo"><div class="entry3d__analytics-top"><span>Rendimiento operativo</span><small>Últimos 30 días</small></div><strong>98%</strong><small>Disponibilidad · dato ilustrativo</small><svg viewBox="0 0 180 68" aria-hidden="true"><path d="M4 58 C18 55 24 43 35 47 S54 61 66 41 S88 23 100 35 S121 50 132 30 S151 29 176 9"/></svg></article>

      <article class="entry3d__qr-card entry3d__float" aria-label="Identificación QR y NFC"><b>NFC / QR</b><div class="entry3d__qr" aria-hidden="true">{qrCells.map((cell) => <i class:list={{ 'is-on': (cell * 7 + 3) % 5 !== 0 || cell < 8 || cell > 40 }}></i>)}</div></article>
      <div class="entry3d__gear entry3d__float" aria-hidden="true"><i></i></div>
      <div class="entry3d__machines entry3d__float" aria-hidden="true"><span class="entry3d__machine"><i></i><b></b><em></em></span><span class="entry3d__machine"><i></i><b></b><em></em></span></div>

      <article class="entry3d__status entry3d__float"><i></i><div><strong>Sistema operativo</strong><small>Todos los servicios activos</small></div></article>
      <article class="entry3d__note entry3d__note--mobility entry3d__float"><i>⌁</i><div><strong>Movilidad</strong><small>Actúa desde cualquier lugar</small></div></article>
      <article class="entry3d__note entry3d__note--control entry3d__float"><i>▣</i><div><strong>Control total</strong><small>Todo tu trabajo en tiempo real</small></div></article>
      <article class="entry3d__note entry3d__note--data entry3d__float"><i>▥</i><div><strong>Decisiones con datos</strong><small>Información clara para decidir mejor</small></div></article>
      <article class="entry3d__note entry3d__note--assets entry3d__float"><i>▦</i><div><strong>Activos conectados</strong><small>Equipos críticos bajo control</small></div></article>
      <article class="entry3d__note entry3d__note--maintenance entry3d__float"><i>⚙</i><div><strong>Mantenimiento inteligente</strong><small>Preventivo, correctivo y predictivo</small></div></article>
      <article class="entry3d__note entry3d__note--scan entry3d__float"><i>⌁</i><div><strong>Identificación instantánea</strong><small>Escanea, accede, resuelve</small></div></article>
    </div>

    <footer class="entry3d__actions"><a class="entry3d__primary" href={accessHref}>Entrar en la plataforma <span aria-hidden="true">→</span></a><a class="entry3d__secondary" href={demoHref}>Ver demo <span aria-hidden="true">›</span></a><small><i aria-hidden="true">ⓘ</i> Vista conceptual · datos ilustrativos</small></footer>
  </div>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#entry3d-canvas');
  const host = document.querySelector<HTMLElement>('#entry3d-scene');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let alreadySeen = document.documentElement.classList.contains('skip-intro');
  try { alreadySeen ||= sessionStorage.getItem('isivoltpro-intro-seen') === '1'; } catch (_) {}

  const mountEntry3D = async () => {
    if (!canvas || !host || reduced || alreadySeen) return;
    const THREE = await import('three');
    if (document.querySelector('#intro')?.classList.contains('is-done')) return;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.6));
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(31, 1, 0.1, 100);
    camera.position.set(0, 0.3, 6.7);

    scene.add(new THREE.HemisphereLight(0xffffff, 0xcbd6ff, 3.4));
    const key = new THREE.PointLight(0x5269ff, 28, 20); key.position.set(-3, 4, 5); scene.add(key);
    const magenta = new THREE.PointLight(0xf04acb, 19, 16); magenta.position.set(3, 1, 4); scene.add(magenta);
    const cyan = new THREE.PointLight(0x36d8ea, 18, 15); cyan.position.set(-2, -2, 4); scene.add(cyan);

    const group = new THREE.Group(); group.rotation.x = -0.08; scene.add(group);
    const logo = new THREE.Group();
    const cubeMaterial = new THREE.MeshStandardMaterial({color:0xffffff,roughness:.15,metalness:.06,emissive:0xf4f8ff,emissiveIntensity:.30});
    const cubeGeo = new THREE.BoxGeometry(.68,.68,.68);
    [[-.34,.28,0],[.34,.28,0],[0,-.32,0]].forEach(([x,y,z],index)=>{const cube=new THREE.Mesh(cubeGeo,cubeMaterial);cube.position.set(x,y,z);cube.rotation.set(.36,.64+index*.12,.12);logo.add(cube)});
    logo.position.set(0,.08,.35);logo.scale.setScalar(.86);group.add(logo);

    [1.52,1.78,2.02].forEach((radius,index)=>{const ring=new THREE.Mesh(new THREE.TorusGeometry(radius,.018+index*.007,12,110),new THREE.MeshBasicMaterial({color:index===1?0x45cad8:0x6680ff,transparent:true,opacity:.20}));ring.rotation.x=Math.PI/2.12;ring.rotation.z=index*.20;ring.position.y=-1.16-index*.065;ring.scale.y=.50;group.add(ring)});

    const resize=()=>{const rect=canvas.getBoundingClientRect();renderer.setSize(Math.max(1,rect.width),Math.max(1,rect.height),false);camera.aspect=Math.max(1,rect.width)/Math.max(1,rect.height);camera.updateProjectionMatrix()};
    resize(); const ro=new ResizeObserver(resize);ro.observe(canvas);
    let pointerX=0,pointerY=0,raf=0;
    const onPointer=(event:PointerEvent)=>{const rect=host.getBoundingClientRect();pointerX=((event.clientX-rect.left)/Math.max(1,rect.width)-.5)*2;pointerY=((event.clientY-rect.top)/Math.max(1,rect.height)-.5)*2};
    host.addEventListener('pointermove',onPointer,{passive:true});
    const clock=new THREE.Clock();
    const animate=()=>{const t=clock.getElapsedTime();group.rotation.y+=((pointerX*.08)-group.rotation.y)*.035;group.rotation.x+=((-.08-pointerY*.04)-group.rotation.x)*.035;group.position.y=Math.sin(t*.85)*.055;logo.rotation.y=Math.sin(t*.72)*.10;renderer.render(scene,camera);raf=requestAnimationFrame(animate)};
    animate();

    const clean=()=>{cancelAnimationFrame(raf);host.removeEventListener('pointermove',onPointer);ro.disconnect();scene.traverse((object:any)=>{object.geometry?.dispose?.();if(object.material){const materials=Array.isArray(object.material)?object.material:[object.material];materials.forEach((material:any)=>material.dispose?.())}});renderer.dispose()};
    document.querySelector('#intro')?.addEventListener('transitionend',(event)=>{if((event.target as HTMLElement).classList.contains('is-done'))clean()},{once:true});
  };

  void mountEntry3D();
</script>
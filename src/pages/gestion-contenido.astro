---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
import { v3AdminPreview, v3ContentAdminContract } from '../data/v3-content-admin';
import { assertSafeContentPreview, getContentCapabilitySnapshot } from '../lib/v3-content-management';

const base = import.meta.env.BASE_URL;
const enabled = import.meta.env.PUBLIC_V3_CONTENT_ADMIN_PREVIEW === 'true';
const { media, entries, revisions, social } = v3AdminPreview;
const entryById = new Map(entries.map((entry) => [entry.id, entry]));
const mediaUrl = (file: string) => `${base}${file.replace(/^\/+/, '')}`;
const mediaUsage = (mediaId: string) => entries.filter((entry) => entry.mediaIds.includes(mediaId));
assertSafeContentPreview();
const contentCapabilities = getContentCapabilitySnapshot();
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Gestión de contenido · IsiVoltPro" description="Vista de preparación del gestor de contenido y medios de IsiVoltPro." path={`${base}gestion-contenido/`} noindex={true} />
  <style is:inline>
    .admin-page{padding:52px 0 90px;background:linear-gradient(180deg,#fff 0%,#f8faff 100%);min-height:80vh}
    .admin-shell{width:min(1180px,calc(100% - 32px));margin:0 auto}
    .admin-hero{display:grid;grid-template-columns:1.2fr .8fr;gap:26px;align-items:end;margin-bottom:28px}
    .admin-hero h1{font:800 clamp(42px,6vw,72px)/.98 Manrope,sans-serif;letter-spacing:-.055em;margin:12px 0 18px}
    .admin-hero p{color:var(--muted);font-size:18px;line-height:1.65;max-width:720px}
    .admin-status{padding:18px 20px;border-radius:20px;background:#fff;border:1px solid #e7ebf5;box-shadow:0 16px 50px rgba(45,65,110,.08)}
    .admin-status strong{display:block;margin-bottom:7px}.admin-status small{color:#65708c;line-height:1.5}
    .admin-grid{display:grid;grid-template-columns:230px 1fr;gap:22px}
    .admin-nav,.admin-panel{background:#fff;border:1px solid #e6eaf3;border-radius:24px;box-shadow:0 18px 60px rgba(45,65,110,.07)}
    .admin-nav{padding:16px;align-self:start;position:sticky;top:90px}.admin-nav a{display:flex;gap:10px;align-items:center;padding:12px 13px;color:#27314a;text-decoration:none;border-radius:12px;font-weight:750}.admin-nav a:first-child{background:#eef3ff;color:#175cff}.admin-nav span{width:25px;text-align:center}
    .admin-panel{padding:26px}.admin-panel__head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:20px}.admin-panel h2{font:800 28px/1.1 Manrope,sans-serif;margin:0 0 5px}.admin-panel p{margin:0;color:#69748f;line-height:1.55}
    .admin-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;padding:11px 15px;font-weight:800;background:#175cff;color:white}.admin-btn[disabled]{background:#e9edf5;color:#8c95a9;cursor:not-allowed}.admin-btn--ghost{background:#f5f7fb;color:#36415f}
    .media-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.media-card{border:1px solid #e8ebf3;border-radius:18px;overflow:hidden;background:#fff}.media-visual{height:190px;background:linear-gradient(135deg,#edf3ff,#f9efff 45%,#edfafa);position:relative;overflow:hidden}.media-visual img{width:100%;height:100%;display:block;object-fit:cover}.media-visual__fallback{height:100%;display:grid;place-items:center;font-size:48px}.media-state{position:absolute;top:10px;right:10px;padding:6px 9px;border-radius:999px;background:rgba(255,255,255,.9);backdrop-filter:blur(8px);font-size:10px;font-weight:900;color:#1d6a4d;box-shadow:0 6px 18px rgba(30,48,90,.12)}.media-state.review{color:#98550f}.media-copy{padding:15px}.media-copy strong{display:block}.media-copy small{display:block;color:#7a849c;line-height:1.45;margin-top:4px}.media-tags,.media-usage{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.media-tags i,.media-usage span{font-style:normal;font-size:11px;font-weight:800;padding:5px 8px;border-radius:999px;background:#f1f4f9;color:#59647e}.media-usage{padding-top:10px;border-top:1px solid #eef1f6}.media-usage b{font-size:11px;color:#7a849c;align-self:center;margin-right:2px}.media-file{margin-top:9px;font:700 10px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;color:#768098;overflow-wrap:anywhere}
    .content-table{display:grid;gap:10px}.content-row{display:grid;grid-template-columns:1fr auto auto;gap:14px;align-items:center;border:1px solid #e8ebf3;border-radius:16px;padding:15px}.content-row small{display:block;color:#79839a;margin-top:4px}.status-pill{font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.06em;padding:6px 8px;border-radius:999px;background:#eef8f4;color:#14845e}.status-pill.review{background:#fff5e8;color:#b36717}
    .revision-list{display:grid;gap:10px}.revision-row{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:start;padding:15px;border:1px solid #e8ebf3;border-radius:16px}.revision-version{display:grid;place-items:center;min-width:42px;height:42px;border-radius:13px;background:#eef3ff;color:#175cff;font-size:12px;font-weight:900}.revision-copy strong{display:block}.revision-copy small{display:block;color:#78839a;margin-top:4px;line-height:1.5}.revision-meta{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-top:9px}.revision-meta span{font-size:11px;font-weight:800;padding:5px 8px;border-radius:999px;background:#f3f5fa;color:#56617a}
    .social-row{border:1px solid #e8ebf3;border-radius:16px;padding:15px;display:grid;grid-template-columns:1fr auto;gap:15px}.social-channels{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.social-channels span{padding:5px 8px;background:#f3f5fa;border-radius:999px;font-size:11px;font-weight:800}.social-schedule{margin-top:10px;font-size:12px;color:#68738d}.blocked{color:#b1582a;font-weight:800;font-size:12px}
    .workflow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:18px 0}.workflow-step{padding:14px;border-radius:16px;background:#f7f9fd;border:1px solid #e9edf5}.workflow-step b{display:block;font-size:12px;color:#175cff;margin-bottom:4px}.workflow-step span{font-size:12px;color:#6f7990;line-height:1.45}
    .upload-zone{margin-top:14px;border:1.5px dashed #cdd5e5;border-radius:18px;padding:24px;text-align:center;background:#fbfcff}.upload-zone input{display:none}.upload-zone strong{display:block;margin-bottom:5px}.upload-zone small{color:#78839a}
    .security-note{margin-top:20px;padding:16px 18px;border-radius:16px;background:#fff8ed;border:1px solid #f4dfbd;color:#704d1a;line-height:1.55}
    .capability-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:18px}.capability-card{padding:14px;border:1px solid #e8ebf3;border-radius:16px;background:#fbfcff}.capability-card__top{display:flex;align-items:center;justify-content:space-between;gap:12px}.capability-card strong{font-size:12px}.capability-card p{margin:7px 0 0;font-size:11px;line-height:1.5}.capability-state{flex:0 0 auto;padding:5px 8px;border-radius:999px;background:#fff1ec;color:#a54d27;font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.05em}.capability-state.enabled{background:#eaf9f3;color:#16845f}
    .preview-off{margin-top:22px;padding:28px;border-radius:22px;background:#111827;color:#fff}.preview-off p{color:#cbd5e1;line-height:1.6}.preview-off code{background:#243047;padding:3px 7px;border-radius:7px}
    @media(max-width:840px){.admin-hero,.admin-grid{grid-template-columns:1fr}.admin-nav{display:none}.media-grid,.workflow,.capability-grid{grid-template-columns:1fr}.content-row,.social-row,.revision-row{grid-template-columns:1fr}.admin-panel{padding:19px}.admin-panel__head{display:grid}.revision-version{width:42px}.media-visual{height:220px}}
  </style>
</head>
<body>
  <V3CommercialHeader />
  <main class="admin-page">
    <div class="admin-shell">
      <section class="admin-hero">
        <div><span class="eyebrow">Administración de la web</span><h1>Contenido, fotos y redes<br/><span class="gradient-text">desde un solo lugar.</span></h1><p>Esta zona prepara el flujo editorial de IsiVoltPro para actualizar textos, sustituir imágenes, revisar cambios y reutilizar piezas en redes sociales sin editar archivos a mano.</p></div>
        <aside class="admin-status"><strong>Modo seguro de preproducción</strong><small>El dominio de contenido verifica durante el build que persistencia, autenticación, autorización, subida, programación y publicación social sigan desactivadas en la web pública.</small></aside>
      </section>

      {enabled ? (
        <div class="admin-grid">
          <nav class="admin-nav" aria-label="Gestión de contenido"><a href="#media"><span>▧</span> Biblioteca</a><a href="#paginas"><span>▤</span> Páginas</a><a href="#historial"><span>↺</span> Historial</a><a href="#redes"><span>⌁</span> Redes sociales</a><a href="#seguridad"><span>◈</span> Seguridad</a></nav>
          <div style="display:grid;gap:22px">
            <section class="admin-panel" id="media"><div class="admin-panel__head"><div><h2>Biblioteca multimedia</h2><p>Fotos, ilustraciones y vídeos reutilizables por toda la web, con vista previa real, texto alternativo y trazabilidad de uso.</p></div><button class="admin-btn" type="button" disabled>Añadir foto</button></div><div class="media-grid">{media.map((item) => { const usages = mediaUsage(item.id); return <article class="media-card"><div class="media-visual">{item.kind === 'photo' || item.kind === 'illustration' ? <img src={mediaUrl(item.file)} alt={item.alt} loading="lazy" decoding="async"/> : <div class="media-visual__fallback" aria-hidden="true">▶</div>}<span class:list={["media-state", !item.published && "review"]}>{item.published ? 'Publicado' : 'En revisión'}</span></div><div class="media-copy"><strong>{item.title}</strong><small>{item.alt}</small><div class="media-tags">{item.tags.map((tag) => <i>{tag}</i>)}</div><div class="media-file">{item.file}</div><div class="media-usage"><b>Usado en:</b>{usages.length ? usages.map((entry) => <span>{entry.route} · {entry.section}</span>) : <span>Sin uso</span>}</div></div></article> })}</div><label class="upload-zone"><input type="file" accept="image/jpeg,image/png,image/webp,image/avif" disabled/><strong>Arrastra o selecciona una imagen</strong><small>JPEG, PNG, WebP o AVIF · máximo {Math.round(v3ContentAdminContract.limits.imageMaxBytes / 1024 / 1024)} MB · desactivado hasta conectar backend autenticado.</small></label></section>

            <section class="admin-panel" id="paginas"><div class="admin-panel__head"><div><h2>Páginas y secciones</h2><p>Edita mensajes y cambia la imagen asociada sin tocar Astro.</p></div><button class="admin-btn admin-btn--ghost" type="button" disabled>Nueva pieza</button></div><div class="content-table">{entries.map((entry) => <article class="content-row"><div><strong>{entry.section}</strong><small>{entry.route} · {entry.title}</small></div><span class:list={["status-pill", entry.status === 'review' && 'review']}>{entry.status === 'published' ? 'Publicado' : 'Revisión'}</span><button class="admin-btn admin-btn--ghost" type="button" disabled>Editar</button></article>)}</div></section>

            <section class="admin-panel" id="historial"><div class="admin-panel__head"><div><h2>Historial y revisiones</h2><p>Cada publicación o cambio de imagen tendrá una versión recuperable y trazable.</p></div><button class="admin-btn admin-btn--ghost" type="button" disabled>Comparar versiones</button></div><div class="revision-list">{revisions.map((revision) => { const entry = entryById.get(revision.contentEntryId); return <article class="revision-row"><div class="revision-version">v{revision.version}</div><div class="revision-copy"><strong>{entry?.section ?? 'Contenido'} · {revision.summary}</strong><small>{revision.actor} · {new Date(revision.createdAt).toLocaleString('es-ES', { dateStyle: 'medium', timeStyle: 'short' })}</small><div class="revision-meta"><span>{revision.action === 'published' ? 'Publicado' : revision.action === 'media_changed' ? 'Imagen cambiada' : revision.action === 'restored' ? 'Restaurado' : revision.action === 'edited' ? 'Editado' : 'Creado'}</span>{revision.restorable && <span>Restaurable</span>}</div></div><button class="admin-btn admin-btn--ghost" type="button" disabled>Restaurar</button></article> })}</div></section>

            <section class="admin-panel" id="redes"><div class="admin-panel__head"><div><h2>Publicación social</h2><p>Una pieza de la web puede preparar versiones para Instagram, Facebook y LinkedIn, siempre con aprobación previa.</p></div><button class="admin-btn" type="button" disabled>Crear publicación</button></div><div class="workflow" aria-label="Flujo de publicación social"><div class="workflow-step"><b>1 · Preparar</b><span>Seleccionar contenido e imagen.</span></div><div class="workflow-step"><b>2 · Revisar</b><span>Ajustar copy para cada red.</span></div><div class="workflow-step"><b>3 · Aprobar</b><span>Owner/Admin valida la publicación.</span></div><div class="workflow-step"><b>4 · Programar</b><span>Backend publica en fecha autorizada.</span></div></div>{social.map((item) => <article class="social-row"><div><strong>{item.caption}</strong><div class="social-channels">{item.channels.map((channel) => <span>{channel}</span>)}</div>{item.mode === 'scheduled' && item.scheduledFor && <div class="social-schedule">Programación prevista: {new Date(item.scheduledFor).toLocaleString('es-ES', { dateStyle: 'medium', timeStyle: 'short' })}</div>}</div><span class="blocked">Bloqueado hasta autorizar cuentas y aprobar</span></article>)}</section>

            <section class="admin-panel" id="seguridad"><h2>Capacidades bloqueadas hasta backend real</h2><p>Esta vista ya consume el mismo dominio de seguridad que deberá gobernar el futuro gestor. En preproducción, cualquier intento de activar una capacidad sensible dentro de la web pública hace fallar el build.</p><div class="capability-grid">{contentCapabilities.map((item) => <article class="capability-card"><div class="capability-card__top"><strong>{item.label}</strong><span class:list={["capability-state", item.enabled && "enabled"]}>{item.enabled ? 'Activa' : 'Bloqueada'}</span></div><p>{item.boundary}</p></article>)}</div><div class="security-note"><strong>Separación importante:</strong> la web comercial no almacenará secretos ni credenciales de PocketBase o redes sociales. Las operaciones sensibles, historial persistente y workers de publicación vivirán en el backend autenticado y el gestor seguirá separado de <code>/acceso/</code>.</div></section>
          </div>
        </div>
      ) : (
        <section class="preview-off"><strong>Vista administrativa bloqueada por defecto.</strong><p>El diseño y el contrato de datos ya están preparados, pero esta página no muestra controles editoriales en un despliegue normal. Para QA aislado se habilita únicamente con <code>PUBLIC_V3_CONTENT_ADMIN_PREVIEW=true</code>.</p></section>
      )}
    </div>
  </main>
  <V3CommercialFooter />
</body>
</html>
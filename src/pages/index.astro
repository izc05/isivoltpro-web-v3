---
import Intro from '../components/home/Intro.astro';
import ExperienceHero from '../components/home/ExperienceHero.astro';
import EcosystemExperience from '../components/home/EcosystemExperience.astro';
import FlowExperience from '../components/home/FlowExperience.astro';
import AccessExperience from '../components/home/AccessExperience.astro';
import '../styles/global.css';
import '../styles/home.css';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="IsiVoltPro conecta activos, mantenimiento, órdenes de trabajo, recursos y trazabilidad en un único ecosistema técnico." />
  <meta name="theme-color" content="#03070c" />
  <title>IsiVoltPro · Gestión técnica conectada</title>
</head>
<body class="has-intro">
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <main id="contenido">
    <ExperienceHero />
    <EcosystemExperience />
    <FlowExperience />
    <AccessExperience />
    <Intro />
  </main>
</body>
</html>

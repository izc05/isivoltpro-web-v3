---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const contact = `${base}contacto/`;
const pilot = `${base}piloto/`;
const appMaintenance = `${base}app-mantenimiento/`;
const solutions = `${base}soluciones/`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Demo · IsiVoltPro" description="Prueba una demo guiada de IsiVoltPro en 60 segundos: aviso, OT, QR, intervención, cierre e histórico con datos ficticios y sin enviar información personal." path={`${base}demo/`} />
  <style is:inline>
    .demo-hero{padding:76px 0 70px;background:radial-gradient(circle at 80% 32%,rgba(101,82,226,.12),transparent 25%),radial-gradient(circle at 92% 70%,rgba(31,183,135,.09),transparent 20%),#fff}.demo-hero__grid{display:grid;grid-template-columns:.86fr 1.14fr;gap:64px;align-items:center}.demo-hero h1{margin:14px 0 18px;font:800 clamp(48px,4.8vw,68px)/.98 var(--v3-font-display,system-ui);letter-spacing:-.06em}.demo-hero p{max-width:560px;color:var(--muted);line-height:1.7}.demo-workspace{position:relative;min-height:440px}.demo-window{position:absolute;inset:18px 24px 24px 18px;border:1px solid #e3e7ef;border-radius:24px;background:#fff;box-shadow:0 28px 70px rgba(51,61,105,.14);overflow:hidden}.demo-window__bar{height:43px;display:flex;align-items:center;gap:6px;padding:0 14px;border-bottom:1px solid #edf0f5}.demo-window__bar i{width:7px;height:7px;border-radius:50%;background:#d9deea}.demo-window__body{display:grid;grid-template-columns:112px 1fr;height:calc(100% - 43px)}.demo-side{padding:17px 10px;background:#fafbfe;border-right:1px solid #edf0f5}.demo-side b{display:block;margin-bottom:16px;font-size:10px}.demo-side span{display:block;margin:7px 0;padding:7px;border-radius:7px;color:#7e889b;font-size:8px}.demo-side span:first-of-type{background:#f0edff;color:#6652d7;font-weight:800}.demo-main{padding:19px}.demo-main__top{display:flex;justify-content:space-between;gap:12px;align-items:center}.demo-main__top strong{font-size:17px}.demo-main__top small{padding:6px 9px;border-radius:999px;background:#eaf9f3;color:#15835f;font-weight:900}.demo-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:16px 0}.demo-kpis div{padding:11px;border:1px solid #eceff4;border-radius:11px}.demo-kpis small{display:block;color:#929baa;font-size:7px}.demo-kpis b{display:block;margin-top:4px;font-size:18px}.demo-flow{display:grid;gap:7px}.demo-flow div{display:grid;grid-template-columns:34px 1fr auto;align-items:center;gap:9px;padding:9px;border:1px solid #edf0f5;border-radius:9px;font-size:8px}.demo-flow b{width:28px;height:28px;display:grid;place-items:center;border-radius:9px;background:#eef3ff;color:#4261d5}.demo-flow span{color:#68748a}.demo-flow em{font-style:normal;padding:4px 6px;border-radius:999px;background:#f1efff;color:#6752d7;font-weight:800}.demo-float{position:absolute;z-index:3;border:1px solid #e5e8f0;background:#fff;box-shadow:0 14px 34px rgba(50,59,103,.14)}.demo-float--clock{right:0;top:55px;padding:13px 15px;border-radius:16px;font-size:10px;font-weight:900}.demo-float--clock strong{display:block;font-size:20px;color:#5f4bd3}.demo-float--result{right:24px;bottom:3px;padding:12px 14px;border-radius:15px;color:#16845f;font-size:10px;font-weight:900}.demo-paths{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.demo-path{padding:27px;border:1px solid var(--line);border-radius:27px;background:#fff;box-shadow:var(--shadow-soft)}.demo-path i{width:46px;height:46px;display:grid;place-items:center;border-radius:15px;background:var(--tone,#eef3ff);color:var(--ink,var(--blue));font-style:normal;font-weight:900}.demo-path h3{margin:19px 0 8px;font-size:22px}.demo-path p{margin:0;color:var(--muted);line-height:1.65}.demo-path small{display:block;margin-top:15px;color:#52617c;font-weight:800}.quick-demo{padding:34px;border:1px solid #dfe6f3;border-radius:32px;background:linear-gradient(145deg,#fff,#f8fbff 55%,#f8f5ff);box-shadow:var(--shadow-soft)}.quick-demo__head{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;margin-bottom:26px}.quick-demo__head h2{margin:8px 0 0;font-size:clamp(34px,5vw,58px);line-height:1.02;letter-spacing:-.05em}.quick-demo__head p{max-width:500px;margin:0;color:var(--muted);line-height:1.65}.quick-demo__grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:22px}.quick-demo__steps{display:grid;gap:10px}.quick-step{width:100%;min-height:70px;display:grid;grid-template-columns:42px 1fr;gap:12px;align-items:center;padding:12px 14px;border:1px solid #e2e8f2;border-radius:18px;background:#fff;text-align:left;color:#28344b;cursor:pointer}.quick-step:focus-visible{outline:3px solid rgba(62,103,246,.28);outline-offset:2px}.quick-step[aria-current="step"]{border-color:#9eb3ff;background:#f5f7ff}.quick-step__index{width:42px;height:42px;display:grid;place-items:center;border-radius:14px;background:#eef3ff;color:var(--blue);font-weight:900}.quick-step strong,.quick-step small{display:block}.quick-step small{margin-top:3px;color:#6e7890}.quick-demo__stage{min-height:430px;padding:24px;border:1px solid #e1e7f1;border-radius:26px;background:#fff}.stage-top{display:flex;justify-content:space-between;gap:16px;align-items:center}.stage-badge{padding:8px 11px;border-radius:999px;background:#eef9f5;color:#15845f;font-size:12px;font-weight:900}.stage-clock{font-size:12px;color:#6f7890;font-weight:800}.stage-card{margin-top:24px;padding:24px;border:1px solid #e4eaf3;border-radius:22px;background:linear-gradient(160deg,#fff,#fbfcff)}.stage-kicker{font-size:11px;font-weight:900;letter-spacing:.12em;color:#65738d;text-transform:uppercase}.stage-card h3{margin:9px 0 10px;font-size:clamp(25px,3.5vw,36px)}.stage-card p{margin:0;color:var(--muted);line-height:1.65}.stage-meta,.stage-result{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:20px}.stage-result{grid-template-columns:1fr 1fr}.stage-meta div,.stage-result div{padding:13px;border-radius:15px;background:#f7f9fd}.stage-meta small,.stage-result small{display:block;color:#7a8498}.stage-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.stage-action{min-height:46px;padding:0 16px;border:0;border-radius:14px;background:#17223a;color:#fff;font:inherit;font-weight:900;cursor:pointer}.stage-action--soft{background:#eef3ff;color:#3152c9}.stage-progress{height:8px;margin-top:22px;border-radius:999px;background:#edf1f7;overflow:hidden}.stage-progress span{display:block;height:100%;width:var(--progress,16.6%);background:linear-gradient(90deg,#3d69f6,#7451e8,#1fb787)}.stage-note{margin-top:14px;font-size:12px;color:#69758d}.quick-demo__footer{display:flex;justify-content:space-between;gap:18px;align-items:center;margin-top:20px;padding-top:18px;border-top:1px solid #e4e9f2}.quick-demo__footer p{margin:0;color:#68758d;font-size:13px}.after-demo{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.after-demo article{padding:25px;border:1px solid var(--line);border-radius:24px;background:#fff}.after-demo h3{margin:12px 0 8px}.after-demo p{margin:0;color:var(--muted);line-height:1.6}@media(max-width:900px){.demo-hero__grid,.quick-demo__grid{grid-template-columns:1fr}.demo-paths,.after-demo{grid-template-columns:repeat(2,1fr)}.quick-demo__head{align-items:flex-start;flex-direction:column}.quick-demo__steps{grid-template-columns:repeat(3,1fr)}}@media(max-width:680px){.demo-hero{padding:56px 0}.demo-workspace{min-height:350px}.demo-window{inset:12px 5px 22px}.demo-window__body{grid-template-columns:72px 1fr}.demo-side{padding:12px 5px}.demo-main{padding:12px}.demo-kpis{grid-template-columns:1fr 1fr}.demo-kpis div:last-child{display:none}.demo-float--clock{right:2px}.quick-demo{padding:22px}.quick-demo__steps{display:flex;overflow-x:auto}.quick-step{min-width:138px}.stage-meta,.stage-result{grid-template-columns:1fr}.quick-demo__footer{align-items:flex-start;flex-direction:column}}@media(max-width:580px){.demo-paths,.after-demo{grid-template-columns:1fr}}
  </style>
</head>
<body><V3CommercialHeader /><main class="page-main">
<section class="demo-hero"><div class="page-shell demo-hero__grid"><div><span class="eyebrow">Una demo sobre tu problema, no sobre nuestro menú</span><h1>Ver IsiVoltPro tiene que<br/><span class="gradient-text">ayudarte a decidir.</span></h1><p>La demo parte de una situación cotidiana y enseña cómo pasa de aviso disperso a trabajo trazable, sin registro y sin enviar datos.</p><div class="page-hero__actions"><a class="btn btn--primary" href="#demo-60">Probar demo de 60 segundos →</a><a class="btn" href={solutions}>Elegir mi problema</a></div></div><div class="demo-workspace" aria-label="Vista conceptual de la demo IsiVoltPro"><div class="demo-window"><div class="demo-window__bar"><i></i><i></i><i></i></div><div class="demo-window__body"><aside class="demo-side"><b>IsiVoltPro</b><span>Demo</span><span>Avisos</span><span>OT</span><span>Activos</span><span>Histórico</span></aside><div class="demo-main"><div class="demo-main__top"><strong>Demo · Oficina 03</strong><small>Datos ficticios</small></div><div class="demo-kpis"><div><small>PASOS</small><b>6</b></div><div><small>DURACIÓN</small><b>60 s</b></div><div><small>REGISTRO</small><b>No</b></div></div><div class="demo-flow"><div><b>01</b><span>Aviso recibido</span><em>Nuevo</em></div><div><b>02</b><span>OT asignada</span><em>En curso</em></div><div><b>03</b><span>Activo por QR</span><em>CLIMA-003</em></div><div><b>04</b><span>Cierre e histórico</span><em>Listo</em></div></div></div></div></div><span class="demo-float demo-float--clock"><strong>00:60</strong>recorrido completo</span><span class="demo-float demo-float--result">✓ Sin guardar datos</span></div></div></section>
<section class="page-section" id="demo-60"><div class="page-shell"><div class="quick-demo" data-quick-demo><div class="quick-demo__head"><div><span class="eyebrow">Prueba IsiVoltPro · 60 segundos</span><h2>De un aviso perdido<br/><span class="gradient-text">a un histórico útil.</span></h2></div><p>Recorre un caso ficticio sin registrarte y sin enviar datos.</p></div><div class="quick-demo__grid"><div class="quick-demo__steps"><button class="quick-step" type="button" data-step="0" aria-current="step"><span class="quick-step__index">01</span><span><strong>Aviso</strong><small>Entra la incidencia</small></span></button><button class="quick-step" type="button" data-step="1"><span class="quick-step__index">02</span><span><strong>OT</strong><small>Se asigna</small></span></button><button class="quick-step" type="button" data-step="2"><span class="quick-step__index">03</span><span><strong>QR</strong><small>Abre el activo</small></span></button><button class="quick-step" type="button" data-step="3"><span class="quick-step__index">04</span><span><strong>Campo</strong><small>Registra trabajo</small></span></button><button class="quick-step" type="button" data-step="4"><span class="quick-step__index">05</span><span><strong>Cierre</strong><small>Deja trazabilidad</small></span></button><button class="quick-step" type="button" data-step="5"><span class="quick-step__index">06</span><span><strong>Histórico</strong><small>Mejora la próxima OT</small></span></button></div><div class="quick-demo__stage" aria-live="polite"><div class="stage-top"><span class="stage-badge">Datos ficticios</span><span class="stage-clock" data-stage-clock>00:10 / 01:00</span></div><div class="stage-card"><span class="stage-kicker" data-stage-kicker>Nuevo aviso</span><h3 data-stage-title>Aire acondicionado no enfría</h3><p data-stage-copy>Un aviso entra con ubicación, prioridad y una descripción corta.</p><div class="stage-meta" data-stage-meta><div><small>Ubicación</small><strong>Oficina 03</strong></div><div><small>Prioridad</small><strong>Media</strong></div><div><small>Estado</small><strong>Nuevo</strong></div></div><div class="stage-result" data-stage-result hidden></div><div class="stage-actions"><button class="stage-action" type="button" data-next-step>Siguiente paso →</button><button class="stage-action stage-action--soft" type="button" data-restart hidden>Repetir demo</button></div><div class="stage-progress"><span data-stage-progress style="--progress:16.6%"></span></div><p class="stage-note" data-stage-note>Paso 1 de 6 · No se guarda ni transmite información.</p></div></div></div><div class="quick-demo__footer"><p><strong>Demostración conceptual.</strong> La disponibilidad exacta se valida según el estado real de la plataforma.</p><a class="btn" href={appMaintenance}>Ver App Mantenimiento</a></div></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Tres puntos de partida</span><h2>La misma plataforma.<br/><span class="gradient-text">Demos diferentes.</span></h2></div><p>El recorrido cambia según quién trabaja y qué problema necesita resolver primero.</p></div><div class="demo-paths"><article class="demo-path"><i>👤</i><h3>Autónomo técnico</h3><p>Clientes, equipos, avisos, OT, fotos y preventivos desde móvil.</p><small>Rapidez y memoria técnica.</small></article><article class="demo-path" style="--tone:#f2efff;--ink:#6544e8"><i>👥</i><h3>Pequeño equipo</h3><p>Asignación, estados, coordinación y documentación compartida.</p><small>Una misma información.</small></article><article class="demo-path" style="--tone:#eaf9f3;--ink:#159f71"><i>▦</i><h3>Instalaciones propias</h3><p>Activos, preventivos, incidencias e histórico por ubicación.</p><small>Control y trazabilidad.</small></article></div></div></section>
<section class="page-section"><div class="page-shell"><div class="after-demo"><article><b>01</b><h3>Encaja</h3><p>Pasar a piloto con un alcance pequeño y medible.</p></article><article><b>02</b><h3>Hay dudas</h3><p>Validar integraciones o requisitos críticos antes de avanzar.</p></article><article><b>03</b><h3>No encaja</h3><p>Parar pronto también es una buena decisión comercial.</p></article></div><div class="page-hero__actions" style="margin-top:24px"><a class="btn btn--primary" href={pilot}>Ver proceso de piloto →</a><a class="btn" href={contact}>Hablar de mi caso</a></div></div></section>
</main><V3CommercialFooter />
<script is:inline>
(()=>{const steps=[
{k:'Nuevo aviso',t:'Aire acondicionado no enfría',c:'Un aviso entra con ubicación, prioridad y una descripción corta.',m:[['Ubicación','Oficina 03'],['Prioridad','Media'],['Estado','Nuevo']]},
{k:'Orden de trabajo',t:'OT-2026-0148 asignada',c:'El aviso se convierte en trabajo visible y queda asociado a un técnico.',m:[['Técnico','Ana'],['Estado','Asignada'],['SLA','Demo']]},
{k:'Activo por QR',t:'CLIMA-003 abierto',c:'El técnico llega al equipo y abre su ficha contextual desde el QR.',m:[['Activo','CLIMA-003'],['Histórico','12 OT'],['Docs','4']]},
{k:'Trabajo en campo',t:'Intervención registrada',c:'Se añaden notas y evidencias desde el punto de trabajo.',m:[['Fotos','2'],['Acción','Filtro'],['Tiempo','18 min']]},
{k:'Cierre',t:'OT cerrada con trazabilidad',c:'El trabajo deja un resultado entendible para quien consulte después.',m:[['Estado','Cerrada'],['Resultado','Resuelto'],['Evidencia','Completa']]},
{k:'Histórico',t:'La próxima OT empieza mejor',c:'El activo conserva lo ocurrido y evita empezar de cero.',m:[['OT','13'],['Último cierre','Hoy'],['Contexto','Disponible']],r:[['13','OT en histórico'],['1','activo conectado']]}
];const buttons=[...document.querySelectorAll('[data-step]')],title=document.querySelector('[data-stage-title]'),kicker=document.querySelector('[data-stage-kicker]'),copy=document.querySelector('[data-stage-copy]'),meta=document.querySelector('[data-stage-meta]'),result=document.querySelector('[data-stage-result]'),clock=document.querySelector('[data-stage-clock]'),progress=document.querySelector('[data-stage-progress]'),note=document.querySelector('[data-stage-note]'),next=document.querySelector('[data-next-step]'),restart=document.querySelector('[data-restart]');let current=0;const render=i=>{current=i;const s=steps[i];buttons.forEach((b,n)=>b.toggleAttribute('aria-current',n===i));kicker.textContent=s.k;title.textContent=s.t;copy.textContent=s.c;meta.innerHTML=s.m.map(([a,b])=>`<div><small>${a}</small><strong>${b}</strong></div>`).join('');result.hidden=!s.r;result.innerHTML=s.r?s.r.map(([a,b])=>`<div><b>${a}</b><small>${b}</small></div>`).join(''):'';clock.textContent=`00:${String((i+1)*10).padStart(2,'0')} / 01:00`;progress.style.setProperty('--progress',`${((i+1)/steps.length)*100}%`);note.textContent=`Paso ${i+1} de ${steps.length} · No se guarda ni transmite información.`;next.hidden=i===steps.length-1;restart.hidden=i!==steps.length-1};buttons.forEach((b,i)=>b.addEventListener('click',()=>render(i)));next.addEventListener('click',()=>render(Math.min(current+1,steps.length-1)));restart.addEventListener('click',()=>render(0));render(0)})();
</script></body></html>
---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const demo = `${base}demo/`;
const pilot = `${base}piloto/`;
const apps = `${base}aplicaciones/`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Alcance del producto · IsiVoltPro" description="Qué problemas pretende cubrir el núcleo de IsiVoltPro, qué capacidades son ampliaciones y qué necesidades quedan fuera del enfoque actual para autónomos y pequeñas empresas." path={`${base}alcance/`} />
  <style is:inline>
    .scope-hero{padding:78px 0 72px;background:radial-gradient(circle at 78% 30%,rgba(93,78,220,.13),transparent 28%),radial-gradient(circle at 92% 68%,rgba(43,184,142,.10),transparent 23%),#fff}.scope-hero__grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:66px;align-items:center}.scope-hero h1{margin:14px 0 18px;font:800 clamp(48px,4.8vw,69px)/.98 var(--v3-font-display,system-ui);letter-spacing:-.06em}.scope-hero h1 span{display:block;color:transparent;background:linear-gradient(90deg,#6653dc,#5598dd 52%,#2db88b);-webkit-background-clip:text;background-clip:text}.scope-hero p{max-width:540px;color:#717d91;line-height:1.72}.scope-hero .btn--primary{background:#111827;border-color:#111827;color:#fff}.scope-workspace{position:relative;min-height:455px}.scope-window{position:absolute;inset:16px 24px 26px 18px;border:1px solid #e3e7f0;border-radius:24px;background:#fff;box-shadow:0 30px 75px rgba(57,65,111,.14);overflow:hidden}.scope-window__bar{height:43px;display:flex;align-items:center;gap:6px;padding:0 14px;border-bottom:1px solid #edf0f5}.scope-window__bar i{width:7px;height:7px;border-radius:50%;background:#d9deea}.scope-window__body{display:grid;grid-template-columns:118px 1fr;height:calc(100% - 43px)}.scope-side{padding:18px 10px;background:#fafbfe;border-right:1px solid #edf0f5}.scope-side b{display:block;margin-bottom:17px;font-size:10px}.scope-side span{display:block;margin:8px 0;padding:7px;border-radius:7px;color:#818b9d;font-size:8px}.scope-side span:first-of-type{background:#f0edff;color:#6854d8;font-weight:800}.scope-main{padding:19px}.scope-main__head{display:flex;align-items:center;justify-content:space-between;gap:12px}.scope-main__head strong{font-size:17px}.scope-main__head small{padding:6px 9px;border-radius:999px;background:#eef8f4;color:#14845e;font-weight:800}.scope-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:16px 0}.scope-kpis div{padding:11px;border:1px solid #eceef4;border-radius:11px}.scope-kpis small{display:block;color:#929baa;font-size:7px}.scope-kpis b{display:block;margin-top:4px;font-size:18px}.scope-map{display:grid;gap:7px}.scope-map div{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center;padding:9px 10px;border:1px solid #edf0f5;border-radius:9px;font-size:8px}.scope-map em{font-style:normal;color:#6f7b8f}.scope-map span{padding:4px 6px;border-radius:999px;font-weight:800}.scope-map .core{background:#eaf9f3;color:#14845e}.scope-map .extend{background:#f1efff;color:#6752d7}.scope-map .verify{background:#fff4e8;color:#b8681b}.scope-map .out{background:#f2f4f8;color:#6b7486}.scope-chip{position:absolute;z-index:3;border:1px solid #e5e8f0;background:#fff;box-shadow:0 14px 34px rgba(50,59,103,.14)}.scope-chip--a{left:0;bottom:72px;padding:11px 13px;border-radius:15px;color:#14845e;font-size:9px;font-weight:900}.scope-chip--b{right:0;top:54px;width:75px;height:75px;display:grid;place-items:center;border-radius:22px;color:#6752d7;font-size:26px}.scope-chip--c{right:24px;bottom:5px;padding:10px 13px;border-radius:15px;color:#b8681b;font-size:9px;font-weight:900}.scope-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}.scope-card{padding:28px;border:1px solid var(--line);border-radius:28px;background:#fff;box-shadow:var(--shadow-soft)}.scope-card__tag{display:inline-flex;padding:7px 10px;border-radius:999px;background:var(--tag-bg,#eef3ff);color:var(--tag,#175cff);font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.scope-card h3{margin:20px 0 9px;font-size:24px;letter-spacing:-.035em}.scope-card p{margin:0 0 18px;color:var(--muted);line-height:1.65}.scope-card ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}.scope-card li{display:grid;grid-template-columns:22px 1fr;gap:9px;color:#53607a;line-height:1.5}.scope-card li span{font-weight:900;color:var(--tag,#175cff)}.verify-board{display:grid;grid-template-columns:.9fr 1.1fr;gap:28px;padding:36px;border-radius:31px;background:linear-gradient(145deg,#0c1530,#1c2f62);color:#fff}.verify-board h2{margin:0;font-size:clamp(34px,4.8vw,58px);line-height:1.03;letter-spacing:-.05em}.verify-board p{color:#c4cee8;line-height:1.7}.verify-list{display:grid;gap:10px}.verify-list div{padding:14px 16px;border:1px solid rgba(255,255,255,.13);border-radius:15px;background:rgba(255,255,255,.06)}.verify-list strong{display:block;margin-bottom:4px}.verify-list small{color:#c3cce4;line-height:1.5}.scope-note{margin-top:20px;padding:18px 20px;border:1px solid #e0e6f2;border-radius:18px;background:#f9fbff;color:#53617a;line-height:1.65}.scope-note strong{color:#1c2945}@media(max-width:920px){.scope-hero__grid{grid-template-columns:1fr}.scope-grid{grid-template-columns:1fr 1fr}.verify-board{grid-template-columns:1fr}}@media(max-width:580px){.scope-hero{padding:56px 0}.scope-hero h1{font-size:clamp(42px,12vw,56px)}.scope-workspace{min-height:370px}.scope-window{inset:12px 7px 24px}.scope-window__body{grid-template-columns:74px 1fr}.scope-side{padding:14px 6px}.scope-main{padding:13px}.scope-kpis{grid-template-columns:1fr 1fr}.scope-kpis div:last-child{display:none}.scope-chip--a{display:none}.scope-chip--b{width:54px;height:54px}.scope-chip--c{right:8px}.scope-grid{grid-template-columns:1fr}.scope-card,.verify-board{padding:22px}}
  </style>
</head>
<body>
<V3CommercialHeader />
<main class="page-main">
  <section class="scope-hero"><div class="page-shell scope-hero__grid"><div><span class="eyebrow">Transparencia de producto</span><h1>Qué queremos resolver.<span>Y qué no vamos a fingir.</span></h1><p>IsiVoltPro está enfocado en organizar trabajo técnico para autónomos y pequeñas empresas. El objetivo es hacer muy bien un núcleo práctico antes de intentar convertirse en un ERP generalista. La disponibilidad exacta de cada capacidad se valida en demo.</p><div class="page-hero__actions"><a class="btn btn--primary" href={demo}>Ver cómo lo mostramos en demo →</a><a class="btn" href={apps}>Explorar apps</a></div></div><div class="scope-workspace" aria-label="Mapa conceptual del alcance de IsiVoltPro"><div class="scope-window"><div class="scope-window__bar"><i></i><i></i><i></i></div><div class="scope-window__body"><aside class="scope-side"><b>IsiVoltPro</b><span>Alcance</span><span>Núcleo</span><span>Ampliaciones</span><span>Requisitos</span><span>Límites</span></aside><div class="scope-main"><div class="scope-main__head"><strong>Mapa de producto</strong><small>Transparente</small></div><div class="scope-kpis"><div><small>Núcleo</small><b>6</b></div><div><small>Ampliaciones</small><b>5</b></div><div><small>Validación</small><b>Antes</b></div></div><div class="scope-map"><div><em>Avisos · OT · activos · preventivo</em><span class="core">Núcleo</span></div><div><em>QR/NFC · inspecciones · inventario</em><span class="extend">Ampliar</span></div><div><em>Integraciones · privacidad · offline</em><span class="verify">Validar</span></div><div><em>ERP financiero · nóminas · fiscalidad</em><span class="out">Fuera</span></div></div></div></div></div><span class="scope-chip scope-chip--a" aria-hidden="true">✓ Trabajo diario</span><span class="scope-chip scope-chip--b" aria-hidden="true">＋</span><span class="scope-chip scope-chip--c" aria-hidden="true">! Validar antes</span></div></div></section>

  <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Tres niveles</span><h2>Un mapa claro de<br/><span class="gradient-text">lo que estamos construyendo.</span></h2></div><p>Esta clasificación describe la dirección comercial y técnica. No sustituye la verificación de disponibilidad de una versión concreta.</p></div><div class="scope-grid">
    <article class="scope-card"><span class="scope-card__tag">Núcleo prioritario</span><h3>Trabajo de mantenimiento</h3><p>El centro de la propuesta para resolver problemas cotidianos sin implantar una suite enorme.</p><ul><li><span>✓</span><div>Clientes, ubicaciones y activos.</div></li><li><span>✓</span><div>Avisos e incidencias.</div></li><li><span>✓</span><div>Órdenes de trabajo y estados.</div></li><li><span>✓</span><div>Mantenimiento preventivo.</div></li><li><span>✓</span><div>Fotos, notas, documentación e histórico.</div></li><li><span>✓</span><div>Uso móvil y acceso contextual al activo.</div></li></ul></article>
    <article class="scope-card" style="--tag-bg:#f2efff;--tag:#6544e8"><span class="scope-card__tag">Ampliación</span><h3>Capacidades conectadas</h3><p>Se añaden cuando el flujo básico ya aporta valor y la necesidad concreta justifica más profundidad.</p><ul><li><span>+</span><div>QR / NFC y etiquetado.</div></li><li><span>+</span><div>Inspecciones y checklists.</div></li><li><span>+</span><div>Inventario y materiales.</div></li><li><span>+</span><div>Más usuarios, sedes y coordinación.</div></li><li><span>+</span><div>Apps especializadas por actividad.</div></li><li><span>+</span><div>Integraciones verificadas caso a caso.</div></li></ul></article>
    <article class="scope-card" style="--tag-bg:#fff3e9;--tag:#d96c20"><span class="scope-card__tag">Fuera del foco actual</span><h3>No queremos ser todo</h3><p>Hay necesidades para las que un ERP, software contable u otra herramienta especializada puede ser una elección mejor.</p><ul><li><span>—</span><div>Contabilidad, fiscalidad y nóminas completas.</div></li><li><span>—</span><div>ERP financiero o compras corporativas como objetivo principal.</div></li><li><span>—</span><div>Sustituir de golpe todos los sistemas de una organización grande.</div></li><li><span>—</span><div>Prometer integraciones no probadas.</div></li><li><span>—</span><div>Certificaciones, SLA o compromisos aún no formalizados.</div></li><li><span>—</span><div>Funciones que obliguen al técnico a duplicar trabajo sin aportar contexto.</div></li></ul></article>
  </div><p class="scope-note"><strong>Principio:</strong> si una capacidad es crítica para tu negocio y todavía no está verificada, se trata como requisito previo del piloto. No se da por hecha solo porque encaje en la visión futura.</p></div></section>

  <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Antes de comprometerse</span><h2>Hay requisitos que deben<br/><span class="gradient-text">confirmarse expresamente.</span></h2></div><p>Algunas necesidades no son visibles en una landing comercial. Por eso se revisan antes de aceptar un piloto o una implantación.</p></div><div class="verify-board"><div><h2>Lo crítico se valida antes, no después.</h2><p>Una buena decisión comercial incluye límites. Si un requisito condiciona toda la operación, debe estar confirmado antes de que una empresa dependa de IsiVoltPro.</p><div class="page-hero__actions"><a class="btn" style="background:#fff;color:#14213d" href={pilot}>Ver criterios del piloto →</a></div></div><div class="verify-list"><div><strong>Integraciones obligatorias</strong><small>APIs, importaciones o sistemas externos imprescindibles para el flujo.</small></div><div><strong>Privacidad y datos</strong><small>Tratamientos, roles, retención y requisitos específicos del caso.</small></div><div><strong>Seguridad</strong><small>Acceso, aislamiento, administración y cualquier control requerido antes de producción.</small></div><div><strong>Trabajo sin conexión u otros requisitos de campo</strong><small>No se asumen; se validan explícitamente si son críticos.</small></div><div><strong>Informes o exigencias regulatorias</strong><small>Plantillas, firmas o evidencias obligatorias deben revisarse antes de comprometer alcance.</small></div></div></div></div></section>

  <section class="page-section page-section--soft"><div class="page-shell"><div class="callout"><div><h2>La mejor configuración puede ser más pequeña de lo que imaginas.</h2><p>Si un único flujo resuelve el problema principal, empezamos ahí. Si IsiVoltPro no encaja, también queremos detectarlo pronto.</p></div><a class="btn btn--primary" href={demo}>Comprobar encaje en una demo →</a></div></div></section>
</main>
<V3CommercialFooter />
</body>
</html>

---
import '../styles/v4-entry-minimal.css';
import premiumCubeUrl from '../assets/isivoltpro-cube-premium-v4.webp?url';

interface Props {
  accessHref: string;
  demoHref: string;
}

const base = import.meta.env.BASE_URL;
const brandMark = `${base}brand/isivoltpro-mark-v4.svg`;
---
<div class="intro entry3d" id="intro" aria-label="Presentación de IsiVoltPro">
  <button class="intro__skip entry3d__skip" id="skip-intro" type="button">Saltar intro</button>
  <div class="entry3d__minimal">
    <div class="entry3d__logo" aria-label="IsiVoltPro">
      <img src={brandMark} alt="" width="78" height="78" decoding="async" />
      <span>IsiVolt<strong>Pro</strong></span>
    </div>
    <div class="entry3d__scene" id="entry3d-scene" aria-label="Cubo de cristal multicolor de IsiVoltPro en movimiento">
      <div class="entry3d__halo" aria-hidden="true"></div>
      <canvas id="entry3d-canvas" class="entry3d__canvas" aria-hidden="true"></canvas>
      <img class="entry3d__fallback" src={premiumCubeUrl} alt="" width="690" height="670" loading="eager" decoding="sync" fetchpriority="high" />
    </div>
  </div>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#entry3d-canvas');
  const host = document.querySelector<HTMLElement>('#entry3d-scene');
  const intro = document.querySelector<HTMLElement>('#intro');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let alreadySeen = document.documentElement.classList.contains('skip-intro');
  try { alreadySeen ||= sessionStorage.getItem('isivoltpro-intro-seen') === '1'; } catch (_) {}

  const mountEntry3D = async () => {
    if (!canvas || !host || !intro || reduced || alreadySeen || intro.classList.contains('is-done')) return;
    const THREE = await import('three');
    const { RoundedBoxGeometry } = await import('three/addons/geometries/RoundedBoxGeometry.js');
    if (intro.classList.contains('is-done')) return;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.55));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.12;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(31, 1, .1, 100);
    camera.position.set(0, .08, 5.25);
    scene.add(new THREE.HemisphereLight(0xffffff, 0x768ad8, 2.8));

    const blue = new THREE.PointLight(0x2563eb, 42, 16); blue.position.set(-3, 2.5, 3.6); scene.add(blue);
    const cyan = new THREE.PointLight(0x20d9e8, 38, 16); cyan.position.set(3, 1.6, 3.3); scene.add(cyan);
    const violet = new THREE.PointLight(0x8057ee, 35, 15); violet.position.set(-2.1, -2, 2.9); scene.add(violet);
    const magenta = new THREE.PointLight(0xf05ac8, 26, 14); magenta.position.set(2.3, -1.7, 2.7); scene.add(magenta);
    const whiteKey = new THREE.PointLight(0xffffff, 18, 13); whiteKey.position.set(.2, 3.6, 4.6); scene.add(whiteKey);

    const group = new THREE.Group();
    group.rotation.set(-.14, -.44, .028);
    scene.add(group);

    const cubeGeometry = new RoundedBoxGeometry(2.72, 2.72, 2.14, 8, .18);
    const cubeMaterial = new THREE.MeshPhysicalMaterial({
      color: 0x4773f7, transparent: true, opacity: .5, transmission: .38, thickness: 1.12,
      roughness: .065, metalness: 0, ior: 1.39, clearcoat: 1, clearcoatRoughness: .025,
      emissive: 0x163aa0, emissiveIntensity: .055, side: THREE.DoubleSide, depthWrite: false,
    });
    group.add(new THREE.Mesh(cubeGeometry, cubeMaterial));

    const innerGeometry = new RoundedBoxGeometry(2.34, 2.34, 1.82, 7, .145);
    const innerMaterial = new THREE.MeshPhysicalMaterial({
      color: 0x684fd8, transparent: true, opacity: .2, transmission: .34, thickness: .62,
      roughness: .05, ior: 1.3, clearcoat: .8, emissive: 0x472f9f, emissiveIntensity: .07,
      depthWrite: false,
    });
    group.add(new THREE.Mesh(innerGeometry, innerMaterial));

    const makeGlowTexture = (center: string, middle: string) => {
      const surface = document.createElement('canvas'); surface.width = 192; surface.height = 192;
      const context = surface.getContext('2d');
      if (context) {
        const gradient = context.createRadialGradient(96, 96, 4, 96, 96, 92);
        gradient.addColorStop(0, center); gradient.addColorStop(.35, middle); gradient.addColorStop(1, 'rgba(0,0,0,0)');
        context.fillStyle = gradient; context.fillRect(0, 0, 192, 192);
      }
      const texture = new THREE.CanvasTexture(surface); texture.colorSpace = THREE.SRGBColorSpace; return texture;
    };
    const cyanTexture = makeGlowTexture('rgba(38,225,238,.95)', 'rgba(38,180,238,.36)');
    const violetTexture = makeGlowTexture('rgba(119,80,238,.9)', 'rgba(101,70,230,.34)');
    const pinkTexture = makeGlowTexture('rgba(239,84,190,.82)', 'rgba(210,70,190,.30)');
    const addGlow = (texture: any, x: number, y: number, z: number, size: number, opacity: number) => {
      const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: texture, transparent: true, opacity, depthWrite: false, blending: THREE.AdditiveBlending }));
      sprite.position.set(x, y, z); sprite.scale.set(size, size, 1); group.add(sprite);
    };
    addGlow(cyanTexture, .72, .42, .2, 1.75, .74);
    addGlow(violetTexture, -.68, .36, .12, 1.7, .72);
    addGlow(pinkTexture, -.25, -.7, .38, 1.45, .6);

    const edges = new THREE.LineSegments(new THREE.EdgesGeometry(cubeGeometry, 28), new THREE.LineBasicMaterial({ color: 0xe8f5ff, transparent: true, opacity: .88 }));
    edges.renderOrder = 5; group.add(edges);

    const boltShape = new THREE.Shape();
    boltShape.moveTo(.15, 1.04); boltShape.lineTo(-.8, -.05); boltShape.lineTo(-.18, -.05);
    boltShape.lineTo(-.48, -1.04); boltShape.lineTo(.8, .18); boltShape.lineTo(.18, .18); boltShape.closePath();
    const boltGeometry = new THREE.ExtrudeGeometry(boltShape, { depth: .18, bevelEnabled: true, bevelSize: .05, bevelThickness: .05, bevelSegments: 3 });
    boltGeometry.center();
    const bolt = new THREE.Mesh(boltGeometry, new THREE.MeshPhysicalMaterial({ color: 0xffffff, metalness: .18, roughness: .11, clearcoat: 1, emissive: 0xa9e8ff, emissiveIntensity: .32 }));
    bolt.scale.set(.72, .72, .72); bolt.position.z = 1.04; bolt.rotation.z = -.035; bolt.renderOrder = 8; group.add(bolt);

    const backGlow = new THREE.Mesh(new THREE.CircleGeometry(1.04, 48), new THREE.MeshBasicMaterial({ color: 0x645dff, transparent: true, opacity: .1, blending: THREE.AdditiveBlending, depthWrite: false }));
    backGlow.position.z = -.99; group.add(backGlow);

    const pointer = { x: 0, y: 0 }, target = { x: 0, y: 0 };
    host.addEventListener('pointermove', (event) => {
      const rect = host.getBoundingClientRect();
      target.x = ((event.clientX - rect.left) / rect.width - .5) * .3;
      target.y = ((event.clientY - rect.top) / rect.height - .5) * .18;
    }, { passive: true });
    host.addEventListener('pointerleave', () => { target.x = 0; target.y = 0; }, { passive: true });

    const resize = () => {
      const width = Math.max(1, host.clientWidth), height = Math.max(1, host.clientHeight);
      renderer.setSize(width, height, false); camera.aspect = width / height; camera.updateProjectionMatrix();
    };
    resize(); const observer = new ResizeObserver(resize); observer.observe(host);

    const start = performance.now(); let raf = 0;
    const render = (now: number) => {
      if (intro.classList.contains('is-done')) {
        observer.disconnect(); cyanTexture.dispose(); violetTexture.dispose(); pinkTexture.dispose(); renderer.dispose(); cancelAnimationFrame(raf); return;
      }
      const t = (now - start) / 1000;
      pointer.x += (target.x - pointer.x) * .045; pointer.y += (target.y - pointer.y) * .045;
      group.rotation.y = -.44 + Math.sin(t * .48) * .16 + pointer.x;
      group.rotation.x = -.14 + Math.sin(t * .4) * .045 - pointer.y;
      group.rotation.z = .028 + Math.sin(t * .35) * .022; group.position.y = Math.sin(t * .88) * .075;
      blue.intensity = 40 + Math.sin(t * 1.1) * 6; cyan.intensity = 36 + Math.cos(t * .93) * 6;
      violet.intensity = 33 + Math.sin(t * .77 + 1.4) * 5; magenta.intensity = 25 + Math.cos(t * .7) * 4;
      renderer.render(scene, camera); raf = requestAnimationFrame(render);
    };
    raf = requestAnimationFrame(render);
  };

  mountEntry3D();
</script>
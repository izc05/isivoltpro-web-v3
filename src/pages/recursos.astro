---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const contact = `${base}contacto/`;
const implementation = `${base}implantacion/`;
const guide = (slug: string) => `${base}recursos/${slug}/`;
---
<!doctype html><html lang="es"><head><V3Seo title="Recursos · IsiVoltPro" description="Guías prácticas IsiVoltPro para pasar de WhatsApp y Excel a un mantenimiento organizado, gestionar avisos y OT, activos, QR, preventivo e implantación digital en autónomos y pequeñas empresas." path={`${base}recursos/`} />
<style is:inline>
.resources-hero{position:relative;padding:84px 0 82px;background:radial-gradient(circle at 77% 24%,rgba(101,84,224,.13),transparent 27%),radial-gradient(circle at 94% 60%,rgba(45,191,141,.10),transparent 18%),#fff}.resources-hero__grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:72px;align-items:center}.resources-hero h1{margin:17px 0 18px;font:800 clamp(50px,4.8vw,70px)/.98 var(--v3-font-display,system-ui);letter-spacing:-.064em}.resources-hero h1 span{display:block;color:transparent;background:linear-gradient(90deg,#6b58df,#4aa7d2 52%,#35bd8f);-webkit-background-clip:text;background-clip:text}.resources-hero p{max-width:560px;margin:0;color:#727d90;font-size:15px;line-height:1.72}.resources-hero .btn--primary{background:#111827;border-color:#111827;color:#fff}.resource-workspace{position:relative;min-height:470px}.resource-workspace::before{content:'';position:absolute;inset:8% -4% 0 10%;border-radius:42px;background:linear-gradient(135deg,rgba(99,83,224,.15),rgba(55,166,212,.08) 48%,rgba(45,192,141,.11));filter:blur(30px)}.resource-workspace__panel{position:absolute;inset:22px 20px 24px 42px;border:1px solid #e5e9f2;border-radius:28px;background:rgba(255,255,255,.96);box-shadow:0 34px 84px rgba(58,67,109,.16);overflow:hidden}.resource-workspace__bar{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid #edf0f5}.resource-workspace__bar strong{font-size:11px}.resource-workspace__bar small{font-size:8px;color:#929aaa}.resource-workspace__body{display:grid;grid-template-columns:116px 1fr;min-height:360px}.resource-workspace__nav{padding:18px 12px;background:#10182f;color:#b8c2d6}.resource-workspace__nav strong{display:block;margin:0 8px 16px;color:#fff;font-size:10px}.resource-workspace__nav span{display:block;margin:5px 0;padding:8px 9px;border-radius:9px;font-size:8px}.resource-workspace__nav span:first-of-type{background:linear-gradient(90deg,rgba(89,101,235,.32),rgba(110,84,224,.26));color:#fff}.resource-workspace__main{padding:18px;background:linear-gradient(180deg,#fbfcff,#f7f9fd)}.resource-workspace__top{display:flex;align-items:end;justify-content:space-between;gap:12px}.resource-workspace__top small{color:#8992a3;font-size:8px}.resource-workspace__top strong{display:block;margin-top:4px;font-size:18px}.resource-featured{display:grid;grid-template-columns:1.12fr .88fr;gap:11px;margin-top:15px}.resource-featured__main{padding:16px;border:1px solid #e8ebf3;border-radius:15px;background:linear-gradient(145deg,#f4f1ff,#f7fbff 52%,#eefaf6)}.resource-featured__main small{font-size:7px;color:#6a58d9;font-weight:800}.resource-featured__main strong{display:block;margin-top:8px;font-size:15px;line-height:1.12}.resource-featured__main p{margin:7px 0 0;color:#7a8495;font-size:8px;line-height:1.5}.resource-featured__side{display:grid;gap:8px}.resource-featured__side div{padding:11px;border:1px solid #e9ecf3;border-radius:12px;background:#fff}.resource-featured__side small{display:block;color:#8d96a5;font-size:7px}.resource-featured__side b{display:block;margin-top:4px;font-size:11px}.resource-library{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:11px}.resource-library span{padding:10px;border:1px solid #e9ecf3;border-radius:11px;background:#fff;font-size:7px;font-weight:800;color:#566176}.resource-library span::before{content:'↗';display:block;margin-bottom:6px;color:#6654dc;font-size:10px}.resource-progress{margin-top:12px;padding:10px;border-radius:11px;background:#fff;border:1px solid #e9ecf3}.resource-progress small{display:flex;justify-content:space-between;color:#8992a3;font-size:7px}.resource-progress i{display:block;height:6px;margin-top:7px;border-radius:999px;background:linear-gradient(90deg,#6958df 0 72%,#e9ecf3 72%);font-style:normal}.resource-float{position:absolute;z-index:3;padding:11px 13px;border:1px solid #e5e9f1;border-radius:14px;background:#fff;box-shadow:0 16px 38px rgba(55,64,103,.14)}.resource-float strong{display:block;font-size:9px}.resource-float small{display:block;margin-top:3px;color:#8b94a3;font-size:7px}.resource-float--a{left:0;top:88px}.resource-float--b{right:0;top:46px}.resource-float--c{right:8px;bottom:34px}.resource-float--a strong{color:#6b56dd}.resource-float--b strong{color:#23a878}.resource-float--c strong{color:#d65ca8}.resource-grid{grid-template-columns:repeat(4,1fr)!important}.resource-card{min-height:255px}.resource-card:nth-child(1),.resource-card:nth-child(8){background:linear-gradient(145deg,#fff,#f8f6ff)!important}.resource-card:nth-child(3),.resource-card:nth-child(7){background:linear-gradient(145deg,#fff,#f5fbff)!important}.resource-card:nth-child(5),.resource-card:nth-child(6){background:linear-gradient(145deg,#fff,#f3fbf7)!important}@media(max-width:980px){.resources-hero__grid{grid-template-columns:1fr}.resource-grid{grid-template-columns:repeat(2,1fr)!important}.resource-workspace{min-height:430px}}@media(max-width:560px){.resources-hero{padding:58px 0}.resources-hero h1{font-size:clamp(43px,12vw,56px)}.resource-workspace{min-height:360px}.resource-workspace__panel{inset:18px 2px 18px 14px}.resource-workspace__body{grid-template-columns:74px 1fr}.resource-workspace__nav{padding:14px 7px}.resource-workspace__main{padding:12px}.resource-featured{grid-template-columns:1fr}.resource-featured__side{grid-template-columns:1fr 1fr}.resource-library{grid-template-columns:1fr 1fr}.resource-library span:last-child{display:none}.resource-float{padding:8px 9px}.resource-grid{grid-template-columns:1fr!important}}
</style></head><body>
<V3CommercialHeader />
<main class="page-main">
<section class="resources-hero"><div class="page-shell resources-hero__grid"><div><span class="eyebrow">Aprender antes de implantar</span><h1>Mejora tu forma de trabajar,<span>uses IsiVoltPro o no.</span></h1><p>Guías prácticas para ordenar avisos, órdenes, activos, preventivos y la transición desde WhatsApp/Excel sin burocracia innecesaria. El objetivo es aportar valor antes incluso de pedir una demo.</p><div class="page-hero__actions"><a class="btn btn--primary" href="#guias">Explorar guías →</a><a class="btn" href={implementation}>Cómo empezar un piloto</a></div></div><div class="resource-workspace" aria-label="Biblioteca conceptual de recursos IsiVoltPro"><div class="resource-workspace__panel"><div class="resource-workspace__bar"><strong>IsiVoltPro · biblioteca práctica</strong><small>8 guías publicadas</small></div><div class="resource-workspace__body"><aside class="resource-workspace__nav"><strong>Recursos</strong><span>Destacados</span><span>Avisos</span><span>OT</span><span>Activos</span><span>Preventivo</span></aside><div class="resource-workspace__main"><div class="resource-workspace__top"><div><small>APRENDER · APLICAR · MEJORAR</small><strong>Ideas para trabajar con menos fricción.</strong></div><small>Lectura práctica</small></div><div class="resource-featured"><div class="resource-featured__main"><small>GUÍA DESTACADA</small><strong>De WhatsApp y Excel a un flujo organizado.</strong><p>Qué conservar, qué ordenar y qué merece convertirse en trabajo trazable.</p></div><div class="resource-featured__side"><div><small>Guías</small><b>8 publicadas</b></div><div><small>Enfoque</small><b>Problemas reales</b></div></div></div><div class="resource-library"><span>Avisos claros</span><span>OT útiles</span><span>QR en activos</span></div><div class="resource-progress"><small><span>Ruta recomendada</span><span>3 de 4 pasos</span></small><i></i></div></div></div></div><div class="resource-float resource-float--a"><strong>Sin relleno SEO</strong><small>Contenido aplicable</small></div><div class="resource-float resource-float--b"><strong>8 guías</strong><small>Biblioteca inicial</small></div><div class="resource-float resource-float--c"><strong>De proceso a producto</strong><small>Primero ordenar</small></div></div></div></section>
<section class="page-section page-section--soft" id="guias"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Biblioteca práctica</span><h2>Problemas cotidianos.<br/><span class="gradient-text">Respuestas aplicables.</span></h2></div><p>Las guías explican principios que pueden aplicarse incluso sin IsiVoltPro. Si el proceso no es claro por sí mismo, digitalizarlo solo trasladará el desorden a otra pantalla.</p></div><div class="resource-grid">
<a class="resource-card" href={guide('dejar-whatsapp-excel-mantenimiento')}><i>01</i><h3>De WhatsApp y Excel a un flujo organizado</h3><p>Cómo mantener la comunicación habitual sin dejar que el registro del trabajo dependa de chats y hojas separadas.</p><small>Leer guía →</small></a>
<a class="resource-card" href={guide('organizar-avisos-mantenimiento')}><i>02</i><h3>Organizar avisos sin perder ninguno</h3><p>Qué información capturar para decidir prioridad, ubicación, equipo afectado y siguiente paso.</p><small>Leer guía →</small></a>
<a class="resource-card" href={guide('orden-trabajo-util')}><i>03</i><h3>Qué debe tener una OT útil</h3><p>Qué información ayuda de verdad al técnico y qué campos solo añaden fricción.</p><small>Leer guía →</small></a>
<a class="resource-card" href={guide('cerrar-ot-historico-util')}><i>04</i><h3>Cerrar una OT para que el histórico sirva</h3><p>Cómo registrar causa, actuación, evidencias y pendientes sin convertir el cierre en una memoria interminable.</p><small>Leer guía →</small></a>
<a class="resource-card" href={guide('organizar-activos-instalaciones')}><i>05</i><h3>Cómo organizar clientes y activos</h3><p>Una estructura simple para separar cliente, ubicación, sistema y equipo sin crear una base inmanejable.</p><small>Leer guía →</small></a>
<a class="resource-card" href={guide('qr-activos-mantenimiento')}><i>06</i><h3>QR en mantenimiento</h3><p>Cuándo merece la pena identificar un activo y qué información debería abrir al escanearlo.</p><small>Leer guía →</small></a>
<a class="resource-card" href={guide('mantenimiento-preventivo-pequena-empresa')}><i>07</i><h3>Preventivo sin hojas paralelas</h3><p>Cómo pasar de un calendario estático a revisiones que generan trabajo y dejan histórico.</p><small>Leer guía →</small></a>
<a class="resource-card" href={guide('piloto-mantenimiento-digital')}><i>08</i><h3>Un piloto digital sin paralizar el negocio</h3><p>Cómo probar con alcance limitado, criterios claros y trabajo real antes de importar o cambiarlo todo.</p><small>Leer guía →</small></a>
</div></div></section>
<section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Principio de producto</span><h2>Antes de digitalizar,<br/><span class="gradient-text">ordena el proceso.</span></h2></div><p>Digitalizar un proceso confuso solo hace que el desorden viaje más rápido. IsiVoltPro parte de estructuras pequeñas que puedan mantenerse en el día a día.</p></div><div class="value-grid"><article class="value-card"><i>▤</i><h3>Activos mínimos</h3><p>Código, ubicación, tipo, marca, modelo, serie, estado y documentación básica para empezar.</p></article><article class="value-card" style="--icon:#6544e8;--icon-bg:#f2efff"><i>✓</i><h3>OT comprensible</h3><p>Cliente, activo, descripción, prioridad, responsable, evidencias y resultado.</p></article><article class="value-card" style="--icon:#159f71;--icon-bg:#eaf9f3"><i>↺</i><h3>Preventivo ejecutable</h3><p>Periodicidades que terminan generando una tarea clara y un registro verificable.</p></article></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="callout"><div><h2>¿Tienes un problema concreto que debería convertirse en guía?</h2><p>Los mejores recursos deben salir de problemas reales de autónomos y pequeñas empresas, no de contenido genérico.</p></div><a class="btn btn--primary" href={contact}>Contarnos el problema →</a></div></div></section>
</main><V3CommercialFooter /></body></html>
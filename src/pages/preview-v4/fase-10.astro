---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const phases = [
  { id:'10A', title:'Imágenes reales', status:'COMPLETADA', copy:'Auditoría pantalla por pantalla. Sustituimos ilustraciones o imágenes poco apropiadas por escenas fotorealistas coherentes con electricidad, climatización, instalaciones, QR/NFC, coordinación técnica y soporte.', result:'Soluciones, Empresa, Sectores, Recursos, Producto, Demo y Blog ya incorporan fotografía contextual distinta. Los artículos públicos de QR y preventivo usan también imágenes V4 específicas.' },
  { id:'10B', title:'Blog + Noticias premium', status:'COMPLETADA', copy:'Fuente, fecha, estado, lectura práctica, imagen propia, presentación editorial consistente y un Radar IsiVoltPro visible dentro del Blog V4.', result:'RSS incluye publicaciones diarias verificadas. Los artículos usan imagen propia en Open Graph/schema, compartir por canal y una presentación editorial coherente.' },
  { id:'10C', title:'Radar IA diario', status:'MOTOR LISTO', copy:'Fuentes oficiales → descubrimiento → borrador asistido por IA → verificación humana → propuesta → PR de contenido → QA. La IA nunca convierte por sí sola una noticia temporal o normativa en contenido público.', result:'10C.1, 10C.2 y 10C.3 completadas. El motor funciona hoy en discovery_only hasta configurar OPENAI_API_KEY como secreto de Actions.' },
  { id:'10D', title:'Redes + compartir + SEO', status:'CONTRATO LISTO', copy:'LinkedIn, Instagram y Facebook con textos específicos, Open Graph, RSS, cola revisable y contrato seguro con proveedores.', result:'10D.1 y 10D.2 completadas. `published` exige aprobación, proveedor listo, idempotencia y receipt real; las cuentas siguen desconectadas hasta disponer de credenciales oficiales.' },
  { id:'10E', title:'Analítica + conversión', status:'10E.1 EN QA', copy:'Medir intención hacia Demo, Planes, Apps, Contacto y Blog sin identificar personas ni activar rastreadores externos.', result:'Contrato local preparado: cinco eventos, cuatro campos permitidos, cero formularios, cookies, storage, query string o referrer. El transporte externo sigue desactivado.' },
  { id:'10F', title:'QA final + publicación V4', status:'PENDIENTE', copy:'Revisión 360/390/430, tablet y escritorio; accesibilidad, velocidad, SEO, enlaces, claims y coherencia visual.', result:'Solo después de este pase se decidirá qué sustituye definitivamente a la web estable.' },
];
---
<!doctype html><html lang="es"><head><V3Seo title="Fase 10 V4 · IsiVoltPro" description="Hoja de ruta visible de la revisión final V4: imágenes reales, Blog y Noticias, Radar IA, redes, analítica y QA." path={`${base}preview-v4/fase-10/`} noindex={true}/><style is:inline>
.hero{padding:76px 0 56px;background:radial-gradient(circle at 82% 8%,rgba(109,74,255,.14),transparent 28%),radial-gradient(circle at 91% 62%,rgba(36,197,140,.09),transparent 22%),#fff}.hero h1{max-width:900px;margin:18px 0;font:800 clamp(48px,6vw,78px)/.98 Manrope,sans-serif;letter-spacing:-.06em}.hero p{max-width:760px;margin:0;color:#6e7a90;font-size:18px;line-height:1.7}.top-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}.phase-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.phase-card{padding:28px;border:1px solid #e4e8f1;border-radius:26px;background:#fff;box-shadow:0 16px 42px rgba(54,64,102,.06)}.phase-top{display:flex;justify-content:space-between;gap:16px;align-items:center}.phase-id{font-size:12px;font-weight:900;letter-spacing:.08em;color:#6752db}.phase-status{padding:6px 9px;border-radius:999px;background:#eef9f5;color:#168965;font-size:9px;font-weight:900;letter-spacing:.06em}.phase-card:nth-child(n+5) .phase-status{background:#f2efff;color:#6544e8}.phase-card h2{margin:15px 0 10px;font-size:28px;letter-spacing:-.035em}.phase-card p{margin:0;color:#748096;line-height:1.65}.result{margin-top:18px;padding:15px;border-radius:16px;background:#f8f9fc;color:#536079;font-size:12px;line-height:1.55}.result strong{color:#1f2c45}.rule{margin-top:42px;padding:30px;border-radius:28px;background:linear-gradient(120deg,#0e1830,#1b2d58 58%,#342676);color:#fff}.rule h2{margin:0 0 10px;font-size:30px}.rule p{margin:0;color:#c9d3e7;line-height:1.65}@media(max-width:760px){.hero{padding:56px 0 44px}.hero h1{font-size:clamp(42px,12.5vw,58px)}.hero p{font-size:16px}.phase-grid{grid-template-columns:1fr}.phase-card{padding:22px}.rule{padding:24px 20px}}
</style></head><body><V3CommercialHeader/><main><section class="hero"><div class="page-shell"><span class="eyebrow">Fase 10 · Entrega paso a paso</span><h1>Hacemos una fase.<br/><span class="gradient-text">La ves. La corregimos. Seguimos.</span></h1><p>Esta pantalla marca el orden real de trabajo de la V4. No damos una fase por terminada solo porque compile: tiene que verse bien, tener sentido comercial y pasar QA en móvil y escritorio.</p><div class="top-actions"><a class="btn btn--primary" href={`${base}preview-v4/home/`}>Revisar Home V4 →</a><a class="btn" href={`${base}preview-v4/blog/`}>Revisar Blog V4</a><a class="btn" href={`${base}preview-v4/social/`}>Ver social 10D.2</a><a class="btn" href={`${base}preview-v4/`}>Volver al laboratorio</a></div></div></section><section class="page-section page-section--soft"><div class="page-shell"><div class="phase-grid">{phases.map((phase)=><article class="phase-card"><div class="phase-top"><span class="phase-id">{phase.id}</span><span class="phase-status">{phase.status}</span></div><h2>{phase.title}</h2><p>{phase.copy}</p><div class="result"><strong>Resultado / checkpoint:</strong> {phase.result}</div></article>)}</div><aside class="rule"><h2>Regla de medición</h2><p>10E.1 solo marca intención de navegación dentro de la Preview V4. No transmite datos, no lee formularios y no crea identificadores. Cualquier transporte analítico futuro requerirá revisión explícita de privacidad y consentimiento antes de activarse.</p></aside></div></section></main><V3CommercialFooter/></body></html>
---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const contact = `${base}contacto/`;
const pilot = `${base}piloto/`;
const appMaintenance = `${base}app-mantenimiento/`;
const solutions = `${base}soluciones/`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Demo · IsiVoltPro" description="Prueba una demo guiada de IsiVoltPro en 60 segundos: aviso, OT, QR, intervención, cierre e histórico con datos ficticios y sin enviar información personal." path={`${base}demo/`} />
  <style is:inline>
    .demo-paths{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.demo-path{padding:27px;border:1px solid var(--line);border-radius:27px;background:#fff;box-shadow:var(--shadow-soft)}.demo-path i{width:46px;height:46px;display:grid;place-items:center;border-radius:15px;background:var(--tone,#eef3ff);color:var(--ink,var(--blue));font-style:normal;font-weight:900}.demo-path h3{margin:19px 0 8px;font-size:22px}.demo-path p{margin:0;color:var(--muted);line-height:1.65}.demo-path small{display:block;margin-top:15px;color:#52617c;font-weight:800}
    .quick-demo{padding:34px;border:1px solid #dfe6f3;border-radius:32px;background:linear-gradient(145deg,#fff 0%,#f8fbff 55%,#f8f5ff 100%);box-shadow:var(--shadow-soft)}.quick-demo__head{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;margin-bottom:26px}.quick-demo__head h2{margin:8px 0 0;font-size:clamp(34px,5vw,58px);line-height:1.02;letter-spacing:-.05em}.quick-demo__head p{max-width:500px;margin:0;color:var(--muted);line-height:1.65}.quick-demo__grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:22px}.quick-demo__steps{display:grid;gap:10px}.quick-step{width:100%;min-height:70px;display:grid;grid-template-columns:42px 1fr;gap:12px;align-items:center;padding:12px 14px;border:1px solid #e2e8f2;border-radius:18px;background:#fff;text-align:left;color:#28344b;cursor:pointer}.quick-step:hover{border-color:#cbd6ea}.quick-step:focus-visible{outline:3px solid rgba(62,103,246,.28);outline-offset:2px}.quick-step[aria-current="step"]{border-color:#9eb3ff;background:#f5f7ff;box-shadow:0 10px 30px rgba(57,82,145,.08)}.quick-step__index{width:42px;height:42px;display:grid;place-items:center;border-radius:14px;background:#eef3ff;color:var(--blue);font-weight:900}.quick-step strong{display:block;font-size:15px}.quick-step small{display:block;margin-top:3px;color:#6e7890}.quick-demo__stage{min-height:450px;padding:24px;border:1px solid #e1e7f1;border-radius:26px;background:#fff;position:relative;overflow:hidden}.quick-demo__stage:before{content:"";position:absolute;width:180px;height:180px;border-radius:50%;background:rgba(106,74,232,.08);right:-50px;top:-55px;filter:blur(2px)}.stage-top{display:flex;justify-content:space-between;gap:16px;align-items:center;position:relative}.stage-badge{display:inline-flex;align-items:center;gap:8px;padding:8px 11px;border-radius:999px;background:#eef9f5;color:#15845f;font-size:12px;font-weight:900}.stage-badge:before{content:"";width:8px;height:8px;border-radius:50%;background:#22b983}.stage-clock{font-size:12px;color:#6f7890;font-weight:800}.stage-card{position:relative;margin-top:28px;padding:24px;border:1px solid #e4eaf3;border-radius:22px;background:linear-gradient(160deg,#fff,#fbfcff)}.stage-kicker{font-size:11px;font-weight:900;letter-spacing:.12em;color:#65738d;text-transform:uppercase}.stage-card h3{margin:9px 0 10px;font-size:clamp(25px,3.5vw,36px);letter-spacing:-.03em}.stage-card p{margin:0;color:var(--muted);line-height:1.65}.stage-meta{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:20px}.stage-meta div{padding:13px;border-radius:15px;background:#f7f9fd}.stage-meta small{display:block;color:#7a8498}.stage-meta strong{display:block;margin-top:4px;font-size:14px}.stage-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.stage-action{min-height:46px;padding:0 16px;border:0;border-radius:14px;background:#17223a;color:#fff;font:inherit;font-weight:900;cursor:pointer}.stage-action--soft{background:#eef3ff;color:#3152c9}.stage-action:focus-visible{outline:3px solid rgba(62,103,246,.28);outline-offset:2px}.stage-progress{height:8px;margin-top:22px;border-radius:999px;background:#edf1f7;overflow:hidden}.stage-progress span{display:block;height:100%;width:var(--progress,16.6%);border-radius:inherit;background:linear-gradient(90deg,#3d69f6,#7451e8,#1fb787);transition:width .35s ease}.stage-note{margin-top:14px;font-size:12px;color:#69758d}.stage-result{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.stage-result div{padding:15px;border:1px solid #e6ebf3;border-radius:16px}.stage-result b{display:block;font-size:22px}.stage-result small{color:#728096}.quick-demo__footer{display:flex;justify-content:space-between;gap:18px;align-items:center;margin-top:20px;padding-top:18px;border-top:1px solid #e4e9f2}.quick-demo__footer p{margin:0;color:#68758d;font-size:13px;line-height:1.55}.quick-demo__footer strong{color:#26334d}
    .demo-board{display:grid;grid-template-columns:.85fr 1.15fr;gap:30px;align-items:start;padding:36px;border:1px solid var(--line);border-radius:30px;background:linear-gradient(145deg,#fff,#f7f9ff)}.demo-board h2{margin:0;font-size:clamp(34px,4.8vw,56px);line-height:1.04;letter-spacing:-.05em}.demo-board p{color:var(--muted);line-height:1.7}.demo-list{display:grid;gap:10px}.demo-list article{display:grid;grid-template-columns:36px 1fr;gap:13px;padding:17px;border:1px solid #e4eaf5;border-radius:18px;background:#fff}.demo-list b{width:34px;height:34px;display:grid;place-items:center;border-radius:11px;background:#eef3ff;color:var(--blue);font-size:11px}.demo-list strong{display:block;margin-bottom:4px}.demo-list small{color:var(--muted);line-height:1.5}.prep-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.prep-card{padding:28px;border:1px solid var(--line);border-radius:27px;background:#fff}.prep-card h3{margin:0 0 15px;font-size:24px}.prep-card ul{margin:0;padding:0;list-style:none;display:grid;gap:11px}.prep-card li{display:grid;grid-template-columns:26px 1fr;gap:10px;color:#52607a;line-height:1.55}.prep-card li span{width:23px;height:23px;display:grid;place-items:center;border-radius:8px;background:#eaf9f3;color:#159f71;font-weight:900}.prep-card--safe{background:linear-gradient(145deg,#fff,#f8f6ff)}.prep-card--safe li span{background:#f2efff;color:#6544e8}.after-demo{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.after-demo article{padding:25px;border:1px solid var(--line);border-radius:24px;background:#fff}.after-demo b{color:var(--blue);font-size:12px}.after-demo h3{margin:16px 0 8px;font-size:20px}.after-demo p{margin:0;color:var(--muted);line-height:1.62}
    @media(max-width:900px){.demo-board,.prep-grid,.quick-demo__grid{grid-template-columns:1fr}.quick-demo__head{align-items:flex-start;flex-direction:column}.demo-paths,.after-demo{grid-template-columns:repeat(2,1fr)}.quick-demo__steps{grid-template-columns:repeat(3,1fr)}.quick-step{grid-template-columns:1fr;text-align:center}.quick-step__index{margin:auto}.quick-step small{display:none}}
    @media(max-width:680px){.quick-demo{padding:22px}.quick-demo__steps{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:4px}.quick-step{min-width:138px;min-height:86px;scroll-snap-align:start}.quick-demo__stage{min-height:500px;padding:19px}.stage-meta,.stage-result{grid-template-columns:1fr}.quick-demo__footer{align-items:flex-start;flex-direction:column}}
    @media(max-width:580px){.demo-paths,.after-demo{grid-template-columns:1fr}.demo-board,.prep-card,.demo-path{padding:22px}}
    @media(prefers-reduced-motion:reduce){.stage-progress span{transition:none}}
  </style>
</head>
<body>
<V3CommercialHeader />
<main class="page-main">
  <section class="page-hero"><div class="page-shell page-hero__grid"><div><span class="eyebrow">Una demo sobre tu problema, no sobre nuestro menú</span><h1>Ver IsiVoltPro tiene que<br/><span class="gradient-text">ayudarte a decidir.</span></h1><p>La demo se plantea alrededor de una situación cotidiana: avisos que se pierden, OT sin seguimiento, preventivos difíciles de controlar, equipos sin histórico o información repartida. No hace falta preparar una implantación para entender si el enfoque encaja.</p><div class="page-hero__actions"><a class="btn btn--primary" href="#demo-60">Probar demo de 60 segundos →</a><a class="btn" href={solutions}>Elegir mi problema</a></div></div><div class="page-hero__visual" aria-hidden="true"><div class="page-orbit"></div><div class="page-core">DEMO<small>TU CASO → UN FLUJO</small></div><div class="page-pill page-pill--a">Problema<small>Qué ocurre hoy</small></div><div class="page-pill page-pill--b">Flujo<small>Cómo se ordena</small></div><div class="page-pill page-pill--c">Móvil<small>Trabajo real</small></div><div class="page-pill page-pill--d">Decisión<small>Encaja o no</small></div></div></div></section>

  <section class="page-section" id="demo-60"><div class="page-shell"><div class="quick-demo" data-quick-demo><div class="quick-demo__head"><div><span class="eyebrow">Prueba IsiVoltPro · 60 segundos</span><h2>De un aviso perdido<br/><span class="gradient-text">a un histórico útil.</span></h2></div><p>Recorre un caso ficticio sin registrarte y sin enviar datos. Cada paso representa una acción real del flujo de mantenimiento que IsiVoltPro quiere ordenar.</p></div><div class="quick-demo__grid"><div class="quick-demo__steps" role="list" aria-label="Pasos de la demo"><button class="quick-step" type="button" data-step="0" aria-current="step"><span class="quick-step__index">01</span><span><strong>Aviso</strong><small>Entra la incidencia</small></span></button><button class="quick-step" type="button" data-step="1"><span class="quick-step__index">02</span><span><strong>OT</strong><small>Se asigna el trabajo</small></span></button><button class="quick-step" type="button" data-step="2"><span class="quick-step__index">03</span><span><strong>QR</strong><small>Se abre el activo</small></span></button><button class="quick-step" type="button" data-step="3"><span class="quick-step__index">04</span><span><strong>Campo</strong><small>Se registra lo hecho</small></span></button><button class="quick-step" type="button" data-step="4"><span class="quick-step__index">05</span><span><strong>Cierre</strong><small>Queda trazabilidad</small></span></button><button class="quick-step" type="button" data-step="5"><span class="quick-step__index">06</span><span><strong>Histórico</strong><small>La próxima OT empieza mejor</small></span></button></div><div class="quick-demo__stage" aria-live="polite"><div class="stage-top"><span class="stage-badge">Datos ficticios</span><span class="stage-clock" data-stage-clock>00:10 / 01:00</span></div><div class="stage-card"><span class="stage-kicker" data-stage-kicker>Nuevo aviso</span><h3 data-stage-title>Aire acondicionado no enfría</h3><p data-stage-copy>Un aviso entra con ubicación, prioridad y una descripción corta. Ya no depende de recordar un mensaje de WhatsApp.</p><div class="stage-meta" data-stage-meta><div><small>Ubicación</small><strong>Oficina 03</strong></div><div><small>Prioridad</small><strong>Media</strong></div><div><small>Estado</small><strong>Nuevo</strong></div></div><div class="stage-result" data-stage-result hidden></div><div class="stage-actions"><button class="stage-action" type="button" data-next-step>Siguiente paso →</button><button class="stage-action stage-action--soft" type="button" data-restart hidden>Repetir demo</button></div><div class="stage-progress" aria-hidden="true"><span data-stage-progress style="--progress:16.6%"></span></div><p class="stage-note" data-stage-note>Paso 1 de 6 · No se guarda ni transmite información.</p></div></div></div><div class="quick-demo__footer"><p><strong>Esto es una demostración conceptual.</strong> La disponibilidad exacta de cada capacidad se valida según el estado real de la plataforma.</p><a class="btn" href={appMaintenance}>Ver App Mantenimiento</a></div></div></div></section>

  <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Tres puntos de partida</span><h2>La misma plataforma.<br/><span class="gradient-text">Demos diferentes.</span></h2></div><p>No tiene sentido enseñar lo mismo a alguien que trabaja solo, a quien coordina varios técnicos y a una empresa que controla sus propias instalaciones.</p></div><div class="demo-paths"><article class="demo-path"><i>👤</i><h3>Autónomo técnico</h3><p>Clientes, equipos, avisos, OT, fotos, preventivos y acceso móvil sin crear administración adicional.</p><small>Prioridad: rapidez y memoria técnica.</small></article><article class="demo-path" style="--tone:#f2efff;--ink:#6544e8"><i>👥</i><h3>Pequeño equipo</h3><p>Asignación, estados, coordinación, documentación compartida y visibilidad de lo que sigue pendiente.</p><small>Prioridad: trabajar con la misma información.</small></article><article class="demo-path" style="--tone:#eaf9f3;--ink:#159f71"><i>🏢</i><h3>Instalaciones propias</h3><p>Activos, incidencias, preventivos, documentación e histórico aunque parte del mantenimiento esté externalizado.</p><small>Prioridad: control y contexto.</small></article></div></div></section>

  <section class="page-section"><div class="page-shell"><div class="demo-board"><div><span class="eyebrow">Qué enseñaremos</span><h2>Un trabajo de principio a fin.</h2><p>La demostración debe permitir entender el hilo completo, no solo pantallas aisladas. La disponibilidad exacta de cada capacidad se confirma según la fase real del producto.</p></div><div class="demo-list"><article><b>01</b><div><strong>Registrar la necesidad</strong><small>Aviso o revisión con cliente, ubicación, activo y prioridad.</small></div></article><article><b>02</b><div><strong>Convertirla en trabajo</strong><small>OT con responsable, estado y contexto disponible para quien actúa.</small></div></article><article><b>03</b><div><strong>Trabajar desde campo</strong><small>Consulta móvil, fotos, notas, documentación y acceso al activo.</small></div></article><article><b>04</b><div><strong>Cerrar con resultado</strong><small>Qué se encontró, qué se hizo y qué queda pendiente.</small></div></article><article><b>05</b><div><strong>Reutilizar el histórico</strong><small>La siguiente intervención empieza con más información que la anterior.</small></div></article><article><b>06</b><div><strong>Ampliar si aporta</strong><small>Preventivo, QR/NFC, inspecciones, inventario o más usuarios cuando tengan sentido.</small></div></article></div></div></div></section>

  <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Cómo prepararla</span><h2>No necesitamos tus datos.<br/><span class="gradient-text">Necesitamos entender el flujo.</span></h2></div><p>En esta fase de preproducción no debes introducir información personal ni datos reales de clientes en la web. Para definir una demo basta con describir el tipo de problema de forma genérica cuando el canal comercial definitivo esté disponible.</p></div><div class="prep-grid"><article class="prep-card"><h3>Lo útil para una futura demo</h3><ul><li><span>✓</span><div>Qué tipo de trabajo haces: mantenimiento, SAT, electricidad, climatización, instalaciones propias…</div></li><li><span>✓</span><div>Dónde se pierde hoy más tiempo o información.</div></li><li><span>✓</span><div>Si trabajas solo o coordinas a más personas.</div></li><li><span>✓</span><div>Qué herramienta utilizas ahora para avisos, activos o preventivo.</div></li></ul></article><article class="prep-card prep-card--safe"><h3>Lo que no debes enviar ahora</h3><ul><li><span>!</span><div>Nombres, teléfonos, correos o datos personales reales a través del formulario desactivado.</div></li><li><span>!</span><div>Listados de clientes, activos o documentación interna antes de definir el tratamiento adecuado.</div></li><li><span>!</span><div>Contraseñas, credenciales, enlaces privados o secretos técnicos.</div></li><li><span>!</span><div>Información sensible solo para “hacer la demo más real”. Usaremos datos ilustrativos.</div></li></ul></article></div></div></section>

  <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Después de verla</span><h2>Tres resultados posibles.<br/><span class="gradient-text">Los tres son válidos.</span></h2></div><p>Una buena demo no necesita acabar siempre en contratación. Debe ayudar a saber cuál es el siguiente paso correcto.</p></div><div class="after-demo"><article><b>01 · NO ENCAJA</b><h3>Parar</h3><p>Si la necesidad principal no corresponde al enfoque de IsiVoltPro o falta una capacidad crítica, lo correcto es no forzar el proceso.</p></article><article><b>02 · HAY DUDAS</b><h3>Acotar</h3><p>Elegir un problema menor o esperar hasta que una integración, condición de privacidad o capacidad necesaria esté validada.</p></article><article><b>03 · ENCAJA</b><h3>Pilotar</h3><p>Definir un flujo pequeño con usuarios y activos representativos para comprobar el valor con trabajo real.</p></article></div><div class="page-hero__actions" style="justify-content:center"><a class="btn btn--primary" href={pilot}>Ver fases del piloto →</a><a class="btn" href={contact}>Estado del canal de contacto</a></div></div></section>
</main>
<V3CommercialFooter />
<script is:inline>
(() => {
  const root = document.querySelector('[data-quick-demo]');
  if (!root) return;
  const steps = [
    { kicker:'Nuevo aviso', title:'Aire acondicionado no enfría', copy:'Un aviso entra con ubicación, prioridad y una descripción corta. Ya no depende de recordar un mensaje de WhatsApp.', meta:[['Ubicación','Oficina 03'],['Prioridad','Media'],['Estado','Nuevo']] },
    { kicker:'Orden de trabajo', title:'OT-0248 · Climatización', copy:'El aviso se convierte en una OT y queda asignado a una persona con el contexto mínimo para empezar.', meta:[['Asignado','Técnico 02'],['Vence','Hoy · 14:00'],['Estado','Asignada']] },
    { kicker:'Acceso por QR', title:'CLIMA-003 · Split oficina', copy:'Al llegar, el técnico abre el activo desde un QR demostrativo y ve modelo, ubicación e intervenciones anteriores.', meta:[['Activo','CLIMA-003'],['Última OT','Hace 4 meses'],['Preventivo','Al día']] },
    { kicker:'Trabajo en campo', title:'Filtro saturado detectado', copy:'La intervención registra qué se encontró, qué se hizo y una nota técnica breve, sin perder el vínculo con el equipo.', meta:[['Acción','Limpieza filtro'],['Tiempo','34 min'],['Resultado','Operativo']] },
    { kicker:'Cierre de OT', title:'OT cerrada con trazabilidad', copy:'La orden queda cerrada con resultado y el activo conserva la intervención para futuras consultas.', meta:[['Estado','Cerrada'],['Pendiente','Ninguno'],['Histórico','Actualizado']] },
    { kicker:'Histórico reutilizable', title:'La próxima intervención empieza mejor', copy:'El siguiente técnico ya no parte de cero: puede consultar qué ocurrió, cuánto tardó y qué solución funcionó.', meta:[['OT del activo','7'],['Último trabajo','Filtro'],['Contexto','Disponible']], result:[['34 min','Tiempo registrado'],['7 OT','Histórico del activo']] }
  ];
  const buttons = [...root.querySelectorAll('[data-step]')];
  const title = root.querySelector('[data-stage-title]');
  const kicker = root.querySelector('[data-stage-kicker]');
  const copy = root.querySelector('[data-stage-copy]');
  const meta = root.querySelector('[data-stage-meta]');
  const result = root.querySelector('[data-stage-result]');
  const clock = root.querySelector('[data-stage-clock]');
  const progress = root.querySelector('[data-stage-progress]');
  const note = root.querySelector('[data-stage-note]');
  const next = root.querySelector('[data-next-step]');
  const restart = root.querySelector('[data-restart]');
  let current = 0;
  const render = (index) => {
    current = index;
    const step = steps[index];
    buttons.forEach((button, i) => i === index ? button.setAttribute('aria-current','step') : button.removeAttribute('aria-current'));
    kicker.textContent = step.kicker;
    title.textContent = step.title;
    copy.textContent = step.copy;
    meta.innerHTML = step.meta.map(([label,value]) => `<div><small>${label}</small><strong>${value}</strong></div>`).join('');
    if (step.result) {
      result.hidden = false;
      result.innerHTML = step.result.map(([value,label]) => `<div><b>${value}</b><small>${label}</small></div>`).join('');
    } else {
      result.hidden = true;
      result.innerHTML = '';
    }
    const seconds = String((index + 1) * 10).padStart(2,'0');
    clock.textContent = `00:${seconds === '60' ? '60' : seconds} / 01:00`;
    progress.style.setProperty('--progress', `${((index + 1) / steps.length) * 100}%`);
    note.textContent = `Paso ${index + 1} de ${steps.length} · No se guarda ni transmite información.`;
    const finished = index === steps.length - 1;
    next.hidden = finished;
    restart.hidden = !finished;
  };
  buttons.forEach((button, index) => button.addEventListener('click', () => render(index)));
  next.addEventListener('click', () => render(Math.min(current + 1, steps.length - 1)));
  restart.addEventListener('click', () => { render(0); buttons[0].focus(); });
  render(0);
})();
</script>
</body>
</html>

---
const base = import.meta.env.BASE_URL;
---
<style is:inline>
  .page-footer{padding:50px 0 28px!important;color:#566176!important;background:#fff!important;border-top:1px solid #eceef4!important}
  .page-footer .brand{color:#11182b!important}.page-footer .brand__icon{background:linear-gradient(145deg,#42c9a0,#4e91ea 36%,#7558e5 68%,#d65cc1)!important;box-shadow:0 7px 18px rgba(92,79,201,.14)!important}
  .page-footer p{color:#7e8899!important;line-height:1.65}.page-footer h4{color:#172036!important}.page-footer a{color:#657086!important}.page-footer a:hover{color:#6255d9!important}
  .page-footer__bottom{margin-top:32px!important;padding-top:18px!important;border-top:1px solid #edf0f5!important;color:#929aa8!important}
  .page-footer__bottom a{display:inline;margin:0;color:#788295!important}.page-footer__bottom a:hover{text-decoration:underline;color:#6255d9!important}
  .page-footer__nav{display:grid;align-content:start}
  :where(a,button,input,select,textarea):focus-visible{outline:3px solid rgba(109,74,255,.24);outline-offset:3px}
</style>
<footer class="page-footer" aria-label="Pie de página">
  <div class="page-shell">
    <div class="page-footer__grid">
      <div><div class="brand"><i class="brand__icon" aria-hidden="true"></i><span>IsiVoltPro</span></div><p>Soluciones y aplicaciones para autónomos, pequeños equipos y empresas de mantenimiento: activos, avisos, OT, preventivos, documentación y trabajo de campo en un solo ecosistema.</p></div>
      <nav class="page-footer__nav" aria-label="Producto"><h4>Producto</h4><a href={`${base}producto/`}>Plataforma</a><a href={`${base}app-mantenimiento/`}>App Mantenimiento</a><a href={`${base}aplicaciones/`}>Módulos</a><a href={`${base}apps-especializadas/`}>Apps especializadas</a><a href={`${base}alcance/`}>Alcance del producto</a><a href={`${base}precios/`}>Precios y planes</a></nav>
      <nav class="page-footer__nav" aria-label="Recursos"><h4>Recursos</h4><a href={`${base}recursos/`}>Guías prácticas</a><a href={`${base}faq/`}>Preguntas frecuentes</a><a href={`${base}seguridad/`}>Seguridad</a><a href={`${base}implantacion/`}>Implantación</a></nav>
      <nav class="page-footer__nav" aria-label="Empresa"><h4>Empresa</h4><a href={`${base}empresa/`}>Quiénes somos</a><a href={`${base}piloto/`}>Piloto y contratación</a><a href={`${base}contacto/`}>Contacto</a><a href={`${base}acceso/`}>Acceder</a></nav>
    </div>
    <div class="page-footer__bottom"><span>IsiVoltPro · Mantenimiento bajo control.</span> · <a href={`${base}privacidad/`}>Privacidad</a> · <a href={`${base}cookies/`}>Cookies</a> · <a href={`${base}aviso-legal/`}>Aviso legal</a></div>
  </div>
</footer>
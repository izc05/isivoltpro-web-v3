---
const base = import.meta.env.BASE_URL;
const videoSrc = `${base}video/hero-home-calidad-original.mp4`;
---
<section class="hero-v3" data-hero aria-labelledby="hero-title">
  <video
    class="hero-v3__video"
    data-hero-video
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
    style="object-position:56% center;filter:saturate(1) contrast(1.02) brightness(.94);transform:none"
  >
    <source src={videoSrc} type="video/mp4" />
  </video>

  <div
    class="hero-v3__ambient"
    aria-hidden="true"
    style="background:radial-gradient(circle at 76% 46%,rgba(49,112,255,.07),transparent 34%),linear-gradient(180deg,rgba(3,7,12,.05),transparent 38%,rgba(3,7,12,.10))"
  ></div>
  <div
    class="hero-v3__shade"
    aria-hidden="true"
    style="background:linear-gradient(90deg,rgba(2,6,10,.90) 0%,rgba(2,6,10,.78) 25%,rgba(2,6,10,.42) 47%,rgba(2,6,10,.10) 70%,rgba(2,6,10,.08) 100%),linear-gradient(180deg,rgba(2,6,10,.18) 0%,transparent 25%,transparent 78%,rgba(2,6,10,.26) 100%)"
  ></div>

  <header class="hero-v3__header shell">
    <a class="hero-v3__brand" href={base} aria-label="IsiVoltPro">
      <span class="hero-v3__mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>ISIVOLT<span>PRO</span></span>
    </a>

    <nav class="hero-v3__nav" aria-label="Navegación principal">
      <a href={`${base}ecosistema/`}>Ecosistema</a>
      <a href={`${base}aplicaciones/`}>Aplicaciones</a>
      <a href={`${base}mantenimiento/`}>Mantenimiento</a>
      <a href={`${base}recursos/`}>Recursos</a>
      <a href={`${base}empresa/`}>Empresa</a>
    </nav>

    <a class="hero-v3__demo" href={`${base}contacto/`}>Solicitar demo <span>↗</span></a>
  </header>

  <div class="hero-v3__content shell">
    <div class="hero-v3__copy">
      <p class="hero-v3__eyebrow">CONTROL TOTAL · RENDIMIENTO REAL</p>
      <h2 id="hero-title">Toda tu instalación.<span>Un solo sistema.</span></h2>
      <p class="hero-v3__lead">
        Supervisa activos, mantenimiento, órdenes de trabajo y recursos técnicos desde una única plataforma conectada.
      </p>

      <div class="hero-v3__actions">
        <a class="hero-v3__primary" href="#plataforma">Explorar plataforma <span>→</span></a>
        <a class="hero-v3__secondary" href={`${base}contacto/`}>Solicitar demo <span>↗</span></a>
      </div>

      <div class="hero-v3__trust" aria-label="Ventajas clave">
        <span><i></i>Operación conectada</span>
        <span><i></i>Trazabilidad completa</span>
        <span><i></i>Histórico técnico único</span>
      </div>
    </div>
  </div>

  <div class="hero-v3__scroll" aria-hidden="true"><span>DESCUBRIR</span><i></i></div>
</section>

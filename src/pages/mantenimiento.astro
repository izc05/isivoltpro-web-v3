---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';

const base = import.meta.env.BASE_URL;
const preventive = `${base}modulos/mantenimiento-preventivo/`;
const modules = `${base}aplicaciones/`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo
    title="Mantenimiento · IsiVoltPro"
    description="Acceso de compatibilidad a la nueva sección de mantenimiento preventivo de IsiVoltPro."
    path={`${base}mantenimiento/`}
    noindex={true}
  />
</head>
<body>
  <V3CommercialHeader />
  <main class="page-main">
    <section class="page-hero" style="min-height:72svh;display:grid;align-items:center">
      <div class="page-shell page-hero__grid">
        <div>
          <span class="eyebrow">Ruta actualizada</span>
          <h1>El mantenimiento ahora vive<br /><span class="gradient-text">dentro del producto.</span></h1>
          <p>Hemos reorganizado la Web V3 para explicar cada problema de forma más clara. La información sobre planificación, revisiones periódicas e histórico está ahora en el módulo de Mantenimiento preventivo.</p>
          <div class="page-hero__actions">
            <a class="btn btn--primary" href={preventive}>Ver Mantenimiento preventivo →</a>
            <a class="btn" href={modules}>Explorar módulos</a>
          </div>
        </div>
        <div class="page-hero__visual" aria-hidden="true">
          <div class="page-orbit"></div>
          <div class="page-core">⚙<small>MANTENIMIENTO</small></div>
          <div class="page-pill page-pill--a">Planificar<small>Qué toca y cuándo</small></div>
          <div class="page-pill page-pill--b">Ejecutar<small>Trabajo visible</small></div>
          <div class="page-pill page-pill--c">Registrar<small>Resultado y evidencias</small></div>
          <div class="page-pill page-pill--d">Histórico<small>Preparado para después</small></div>
        </div>
      </div>
    </section>
  </main>
  <V3CommercialFooter />
</body>
</html>

---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const demo = `${base}demo/`;
const pilot = `${base}piloto/`;
const security = `${base}seguridad/`;
const email = 'isivoltpro@gmail.com';
const mailto = `mailto:${email}?subject=${encodeURIComponent('Consulta sobre IsiVoltPro')}`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Contacto · IsiVoltPro" description="Contacta directamente con IsiVoltPro para solicitar información, una demostración o valorar un piloto de mantenimiento." path={`${base}contacto/`} />
  <style is:inline>
    .contact-board{min-height:100svh;background:radial-gradient(circle at 16% 66%,rgba(65,199,153,.09),transparent 26%),radial-gradient(circle at 62% 20%,rgba(109,88,225,.11),transparent 25%),#fff}.contact-main{padding:74px 0 90px}.contact-layout{display:grid;grid-template-columns:.88fr 1.12fr;gap:70px;align-items:center}.contact-kicker{display:inline-flex;padding:8px 12px;border:1px solid #e6eaf2;border-radius:999px;color:#68748a;font-size:11px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.contact-left h1{margin:17px 0 20px;font:800 clamp(46px,5vw,70px)/.98 var(--v3-font-display,system-ui);letter-spacing:-.064em}.contact-left h1 span{display:block;color:transparent;background:linear-gradient(90deg,#6658de,#49a9d1 52%,#35bd8e);-webkit-background-clip:text;background-clip:text}.contact-left>p{max-width:520px;margin:0;color:#68748a;font-size:16px;line-height:1.72}.contact-methods{display:grid;gap:12px;margin:28px 0}.contact-method{display:grid;grid-template-columns:42px 1fr;gap:13px;align-items:center;padding:12px 14px;border:1px solid #e8ebf2;border-radius:15px;background:rgba(255,255,255,.8)}.contact-method i{width:42px;height:42px;display:grid;place-items:center;border-radius:13px;background:#f0edff;color:#6654d8;font-style:normal}.contact-method:nth-child(2) i{background:#e9f9f2;color:#159f71}.contact-method:nth-child(3) i{background:#edf7fb;color:#238fae}.contact-method strong{display:block;font-size:13px}.contact-method small{display:block;margin-top:4px;color:#7c8799;font-size:12px;line-height:1.45}.contact-links{display:flex;gap:10px;flex-wrap:wrap}.contact-links .btn{min-height:46px}.contact-card{position:relative;padding:34px;border:1px solid #e2e7f0;border-radius:30px;background:rgba(255,255,255,.94);box-shadow:0 34px 90px rgba(52,61,101,.16)}.contact-photo{margin:-18px -18px 26px;overflow:hidden;border-radius:22px}.contact-photo img{display:block;width:100%;height:280px;object-fit:cover}.contact-state{display:inline-flex;padding:7px 10px;border-radius:999px;background:#eaf9f3;color:#168965;font-size:11px;font-weight:850}.contact-card h2{margin:16px 0 8px;font-size:clamp(28px,3vw,40px);letter-spacing:-.04em}.contact-owner{margin:0;color:#4e5a70;font-size:15px;font-weight:750}.contact-email{display:block;margin:20px 0 6px;color:#17213b;font-size:clamp(20px,2.5vw,30px);font-weight:850;letter-spacing:-.03em;text-decoration:none;overflow-wrap:anywhere}.contact-email:hover{text-decoration:underline}.contact-note{margin:0 0 22px;color:#748096;font-size:13px;line-height:1.55}.contact-card .btn{width:100%;min-height:50px;background:#111827;border-color:#111827;color:#fff}.privacy-note{display:flex;gap:9px;margin-top:15px;color:#748096;font-size:12px;line-height:1.5}.privacy-note i{font-style:normal}.contact-glow{position:absolute;z-index:-1;inset:8% -8%;border-radius:48px;background:linear-gradient(135deg,rgba(78,104,235,.17),rgba(117,82,225,.12),rgba(51,190,145,.12));filter:blur(32px)}@media(max-width:900px){.contact-layout{grid-template-columns:1fr;gap:42px}.contact-left{max-width:680px}.contact-card{max-width:720px}}@media(max-width:560px){.contact-main{padding:52px 0 68px}.contact-left h1{font-size:clamp(43px,12vw,56px)}.contact-left>p{font-size:15px}.contact-links{flex-direction:column}.contact-links .btn{width:100%}.contact-card{padding:22px;border-radius:23px}.contact-photo{margin:-10px -10px 22px}.contact-photo img{height:220px}}
  </style>
</head>
<body class="contact-board">
  <V3CommercialHeader />
  <main class="contact-main"><div class="page-shell contact-layout">
    <section class="contact-left"><span class="contact-kicker">Contacto directo</span><h1>Hablemos de<span>tu proyecto.</span></h1><p>Cuéntanos qué quieres organizar mejor: avisos, órdenes de trabajo, activos, preventivos o documentación. Puedes conocer primero el producto y escribirnos cuando quieras, sin formularios que almacenen tus datos.</p><div class="contact-methods"><div class="contact-method"><i aria-hidden="true">▣</i><div><strong>Demo del producto</strong><small>Recorre el flujo con información ficticia y sin registro.</small></div></div><div class="contact-method"><i aria-hidden="true">✓</i><div><strong>Piloto acotado</strong><small>Valida un problema concreto con alcance y objetivos claros.</small></div></div><div class="contact-method"><i aria-hidden="true">◇</i><div><strong>Contacto transparente</strong><small>Tu mensaje se envía desde tu propia aplicación de correo.</small></div></div></div><div class="contact-links"><a class="btn btn--primary" href={demo}>Ver demo</a><a class="btn" href={pilot}>Ver piloto</a><a class="btn" href={security}>Seguridad</a></div></section>
    <section class="contact-card" aria-labelledby="contact-title"><div class="contact-glow" aria-hidden="true"></div><figure class="contact-photo"><img src={`${base}media/v4/solutions-team-tablet-v2.webp`} alt="Profesionales de mantenimiento revisando una intervención en una tablet" width="1400" height="1050" loading="eager" decoding="async" /></figure><span class="contact-state">● Canal de correo activo</span><h2 id="contact-title">Escríbenos directamente</h2><p class="contact-owner">Atención: Isicio Zafra Cantos</p><a class="contact-email" href={mailto}>{email}</a><p class="contact-note">Indica brevemente tu actividad, el tamaño del equipo y qué proceso de mantenimiento quieres mejorar.</p><a class="btn btn--primary" href={mailto}>Escribir por correo →</a><p class="privacy-note"><i aria-hidden="true">🔒</i><span>Se abrirá tu aplicación de correo. Esta web no recoge, envía ni almacena los datos del mensaje.</span></p></section>
  </div></main>
  <V3CommercialFooter />
</body>
</html>

---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
const base=import.meta.env.BASE_URL;
const demo=`${base}preview-v4/demo/`,product=`${base}preview-v4/producto/`,solutions=`${base}preview-v4/soluciones/`,resources=`${base}preview-v4/recursos/`,photo=`${base}media/v4/app-qr-mobile.webp`;
---
<!doctype html><html lang="es"><head><V3Seo title="Preview V4 · Apps · IsiVoltPro" description="Vista previa no indexada de Apps V4: App Mantenimiento, QR/NFC, trabajo de campo y evolución del ecosistema IsiVoltPro." path={`${base}preview-v4/apps/`} noindex={true}/><style is:inline>
.ahero{padding:84px 0 68px;background:radial-gradient(circle at 80% 12%,rgba(109,74,255,.12),transparent 28%),radial-gradient(circle at 94% 61%,rgba(36,197,140,.09),transparent 22%),#fff}.agrid{display:grid;grid-template-columns:minmax(0,.95fr) minmax(440px,1.05fr);gap:56px;align-items:center}.ahero h1{margin:18px 0 19px;font:800 clamp(52px,5.8vw,80px)/.98 Manrope,sans-serif;letter-spacing:-.062em}.ahero p{max-width:680px;margin:0;color:#68748a;font-size:18px;line-height:1.72}.acts{display:flex;gap:11px;flex-wrap:wrap;margin-top:28px}.photo{position:relative;overflow:hidden;border-radius:32px;background:#eef2f7;box-shadow:0 30px 80px rgba(42,58,98,.15)}.photo img{display:block;width:100%;height:460px;object-fit:cover}.photo:after{content:'';position:absolute;inset:auto 0 0;height:42%;background:linear-gradient(transparent,rgba(11,20,48,.76))}.caption{position:absolute;z-index:2;left:20px;right:20px;bottom:18px;color:#fff}.caption small{display:block;color:#dbe4f5;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.caption strong{display:block;margin-top:5px;font-size:20px}.appcard{display:grid;grid-template-columns:.86fr 1.14fr;gap:30px;align-items:center;padding:34px;border:1px solid #e6e9f1;border-radius:32px;background:linear-gradient(145deg,#fff,#fafbff);box-shadow:0 20px 55px rgba(54,64,102,.08)}.appcopy h2{margin:13px 0 13px;font:800 clamp(38px,4.6vw,60px)/1.03 Manrope,sans-serif;letter-spacing:-.052em}.appcopy p{margin:0;color:#6f7b91;line-height:1.7}.phonewrap{display:grid;place-items:center;padding:20px;background:radial-gradient(circle at 50% 35%,rgba(109,74,255,.15),transparent 40%)}.phone{width:min(320px,100%);padding:12px;border-radius:37px;background:#101827;box-shadow:0 30px 70px rgba(17,24,39,.22)}.screen{min-height:520px;padding:18px;border-radius:28px;background:linear-gradient(180deg,#fafbff,#f2f5fb);overflow:hidden}.screenbar{display:flex;align-items:center;justify-content:space-between;font-size:10px;color:#66738a}.screenbar b{color:#182238}.greeting{margin:22px 0 14px}.greeting small{color:#8b96aa;font-size:9px}.greeting strong{display:block;margin-top:4px;font-size:21px}.quick{display:grid;grid-template-columns:1fr 1fr;gap:9px}.quick div{padding:13px;border-radius:15px;background:#fff;border:1px solid #e8ebf2}.quick small{display:block;color:#8994a8;font-size:8px}.quick b{display:block;margin-top:5px;font-size:19px}.task{margin-top:12px;padding:14px;border-radius:16px;background:#fff;border:1px solid #e8ebf2}.task small{color:#8a95a8;font-size:8px}.task strong{display:block;margin:5px 0 8px;font-size:13px}.tag{display:inline-flex;padding:5px 7px;border-radius:999px;background:#ecfaf5;color:#168965;font-size:8px;font-weight:900}.scan{margin-top:14px;padding:17px;border-radius:17px;background:linear-gradient(125deg,#141f3e,#2b2876);color:#fff}.scan b{display:block;font-size:13px}.scan small{display:block;margin-top:5px;color:#c9d3eb;line-height:1.45}.flow{display:grid;grid-template-columns:repeat(5,1fr);gap:11px}.flow article{position:relative;padding:22px 17px;border:1px solid #e7eaf2;border-radius:21px;background:#fff}.flow article:not(:last-child):after{content:'→';position:absolute;right:-13px;top:50%;z-index:2;width:26px;height:26px;display:grid;place-items:center;border:1px solid #e4e8f1;border-radius:50%;background:#fff;color:#8290a8;transform:translateY(-50%)}.flow b{color:#5e5bd9;font-size:10px}.flow strong{display:block;margin-top:13px;font-size:16px}.flow small{display:block;margin-top:6px;color:#788499;line-height:1.5}.caps{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.cap{padding:23px;border:1px solid #e7eaf2;border-radius:22px;background:#fff}.cap i{width:42px;height:42px;display:grid;place-items:center;border-radius:13px;background:#eef3ff;color:#536adb;font-style:normal;font-weight:900}.cap h3{margin:16px 0 7px;font-size:18px}.cap p{margin:0;color:#748096;font-size:13px;line-height:1.55}.eco{display:grid;grid-template-columns:.9fr 1.1fr;gap:28px;align-items:stretch}.ecopy{padding:38px;border-radius:30px;background:linear-gradient(130deg,#0c1531,#182957 60%,#30266f);color:#fff}.ecopy h2{margin:13px 0 14px;font:800 clamp(38px,4.7vw,60px)/1.03 Manrope,sans-serif;letter-spacing:-.052em}.ecopy p{margin:0;color:#c5d0e7;line-height:1.7}.elist{display:grid;gap:12px}.elist article{padding:20px 22px;border:1px solid #e7eaf2;border-radius:21px;background:#fff}.elist strong{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:17px}.elist em{padding:5px 7px;border-radius:999px;background:#f2efff;color:#6553dc;font-size:8px;font-style:normal;font-weight:900}.elist p{margin:6px 0 0;color:#748096;font-size:13px;line-height:1.5}.cta{padding:42px;border-radius:32px;background:linear-gradient(115deg,#f1f7ff,#f2efff 48%,#eefaf6);display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center}.cta h2{margin:0;font:800 clamp(34px,4.2vw,54px)/1.03 Manrope,sans-serif;letter-spacing:-.05em}.cta p{margin:12px 0 0;color:#69758b;line-height:1.65}@media(max-width:980px){.agrid,.appcard,.eco{grid-template-columns:1fr}.photo{max-width:760px}.flow,.caps{grid-template-columns:repeat(2,1fr)}.flow article:after{display:none}}@media(max-width:650px){.ahero{padding:60px 0 48px}.ahero h1{font-size:clamp(44px,13vw,64px)}.photo img{height:330px}.appcard{padding:24px 20px}.screen{min-height:470px}.flow,.caps{grid-template-columns:1fr}.ecopy,.cta{padding:28px 22px}.cta{grid-template-columns:1fr}}
</style></head><body><V3CommercialHeader/><main class="page-main">
<section class="ahero"><div class="page-shell agrid"><div><span class="eyebrow">App Mantenimiento · trabajo de campo</span><h1>El mantenimiento también ocurre<br/><span class="gradient-text">lejos del escritorio.</span></h1><p>La App Mantenimiento acerca el activo, la orden de trabajo y el histórico al lugar donde ocurre la intervención. El objetivo es que el técnico pueda identificar, actuar, documentar y cerrar sin reconstruir después lo que pasó.</p><div class="acts"><a class="btn btn--primary" href={demo}>Solicitar demo →</a><a class="btn" href={product}>Ver plataforma</a></div></div><figure class="photo"><img src={photo} alt="Técnico de mantenimiento escaneando con el móvil la identificación de un equipo" width="700" height="525" loading="eager"/><figcaption class="caption"><small>QR / NFC + móvil</small><strong>El contexto del activo, justo donde se trabaja.</strong></figcaption></figure></div></section>
<section class="page-section"><div class="page-shell"><div class="appcard"><div class="appcopy"><span class="eyebrow">Una app centrada en la intervención</span><h2>Lo importante de hoy,<br/>a mano.</h2><p>La pantalla móvil debe priorizar tareas, ubicación, activo, estado y evidencias. Menos navegación innecesaria y más información útil en el momento de intervenir.</p><div class="acts"><a class="btn" href={solutions}>Ver problemas que resuelve →</a></div></div><div class="phonewrap"><div class="phone" aria-label="Vista conceptual móvil con datos ficticios"><div class="screen"><div class="screenbar"><b>IsiVoltPro</b><span>09:42</span></div><div class="greeting"><small>DATOS DE EJEMPLO · HOY</small><strong>Mis trabajos</strong></div><div class="quick"><div><small>Asignadas</small><b>4</b></div><div><small>En curso</small><b>1</b></div></div><div class="task"><small>OT-0184 · CLIMATIZACIÓN</small><strong>UTA-02 · Temperatura alta</strong><span class="tag">En curso</span></div><div class="task"><small>PR-0021 · PREVENTIVO</small><strong>Bomba ACS-01 · Revisión</strong><span class="tag">Para hoy</span></div><div class="scan"><b>Escanear QR / NFC</b><small>Identifica el activo y abre su contexto operativo.</small></div></div></div></div></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Un recorrido pensado para campo</span><h2>Escanea. Identifica. Actúa.<br/><span class="gradient-text">Deja evidencia.</span></h2></div><p>La aplicación debe reducir pasos y mantener el vínculo entre el activo real y la información digital.</p></div><div class="flow"><article><b>01</b><strong>Escanea</strong><small>QR/NFC o búsqueda rápida.</small></article><article><b>02</b><strong>Identifica</strong><small>Activo, ubicación e histórico.</small></article><article><b>03</b><strong>Actúa</strong><small>OT, prioridad y tarea visible.</small></article><article><b>04</b><strong>Documenta</strong><small>Notas, fotos y resultado.</small></article><article><b>05</b><strong>Cierra</strong><small>El trabajo alimenta el histórico.</small></article></div></div></section>
<section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Capacidades que comparten contexto</span><h2>La app no vive aislada<br/><span class="gradient-text">de la plataforma.</span></h2></div><p>El valor aparece cuando móvil, activos, OT y preventivos consultan y alimentan la misma información.</p></div><div class="caps"><article class="cap"><i>▣</i><h3>Activos</h3><p>Ficha, ubicación, documentos e histórico accesibles desde el terreno.</p></article><article class="cap"><i>✓</i><h3>Órdenes de trabajo</h3><p>Responsable, estado, evidencias y cierre en el mismo flujo.</p></article><article class="cap"><i>⌁</i><h3>QR / NFC</h3><p>Una entrada física directa al contexto digital del equipo.</p></article><article class="cap"><i>⚙</i><h3>Preventivo</h3><p>Tareas programadas visibles junto al resto del trabajo del técnico.</p></article></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell eco"><div class="ecopy"><span class="eyebrow">Ecosistema progresivo</span><h2>Una base común.<br/>Apps especializadas cuando aporten valor.</h2><p>La V4 debe distinguir con claridad qué forma parte del producto actual y qué pertenece a la evolución prevista. Nada se presentará como disponible antes de estar realmente listo.</p><div class="acts"><a class="btn btn--primary" href={resources}>Ver recursos →</a></div></div><div class="elist"><article><strong>App Mantenimiento <em>Núcleo V4</em></strong><p>Activos, avisos, OT, preventivo, evidencias y trabajo móvil.</p></article><article><strong>Eléctricas <em>Evolución</em></strong><p>Flujos técnicos especializados que podrán aprovechar la misma base operativa.</p></article><article><strong>RITE / PCI / Legionella <em>Evolución</em></strong><p>Áreas especializadas previstas como extensiones, no como funciones simuladas en la web pública.</p></article></div></div></section>
<section class="page-section"><div class="page-shell"><div class="cta"><div><h2>¿Quieres ver cómo encaja la app en tu forma de trabajar?</h2><p>La demo parte de tus activos, técnicos y flujo actual para enseñar solo lo que tenga sentido.</p></div><div class="acts" style="margin-top:0"><a class="btn btn--primary" href={demo}>Solicitar demo →</a><a class="btn" href={solutions}>Ver soluciones</a></div></div></div></section>
</main><V3CommercialFooter/></body></html>
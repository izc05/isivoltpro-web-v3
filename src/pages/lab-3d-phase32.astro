---
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#02050a" />
    <meta name="description" content="ISIVOLTPRO phase 3.2 physical detail and material pass for the Core V1." />
    <title>ISIVOLTPRO · Phase 3.2 Core Detail</title>
  </head>
  <body>
    <iframe id="core-base" src={`${base}lab-3d-phase31/`} title="IsiVoltPro Core 3.1 base" aria-hidden="true"></iframe>
    <canvas id="detail-webgl" aria-hidden="true"></canvas>

    <header class="topbar">
      <a class="brand" href={base}>ISIVOLT<strong>PRO</strong></a>
      <span class="phase">FASE 3.2 / CORE DETAIL & MATERIALS</span>
      <a class="back" href={`${base}lab-3d-phase31/`}>CORE 3.1</a>
    </header>

    <aside class="metrics" aria-live="polite">
      <div><span>MECHANICAL</span><strong id="pipe-status">LOADING</strong></div>
      <div><span>HVAC</span><strong id="hvac-status">LOADING</strong></div>
      <div><span>HVAC UNIT</span><strong id="aircon-status">LOADING</strong></div>
      <div><span>ELECTRICAL</span><strong id="electrical-status">LOADING</strong></div>
      <div><span>CORE</span><strong>V2</strong></div>
      <div><span>DETAIL</span><strong>ASSEMBLED</strong></div>
      <div><span>BASE FPS</span><strong id="base-fps">--</strong></div>
      <div><span>DETAIL CALLS</span><strong id="detail-calls">--</strong></div>
      <div><span>DETAIL TRIS</span><strong id="detail-tris">--</strong></div>
    </aside>

    <main id="story">
      <section class="chapter active"><div class="copy">
        <p class="eyebrow">ISIVOLTPRO CORE / DETAIL PASS</p>
        <h1>Built to be<br />serviced.</h1>
        <p class="body-copy">Phase 3.2 keeps the Core V1 architecture and adds the details that make it read as assembled equipment: access, fastening, isolation, sealing and thermal management.</p>
        <span class="scroll-hint">INSPECT THE ASSEMBLY <i>↓</i></span>
      </div></section>

      <section class="chapter"><div class="copy right-copy">
        <p class="index">02 / ACCESS</p><p class="eyebrow">PANELS · FASTENERS · ISOLATION</p>
        <h2>Designed to<br />come apart.</h2>
        <p class="body-copy">Service panels, latches, base fixings and anti-vibration feet give the Core a maintainable industrial construction instead of a single uninterrupted shell.</p>
      </div></section>

      <section class="chapter"><div class="copy">
        <p class="index">03 / CONTAINMENT</p><p class="eyebrow">GLASS · GASKETS · RETAINERS</p>
        <h2>Glass is mounted.<br />Not floating.</h2>
        <p class="body-copy">Rubber seals and metal retaining rings define where the technical glass chamber physically meets the structural assembly.</p>
      </div></section>

      <section class="chapter"><div class="copy right-copy">
        <p class="index">04 / THERMAL</p><p class="eyebrow">VENTS · CROWN · AIRFLOW</p>
        <h2>Heat has<br />somewhere to go.</h2>
        <p class="body-copy">A restrained ventilation band in the service crown suggests thermal management without turning the Core into a glowing science-fiction prop.</p>
      </div></section>

      <section class="chapter"><div class="copy">
        <p class="index">05 / STATUS</p><p class="eyebrow">PORTS · LEDS · SERVICE</p>
        <h2>State without<br />spectacle.</h2>
        <p class="body-copy">Port collars, small status indicators and service markers communicate operation at equipment scale. The energy chamber remains the only dominant light source.</p>
      </div></section>

      <section class="chapter"><div class="copy end-copy">
        <p class="index">06 / CHECKPOINT</p><p class="eyebrow">CORE V2</p>
        <h2>More machine.<br />Less demo.</h2>
        <p class="body-copy">The architecture is unchanged; the construction now has joints, access and physical logic. Phase 3.3 can focus on final system integration and state language.</p>
        <a class="lab-button" href={`${base}lab-3d-phase31/`}>COMPARE WITH CORE 3.1 <span>→</span></a>
      </div></section>
    </main>

    <script>
      import * as THREE from 'three';

      const frame = document.querySelector('#core-base');
      const canvas = document.querySelector('#detail-webgl');
      const baseFps = document.querySelector('#base-fps');
      const callsEl = document.querySelector('#detail-calls');
      const trisEl = document.querySelector('#detail-tris');
      const statusIds = ['pipe', 'hvac', 'aircon', 'electrical'];

      let frameReady = false;
      if (frame instanceof HTMLIFrameElement) {
        frame.addEventListener('load', () => {
          try {
            const doc = frame.contentDocument;
            if (!doc) return;
            const style = doc.createElement('style');
            style.textContent = `
              html { scrollbar-width: none !important; }
              html::-webkit-scrollbar, body::-webkit-scrollbar { display: none !important; }
              .topbar, .metrics { visibility: hidden !important; }
              #story { opacity: 0 !important; pointer-events: none !important; }
              body::after { display: none !important; }
            `;
            doc.head.appendChild(style);
            frameReady = true;
          } catch (error) {
            console.error('Phase 3.2 base frame setup failed', error);
          }
        });
      }

      function syncBase(progress: number) {
        if (!(frame instanceof HTMLIFrameElement) || !frameReady) return;
        try {
          const win = frame.contentWindow;
          const doc = frame.contentDocument;
          if (!win || !doc) return;
          const maxScroll = Math.max(0, doc.documentElement.scrollHeight - frame.clientHeight);
          win.scrollTo(0, progress * maxScroll);
          statusIds.forEach((id) => {
            const source = doc.querySelector(`#${id}-status`);
            const target = document.querySelector(`#${id}-status`);
            if (source && target) target.textContent = source.textContent || 'LOADING';
          });
          const sourceFps = doc.querySelector('#fps');
          if (sourceFps && baseFps) baseFps.textContent = sourceFps.textContent || '--';
        } catch (error) {
          console.error('Phase 3.2 base sync failed', error);
          frameReady = false;
        }
      }

      const supportsWebGL = (() => {
        try {
          const test = document.createElement('canvas');
          return Boolean(test.getContext('webgl2') || test.getContext('webgl'));
        } catch { return false; }
      })();

      if (supportsWebGL && canvas instanceof HTMLCanvasElement) {
        const mobile = window.matchMedia('(max-width: 760px)').matches;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false, powerPreference: 'high-performance', stencil: false });
        renderer.setClearColor(0x000000, 0);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, mobile ? 1.0 : 1.3));
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 0.95;
        renderer.shadowMap.enabled = false;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(40, window.innerWidth / window.innerHeight, 0.1, 160);
        camera.position.set(-16, 8, 19);

        const corePaint = new THREE.MeshPhysicalMaterial({ color: 0x11191f, metalness: 0.88, roughness: 0.27, clearcoat: 0.34, clearcoatRoughness: 0.31 });
        const brushed = new THREE.MeshStandardMaterial({ color: 0x36434a, metalness: 0.93, roughness: 0.28 });
        const fastener = new THREE.MeshStandardMaterial({ color: 0x8b969b, metalness: 0.96, roughness: 0.2 });
        const rubber = new THREE.MeshStandardMaterial({ color: 0x05080a, metalness: 0.04, roughness: 0.88 });
        const vent = new THREE.MeshStandardMaterial({ color: 0x080d10, metalness: 0.64, roughness: 0.54 });
        const statusCyan = new THREE.MeshStandardMaterial({ color: 0x06323b, emissive: 0x00c8e8, emissiveIntensity: 1.15, metalness: 0.42, roughness: 0.34 });
        const statusAmber = new THREE.MeshStandardMaterial({ color: 0x3e2b08, emissive: 0xffa629, emissiveIntensity: 0.8, metalness: 0.4, roughness: 0.38 });
        const depthOnly = new THREE.MeshBasicMaterial({ colorWrite: false, depthWrite: true, depthTest: true });

        const detail = new THREE.Group();
        detail.position.set(0, 0.14, 0.2);
        scene.add(detail);

        // Depth masks matching the solid Core V1 parts. They make rear assembly details
        // disappear behind the original Core while leaving the iframe itself untouched.
        const maskFoot = new THREE.Mesh(new THREE.CylinderGeometry(2.45, 2.7, 0.22, 8), depthOnly); maskFoot.position.y = 0.11; detail.add(maskFoot);
        const maskRing = new THREE.Mesh(new THREE.CylinderGeometry(2.2, 2.38, 0.36, 8), depthOnly); maskRing.position.y = 0.4; detail.add(maskRing);
        const maskDeck = new THREE.Mesh(new THREE.CylinderGeometry(1.92, 2.08, 0.18, 8), depthOnly); maskDeck.position.y = 0.67; detail.add(maskDeck);
        const maskCrownBase = new THREE.Mesh(new THREE.CylinderGeometry(1.55, 1.72, 0.32, 8), depthOnly); maskCrownBase.position.y = 4.88; detail.add(maskCrownBase);
        const maskCrownCap = new THREE.Mesh(new THREE.CylinderGeometry(1.18, 1.48, 0.42, 8), depthOnly); maskCrownCap.position.y = 5.2; detail.add(maskCrownCap);
        const maskPylons = new THREE.InstancedMesh(new THREE.BoxGeometry(0.28, 4.35, 0.42), depthOnly, 4);
        const matrix = new THREE.Matrix4();
        const pylonSpecs: Array<[number, number, number, number]> = [
          [-1.27, 2.75, -1.27, Math.PI / 4], [1.27, 2.75, -1.27, -Math.PI / 4],
          [1.27, 2.75, 1.27, Math.PI / 4], [-1.27, 2.75, 1.27, -Math.PI / 4],
        ];
        pylonSpecs.forEach(([x, y, z, ry], index) => {
          matrix.compose(new THREE.Vector3(x, y, z), new THREE.Quaternion().setFromEuler(new THREE.Euler(0, ry, 0)), new THREE.Vector3(1, 1, 1));
          maskPylons.setMatrixAt(index, matrix);
        });
        detail.add(maskPylons);

        // Chamber mounting: visible gasket and retaining rings at both glass interfaces.
        [1.08, 4.48].forEach((y) => {
          const gasket = new THREE.Mesh(new THREE.TorusGeometry(0.965, 0.042, 8, 48), rubber);
          gasket.rotation.x = Math.PI / 2; gasket.position.y = y; detail.add(gasket);
          const retainer = new THREE.Mesh(new THREE.TorusGeometry(1.035, 0.027, 8, 56), brushed);
          retainer.rotation.x = Math.PI / 2; retainer.position.y = y; detail.add(retainer);
        });

        // Eight vibration-isolation feet under the octagonal plinth.
        const footGeo = new THREE.CylinderGeometry(0.115, 0.14, 0.09, 12);
        const isolationFeet = new THREE.InstancedMesh(footGeo, rubber, 8);
        for (let i = 0; i < 8; i += 1) {
          const angle = (i / 8) * Math.PI * 2 + Math.PI / 8;
          matrix.compose(new THREE.Vector3(Math.cos(angle) * 2.26, -0.035, Math.sin(angle) * 2.26), new THREE.Quaternion(), new THREE.Vector3(1, 1, 1));
          isolationFeet.setMatrixAt(i, matrix);
        }
        detail.add(isolationFeet);

        // Base fasteners: one instanced draw call around the service deck.
        const boltGeo = new THREE.CylinderGeometry(0.035, 0.035, 0.04, 8);
        const baseBolts = new THREE.InstancedMesh(boltGeo, fastener, 24);
        for (let i = 0; i < 24; i += 1) {
          const angle = (i / 24) * Math.PI * 2;
          matrix.compose(new THREE.Vector3(Math.cos(angle) * 1.91, 0.79, Math.sin(angle) * 1.91), new THREE.Quaternion(), new THREE.Vector3(1, 1, 1));
          baseBolts.setMatrixAt(i, matrix);
        }
        detail.add(baseBolts);

        // Four inspection plates embedded into the lower octagonal body.
        const inspectionAngles = [Math.PI / 4, 3 * Math.PI / 4, 5 * Math.PI / 4, 7 * Math.PI / 4];
        inspectionAngles.forEach((angle, index) => {
          const radial = new THREE.Vector3(Math.cos(angle), 0, Math.sin(angle));
          const plate = new THREE.Mesh(new THREE.BoxGeometry(0.72, 0.22, 0.045), index === 3 ? corePaint : brushed);
          plate.position.copy(radial.clone().multiplyScalar(2.31));
          plate.position.y = 0.45;
          plate.rotation.y = Math.PI / 2 - angle;
          detail.add(plate);
          const marker = new THREE.Mesh(new THREE.BoxGeometry(0.13, 0.025, 0.018), index === 3 ? statusAmber : statusCyan);
          marker.position.copy(radial.clone().multiplyScalar(2.34));
          marker.position.y = 0.49;
          marker.rotation.y = Math.PI / 2 - angle;
          detail.add(marker);
        });

        // Pylon service doors and latches. Their orientation follows the pylon faces.
        const panelBolts = new THREE.InstancedMesh(new THREE.SphereGeometry(0.037, 7, 7), fastener, 16);
        let boltIndex = 0;
        pylonSpecs.forEach(([x, , z]) => {
          const radial = new THREE.Vector3(x, 0, z).normalize();
          const angle = Math.atan2(radial.x, radial.z);
          const backing = new THREE.Mesh(new THREE.BoxGeometry(0.42, 1.24, 0.035), rubber);
          backing.position.set(x + radial.x * 0.25, 2.82, z + radial.z * 0.25);
          backing.rotation.y = angle;
          detail.add(backing);
          const access = new THREE.Mesh(new THREE.BoxGeometry(0.36, 1.12, 0.035), corePaint);
          access.position.set(x + radial.x * 0.274, 2.82, z + radial.z * 0.274);
          access.rotation.y = angle;
          detail.add(access);
          const latch = new THREE.Mesh(new THREE.BoxGeometry(0.055, 0.25, 0.05), brushed);
          latch.position.set(x + radial.x * 0.31 + Math.cos(angle) * 0.1, 2.82, z + radial.z * 0.31 - Math.sin(angle) * 0.1);
          latch.rotation.y = angle;
          detail.add(latch);

          const tangent = new THREE.Vector3(radial.z, 0, -radial.x);
          const corners: Array<[number, number]> = [[-0.13, -0.46], [0.13, -0.46], [-0.13, 0.46], [0.13, 0.46]];
          corners.forEach(([tx, yy]) => {
            const pos = new THREE.Vector3(x, 2.82 + yy, z).add(radial.clone().multiplyScalar(0.31)).add(tangent.clone().multiplyScalar(tx));
            matrix.compose(pos, new THREE.Quaternion(), new THREE.Vector3(1, 1, 1));
            panelBolts.setMatrixAt(boltIndex, matrix);
            boltIndex += 1;
          });
        });
        detail.add(panelBolts);

        // Glass retaining clamps around the upper and lower chamber edges.
        const clampGeo = new THREE.BoxGeometry(0.14, 0.08, 0.055);
        const clamps = new THREE.InstancedMesh(clampGeo, brushed, 16);
        let clampIndex = 0;
        [1.1, 4.46].forEach((y) => {
          for (let i = 0; i < 8; i += 1) {
            const angle = (i / 8) * Math.PI * 2;
            const pos = new THREE.Vector3(Math.cos(angle) * 1.03, y, Math.sin(angle) * 1.03);
            const q = new THREE.Quaternion().setFromEuler(new THREE.Euler(0, -angle, 0));
            matrix.compose(pos, q, new THREE.Vector3(1, 1, 1));
            clamps.setMatrixAt(clampIndex, matrix);
            clampIndex += 1;
          }
        });
        detail.add(clamps);

        // Crown ventilation slots, instanced to preserve the performance budget.
        const ventGeo = new THREE.BoxGeometry(0.055, 0.16, 0.28);
        const crownVents = new THREE.InstancedMesh(ventGeo, vent, 12);
        for (let i = 0; i < 12; i += 1) {
          const angle = (i / 12) * Math.PI * 2;
          const pos = new THREE.Vector3(Math.cos(angle) * 1.3, 5.06, Math.sin(angle) * 1.3);
          const q = new THREE.Quaternion().setFromEuler(new THREE.Euler(0, -angle, 0));
          matrix.compose(pos, q, new THREE.Vector3(1, 1, 1));
          crownVents.setMatrixAt(i, matrix);
        }
        detail.add(crownVents);

        // Small status points around the crown: information, not decoration.
        const ledGeo = new THREE.SphereGeometry(0.04, 8, 8);
        const crownLeds = new THREE.InstancedMesh(ledGeo, statusCyan, 6);
        for (let i = 0; i < 6; i += 1) {
          const angle = (i / 6) * Math.PI * 2;
          matrix.compose(new THREE.Vector3(Math.cos(angle) * 1.13, 5.31, Math.sin(angle) * 1.13), new THREE.Quaternion(), new THREE.Vector3(1, 1, 1));
          crownLeds.setMatrixAt(i, matrix);
        }
        detail.add(crownLeds);
        const serviceLedA = new THREE.Mesh(ledGeo, statusAmber); serviceLedA.position.set(-0.58, 5.28, 0.98); detail.add(serviceLedA);
        const serviceLedB = serviceLedA.clone(); serviceLedB.position.set(0.58, 5.28, -0.98); detail.add(serviceLedB);

        // Four physical collars reinforce the service-port interfaces from Core V1.
        const portPositions = [
          new THREE.Vector3(-1.62, 0.92, -0.38),
          new THREE.Vector3(0.55, 0.92, 1.52),
          new THREE.Vector3(1.62, 0.92, 0.38),
          new THREE.Vector3(0.38, 0.92, -1.62),
        ];
        const zAxis = new THREE.Vector3(0, 0, 1);
        portPositions.forEach((port, index) => {
          const radial = new THREE.Vector3(port.x, 0, port.z).normalize();
          const q = new THREE.Quaternion().setFromUnitVectors(zAxis, radial);
          const collar = new THREE.Mesh(new THREE.TorusGeometry(0.2, 0.035, 8, 28), index === 3 ? statusAmber : brushed);
          collar.position.copy(port.clone().add(radial.clone().multiplyScalar(0.31)));
          collar.quaternion.copy(q);
          detail.add(collar);
          const backing = new THREE.Mesh(new THREE.CylinderGeometry(0.25, 0.25, 0.07, 16), corePaint);
          backing.position.copy(port.clone().add(radial.clone().multiplyScalar(0.27)));
          backing.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), radial);
          detail.add(backing);
        });

        // A neutral service plate leaves room for final wording/branding later.
        const servicePlate = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.24, 0.035), brushed);
        servicePlate.position.set(0, 4.97, 1.58);
        detail.add(servicePlate);

        scene.add(new THREE.HemisphereLight(0x87a9b6, 0x020407, 0.58));
        const key = new THREE.DirectionalLight(0xd4edf4, 1.55);
        key.position.set(-10, 15, 8);
        scene.add(key);
        const fill = new THREE.PointLight(0x2db8d2, mobile ? 0.45 : 0.75, 5, 2);
        fill.position.set(0, 3.0, 1.4);
        scene.add(fill);

        const cameraPath = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-16, 8, 19), new THREE.Vector3(-10, 4.5, 8), new THREE.Vector3(-5.8, 2.6, 3.4),
          new THREE.Vector3(-3.1, 2.2, 2.3), new THREE.Vector3(2.8, 2.35, 2.7), new THREE.Vector3(3.8, 3.5, -0.5),
          new THREE.Vector3(2.4, 4.9, -3.5), new THREE.Vector3(-1.9, 5.8, -3.2), new THREE.Vector3(-5.5, 4.6, 1.3),
          new THREE.Vector3(-1.8, 3.6, 5.3), new THREE.Vector3(5.8, 6.2, 10.5),
        ]);
        const targetPath = new THREE.CatmullRomCurve3([
          new THREE.Vector3(0, 2.6, 0.2), new THREE.Vector3(0, 2.6, 0.2), new THREE.Vector3(0, 2.5, 0.2),
          new THREE.Vector3(0, 2.5, 0.2), new THREE.Vector3(0, 2.8, 0.2), new THREE.Vector3(0, 2.9, 0.2),
          new THREE.Vector3(0, 3.2, 0.2), new THREE.Vector3(0, 3.3, 0.2), new THREE.Vector3(0, 2.7, 0.2),
          new THREE.Vector3(0, 2.7, 0.2), new THREE.Vector3(0, 2.8, 0.2),
        ]);

        const chapters = Array.from(document.querySelectorAll('.chapter'));
        let currentProgress = 0;
        let raf = 0;
        let visible = true;

        function getProgress() {
          const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
          return THREE.MathUtils.clamp(window.scrollY / max, 0, 1);
        }

        function render() {
          currentProgress = reducedMotion ? 0.88 : getProgress();
          const pathProgress = THREE.MathUtils.clamp(currentProgress, 0.001, 0.999);
          camera.position.lerp(cameraPath.getPointAt(pathProgress), reducedMotion ? 1 : 0.065);
          camera.lookAt(targetPath.getPointAt(pathProgress));
          syncBase(currentProgress);

          const active = Math.min(chapters.length - 1, Math.floor(currentProgress * chapters.length));
          chapters.forEach((chapter, index) => chapter.classList.toggle('active', index === active));

          renderer.render(scene, camera);
          if (callsEl) callsEl.textContent = renderer.info.render.calls.toLocaleString();
          if (trisEl) trisEl.textContent = renderer.info.render.triangles.toLocaleString();
          if (visible) raf = requestAnimationFrame(render);
        }

        function resize() {
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, mobile ? 1.0 : 1.3));
          renderer.setSize(window.innerWidth, window.innerHeight);
        }
        window.addEventListener('resize', resize, { passive: true });
        document.addEventListener('visibilitychange', () => {
          visible = !document.hidden;
          if (visible) {
            cancelAnimationFrame(raf);
            render();
          }
        });
        render();
      }
    </script>
  </body>
</html>

<style is:global>
  :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #fff; background: #02050a; color-scheme: dark; }
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: #02050a; overflow-x: hidden; }
  body { min-width: 320px; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  #core-base, #detail-webgl { position: fixed; inset: 0; width: 100%; height: 100%; display: block; border: 0; pointer-events: none; }
  #core-base { z-index: 0; background: #02050a; }
  #detail-webgl { z-index: 1; }
  body::after { content: ''; position: fixed; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(90deg, rgba(2,5,10,.53), transparent 35%, transparent 68%, rgba(2,5,10,.38)), linear-gradient(180deg, rgba(2,5,10,.12), transparent 54%, rgba(2,5,10,.58)), radial-gradient(circle at 50% 43%, transparent 0 30%, rgba(2,5,10,.13) 63%, rgba(2,5,10,.53) 100%); }
  .topbar { position: fixed; inset: 0 0 auto; z-index: 20; height: 74px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 clamp(22px, 4.5vw, 74px); border-bottom: 1px solid rgba(125,187,211,.1); background: linear-gradient(180deg, rgba(2,5,10,.82), rgba(2,5,10,.06)); backdrop-filter: blur(8px); }
  .brand { justify-self: start; font-size: 17px; font-weight: 700; letter-spacing: .04em; }
  .brand strong { color: #00dcff; }
  .phase, .back { color: #8aa0ae; font-size: 9px; font-weight: 800; letter-spacing: .16em; }
  .back { justify-self: end; }
  .metrics { position: fixed; z-index: 18; right: clamp(22px, 3vw, 48px); top: 96px; width: 208px; padding: 10px 13px; border: 1px solid rgba(126,187,211,.12); background: rgba(3,8,13,.62); backdrop-filter: blur(8px); }
  .metrics div { display: flex; justify-content: space-between; gap: 12px; padding: 5px 0; border-bottom: 1px solid rgba(126,187,211,.07); }
  .metrics div:last-child { border: 0; }
  .metrics span, .metrics strong { font-size: 8px; letter-spacing: .11em; }
  .metrics span { color: #667e8c; }
  .metrics strong { color: #00d9ff; }
  #story { position: relative; z-index: 3; }
  .chapter { min-height: 100vh; position: relative; display: flex; align-items: center; padding: 100px clamp(26px, 6vw, 104px) 60px; pointer-events: none; }

---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const demo = `${base}demo/`;
const appMaintenance = `${base}app-mantenimiento/`;
const specialized = `${base}apps-especializadas/`;
const moduleUrl = (slug: string) => `${base}modulos/${slug}/`;
---
<!doctype html><html lang="es"><head>
<V3Seo title="Módulos · IsiVoltPro" description="Módulos de IsiVoltPro para activos, órdenes de trabajo, mantenimiento preventivo, QR/NFC, inventario, inspecciones y documentación." path={`${base}aplicaciones/`} />
<style is:inline>
.board-modules{background:#fff;overflow:hidden}.board-modules .page-shell{width:min(1180px,calc(100% - 44px))}.modules-hero{position:relative;padding:82px 0 76px;min-height:610px;background:radial-gradient(circle at 78% 42%,rgba(98,104,240,.13),transparent 28%),radial-gradient(circle at 91% 26%,rgba(51,197,150,.09),transparent 19%),#fff}.modules-hero__grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:72px;align-items:center}.modules-hero h1{margin:15px 0 17px;font:800 clamp(48px,4.6vw,68px)/1 var(--v3-font-display,system-ui);letter-spacing:-.06em}.modules-hero h1 span{display:block;color:transparent;background:linear-gradient(90deg,#6c58e3,#58a2dc 52%,#35be93);-webkit-background-clip:text;background-clip:text}.modules-hero p{max-width:530px;margin:0;color:#717d91;font-size:15px;line-height:1.7}.modules-hero .btn--primary{background:#111827;border-color:#111827;color:#fff}.board-kicker{display:inline-flex;padding:7px 10px;border:1px solid #ebedf4;border-radius:999px;color:#6d7485;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.module-stack{position:relative;min-height:450px}.module-window{position:absolute;border:1px solid #e4e8f2;border-radius:22px;background:rgba(255,255,255,.94);box-shadow:0 28px 70px rgba(66,70,120,.14);overflow:hidden}.module-window--back{inset:42px 12px 78px 80px;transform:rotate(4deg);opacity:.74}.module-window--mid{inset:22px 54px 52px 38px;transform:rotate(-3deg);opacity:.88}.module-window--front{inset:56px 25px 25px 66px;z-index:2;transform:rotate(1.2deg)}.module-window__bar{height:45px;display:flex;align-items:center;gap:6px;padding:0 14px;border-bottom:1px solid #edf0f5}.module-window__bar i{width:7px;height:7px;border-radius:50%;background:#d9deea}.module-window__body{padding:17px}.module-window__body small{color:#929bad;font-size:8px}.module-window__body strong{display:block;margin-top:5px;font-size:17px}.module-lines{display:grid;gap:8px;margin-top:16px}.module-lines span{height:28px;border-radius:9px;background:linear-gradient(90deg,#f4f6fb,#eef1f9)}.module-lines span:nth-child(2){width:84%}.module-lines span:nth-child(3){width:68%}.module-chip{position:absolute;z-index:4;width:54px;height:54px;display:grid;place-items:center;border:1px solid #e6e9f1;border-radius:17px;background:#fff;box-shadow:0 15px 34px rgba(60,67,108,.14);font-size:21px}.module-chip--a{left:18px;top:94px;color:#7257dd}.module-chip--b{right:7px;top:48px;color:#2bb17f}.module-chip--c{right:25px;bottom:28px;color:#db5ca8}.module-chip--d{left:72px;bottom:4px;color:#4779df}
.modules-cards{padding:65px 0 76px;background:#fbfcff;border-top:1px solid #f0f2f6}.modules-cards__head{text-align:center;max-width:700px;margin:0 auto 35px}.modules-cards__head h2{margin:0;font:800 clamp(32px,3.5vw,48px)/1.03 var(--v3-font-display,system-ui);letter-spacing:-.05em}.modules-cards__head p{margin:12px 0 0;color:#7b8598;line-height:1.65}.board-module-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.board-module-card{min-height:190px;padding:22px;border:1px solid #e7eaf2;border-radius:18px;background:#fff;box-shadow:0 13px 34px rgba(54,65,102,.06);color:inherit;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}.board-module-card:hover{transform:translateY(-4px);box-shadow:0 20px 42px rgba(54,65,102,.11)}.board-module-card i{width:42px;height:42px;display:grid;place-items:center;border-radius:13px;background:#f1efff;color:#6e58dd;font-style:normal}.board-module-card:nth-child(2) i{background:#fff0f8;color:#d654a8}.board-module-card:nth-child(3) i{background:#eaf9f3;color:#22a977}.board-module-card:nth-child(4) i{background:#eef4ff;color:#4377dc}.board-module-card:nth-child(5) i{background:#fff3ea;color:#e57d35}.board-module-card:nth-child(6) i{background:#eef9fb;color:#2b9eb7}.board-module-card:nth-child(7) i{background:#f4efff;color:#8b56d7}.board-module-card h3{margin:17px 0 8px;font-size:16px}.board-module-card p{margin:0;color:#7c8698;font-size:11px;line-height:1.55}.board-module-card small{display:block;margin-top:15px;color:#5e65ca;font-weight:800;font-size:9px}
.modules-feature{padding:74px 0;background:#fff}.modules-feature__grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:50px;align-items:center}.modules-feature h2{margin:10px 0 15px;font:800 clamp(36px,4vw,54px)/1.02 var(--v3-font-display,system-ui);letter-spacing:-.055em}.modules-feature p{color:#707b90;line-height:1.7}.modules-feature__visual{position:relative;min-height:330px;border:1px solid #e7eaf2;border-radius:28px;background:linear-gradient(145deg,#f8faff,#f5f1ff 50%,#f0fbf6);box-shadow:0 24px 60px rgba(53,63,102,.10);overflow:hidden}.feature-dash{position:absolute;left:34px;top:34px;right:100px;bottom:34px;border:1px solid #e5e8f0;border-radius:18px;background:#fff;box-shadow:0 16px 35px rgba(52,62,100,.09);padding:20px}.feature-dash strong{font-size:17px}.feature-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:18px}.feature-kpis div{padding:13px;border:1px solid #eceef3;border-radius:12px}.feature-kpis small{display:block;color:#8f98a7;font-size:8px}.feature-kpis b{display:block;margin-top:6px;font-size:21px}.feature-phone{position:absolute;right:24px;bottom:17px;width:128px;height:245px;padding:8px;border:6px solid #111827;border-radius:28px;background:#fff;box-shadow:0 20px 44px rgba(31,42,76,.20);transform:rotate(6deg)}.feature-phone img{width:100%;height:100%;object-fit:cover;border-radius:17px}
.modules-final{padding:0 0 72px}.modules-final .callout{background:linear-gradient(120deg,#f3f6ff,#f4f0ff 48%,#eefaf5)}
@media(max-width:900px){.modules-hero__grid,.modules-feature__grid{grid-template-columns:1fr}.module-stack{min-height:400px}.board-module-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.board-modules .page-shell{width:min(100% - 28px,1180px)}.modules-hero{padding:58px 0}.modules-hero h1{font-size:clamp(43px,12vw,56px)}.module-stack{min-height:330px}.module-window--back{inset:50px 2px 60px 40px}.module-window--mid{inset:25px 35px 40px 15px}.module-window--front{inset:50px 10px 20px 34px}.module-chip{width:45px;height:45px}.board-module-grid{grid-template-columns:1fr}.modules-feature__visual{min-height:300px}.feature-dash{left:16px;right:65px}.feature-phone{right:8px;width:108px;height:210px}}
</style></head><body><V3CommercialHeader />
<main class="board-modules">
<section class="modules-hero"><div class="page-shell modules-hero__grid"><div><span class="board-kicker">Módulos</span><h1>Todo lo que necesitas.<span>En un solo lugar.</span></h1><p>Activos, órdenes de trabajo, mantenimiento preventivo, QR/NFC, inspecciones, inventario y documentación comparten el mismo contexto para que el trabajo no vuelva a fragmentarse.</p><div class="page-hero__actions"><a class="btn btn--primary" href={demo}>Solicitar demo</a><a class="btn" href="#modulos">Explorar módulos</a></div></div><div class="module-stack" aria-label="Ventanas conceptuales de módulos IsiVoltPro"><div class="module-window module-window--back"><div class="module-window__bar"><i></i><i></i><i></i></div><div class="module-window__body"><small>ACTIVOS</small><strong>Equipos e histórico</strong><div class="module-lines"><span></span><span></span><span></span></div></div></div><div class="module-window module-window--mid"><div class="module-window__bar"><i></i><i></i><i></i></div><div class="module-window__body"><small>MANTENIMIENTO</small><strong>Preventivos y revisiones</strong><div class="module-lines"><span></span><span></span><span></span></div></div></div><div class="module-window module-window--front"><div class="module-window__bar"><i></i><i></i><i></i></div><div class="module-window__body"><small>ORDEN DE TRABAJO</small><strong>OT-2026-0148 · En curso</strong><div class="module-lines"><span></span><span></span><span></span></div></div></div><span class="module-chip module-chip--a" aria-hidden="true">▣</span><span class="module-chip module-chip--b" aria-hidden="true">✓</span><span class="module-chip module-chip--c" aria-hidden="true">⌁</span><span class="module-chip module-chip--d" aria-hidden="true">▤</span></div></div></section>
<section class="modules-cards" id="modulos"><div class="page-shell"><header class="modules-cards__head"><h2>Un ecosistema modular.</h2><p>Empieza por la capacidad que resuelve el problema de hoy y amplía el sistema sin crear islas nuevas de información.</p></header><div class="board-module-grid">
<a class="board-module-card" href={moduleUrl('activos')}><i>▣</i><h3>Activos</h3><p>Equipos, ubicaciones, fotos, documentos e histórico.</p><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('avisos-incidencias')}><i>!</i><h3>Avisos</h3><p>Incidencias claras con prioridad, contexto y evidencias.</p><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('ordenes-de-trabajo')}><i>✓</i><h3>Órdenes de trabajo</h3><p>Asignación, ejecución, seguimiento y cierre documentado.</p><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('mantenimiento-preventivo')}><i>⚙</i><h3>Mantenimiento</h3><p>Preventivos, periodicidades y revisiones visibles.</p><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('qr-nfc')}><i>⌁</i><h3>QR / NFC</h3><p>Acceso inmediato al activo desde el punto de trabajo.</p><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('inventario')}><i>▥</i><h3>Inventario</h3><p>Materiales y herramientas vinculados a la operación.</p><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('inspecciones')}><i>☑</i><h3>Inspecciones</h3><p>Checklists, observaciones, fotografías y resultados.</p><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('documentacion')}><i>▤</i><h3>Documentación</h3><p>Informes, manuales y archivos junto al contexto correcto.</p><small>Descubrir más →</small></a>
</div></div></section>
<section class="modules-feature"><div class="page-shell modules-feature__grid"><div><span class="board-kicker">Producto de entrada</span><h2>App Mantenimiento</h2><p>La puerta de entrada práctica a IsiVoltPro: avisos, OT, activos, preventivos, fotos y documentación alrededor de quien trabaja desde el móvil.</p><div class="page-hero__actions"><a class="btn btn--primary" href={appMaintenance}>Conocer la app →</a><a class="btn" href={specialized}>Apps especializadas</a></div></div><div class="modules-feature__visual"><div class="feature-dash"><strong>Trabajo pendiente</strong><div class="feature-kpis"><div><small>OT abiertas</small><b>12</b></div><div><small>Preventivos</small><b>8</b></div><div><small>Avisos</small><b>3</b></div></div></div><div class="feature-phone"><img src={`${base}media/tecnico-movil.svg`} alt="Vista conceptual de la App Mantenimiento desde un móvil"/></div></div></div></section>
<section class="modules-final"><div class="page-shell"><div class="callout"><div><h2>No necesitas activar todo.</h2><p>Empieza por el problema más urgente y amplía cuando IsiVoltPro ya forme parte del trabajo diario.</p></div><a class="btn btn--primary" href={demo}>Ver una demo orientada a mi caso →</a></div></div></section>
</main><V3CommercialFooter /></body></html>
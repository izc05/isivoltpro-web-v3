---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const contact = `${base}contacto/`;
const appMaintenance = `${base}app-mantenimiento/`;
const pilot = `${base}piloto/`;
---
<!doctype html><html lang="es"><head><V3Seo title="Implantación · IsiVoltPro" description="Cómo poner en marcha IsiVoltPro en un negocio pequeño: elegir un problema, ordenar datos mínimos, configurar App Mantenimiento, importar activos, QR/NFC, probar con un piloto y ampliar después." path={`${base}implantacion/`} />
<style is:inline>
.impl-page{background:#fff;overflow:hidden}.impl-page .page-shell{width:min(1180px,calc(100% - 44px))}.impl-hero{padding:78px 0 74px;background:radial-gradient(circle at 76% 31%,rgba(102,84,226,.12),transparent 27%),radial-gradient(circle at 92% 66%,rgba(47,188,143,.1),transparent 21%),#fff}.impl-hero__grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:68px;align-items:center}.impl-hero h1{margin:14px 0 18px;font:800 clamp(49px,4.8vw,70px)/.98 var(--v3-font-display,system-ui);letter-spacing:-.062em}.impl-hero h1 span{display:block;color:transparent;background:linear-gradient(90deg,#6854dd,#52a0d7 52%,#2db78a);-webkit-background-clip:text;background-clip:text}.impl-hero p{max-width:540px;color:#727d91;line-height:1.72}.impl-hero .btn--primary{background:#111827;border-color:#111827;color:#fff}.impl-workspace{position:relative;min-height:455px}.impl-window{position:absolute;inset:17px 20px 28px 18px;border:1px solid #e3e7f0;border-radius:26px;background:#fff;box-shadow:0 31px 78px rgba(57,65,111,.14);overflow:hidden}.impl-window__bar{height:44px;display:flex;align-items:center;justify-content:space-between;padding:0 15px;border-bottom:1px solid #edf0f5}.impl-window__bar strong{font-size:10px}.impl-window__bar small{color:#929baa;font-size:8px}.impl-window__body{display:grid;grid-template-columns:105px 1fr;height:calc(100% - 44px)}.impl-side{padding:17px 10px;background:#fafbfe;border-right:1px solid #edf0f5}.impl-side b{display:block;margin:0 7px 15px;font-size:10px}.impl-side span{display:block;margin:5px 0;padding:7px 8px;border-radius:8px;color:#8790a0;font-size:8px}.impl-side span:first-of-type{background:#f0edff;color:#6854d8;font-weight:800}.impl-main{padding:18px}.impl-main__top{display:flex;justify-content:space-between;align-items:center;gap:12px}.impl-main__top strong{font-size:17px}.impl-main__top span{padding:6px 8px;border-radius:999px;background:#eaf9f3;color:#158e68;font-size:8px;font-weight:800}.impl-progress{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:15px 0}.impl-progress div{height:7px;border-radius:999px;background:#edf0f5}.impl-progress div:nth-child(-n+2){background:linear-gradient(90deg,#6555dc,#4ba1d5)}.impl-task{padding:12px;border:1px solid #e9edf3;border-radius:12px;background:#fbfcff}.impl-task__head{display:flex;justify-content:space-between;gap:10px}.impl-task__head strong{font-size:10px}.impl-task__head span{color:#6653d7;font-size:8px;font-weight:800}.impl-rows{display:grid;gap:7px;margin-top:10px}.impl-rows div{display:grid;grid-template-columns:1fr auto;gap:8px;padding:8px 9px;border:1px solid #edf0f5;border-radius:8px;background:#fff;font-size:8px}.impl-rows b{color:#293348}.impl-rows span{color:#7d8798}.impl-chip{position:absolute;z-index:3;padding:11px 13px;border:1px solid #e4e8f0;border-radius:15px;background:#fff;box-shadow:0 14px 34px rgba(52,61,102,.14)}.impl-chip strong{display:block;font-size:9px}.impl-chip small{display:block;margin-top:3px;color:#8b95a5;font-size:7px}.impl-chip--a{right:0;top:57px}.impl-chip--b{left:0;bottom:63px}.impl-chip--c{right:25px;bottom:4px}.impl-chip--a strong{color:#6553d7}.impl-chip--b strong{color:#169c71}.impl-chip--c strong{color:#2497b1}.launch-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.launch-step{min-height:260px;padding:24px;border:1px solid #e6e9f0;border-radius:24px;background:#fff;box-shadow:0 13px 32px rgba(52,63,101,.06)}.launch-step b{display:grid;width:38px;height:38px;place-items:center;border-radius:12px;background:#f0edff;color:#6753d8;font-size:11px}.launch-step h3{margin:20px 0 8px;font-size:20px}.launch-step p{margin:0;color:#768196;line-height:1.6;font-size:13px}.launch-step small{display:block;margin-top:14px;color:#56637c;font-weight:800;font-size:10px}.launch-mini{margin-top:18px;padding:11px;border:1px solid #edf0f5;border-radius:11px;background:#fafbfe}.launch-mini span{display:block;height:7px;margin:6px 0;border-radius:999px;background:#e9edf4}.launch-mini span:nth-child(2){width:74%;background:#dfe4fb}.launch-mini span:nth-child(3){width:52%;background:#dff2eb}.journey{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;counter-reset:journey}.journey article{position:relative;min-height:220px;padding:22px;border:1px solid #e5e8f0;border-radius:23px;background:#fff;box-shadow:0 12px 30px rgba(52,63,101,.055);counter-increment:journey;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.journey article::before{content:"0" counter(journey);display:grid;width:36px;height:36px;place-items:center;margin-bottom:19px;border-radius:11px;background:#f0edff;color:#6753d8;font-size:10px;font-weight:900}.journey article[data-active="true"]{border-color:#b8c7ff;background:linear-gradient(145deg,#fff,#f6f8ff);box-shadow:0 18px 44px rgba(50,74,150,.12);transform:translateY(-4px)}.journey article[role="button"]{cursor:pointer}.journey article:focus-visible{outline:3px solid rgba(72,97,220,.22);outline-offset:3px}.journey h3{margin:0 0 8px;font-size:18px}.journey p{margin:0;color:#778296;line-height:1.56;font-size:12px}.journey small{display:block;margin-top:14px;color:#56637c;font-weight:800;font-size:9px}.journey-panel{display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:center;margin-top:16px;padding:20px 22px;border:1px solid #dfe5f6;border-radius:21px;background:linear-gradient(120deg,#f9fbff,#fff 55%,#faf7ff)}.journey-panel__index{display:grid;width:46px;height:46px;place-items:center;border-radius:14px;background:linear-gradient(135deg,#5d64df,#7651d7);color:#fff;font-size:12px;font-weight:900}.journey-panel strong{display:block;font-size:16px}.journey-panel p{margin:4px 0 0;color:#6f7a90;line-height:1.55;font-size:12px}.journey-panel__hint{color:#7a8598;font-size:10px;font-weight:800}.before-after{display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:center}.before-after article{padding:28px;border:1px solid #e5e8f0;border-radius:27px;background:#fff}.before-after article:first-child{background:#fafbfe}.before-after article:last-child{background:linear-gradient(145deg,#f5f8ff,#f5f2ff 52%,#eff9f5)}.before-after h3{margin:0 0 16px;font-size:23px}.before-after ul{list-style:none;margin:0;padding:0;display:grid;gap:11px;color:#59667e}.before-after li{display:flex;gap:9px;line-height:1.5}.before-after__arrow{width:44px;height:44px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(135deg,#5d64df,#7651d7);color:#fff;font-weight:900}.guardrail{margin-top:16px;padding:16px 18px;border:1px solid #dfe5f5;border-radius:16px;background:#f8faff;color:#53617a;line-height:1.6;font-size:12px}.pilot-band{display:grid;grid-template-columns:1fr .9fr;gap:34px;padding:38px;border-radius:31px;background:#111827;color:#fff}.pilot-band h2{margin:8px 0 10px;font-size:clamp(35px,4.6vw,56px);line-height:1.03;letter-spacing:-.05em}.pilot-band p{color:#c5cee0;line-height:1.7}.pilot-checks{display:grid;gap:10px;align-content:center}.pilot-checks div{padding:13px 15px;border:1px solid rgba(255,255,255,.12);border-radius:14px;background:rgba(255,255,255,.055)}.pilot-checks strong{display:block;font-size:13px}.pilot-checks small{display:block;margin-top:3px;color:#bcc6dc;font-size:10px}@media(max-width:1050px){.journey{grid-template-columns:repeat(3,1fr)}}@media(max-width:980px){.impl-hero__grid{grid-template-columns:1fr}.launch-grid{grid-template-columns:repeat(2,1fr)}.pilot-band{grid-template-columns:1fr}}@media(max-width:680px){.impl-page .page-shell{width:min(100% - 28px,1180px)}.impl-hero{padding:57px 0}.impl-hero h1{font-size:clamp(42px,12vw,56px)}.impl-workspace{min-height:370px}.impl-window{inset:15px 7px 25px}.impl-window__body{grid-template-columns:72px 1fr}.impl-side{padding:12px 5px}.impl-main{padding:12px}.impl-progress{grid-template-columns:repeat(2,1fr)}.impl-chip--b{display:none}.launch-grid,.journey{grid-template-columns:1fr}.launch-step{min-height:auto}.journey article{min-height:auto}.journey-panel{grid-template-columns:1fr}.before-after{grid-template-columns:1fr}.before-after__arrow{margin:auto;transform:rotate(90deg)}.pilot-band{padding:27px 21px}}@media(prefers-reduced-motion:reduce){.journey article{transition:none}.journey article[data-active="true"]{transform:none}}
</style></head><body><V3CommercialHeader /><main class="page-main impl-page">
<section class="impl-hero"><div class="page-shell impl-hero__grid"><div><span class="eyebrow">Puesta en marcha sin convertirla en otro proyecto enorme</span><h1>Empieza con lo mínimo.<span>Hazlo útil desde el primer flujo.</span></h1><p>La implantación para autónomos y pequeñas empresas parte de un problema concreto. Primero hacemos útil el trabajo diario; después ampliamos solo lo que aporta.</p><div class="page-hero__actions"><a class="btn btn--primary" href={pilot}>Ver cómo planteamos el piloto →</a><a class="btn" href={appMaintenance}>Ver App Mantenimiento</a></div></div><div class="impl-workspace" aria-label="Vista conceptual de una implantación IsiVoltPro"><div class="impl-window"><div class="impl-window__bar"><strong>IsiVoltPro · implantación</strong><small>Ejemplo de proceso</small></div><div class="impl-window__body"><aside class="impl-side"><b>Proyecto</b><span>Resumen</span><span>Datos</span><span>Equipo</span><span>Piloto</span><span>Resultado</span></aside><div class="impl-main"><div class="impl-main__top"><strong>Piloto · pequeño equipo</strong><span>Fase 2 de 4</span></div><div class="impl-progress"><div></div><div></div><div></div><div></div></div><div class="impl-task"><div class="impl-task__head"><strong>Preparación mínima</strong><span>En curso</span></div><div class="impl-rows"><div><b>Clientes iniciales</b><span>8</span></div><div><b>Activos del piloto</b><span>24</span></div><div><b>Técnicos</b><span>3</span></div><div><b>Flujo elegido</b><span>Avisos → OT</span></div></div></div></div></div></div><div class="impl-chip impl-chip--a"><strong>1 problema</strong><small>El más urgente</small></div><div class="impl-chip impl-chip--b"><strong>Datos mínimos</strong><small>Sin limpiar todo</small></div><div class="impl-chip impl-chip--c"><strong>Piloto</strong><small>Trabajo real</small></div></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Cuatro pasos</span><h2>De “lo tengo en Excel” a<br/><span class="gradient-text">trabajar con contexto.</span></h2></div><p>No necesitas migrar toda la historia de tu empresa. La primera implantación debe ser pequeña, reversible y medible.</p></div><div class="launch-grid"><article class="launch-step"><b>01</b><h3>Elegir el problema</h3><p>Avisos desordenados, OT sin seguimiento, preventivos olvidados o activos sin histórico.</p><small>Objetivo: una fricción real.</small><div class="launch-mini"><span></span><span></span><span></span></div></article><article class="launch-step"><b>02</b><h3>Ordenar lo mínimo</h3><p>Clientes, ubicaciones y los activos necesarios para que el primer flujo tenga sentido.</p><small>Objetivo: no limpiar datos de más.</small><div class="launch-mini"><span></span><span></span><span></span></div></article><article class="launch-step"><b>03</b><h3>Trabajar un piloto</h3><p>Usar IsiVoltPro con trabajo real y comprobar qué aporta y qué estorba.</p><small>Objetivo: aprender con uso real.</small><div class="launch-mini"><span></span><span></span><span></span></div></article><article class="launch-step"><b>04</b><h3>Ampliar con criterio</h3><p>Añadir QR/NFC, técnicos o módulos solo cuando compense.</p><small>Objetivo: crecer sin burocracia.</small><div class="launch-mini"><span></span><span></span><span></span></div></article></div></div></section>
<section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Timeline interactiva</span><h2>Un recorrido comercial<br/><span class="gradient-text">sin saltos.</span></h2></div><p>Cada etapa tiene una decisión clara y se puede detener si no aporta valor. Pulsa una fase para ver qué significa.</p></div><div class="journey" data-journey><article role="button" tabindex="0" data-index="01" data-title="Diagnóstico breve" data-copy="Empezamos por una fricción real y acotada. No necesitas preparar una migración completa para descubrir si IsiVoltPro encaja." data-active="true"><h3>Diagnóstico breve</h3><p>Entender cómo trabajas hoy y detectar el cuello de botella principal.</p><small>Sin migrar datos todavía.</small></article><article role="button" tabindex="0" data-index="02" data-title="Demo enfocada" data-copy="La demostración se centra en tu flujo concreto: aviso, OT, activo o preventivo. El objetivo es ver el encaje antes de configurar nada."><h3>Demo enfocada</h3><p>Enseñar solo el recorrido que responde al problema elegido.</p><small>Ver antes de configurar.</small></article><article role="button" tabindex="0" data-index="03" data-title="Piloto acotado" data-copy="Se define un alcance pequeño con usuarios, activos y un criterio de éxito comprensible. El piloto usa trabajo real, pero mantiene el riesgo controlado."><h3>Piloto acotado</h3><p>Usuarios, activos y criterio de éxito claramente limitados.</p><small>Trabajo real.</small></article><article role="button" tabindex="0" data-index="04" data-title="Propuesta" data-copy="Solo después del piloto se concretan alcance, soporte, implantación y condiciones aplicables al caso real. La web no inventa precios ni compromisos."><h3>Propuesta</h3><p>Concretar lo que realmente se ha validado.</p><small>Sin precios ficticios.</small></article><article role="button" tabindex="0" data-index="05" data-title="Puesta en marcha" data-copy="Se amplía únicamente lo que ha demostrado valor: más equipo, ubicaciones, QR/NFC, inspecciones, inventario u otros módulos."><h3>Puesta en marcha</h3><p>Crecer únicamente sobre lo que funciona.</p><small>Ampliar cuando compensa.</small></article></div><div class="journey-panel" data-journey-panel aria-live="polite"><span class="journey-panel__index">01</span><div><strong>Diagnóstico breve</strong><p>Empezamos por una fricción real y acotada. No necesitas preparar una migración completa para descubrir si IsiVoltPro encaja.</p></div><span class="journey-panel__hint">Selecciona una fase</span></div><p class="guardrail"><strong>Importante:</strong> la web no activa una contratación automática ni simula un backend de ventas. Canal de contacto, condiciones, privacidad y datos jurídicos deben validarse antes de producción.</p></div></section>
<section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Importación inicial</span><h2>No hace falta tirar<br/><span class="gradient-text">lo que ya tienes.</span></h2></div><p>Excel, listados, carpetas y códigos pueden ser un buen punto de partida. La idea es aprovechar información útil sin copiar el desorden.</p></div><div class="before-after"><article><h3>Lo que suele existir</h3><ul><li><span>→</span>Clientes en contactos o Excel.</li><li><span>→</span>Equipos en listados separados.</li><li><span>→</span>Fotos y manuales en carpetas.</li><li><span>→</span>Preventivos en calendario.</li><li><span>→</span>Avisos por teléfono y WhatsApp.</li></ul></article><div class="before-after__arrow">→</div><article><h3>Lo que queremos conseguir</h3><ul><li><span>✓</span>Cliente e instalación identificados.</li><li><span>✓</span>Activos con histórico útil.</li><li><span>✓</span>Documentos en su contexto.</li><li><span>✓</span>Trabajo pendiente visible.</li><li><span>✓</span>Un flujo que el técnico usa.</li></ul></article></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="pilot-band"><div><span class="eyebrow" style="color:#9eb6ff">Piloto antes de escalar</span><h2>Probar con trabajo real es parte del producto.</h2><p>Un piloto pequeño permite comprobar valor, descubrir fricción y decidir qué debe quedarse antes de ampliar.</p><div class="page-hero__actions"><a class="btn btn--primary" href={pilot}>Ver el proceso completo →</a><a class="btn" style="background:#fff;color:#18223b" href={contact}>Hablar de mi caso</a></div></div><div class="pilot-checks"><div><strong>Alcance limitado</strong><small>Usuarios y activos concretos.</small></div><div><strong>Criterio de éxito</strong><small>Qué debería mejorar para continuar.</small></div><div><strong>Salida clara</strong><small>Si no aporta, no se escala.</small></div></div></div></div></section>
</main><V3CommercialFooter />
<script is:inline>
(()=>{const root=document.querySelector('[data-journey]');const panel=document.querySelector('[data-journey-panel]');if(!root||!panel)return;const cards=[...root.querySelectorAll('article')];const index=panel.querySelector('.journey-panel__index');const title=panel.querySelector('strong');const copy=panel.querySelector('p');function select(card){cards.forEach(c=>c.dataset.active='false');card.dataset.active='true';if(index)index.textContent=card.dataset.index||'';if(title)title.textContent=card.dataset.title||'';if(copy)copy.textContent=card.dataset.copy||'';}cards.forEach(card=>{card.addEventListener('click',()=>select(card));card.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();select(card);}});});})();
</script></body></html>
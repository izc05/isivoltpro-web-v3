---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const demo = `${base}demo/`;
const solutions = `${base}soluciones/`;
const appMaintenance = `${base}app-mantenimiento/`;
const specialized = `${base}apps-especializadas/`;
const moduleUrl = (slug: string) => `${base}modulos/${slug}/`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Apps y módulos · IsiVoltPro" description="Apps y módulos IsiVoltPro para autónomos y pequeñas empresas: App Mantenimiento, activos, avisos, órdenes de trabajo, mantenimiento preventivo, QR/NFC, documentación, inventario e inspecciones." path={`${base}aplicaciones/`} />
  <style is:inline>
    .app-feature{display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:center;padding:40px;border:1px solid #e5e9f3;border-radius:34px;background:linear-gradient(125deg,#f7faff,#f5f1ff 52%,#fff3f8);box-shadow:var(--shadow-soft)}.app-feature h2{margin:15px 0 12px;font-size:clamp(38px,5vw,60px);line-height:1.02;letter-spacing:-.055em}.app-feature p{margin:0;color:var(--muted);line-height:1.7}.app-feature__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.app-feature__visual{position:relative;min-height:310px}.app-feature__window{position:absolute;inset:15px 20px 30px 0;border:1px solid var(--line);border-radius:26px;background:#fff;box-shadow:0 24px 60px rgba(54,70,113,.13);overflow:hidden}.app-feature__bar{display:flex;justify-content:space-between;align-items:center;padding:15px 17px;border-bottom:1px solid var(--line);font-size:10px;color:#75819a}.app-feature__body{padding:18px}.app-feature__body h3{margin:0;font-size:23px}.app-feature__kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:15px}.app-feature__kpis div{padding:12px;border:1px solid var(--line);border-radius:13px}.app-feature__kpis small{display:block;color:var(--muted);font-size:9px}.app-feature__kpis strong{display:block;margin-top:5px;font-size:20px}.app-feature__phone{position:absolute;right:0;bottom:0;width:116px;padding:8px;border:4px solid #101a35;border-radius:24px;background:#fff;box-shadow:0 20px 45px rgba(31,47,90,.22);transform:rotate(4deg)}.app-feature__phone div{min-height:190px;padding:10px;border-radius:15px;background:linear-gradient(180deg,#f7faff,#fff)}.app-feature__phone strong{display:block;margin-top:4px;font-size:12px}.app-feature__phone small{font-size:8px;color:var(--muted)}.app-feature__phone b{display:block;margin-top:12px;padding:9px;border-radius:9px;text-align:center;color:#fff;background:linear-gradient(100deg,var(--blue),var(--violet));font-size:8px}@media(max-width:850px){.app-feature{grid-template-columns:1fr}}@media(max-width:560px){.app-feature{padding:26px 20px;border-radius:26px}.app-feature__visual{min-height:280px}.app-feature__actions .btn{width:100%}.app-feature__kpis{grid-template-columns:1fr 1fr}.app-feature__kpis div:last-child{display:none}}
  </style>
</head>
<body>
  <V3CommercialHeader />
  <main class="page-main">
    <section class="page-hero">
      <div class="page-shell page-hero__grid">
        <div><span class="eyebrow">Aplicaciones conectadas sobre una base común</span><h1>Empieza con una app.<br /><span class="gradient-text">Construye tu sistema después.</span></h1><p>IsiVoltPro no obliga a implantar una suite enorme desde el primer día. Puedes empezar por mantenimiento y añadir activos, QR/NFC, inspecciones, inventario o documentación cuando solucionen un problema concreto.</p><div class="page-hero__actions"><a class="btn btn--primary" href={appMaintenance}>Ver App Mantenimiento →</a><a class="btn" href={solutions}>Ver soluciones</a></div></div>
        <div class="page-hero__visual" aria-hidden="true"><div class="page-orbit"></div><div class="page-core">APPS<small>UN SOLO ECOSISTEMA</small></div><div class="page-pill page-pill--a">Mantenimiento<small>Avisos y OT</small></div><div class="page-pill page-pill--b">Activos<small>Equipos e histórico</small></div><div class="page-pill page-pill--c">QR / NFC<small>Acceso en campo</small></div><div class="page-pill page-pill--d">Inspecciones<small>Trabajo trazable</small></div></div>
      </div>
    </section>

    <section class="page-section"><div class="page-shell"><div class="app-feature"><div><span class="eyebrow">Producto de entrada</span><h2>App Mantenimiento</h2><p>Avisos, órdenes de trabajo, activos, preventivos, fotos, documentación e histórico pensados alrededor de un técnico que trabaja desde el móvil y de quien necesita coordinar sin perseguir información.</p><div class="app-feature__actions"><a class="btn btn--primary" href={appMaintenance}>Conocer la app →</a><a class="btn" href={demo}>Ver cómo sería una demo</a></div></div><div class="app-feature__visual" aria-label="Vista conceptual de App Mantenimiento"><div class="app-feature__window"><div class="app-feature__bar"><strong>IsiVoltPro · Mantenimiento</strong><span>Vista conceptual</span></div><div class="app-feature__body"><small style="color:var(--muted)">Hoy</small><h3>Trabajo pendiente</h3><div class="app-feature__kpis"><div><small>OT abiertas</small><strong>12</strong></div><div><small>Preventivos</small><strong>8</strong></div><div><small>Avisos</small><strong>3</strong></div></div></div></div><div class="app-feature__phone"><div><small>ACTIVO</small><strong>UTA-02</strong><small>Planta 1 · Zona técnica</small><b>ABRIR OT</b></div></div></div></div></div></section>

    <section class="page-section page-section--soft" id="modulos">
      <div class="page-shell">
        <div class="page-section__head"><div><span class="eyebrow">Núcleo operativo conectado</span><h2>Lo que más se usa,<br /><span class="gradient-text">trabajando junto.</span></h2></div><p>Estas capacidades forman el recorrido principal: desde el cliente y el equipo hasta el cierre del trabajo y su histórico. Cada una puede resolver una fricción concreta sin perder la conexión con las demás.</p></div>
        <div class="feature-grid">
          <a class="feature-card" href={moduleUrl('activos')} style="--accent:rgba(23,92,255,.10)"><i>▣</i><h3>Activos y equipos</h3><p>Identidad, ubicación, estado, fotografías, documentos, revisiones y actuaciones alrededor de cada equipo.</p><small>Ver gestión de activos →</small></a>
          <a class="feature-card" href={moduleUrl('avisos-incidencias')} style="--accent:rgba(242,56,169,.10);--icon:#d52f99;--icon-bg:#fff0f8"><i>!</i><h3>Avisos e incidencias</h3><p>Convierte una llamada o mensaje en un registro claro con cliente, activo, prioridad, descripción y evidencias.</p><small>Ver avisos e incidencias →</small></a>
          <a class="feature-card" href={moduleUrl('ordenes-de-trabajo')} style="--accent:rgba(109,74,255,.10);--icon:#6544e8;--icon-bg:#f2efff"><i>✓</i><h3>Órdenes de trabajo</h3><p>Asigna, ejecuta, documenta y controla el estado de cada trabajo hasta el cierre.</p><small>Ver órdenes de trabajo →</small></a>
          <a class="feature-card" href={moduleUrl('mantenimiento-preventivo')} style="--accent:rgba(36,197,140,.11);--icon:#159f71;--icon-bg:#eaf9f3"><i>⚙</i><h3>Mantenimiento preventivo</h3><p>Planifica revisiones periódicas y convierte el calendario técnico en trabajo visible y trazable.</p><small>Ver mantenimiento preventivo →</small></a>
          <a class="feature-card" href={moduleUrl('qr-nfc')} style="--accent:rgba(255,139,61,.12);--icon:#d96c20;--icon-bg:#fff3e9"><i>⌁</i><h3>QR / NFC</h3><p>Identifica físicamente equipos y abre su contexto desde el móvil justo donde ocurre el trabajo.</p><small>Ver QR / NFC →</small></a>
          <a class="feature-card" href={moduleUrl('documentacion')} style="--accent:rgba(24,185,215,.11);--icon:#139db9;--icon-bg:#eafafd"><i>▤</i><h3>Documentación técnica</h3><p>Fotos, manuales e informes vinculados al cliente, instalación, activo o actuación correspondiente.</p><small>Ver documentación →</small></a>
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="page-shell">
        <div class="page-section__head"><div><span class="eyebrow">Trabajo estructurado</span><h2>Revisar y controlar sin<br /><span class="gradient-text">crear más burocracia.</span></h2></div><p>Cuando un equipo pequeño necesita más profundidad, la misma base puede extenderse a inspecciones e inventario sin crear sistemas aislados.</p></div>
        <div class="value-grid">
          <a class="value-card" href={moduleUrl('inspecciones')} style="--accent:rgba(24,185,215,.10);--icon:#139db9;--icon-bg:#eafafd"><i>☑</i><h3>Inspecciones y checklists</h3><p>Comprobaciones, observaciones y evidencias alrededor de una revisión trazable.</p></a>
          <a class="value-card" href={moduleUrl('inventario')} style="--accent:rgba(242,56,169,.10);--icon:#d52f99;--icon-bg:#fff0f8"><i>▥</i><h3>Inventario y materiales</h3><p>Control práctico de existencias y consumos relacionados con el trabajo técnico.</p></a>
          <a class="value-card" href={moduleUrl('documentacion')} style="--accent:rgba(109,74,255,.10);--icon:#6544e8;--icon-bg:#f2efff"><i>↺</i><h3>Histórico técnico</h3><p>Lo registrado durante el trabajo queda disponible para entender la siguiente intervención.</p></a>
        </div>
      </div>
    </section>

    <section class="page-section page-section--soft">
      <div class="page-shell">
        <div class="page-section__head"><div><span class="eyebrow">Soluciones especializadas</span><h2>Más profundidad cuando<br /><span class="gradient-text">tu actividad la necesita.</span></h2></div><p>Estas capacidades se integran progresivamente sobre la misma base. La disponibilidad concreta se confirma en demo para no presentar desarrollo futuro como producto terminado.</p></div>
        <div class="feature-grid">
          <a class="feature-card" href={moduleUrl('inventario')}><i>▥</i><h3>Inventario y almacén</h3><p>Materiales, existencias, movimientos y consumos vinculados a la operación.</p><small>Ver enfoque de inventario →</small></a>
          <a class="feature-card" href={moduleUrl('inspecciones')} style="--icon:#e37427;--icon-bg:#fff4ea"><i>◎</i><h3>Inspecciones</h3><p>Checklists, defectos, fotografías y resultados vinculados a la instalación inspeccionada.</p><small>Ver enfoque de inspecciones →</small></a>
          <article class="feature-card" style="--icon:#159f71;--icon-bg:#eaf9f3"><i>≈</i><h3>Legionella / ACS</h3><p>Controles, purgas, puntos y registros específicos alrededor del activo correspondiente.</p><small>Solución especializada · integración progresiva</small></article>
          <article class="feature-card" style="--icon:#139db9;--icon-bg:#eafafd"><i>❄</i><h3>Climatización y frío</h3><p>Equipos HVAC, mantenimientos, averías, documentación y trazabilidad por instalación.</p><small>Solución especializada · integración progresiva</small></article>
          <article class="feature-card" style="--icon:#6544e8;--icon-bg:#f2efff"><i>⚡</i><h3>Instalaciones eléctricas</h3><p>Cuadros, circuitos, revisiones, documentación técnica y actuaciones sobre cada elemento.</p><small>Solución especializada · integración progresiva</small></article>
          <article class="feature-card" style="--icon:#d52f99;--icon-bg:#fff0f8"><i>✦</i><h3>IsiVoltPro AI</h3><p>Capa de asistencia prevista para consultar documentación e histórico técnico con contexto.</p><small>Capacidad en desarrollo</small></article>
        </div>
        <div class="page-hero__actions" style="justify-content:center"><a class="btn" href={specialized}>Ver catálogo y estado de apps especializadas →</a></div>
      </div>
    </section>

    <section class="page-section">
      <div class="page-shell"><div class="callout"><div><h2>No necesitas activar todo.</h2><p>Empieza por App Mantenimiento o por el problema más urgente y amplía cuando IsiVoltPro ya forme parte de tu trabajo diario.</p></div><a class="btn btn--primary" href={demo}>Ver una demo orientada a mi caso →</a></div></div>
    </section>
  </main>
  <V3CommercialFooter />
</body>
</html>

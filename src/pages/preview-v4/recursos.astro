---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const blog = `${base}preview-v4/blog/`;
const demo = `${base}preview-v4/demo/`;
const sectors = `${base}preview-v4/sectores/`;
const journey = `${base}media/ruta-recursos-isivoltpro.svg`;
const topics = [
  ['01','Organización de avisos','Cómo registrar bien una incidencia desde el principio para evitar reconstruirla después.'],
  ['02','Órdenes de trabajo','Qué información necesita una OT para ser útil en campo, coordinación y cierre.'],
  ['03','Activos y QR/NFC','Cómo identificar equipos y mantener histórico, fotos y documentación junto al activo correcto.'],
  ['04','Mantenimiento preventivo','Planificar tareas, evidencias y revisiones sin convertir el proceso en burocracia.'],
  ['05','Inspecciones y checklists','Capturar observaciones, defectos, fotos y seguimiento de forma estructurada.'],
  ['06','Implantación gradual','Pasar de WhatsApp, Excel o carpetas sueltas a un sistema ordenado sin romper la operativa.'],
];
---
<!doctype html><html lang="es"><head>
<V3Seo title="Recursos V4 · IsiVoltPro" description="Biblioteca V4 de conocimiento práctico sobre mantenimiento, avisos, OT, activos, QR/NFC, preventivo, inspecciones e implantación digital." path={`${base}preview-v4/recursos/`} noindex={true}/>
<style is:inline>
.strip{background:#0d1730;color:#fff}.strip .page-shell{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:12px}.strip a{color:#dfe7ff;font-weight:800}.hero{padding:86px 0 72px;background:radial-gradient(circle at 78% 12%,rgba(109,74,255,.13),transparent 28%),radial-gradient(circle at 90% 62%,rgba(36,197,140,.10),transparent 24%),#fff}.hero-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(500px,1.1fr);gap:58px;align-items:center}.hero h1{margin:18px 0 20px;font:800 clamp(52px,5.8vw,82px)/.97 Manrope,sans-serif;letter-spacing:-.065em}.hero p{max-width:650px;margin:0;color:#68748a;font-size:18px;line-height:1.72}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.library{padding:24px;border:1px solid #e5e9f2;border-radius:30px;background:linear-gradient(145deg,#fff,#f8faff);box-shadow:0 30px 80px rgba(50,61,105,.13)}.library-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.library-head strong{font-size:14px}.library-head small{color:#8a94a6;font-size:10px}.featured{margin-top:18px;padding:22px;border-radius:22px;background:linear-gradient(130deg,#eef4ff,#f3efff 52%,#effaf6)}.featured span{display:inline-flex;padding:6px 9px;border-radius:999px;background:#fff;color:#6652da;font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.07em}.featured h2{margin:13px 0 8px;font-size:27px;letter-spacing:-.04em}.featured p{margin:0;color:#6f7b90;line-height:1.6;font-size:13px}.library-links{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}.library-links div{padding:15px;border:1px solid #e9ecf3;border-radius:16px;background:#fff}.library-links strong{display:block;font-size:13px}.library-links small{display:block;margin-top:5px;color:#8791a2;line-height:1.45}.topics{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.topic{padding:25px;border:1px solid #e5e9f2;border-radius:24px;background:#fff;box-shadow:0 14px 38px rgba(54,64,102,.055)}.topic b{display:inline-flex;padding:6px 8px;border-radius:9px;background:#f1efff;color:#6552d9;font-size:10px}.topic h3{margin:16px 0 8px;font-size:21px;letter-spacing:-.025em}.topic p{margin:0;color:#778398;font-size:13px;line-height:1.62}.authority{display:grid;grid-template-columns:1.08fr .92fr;gap:30px;align-items:stretch}.authority-main{padding:34px;border-radius:30px;background:linear-gradient(125deg,#0e1830,#1b2d58 58%,#342676);color:#fff}.authority-main h2{margin:15px 0 12px;font:800 clamp(38px,4.5vw,58px)/1.03 Manrope,sans-serif;letter-spacing:-.052em}.authority-main p{max-width:720px;margin:0;color:#c7d1e7;line-height:1.7}.authority-main .checks{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:25px}.checks span{padding:12px 14px;border:1px solid rgba(255,255,255,.13);border-radius:14px;background:rgba(255,255,255,.055);color:#dbe4f2;font-size:12px}.authority-visual{padding:20px;border:1px solid #e5e9f2;border-radius:30px;background:#fff;box-shadow:0 22px 58px rgba(54,64,102,.08);display:grid;align-content:center}.authority-visual img{width:100%;height:auto;display:block;border-radius:20px}.bridge{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.bridge article{padding:22px;border:1px solid #e5e9f2;border-radius:22px;background:#fff}.bridge strong{display:block;font-size:18px}.bridge p{margin:8px 0 0;color:#778398;font-size:13px;line-height:1.58}.cta{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;padding:38px;border-radius:28px;background:linear-gradient(115deg,#f2f7ff,#f4f0ff 48%,#effaf6)}.cta h2{margin:0;font:800 clamp(34px,4vw,50px)/1.04 Manrope,sans-serif;letter-spacing:-.048em}.cta p{margin:11px 0 0;color:#6f7b90;line-height:1.65}@media(max-width:980px){.hero-grid,.authority,.cta{grid-template-columns:1fr}.topics{grid-template-columns:repeat(2,1fr)}}@media(max-width:680px){.hero{padding:58px 0 48px}.hero h1{font-size:clamp(44px,13vw,62px)}.topics,.library-links,.bridge,.authority-main .checks{grid-template-columns:1fr}.strip .page-shell{padding:8px 0;flex-direction:column;align-items:flex-start;gap:4px}.authority-main,.cta{padding:28px 22px}}
</style></head><body>
<V3CommercialHeader/>
<div class="strip"><div class="page-shell"><strong>Preview V4 · Fase 6 · Recursos</strong><span>Conocimiento → confianza → producto · <a href={`${base}preview-v4/`}>Mapa V4</a></span></div></div>
<main class="page-main">
<section class="hero"><div class="page-shell hero-grid"><div><span class="eyebrow">Conocimiento útil antes de vender</span><h1>Software para mantener.<br/><span class="gradient-text">Criterio para decidir mejor.</span></h1><p>La biblioteca de IsiVoltPro debe demostrar que entendemos el trabajo técnico. Guías, procesos, checklists y buenas prácticas pueden aportar valor incluso antes de usar la plataforma.</p><div class="actions"><a class="btn btn--primary" href="#biblioteca">Explorar biblioteca →</a><a class="btn" href={blog}>Ver Blog V4</a></div></div><aside class="library"><div class="library-head"><strong>IsiVoltPro · Biblioteca práctica</strong><small>V4 · contenido técnico</small></div><div class="featured"><span>Ruta recomendada</span><h2>De información dispersa a mantenimiento trazable.</h2><p>Un recorrido por avisos, OT, activos, QR/NFC, preventivo e implantación gradual.</p></div><div class="library-links"><div><strong>Campo</strong><small>OT, fotos, cierre y QR.</small></div><div><strong>Gestión</strong><small>Planificación, activos y pendientes.</small></div><div><strong>Conocimiento</strong><small>Guías, normativa y buenas prácticas.</small></div></div></aside></div></section>

<section class="page-section page-section--soft" id="biblioteca"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Biblioteca práctica</span><h2>Seis temas que conectan<br/><span class="gradient-text">problema, método y herramienta.</span></h2></div><p>La V4 evita artículos genéricos. Cada recurso debe ayudar a ordenar una decisión o un proceso concreto.</p></div><div class="topics">{topics.map(([n,title,copy])=><article class="topic"><b>{n}</b><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>

<section class="page-section"><div class="page-shell authority"><div class="authority-main"><span class="eyebrow">Autoridad técnica</span><h2>No basta con decir<br/>que sabemos de mantenimiento.</h2><p>La confianza se construye explicando procesos con rigor, diferenciando hechos de ejemplos y mostrando cuándo una información procede de normativa, experiencia de campo o una propuesta de mejora.</p><div class="checks"><span>Fuente y fecha cuando aplique</span><span>Estado normativo claro</span><span>Ejemplos marcados como ejemplos</span><span>Aplicación práctica para técnicos</span></div></div><div class="authority-visual"><img src={journey} alt="Ruta conceptual de recursos y conocimiento de IsiVoltPro" loading="lazy"/></div></div></section>

<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Del conocimiento a la solución</span><h2>Aprender, ordenar<br/><span class="gradient-text">y después digitalizar.</span></h2></div><p>El contenido debe ayudar a entender por qué existe el producto, no funcionar como un apartado separado del resto de la marca.</p></div><div class="bridge"><article><strong>1 · Entender</strong><p>Guías y artículos aclaran problemas frecuentes de mantenimiento.</p></article><article><strong>2 · Estructurar</strong><p>Checklists, flujos y criterios ayudan a ordenar la operación.</p></article><article><strong>3 · Aplicar</strong><p>IsiVoltPro convierte ese método en un flujo usable desde oficina y campo.</p></article></div></div></section>

<section class="page-section"><div class="page-shell"><div class="cta"><div><h2>El contenido también vende confianza.</h2><p>La siguiente pieza de esta fase es Blog + Noticias V4: actualidad técnica con fuente, fecha, contexto y aplicación práctica.</p></div><div class="actions"><a class="btn btn--primary" href={blog}>Abrir Blog V4 →</a><a class="btn" href={sectors}>Ver Sectores</a><a class="btn" href={demo}>Solicitar demo</a></div></div></div></section>
</main><V3CommercialFooter/></body></html>
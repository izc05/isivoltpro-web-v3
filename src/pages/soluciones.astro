---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const contact = `${base}contacto/`;
const appMaintenance = `${base}app-mantenimiento/`;
const transition = `${base}de-whatsapp-excel-a-isivoltpro/`;
const moduleUrl = (slug: string) => `${base}modulos/${slug}/`;
const sectorUrl = (slug: string) => `${base}sectores/${slug}/`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Soluciones · IsiVoltPro" description="Soluciones prácticas de IsiVoltPro para avisos, órdenes de trabajo, mantenimiento preventivo, activos, documentación, técnicos, inventario y trazabilidad en autónomos y pequeñas empresas." path={`${base}soluciones/`} />
  <style is:inline>
    .solutions-hero{position:relative;padding:84px 0 82px;background:radial-gradient(circle at 76% 24%,rgba(102,84,224,.13),transparent 27%),radial-gradient(circle at 94% 58%,rgba(47,192,142,.10),transparent 18%),#fff}.solutions-hero__grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:72px;align-items:center}.solutions-hero h1{margin:17px 0 18px;font:800 clamp(50px,4.8vw,70px)/.98 var(--v3-font-display,system-ui);letter-spacing:-.064em}.solutions-hero h1 span{display:block;color:transparent;background:linear-gradient(90deg,#6b58df,#4aa7d2 52%,#35bd8f);-webkit-background-clip:text;background-clip:text}.solutions-hero p{max-width:560px;margin:0;color:#727d90;font-size:15px;line-height:1.72}.solutions-hero .btn--primary{background:#111827;border-color:#111827;color:#fff}.solution-workspace{position:relative;min-height:480px}.solution-workspace::before{content:'';position:absolute;inset:8% -4% 0 10%;border-radius:42px;background:linear-gradient(135deg,rgba(99,83,224,.15),rgba(55,166,212,.08) 48%,rgba(45,192,141,.11));filter:blur(30px)}.solution-workspace__panel{position:absolute;inset:22px 18px 24px 42px;border:1px solid #e5e9f2;border-radius:28px;background:rgba(255,255,255,.96);box-shadow:0 34px 84px rgba(58,67,109,.16);overflow:hidden;backdrop-filter:blur(14px)}.solution-workspace__bar{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid #edf0f5}.solution-workspace__bar strong{font-size:11px}.solution-workspace__bar small{color:#919aaa;font-size:8px}.solution-workspace__body{display:grid;grid-template-columns:108px 1fr;min-height:372px}.solution-workspace__nav{padding:18px 12px;background:#10182f;color:#b8c2d6}.solution-workspace__nav strong{display:block;margin:0 8px 16px;color:#fff;font-size:10px}.solution-workspace__nav span{display:block;margin:5px 0;padding:8px 9px;border-radius:9px;font-size:8px}.solution-workspace__nav span:first-of-type{background:linear-gradient(90deg,rgba(89,101,235,.32),rgba(110,84,224,.26));color:#fff}.solution-workspace__main{padding:18px;background:linear-gradient(180deg,#fbfcff,#f7f9fd)}.solution-workspace__top{display:flex;align-items:end;justify-content:space-between;gap:12px}.solution-workspace__top small{color:#8992a3;font-size:8px}.solution-workspace__top strong{display:block;margin-top:4px;font-size:18px}.solution-workspace__kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:15px}.solution-workspace__kpis div{padding:12px;border:1px solid #e9ecf3;border-radius:12px;background:#fff}.solution-workspace__kpis small{display:block;color:#8c95a5;font-size:7px}.solution-workspace__kpis b{display:block;margin-top:4px;font-size:18px}.solution-workspace__list{display:grid;gap:8px;margin-top:13px}.solution-workspace__row{display:grid;grid-template-columns:1.35fr .72fr .62fr;gap:8px;align-items:center;padding:10px 11px;border:1px solid #e9ecf3;border-radius:11px;background:#fff}.solution-workspace__row strong{font-size:8px}.solution-workspace__row small{font-size:7px;color:#8a94a4}.solution-workspace__status{justify-self:end;padding:5px 7px;border-radius:999px;background:#eef0ff;color:#6553dc;font-size:6px;font-weight:800}.solution-workspace__row:nth-child(2) .solution-workspace__status{background:#fff3ea;color:#d87735}.solution-workspace__row:nth-child(3) .solution-workspace__status{background:#eaf9f3;color:#229b70}.solution-workspace__flow{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:13px}.solution-workspace__flow span{padding:8px;border-radius:10px;background:#f0edff;color:#6655d8;text-align:center;font-size:6px;font-weight:800}.solution-workspace__flow span:nth-child(2){background:#eef6ff;color:#3f78d4}.solution-workspace__flow span:nth-child(3){background:#eefaf6;color:#279d73}.solution-workspace__flow span:nth-child(4){background:#fff4ed;color:#d77b3d}.solution-float{position:absolute;z-index:3;padding:11px 13px;border:1px solid #e5e9f1;border-radius:14px;background:#fff;box-shadow:0 16px 38px rgba(55,64,103,.14)}.solution-float strong{display:block;font-size:9px}.solution-float small{display:block;margin-top:3px;color:#8b94a3;font-size:7px}.solution-float--a{left:0;top:82px}.solution-float--b{right:0;top:38px}.solution-float--c{right:10px;bottom:30px}.solution-float--a strong{color:#6b56dd}.solution-float--b strong{color:#23a878}.solution-float--c strong{color:#d65ca8}
    .solution-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.solution-card{display:grid;grid-template-columns:auto 1fr;gap:18px;padding:28px;border:1px solid var(--line);border-radius:28px;background:#fff;box-shadow:var(--shadow-soft);color:inherit}.solution-card>i{width:50px;height:50px;display:grid;place-items:center;border-radius:16px;background:var(--tone,#eef3ff);color:var(--ink,var(--blue));font-style:normal;font-weight:900;font-size:19px}.solution-card h3{margin:2px 0 8px;font-size:22px;letter-spacing:-.035em}.solution-card p{margin:0;color:var(--muted);line-height:1.65}.solution-card small{display:block;margin-top:16px;color:#52617c;font-weight:800}
    .pain-outcomes{display:grid;gap:12px}.pain-outcome{display:grid;grid-template-columns:.86fr 1fr 1fr auto;gap:16px;align-items:center;padding:20px 22px;border:1px solid var(--line);border-radius:22px;background:#fff}.pain-outcome small{display:block;margin-bottom:6px;color:#8a94a6;font-size:10px;font-weight:850;text-transform:uppercase}.pain-outcome__problem strong{font-size:17px;line-height:1.25}.pain-outcome__answer,.pain-outcome__change{padding-left:16px;border-left:1px solid #edf0f5}.pain-outcome p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}.pain-outcome__answer b{color:#6253d8}.pain-outcome__change b{color:#1b9a72}
    .solution-band{display:grid;grid-template-columns:.9fr 1.1fr;gap:30px;align-items:center;padding:38px;border-radius:32px;background:linear-gradient(125deg,#0b1430,#162653 60%,#243c81);color:#fff}.solution-band h2{margin:0;font-size:clamp(34px,4.8vw,58px);line-height:1.03;letter-spacing:-.052em}.solution-band p{margin:15px 0 0;color:#c3cdea;line-height:1.7}.solution-flow{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.solution-flow article{padding:20px;border:1px solid var(--line);border-radius:20px;background:#fff}.solution-flow b{display:block;color:var(--blue);font-size:12px}.solution-flow strong{display:block;margin-top:18px;font-size:18px}.solution-flow small{display:block;margin-top:7px;color:var(--muted);line-height:1.5}
    @media(max-width:1020px){.pain-outcome{grid-template-columns:1fr 1fr}.pain-outcome .btn{justify-self:start}}
    @media(max-width:900px){.solutions-hero__grid,.solution-grid,.solution-band{grid-template-columns:1fr}.solution-workspace{min-height:430px}.solution-flow{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:620px){.pain-outcome{grid-template-columns:1fr}.pain-outcome__answer,.pain-outcome__change{padding:12px 0 0;border:0;border-top:1px solid #edf0f5}.pain-outcome .btn{width:100%;justify-content:center}}
    @media(max-width:560px){.solutions-hero{padding:58px 0}.solutions-hero h1{font-size:clamp(43px,12vw,56px)}.solution-workspace{min-height:350px}.solution-workspace__panel{inset:18px 2px 18px 14px}.solution-workspace__body{grid-template-columns:76px 1fr}.solution-workspace__nav{padding:14px 7px}.solution-workspace__main{padding:12px}.solution-workspace__kpis{grid-template-columns:1fr 1fr}.solution-workspace__kpis div:last-child{display:none}.solution-workspace__row{grid-template-columns:1fr}.solution-workspace__row small,.solution-workspace__status{justify-self:start}.solution-workspace__flow{grid-template-columns:1fr 1fr}.solution-float{padding:8px 9px}.solution-grid,.solution-flow{grid-template-columns:1fr}.solution-card{padding:22px;grid-template-columns:1fr}.solution-band{padding:28px 22px}.solution-band .btn{width:100%}}
  </style>
</head>
<body>
  <V3CommercialHeader />
  <main class="page-main">
    <section class="solutions-hero">
      <div class="page-shell solutions-hero__grid">
        <div><span class="eyebrow">Empieza por el problema, no por el software</span><h1>Cuéntanos qué te hace perder tiempo.<span>IsiVoltPro organiza la solución.</span></h1><p>No necesitas saber qué módulo comprar. Si los avisos se pierden, los preventivos se olvidan, las fotos están repartidas, falta material o coordinar técnicos exige llamadas, empezamos ahí.</p><div class="page-hero__actions"><a class="btn btn--primary" href={contact}>Contar mi problema →</a><a class="btn" href={transition}>¿WhatsApp y Excel se quedan cortos?</a></div></div>
        <div class="solution-workspace" aria-label="Workspace conceptual de problemas y soluciones IsiVoltPro"><div class="solution-workspace__panel"><div class="solution-workspace__bar"><strong>IsiVoltPro · centro de trabajo</strong><small>Vista conceptual</small></div><div class="solution-workspace__body"><aside class="solution-workspace__nav"><strong>IsiVoltPro</strong><span>Resumen</span><span>Avisos</span><span>OT</span><span>Activos</span><span>Preventivo</span></aside><div class="solution-workspace__main"><div class="solution-workspace__top"><div><small>OPERACIÓN DE HOY</small><strong>Todo lo importante, visible.</strong></div><small>Datos de demostración</small></div><div class="solution-workspace__kpis"><div><small>Avisos nuevos</small><b>3</b></div><div><small>OT abiertas</small><b>12</b></div><div><small>Preventivos</small><b>8</b></div></div><div class="solution-workspace__list"><div class="solution-workspace__row"><div><strong>Climatización · Planta 2</strong><small>Equipo con histórico disponible</small></div><small>OT-0148</small><span class="solution-workspace__status">En curso</span></div><div class="solution-workspace__row"><div><strong>Cuadro eléctrico · Sala técnica</strong><small>Aviso pendiente de asignar</small></div><small>AV-0062</small><span class="solution-workspace__status">Pendiente</span></div><div class="solution-workspace__row"><div><strong>Bomba secundaria · ACS</strong><small>Preventivo programado</small></div><small>PR-021</small><span class="solution-workspace__status">Planificado</span></div></div><div class="solution-workspace__flow"><span>Detectar</span><span>Organizar</span><span>Resolver</span><span>Conservar</span></div></div></div></div><div class="solution-float solution-float--a"><strong>Aviso claro</strong><small>Sin perder contexto</small></div><div class="solution-float solution-float--b"><strong>Activo conectado</strong><small>Histórico disponible</small></div><div class="solution-float solution-float--c"><strong>Cierre útil</strong><small>Evidencias + resultado</small></div></div>
      </div>
    </section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Problemas cotidianos</span><h2>Lo que hoy te obliga a<br/><span class="gradient-text">buscar, llamar o recordar.</span></h2></div><p>Situaciones habituales de autónomos y pequeños equipos. Cada solución conecta con el resto para no crear otro sistema aislado.</p></div><div class="solution-grid">
      <a class="solution-card" href={moduleUrl('avisos-incidencias')}><i>!</i><div><h3>“Los avisos me llegan por todas partes”</h3><p>Registra cliente, equipo, prioridad, descripción y evidencias para que una llamada o WhatsApp se convierta en trabajo trazable.</p><small>Solución para avisos →</small></div></a>
      <a class="solution-card" href={moduleUrl('ordenes-de-trabajo')} style="--tone:#f2efff;--ink:#6544e8"><i>✓</i><div><h3>“No sé qué trabajos siguen abiertos”</h3><p>Centraliza responsable, estado, notas, fotos y resultado desde que el trabajo entra hasta que queda cerrado.</p><small>Solución para OT →</small></div></a>
      <a class="solution-card" href={moduleUrl('mantenimiento-preventivo')} style="--tone:#eaf9f3;--ink:#159f71"><i>⚙</i><div><h3>“Las revisiones dependen de acordarme”</h3><p>Convierte periodicidades en trabajo visible y deja constancia de qué se revisó, cuándo y con qué resultado.</p><small>Solución para preventivo →</small></div></a>
      <a class="solution-card" href={moduleUrl('activos')} style="--tone:#eef3ff;--ink:#175cff"><i>▣</i><div><h3>“Cada vez que vuelvo a un equipo empiezo de cero”</h3><p>Ficha, ubicación, fotos, documentos, averías y actuaciones quedan alrededor del mismo activo.</p><small>Solución para activos →</small></div></a>
      <a class="solution-card" href={moduleUrl('documentacion')} style="--tone:#eafafd;--ink:#139db9"><i>▤</i><div><h3>“Tengo fotos y documentos pero nunca donde los necesito”</h3><p>Relaciona evidencias, manuales e informes con el cliente, instalación, activo o trabajo correspondiente.</p><small>Solución documental →</small></div></a>
      <a class="solution-card" href={sectorUrl('empresas-mantenedoras')} style="--tone:#fff3e9;--ink:#d96c20"><i>👥</i><div><h3>“Coordino al equipo a base de llamadas”</h3><p>Comparte prioridades, asignaciones y contexto para trabajar sobre la misma información.</p><small>Solución para equipos →</small></div></a>
    </div><div class="home-more"><a class="btn" href={transition}>Ver cuándo WhatsApp + Excel dejan de ser suficientes →</a></div></div></section>

    <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Del problema al cambio diario</span><h2>No basta con guardar datos.<br/><span class="gradient-text">Tienen que evitar trabajo repetido.</span></h2></div><p>Cuatro fricciones que aparecen al crecer. La propuesta es conectar la información que ya necesitas, no añadir burocracia.</p></div><div class="pain-outcomes">
      <article class="pain-outcome"><div class="pain-outcome__problem"><small>Problema</small><strong>“No sé qué material queda ni qué se gastó.”</strong></div><div class="pain-outcome__answer"><small>Con IsiVoltPro</small><p><b>Inventario conectado:</b> material y herramientas consultables desde el contexto del trabajo.</p></div><div class="pain-outcome__change"><small>Qué cambia</small><p><b>Menos búsquedas:</b> sabes qué necesitas y el cierre puede dejar constancia de lo utilizado.</p></div><a class="btn" href={moduleUrl('inventario')}>Ver Inventario →</a></article>
      <article class="pain-outcome"><div class="pain-outcome__problem"><small>Problema</small><strong>“Días después reconstruyo qué hicimos.”</strong></div><div class="pain-outcome__answer"><small>Con IsiVoltPro</small><p><b>Cierre con evidencias:</b> notas, fotos, materiales, estado y resultado unidos a la orden y al activo.</p></div><div class="pain-outcome__change"><small>Qué cambia</small><p><b>Mejor justificación:</b> partes del registro de la intervención, no de recuerdos dispersos.</p></div><a class="btn" href={moduleUrl('ordenes-de-trabajo')}>Ver Órdenes →</a></article>
      <article class="pain-outcome"><div class="pain-outcome__problem"><small>Problema</small><strong>“Repito cliente, equipo y ubicación en varios sitios.”</strong></div><div class="pain-outcome__answer"><small>Con IsiVoltPro</small><p><b>Contexto reutilizable:</b> aviso, OT, fotos e histórico apuntan al mismo activo y ubicación.</p></div><div class="pain-outcome__change"><small>Qué cambia</small><p><b>Menos duplicidad:</b> la siguiente persona recibe el contexto sin volver a preguntarlo.</p></div><a class="btn" href={moduleUrl('activos')}>Ver Activos →</a></article>
      <article class="pain-outcome"><div class="pain-outcome__problem"><small>Problema</small><strong>“Sé que se hizo, pero no encuentro quién, cuándo o cómo.”</strong></div><div class="pain-outcome__answer"><small>Con IsiVoltPro</small><p><b>Trazabilidad operativa:</b> responsable, estado y evidencias permanecen relacionados con el activo.</p></div><div class="pain-outcome__change"><small>Qué cambia</small><p><b>Decides con contexto:</b> revisas lo anterior antes de repetir pruebas, llamadas o búsquedas.</p></div><a class="btn" href={appMaintenance}>Ver App Mantenimiento →</a></article>
    </div></div></section>

    <section class="page-section"><div class="page-shell"><div class="solution-band"><div><span class="eyebrow" style="color:#9eb6ff">Una puerta de entrada sencilla</span><h2>App Mantenimiento:<br/>el trabajo diario en un solo sitio.</h2><p>Una experiencia enfocada en avisos, OT, activos, preventivos, fotos e histórico para trabajar desde móvil y escritorio sin empezar implantando una suite enorme.</p></div><div><div class="page-hero__actions"><a class="btn btn--primary" href={appMaintenance}>Conocer App Mantenimiento →</a><a class="btn" style="background:#fff;color:#17233f" href={contact}>Verlo sobre mi negocio</a></div></div></div></div></section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Un mismo hilo</span><h2>Resolver hoy y dejar<br/><span class="gradient-text">contexto para mañana.</span></h2></div><p>La diferencia no está en añadir formularios. Está en que cada intervención mejora la información disponible para la siguiente.</p></div><div class="solution-flow"><article><b>01</b><strong>Detectas</strong><small>Un aviso, una revisión o una necesidad.</small></article><article><b>02</b><strong>Identificas</strong><small>Cliente, ubicación y activo correcto.</small></article><article><b>03</b><strong>Organizas</strong><small>Prioridad, responsable y trabajo.</small></article><article><b>04</b><strong>Resuelves</strong><small>Notas, fotos, materiales y resultado.</small></article><article><b>05</b><strong>Conservas</strong><small>El histórico queda listo para la próxima vez.</small></article></div></div></section>

    <section class="page-section"><div class="page-shell"><div class="callout"><div><h2>No adaptes tu negocio al software.</h2><p>Empezamos por cómo trabajas hoy y buscamos la configuración mínima que realmente elimine fricción.</p></div><a class="btn btn--primary" href={contact}>Hablar de mi caso →</a></div></div></section>
  </main>
  <V3CommercialFooter />
</body>
</html>
---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const demo = `${base}preview-v4/demo/`;
const solutions = `${base}preview-v4/soluciones/`;
const apps = `${base}preview-v4/apps/`;
const heroPhoto = `${base}media/v4/home-maintenance-tablet.webp`;
const fieldPhoto = `${base}media/v4/app-qr-mobile.webp`;
const sectors = [
  { icon:'⚙', title:'Empresas mantenedoras', copy:'Coordina clientes, ubicaciones, activos, avisos y técnicos sin perder el contexto entre oficina y campo.', bullets:['Asignación y seguimiento de OT','Evidencias de intervención','Histórico por activo'] },
  { icon:'▣', title:'Instalaciones propias', copy:'Da visibilidad al estado de equipos e instalaciones y conecta incidencias con preventivo, documentación y responsables.', bullets:['Inventario técnico ordenado','Preventivos y revisiones','Documentación vinculada'] },
  { icon:'⚡', title:'Electricidad', copy:'Organiza cuadros, circuitos, incidencias, inspecciones y actuaciones con trazabilidad técnica y soporte documental.', bullets:['Cuadros y activos eléctricos','Defectos, fotos y acciones','Histórico de intervenciones'] },
  { icon:'❄', title:'Climatización y frío', copy:'Mantén equipos, ubicaciones y revisiones conectados para que cada actuación parta del historial correcto.', bullets:['UTA, bombas y equipos HVAC','Preventivos y correctivos','Evidencias y documentación'] },
  { icon:'◎', title:'Multisede', copy:'Separa ubicaciones sin perder una visión conjunta de pendientes, activos, técnicos y actividad.', bullets:['Sedes y zonas diferenciadas','Vista global de operación','Mismo criterio de trabajo'] },
];
---
<!doctype html>
<html lang="es"><head>
  <V3Seo title="Sectores V4 · IsiVoltPro" description="Vista previa de Sectores V4: IsiVoltPro para empresas mantenedoras, instalaciones propias, electricidad, climatización y operaciones multisede." path={`${base}preview-v4/sectores/`} noindex={true} />
  <style is:inline>
    .strip{background:#0d1730;color:#fff}.strip .page-shell{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:12px}.strip a{color:#dfe7ff;font-weight:800}.hero{padding:84px 0 70px;background:radial-gradient(circle at 78% 8%,rgba(23,92,255,.12),transparent 28%),radial-gradient(circle at 92% 58%,rgba(109,74,255,.12),transparent 22%),#fff}.hero-grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(480px,1.08fr);gap:58px;align-items:center}.hero h1{margin:18px 0 20px;font:800 clamp(52px,5.8vw,82px)/.97 Manrope,sans-serif;letter-spacing:-.065em}.hero p{max-width:660px;margin:0;color:#68748a;font-size:18px;line-height:1.72}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.hero-photo{position:relative;overflow:hidden;border-radius:32px;background:#eef2f7;box-shadow:0 32px 86px rgba(45,59,98,.16)}.hero-photo img{display:block;width:100%;height:470px;object-fit:cover}.hero-photo figcaption{position:absolute;left:18px;bottom:18px;padding:9px 12px;border-radius:999px;background:rgba(13,23,48,.84);color:#fff;font-size:10px;font-weight:850;backdrop-filter:blur(8px)}.sector-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.sector-card{padding:24px;border:1px solid #e5e9f2;border-radius:24px;background:#fff;box-shadow:0 16px 42px rgba(54,64,102,.06)}.sector-card i{display:grid;place-items:center;width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,#edf4ff,#f3efff);color:#5b58da;font-style:normal;font-size:20px}.sector-card h3{margin:18px 0 9px;font-size:21px;letter-spacing:-.025em}.sector-card p{margin:0;color:#748096;font-size:13px;line-height:1.62}.sector-card ul{margin:17px 0 0;padding:0;list-style:none;display:grid;gap:8px}.sector-card li{display:flex;gap:7px;color:#4b5870;font-size:11px;line-height:1.4}.sector-card li:before{content:'✓';color:#18a979;font-weight:900}.method{display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,.85fr);gap:54px;align-items:center}.method h2{margin:16px 0;font:800 clamp(40px,4.7vw,62px)/1.02 Manrope,sans-serif;letter-spacing:-.055em}.method p{color:#718096;line-height:1.72}.method-photo{overflow:hidden;border-radius:30px;box-shadow:0 26px 70px rgba(45,59,98,.14)}.method-photo img{display:block;width:100%;height:390px;object-fit:cover}.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:26px}.principles article{padding:20px;border:1px solid #e8ebf3;border-radius:19px;background:#fff}.principles strong{display:block}.principles small{display:block;margin-top:7px;color:#7a869a;line-height:1.5}.cta{display:grid;grid-template-columns:1fr auto;align-items:center;gap:26px;padding:40px;border-radius:30px;background:linear-gradient(115deg,#0e1830,#1b2d58 56%,#342676);color:#fff}.cta h2{margin:0;font:800 clamp(36px,4.4vw,56px)/1.03 Manrope,sans-serif;letter-spacing:-.052em}.cta p{max-width:700px;margin:12px 0 0;color:#c7d1e7;line-height:1.65}.cta .btn{background:#fff;color:#17213d;border-color:#fff}@media(max-width:1080px){.sector-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:900px){.hero-grid,.method,.cta{grid-template-columns:1fr}.hero-photo img{height:410px}}@media(max-width:680px){.hero{padding:58px 0 48px}.hero h1{font-size:clamp(44px,13vw,62px)}.hero-photo img,.method-photo img{height:320px}.sector-grid,.principles{grid-template-columns:1fr}.strip .page-shell{padding:8px 0;flex-direction:column;align-items:flex-start;gap:4px}.cta{padding:28px 22px}}
  </style>
</head><body>
  <V3CommercialHeader />
  <div class="strip"><div class="page-shell"><strong>Preview V4 · Fase 5 · Sectores</strong><span>Casos de uso → contexto real · <a href={`${base}preview-v4/`}>Mapa V4</a></span></div></div>
  <main class="page-main">
    <section class="hero"><div class="page-shell hero-grid"><div><span class="eyebrow">Una plataforma · diferentes operaciones</span><h1>El mismo núcleo.<br/><span class="gradient-text">Distinto trabajo real.</span></h1><p>IsiVoltPro no debería hablar igual a una empresa mantenedora, a un responsable de instalaciones o a un técnico eléctrico. La V4 presenta cada sector desde sus problemas, activos y decisiones habituales.</p><div class="actions"><a class="btn btn--primary" href={demo}>Solicitar demo →</a><a class="btn" href={solutions}>Ver Soluciones V4</a></div></div><figure class="hero-photo"><img src={heroPhoto} alt="Técnico de mantenimiento usando una tablet en una sala de instalaciones" width="836" height="470" loading="eager"/><figcaption>Mantenimiento real · producto en contexto</figcaption></figure></div></section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Sectores prioritarios</span><h2>Que cada visitante se reconozca<br/><span class="gradient-text">antes de ver una lista de funciones.</span></h2></div><p>La página deja de ser un catálogo genérico y pasa a explicar para quién encaja IsiVoltPro y qué parte del trabajo ayuda a ordenar.</p></div><div class="sector-grid">{sectors.map((sector)=><article class="sector-card"><i aria-hidden="true">{sector.icon}</i><h3>{sector.title}</h3><p>{sector.copy}</p><ul>{sector.bullets.map((item)=><li>{item}</li>)}</ul></article>)}</div></div></section>

    <section class="page-section"><div class="page-shell method"><div><span class="eyebrow">Campo + coordinación + histórico</span><h2>No vendemos cinco programas.<br/><span class="gradient-text">Adaptamos un mismo contexto.</span></h2><p>El activo, la ubicación, la OT, las evidencias y el histórico siguen conectados. Lo que cambia es qué información ponemos primero según el tipo de operación.</p><div class="principles"><article><strong>Empieza por el problema</strong><small>Avisos, preventivos, activos o inspecciones según el caso.</small></article><article><strong>Trabaja en campo</strong><small>QR/NFC, móvil, fotos y cierre junto al equipo.</small></article><article><strong>Conserva contexto</strong><small>El trabajo realizado alimenta el histórico del activo.</small></article></div><div class="actions"><a class="btn btn--primary" href={apps}>Ver Apps V4 →</a></div></div><figure class="method-photo"><img src={fieldPhoto} alt="Técnico identificando un equipo mediante un código QR con el móvil" width="700" height="525" loading="lazy"/></figure></div></section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="cta"><div><h2>Tu sector cambia.<br/>El contexto no debería perderse.</h2><p>La demo debe partir de cómo trabajas hoy y enseñar solo lo que tiene sentido para tu operación. Sin cifras inventadas ni promesas que no podamos demostrar.</p></div><a class="btn" href={demo}>Hablar de mi caso →</a></div></div></section>
  </main>
  <V3CommercialFooter />
</body></html>
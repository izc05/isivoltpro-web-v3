    <script is:inline define:vars={{ ecosystemUrl }}>
      const scene = document.querySelector('.scene');
      const frame = scene?.querySelector('iframe');
      const button = scene?.querySelector('button');
      let started = false;
      function startScene() {
        if (started || !scene || !frame) return;
        started = true;
        scene.classList.add('is-loading');
        frame.src = ecosystemUrl;
        frame.addEventListener('load', () => {
          try {
            const doc = frame.contentDocument;
            if (doc && !doc.getElementById('home-v1-cleanup')) {
              const style = doc.createElement('style');
              style.id = 'home-v1-cleanup';
              style.textContent = '.topbar,.metrics,.lab-button{display:none!important}';
              doc.head.appendChild(style);
            }
          } catch (error) {
            console.warn('[ISIVOLTPRO] No se pudo limpiar el cromado de laboratorio', error);
          }
          scene.classList.remove('is-loading');
          scene.classList.add('is-ready');
        }, { once: true });
      }
      button?.addEventListener('click', startScene);
      if ('IntersectionObserver' in window && scene) {
        const observer = new IntersectionObserver((entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            startScene();
            observer.disconnect();
          }
        }, { rootMargin: '350px 0px' });
        observer.observe(scene);
      }
    </script>

---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
const base=import.meta.env.BASE_URL;
const demo=`${base}preview-v4/demo/`;
const contact=`${base}preview-v4/contacto/`;
const pilot=`${base}piloto/`;
const plans=[
 {name:'Autónomo',fit:'Para empezar a ordenar el trabajo propio',lead:'Un núcleo ligero para activos, avisos y órdenes sin desplegar una suite sobredimensionada.',items:['Activos y ubicaciones','Avisos y órdenes de trabajo','Fotos, documentos e histórico','QR/NFC como ampliación natural']},
 {name:'Equipo',fit:'Para coordinar varias personas y trabajos',lead:'Más visibilidad sobre responsables, pendientes y preventivos manteniendo un flujo sencillo para campo.',items:['Todo lo anterior','Técnicos y asignaciones','Preventivo y planificación','Visión operativa compartida']},
 {name:'Empresa',fit:'Para operaciones con más estructura o sedes',lead:'Una base preparada para crecer en permisos, ubicaciones, implantación y necesidades de integración.',items:['Todo lo anterior','Multisede y roles','Implantación acompañada','Integraciones a validar por alcance']},
];
---
<!doctype html><html lang="es"><head>
<V3Seo title="Planes V4 · IsiVoltPro" description="Planes V4 de IsiVoltPro planteados por encaje y complejidad operativa, sin precios ficticios mientras se validan mediante pilotos." path={`${base}preview-v4/precios/`} noindex={true}/>
<style is:inline>
.strip{background:#0d1730;color:#fff}.strip .page-shell{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:12px}.strip a{color:#dfe7ff;font-weight:800}.hero{padding:86px 0 68px;background:radial-gradient(circle at 78% 12%,rgba(47,104,255,.12),transparent 27%),radial-gradient(circle at 91% 62%,rgba(36,197,140,.10),transparent 23%),#fff}.hero-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(440px,.8fr);gap:64px;align-items:center}.hero h1{margin:18px 0 20px;font:800 clamp(52px,5.8vw,82px)/.97 Manrope,sans-serif;letter-spacing:-.065em}.hero p{max-width:650px;color:#68748a;font-size:18px;line-height:1.72}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.truth{padding:30px;border:1px solid #e4e8f1;border-radius:30px;background:linear-gradient(145deg,#fff,#f8faff);box-shadow:0 28px 76px rgba(50,61,105,.12)}.truth b{display:inline-flex;padding:7px 10px;border-radius:999px;background:#eefaf6;color:#168965;font-size:10px;text-transform:uppercase;letter-spacing:.07em}.truth h2{margin:15px 0 10px;font-size:30px;letter-spacing:-.04em}.truth p{margin:0;color:#748096;line-height:1.65}.truth strong{display:block;margin-top:20px;font-size:38px;letter-spacing:-.05em}.truth small{display:block;margin-top:4px;color:#8a94a7}.plan-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px;align-items:stretch}.plan{position:relative;display:flex;flex-direction:column;padding:28px;border:1px solid #e4e8f1;border-radius:26px;background:#fff;box-shadow:0 17px 44px rgba(54,64,102,.065)}.plan:nth-child(2){border-color:#dcd5ff;background:linear-gradient(180deg,#fff,#faf9ff);box-shadow:0 22px 58px rgba(84,71,183,.10)}.plan-label{display:inline-flex;width:max-content;padding:6px 9px;border-radius:999px;background:#f1efff;color:#6652d9;font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.07em}.plan h3{margin:17px 0 5px;font-size:29px;letter-spacing:-.04em}.fit{color:#26334b;font-size:13px;font-weight:850}.plan>p{margin:12px 0 0;color:#758197;line-height:1.6;font-size:13px}.price{margin:22px 0 0;padding:16px;border-radius:17px;background:#f8faff}.price strong{display:block;font-size:22px}.price small{display:block;margin-top:5px;color:#8791a3;line-height:1.45}.plan ul{list-style:none;margin:22px 0 0;padding:0;display:grid;gap:10px}.plan li{display:flex;gap:8px;color:#435069;font-size:12px}.plan li:before{content:'✓';color:#18a979;font-weight:900}.plan .btn{margin-top:auto}.compare{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.compare article{padding:21px;border:1px solid #e5e9f2;border-radius:21px;background:#fff}.compare strong{display:block;font-size:17px}.compare p{margin:7px 0 0;color:#788499;font-size:12px;line-height:1.55}.implementation{display:grid;grid-template-columns:1.05fr .95fr;gap:22px}.implementation-main{padding:36px;border-radius:30px;background:linear-gradient(125deg,#0e1830,#1b2d58 58%,#342676);color:#fff}.implementation-main h2{margin:14px 0 12px;font:800 clamp(38px,4.5vw,58px)/1.03 Manrope,sans-serif;letter-spacing:-.052em}.implementation-main p{color:#c7d1e7;line-height:1.7}.implementation-side{display:grid;grid-template-columns:1fr 1fr;gap:12px}.implementation-side article{padding:21px;border:1px solid #e5e9f2;border-radius:21px;background:#fff}.implementation-side strong{display:block}.implementation-side p{margin:7px 0 0;color:#788499;font-size:12px;line-height:1.55}.cta{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;padding:40px;border-radius:30px;background:linear-gradient(115deg,#f2f7ff,#f4f0ff 48%,#effaf6)}.cta h2{margin:0;font:800 clamp(34px,4vw,50px)/1.04 Manrope,sans-serif;letter-spacing:-.048em}.cta p{margin:11px 0 0;color:#6f7b90;line-height:1.65}@media(max-width:980px){.hero-grid,.implementation,.cta{grid-template-columns:1fr}.compare{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.plan-grid,.compare,.implementation-side{grid-template-columns:1fr}.hero{padding:58px 0 48px}.hero h1{font-size:clamp(44px,13vw,62px)}.strip .page-shell{padding:8px 0;flex-direction:column;align-items:flex-start;gap:4px}.implementation-main,.cta{padding:28px 22px}}
</style></head><body>
<V3CommercialHeader/>
<div class="strip"><div class="page-shell"><strong>Preview V4 · Fase 8 · Planes</strong><span>Encaje antes que precio · <a href={`${base}preview-v4/`}>Mapa V4</a></span></div></div>
<main class="page-main">
<section class="hero"><div class="page-shell hero-grid"><div><span class="eyebrow">Planes que explican para quién encaja cada nivel</span><h1>Empieza por lo necesario.<br/><span class="gradient-text">Crece cuando aporte valor.</span></h1><p>IsiVoltPro no necesita fingir una tabla de precios cerrada antes de validar implantación, soporte y alcance con operaciones reales. La V4 explica primero el encaje.</p><div class="actions"><a class="btn btn--primary" href={demo}>Ver Demo V4 →</a><a class="btn" href={pilot}>Cómo funciona el piloto</a></div></div><aside class="truth"><b>Transparencia comercial</b><h2>Precio todavía en validación.</h2><p>No publicaremos cuotas inventadas para rellenar una tabla. Los pilotos deben ayudarnos a validar qué incluye cada nivel y cuánto soporte requiere.</p><strong>— €</strong><small>Hasta disponer de una propuesta comercial aprobada y sostenible.</small></aside></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Tres puntos de entrada</span><h2>No son tres productos.<br/><span class="gradient-text">Es el mismo núcleo con distinto alcance.</span></h2></div><p>El objetivo es evitar que una operación pequeña pague o configure complejidad que no necesita y que una empresa con más estructura pueda crecer sin rehacer el sistema.</p></div><div class="plan-grid">{plans.map((plan,index)=><article class="plan"><span class="plan-label">{index===1?'Punto de partida habitual':'Encaje V4'}</span><h3>{plan.name}</h3><span class="fit">{plan.fit}</span><p>{plan.lead}</p><div class="price"><strong>Precio en validación</strong><small>Se publicará solo cuando alcance, soporte e implantación estén definidos.</small></div><ul>{plan.items.map(item=><li>{item}</li>)}</ul><a class="btn" href={contact}>Hablar de este encaje →</a></article>)}</div></div></section>
<section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Qué cambia realmente entre niveles</span><h2>Más que límites artificiales,<br/><span class="gradient-text">cambia la complejidad operativa.</span></h2></div><p>La propuesta final deberá convertir estas diferencias en una tabla comercial sencilla, una vez validadas con pilotos.</p></div><div class="compare"><article><strong>Personas</strong><p>Trabajo individual, coordinación de equipo o roles con más responsabilidad.</p></article><article><strong>Ubicaciones</strong><p>Una operación sencilla o varias sedes con visión conjunta.</p></article><article><strong>Planificación</strong><p>Desde OT básicas hasta preventivo, programación y seguimiento.</p></article><article><strong>Implantación</strong><p>Desde arranque ligero hasta importaciones, formación e integraciones.</p></article></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell implementation"><div class="implementation-main"><span class="eyebrow">El software no es todo el coste</span><h2>Una buena implantación también forma parte del producto.</h2><p>Para que IsiVoltPro genere valor, habrá casos donde sea necesario ordenar datos, importar activos, definir nomenclaturas, preparar QR/NFC o acompañar al equipo. La V4 separará con claridad suscripción e implantación cuando los precios estén validados.</p></div><div class="implementation-side"><article><strong>Datos iniciales</strong><p>Clientes, ubicaciones, activos y documentación que merece importar.</p></article><article><strong>QR / NFC</strong><p>Etiquetado, identificación y criterios para trabajar en campo.</p></article><article><strong>Configuración</strong><p>Estados, roles, preventivos y forma de cerrar trabajos.</p></article><article><strong>Formación</strong><p>Arranque breve para técnicos y responsables sin convertirlo en un proyecto eterno.</p></article></div></div></section>
<section class="page-section"><div class="page-shell"><div class="cta"><div><h2>Primero valida el flujo. Después hablamos de precio.</h2><p>La demo y el piloto deben confirmar que IsiVoltPro resuelve un problema real antes de convertir la conversación en una tarifa.</p></div><div class="actions" style="margin-top:0"><a class="btn btn--primary" href={demo}>Ver demo →</a><a class="btn" href={contact}>Contacto V4</a></div></div></div></section>
</main><V3CommercialFooter/></body></html>
---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#02050a" />
    <meta name="description" content="ISIVOLTPRO phase 2.9 optimized industrial digital twin scene." />
    <link rel="preconnect" href="https://raw.githubusercontent.com" crossorigin />
    <title>ISIVOLTPRO · Phase 2.9</title>
  </head>
  <body>
    <canvas id="webgl" aria-hidden="true"></canvas>

    <header class="topbar">
      <a class="brand" href={base}>ISIVOLT<strong>PRO</strong></a>
      <span class="phase">FASE 2.9 / PERFORMANCE BUDGET</span>
      <a class="back" href={`${base}lab-3d-phase28/`}>BACK TO 2.8</a>
    </header>

    <aside class="metrics" aria-live="polite">
      <div><span>MECHANICAL</span><strong id="pipe-status">LOADING</strong></div>
      <div><span>HVAC</span><strong id="hvac-status">LOADING</strong></div>
      <div><span>HVAC UNIT</span><strong id="aircon-status">LOADING</strong></div>
      <div><span>ELECTRICAL</span><strong id="electrical-status">LOADING</strong></div>
      <div><span>FPS</span><strong id="fps">--</strong></div>
      <div><span>DPR</span><strong id="dpr">--</strong></div>
      <div><span>CALLS</span><strong id="calls">--</strong></div>
      <div><span>TRIS</span><strong id="tris">--</strong></div>
    </aside>

    <main id="story">
      <section class="chapter active"><div class="copy">
        <p class="eyebrow">INDUSTRIAL DIGITAL TWIN</p>
        <h1>More headroom.<br />Same plant.</h1>
        <p class="body-copy">Phase 2.9 keeps the composed installation while reducing avoidable render cost and preparing space for higher-quality equipment later.</p>
        <span class="scroll-hint">ENTER THE OPTIMIZED PLANT <i>↓</i></span>
      </div></section>

      <section class="chapter"><div class="copy right-copy">
        <p class="index">02 / MECHANICAL</p><p class="eyebrow">SHARED GEOMETRY · REAL PIPES</p>
        <h2>Detail stays.<br />Waste goes.</h2>
        <p class="body-copy">Repeated procedural equipment now reuses geometry and the real pipe network remains visually dominant without expensive thin-object shadows.</p>
      </div></section>

      <section class="chapter"><div class="copy">
        <p class="index">03 / HVAC</p><p class="eyebrow">DUCTS · SUPPORTS · CLIMATE</p>
        <h2>Air stays<br />lightweight.</h2>
        <p class="body-copy">Ductwork, supports and the real outdoor unit retain their hierarchy while post-processing and dynamic quality are kept under control.</p>
      </div></section>

      <section class="chapter"><div class="copy right-copy">
        <p class="index">04 / ELECTRICAL</p><p class="eyebrow">PANELS · AISLE · TRAY</p>
        <h2>Equipment keeps<br />the expensive shadows.</h2>
        <p class="body-copy">Large cabinets and structures preserve depth; small pipes, ducts and signals no longer spend the same shadow budget.</p>
      </div></section>

      <section class="chapter"><div class="copy">
        <p class="index">05 / QUALITY CONTROL</p><p class="eyebrow">FPS · DPR · DRAW CALLS · TRIS</p>
        <h2>Quality adapts<br />before it stutters.</h2>
        <p class="body-copy">The scene can trim pixel density in small steps only if sustained frame rate drops, then recover when enough performance returns.</p>
      </div></section>

      <section class="chapter"><div class="copy end-copy">
        <p class="index">06 / CHECKPOINT</p><p class="eyebrow">PHASE 2.9</p>
        <h2>Ready for<br />more realism.</h2>
        <p class="body-copy">This performance budget is the base for the next quality pass: real pumps, valves, trays, signage, textures and the definitive Core.</p>
        <a class="lab-button" href={`${base}lab-3d-phase28/`}>COMPARE WITH 2.8 <span>→</span></a>
      </div></section>
    </main>

    <div id="no-webgl" hidden><strong>3D unavailable</strong><p>This checkpoint needs WebGL.</p><a href={base}>Return home</a></div>

    <script>
      import * as THREE from 'three';
      import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
      import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
      import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
      import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';
      import { OutputPass } from 'three/examples/jsm/postprocessing/OutputPass.js';
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);
      THREE.Cache.enabled = true;

      const PIPE_ASSET_URL = 'https://raw.githubusercontent.com/KrazIvan/GodotVR_Test/6dc918140151c3235406a3f616a765e11293285a/Ivan%20VR/models/props/pipe/modular_industrial_pipes_01_4k.gltf';
      const HVAC_ASSET_URL = 'https://raw.githubusercontent.com/Hona/daxship/d63856c6af9aba445a4fe8bf832d0e0ecf2572e5/apps/web/public/assets/models/environment/poly-haven/modular_airduct_circular_01/modular_airduct_circular_01_1k.gltf';
      const ELECTRICAL_ASSET_URL = 'https://raw.githubusercontent.com/adamkhatib/PeakBrake/87be08e1b90a6cfc59cd7364488cdca9053a16a3/public/assets/3d/polyhaven/utility_box_01/utility_box_01_1k.gltf';
      const AIRCON_ASSET_URL = 'https://raw.githubusercontent.com/VoxogoBrusch/the-levels/1e7c37785504d23d9a2f669b3b922eac14cedb01/public/assets/models/exterior_aircon_unit/exterior_aircon_unit_1k.gltf';
      const PIXEL = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Y9Zf6AAAAAASUVORK5CYII=';

      const canvas = document.querySelector('#webgl');
      const pipeStatus = document.querySelector('#pipe-status');
      const hvacStatus = document.querySelector('#hvac-status');
      const airconStatus = document.querySelector('#aircon-status');
      const electricalStatus = document.querySelector('#electrical-status');
      const fpsEl = document.querySelector('#fps');
      const dprEl = document.querySelector('#dpr');
      const callsEl = document.querySelector('#calls');
      const trisEl = document.querySelector('#tris');
      const noWebgl = document.querySelector('#no-webgl');

      const supportsWebGL = (() => {
        try {
          const test = document.createElement('canvas');
          return Boolean(test.getContext('webgl2') || test.getContext('webgl'));
        } catch { return false; }
      })();

      if (!supportsWebGL || !(canvas instanceof HTMLCanvasElement)) {
        if (canvas) canvas.remove();
        if (noWebgl instanceof HTMLElement) noWebgl.hidden = false;
      } else {
        const mobile = window.matchMedia('(max-width: 760px)').matches;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const dprCap = mobile ? 1.0 : 1.3;
        const dprFloor = mobile ? 0.78 : 0.9;
        let qualityDpr = Math.min(window.devicePixelRatio, mobile ? 0.95 : 1.25);

        const renderer = new THREE.WebGLRenderer({ canvas, antialias: false, powerPreference: 'high-performance', stencil: false });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(qualityDpr);
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 0.93;
        renderer.shadowMap.enabled = !mobile;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;

        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x02050a);
        scene.fog = new THREE.FogExp2(0x02050a, 0.0225);

        const camera = new THREE.PerspectiveCamera(40, window.innerWidth / window.innerHeight, 0.1, 160);
        camera.position.set(-17, 8.5, 20);

        const composer = new EffectComposer(renderer);
        composer.addPass(new RenderPass(scene, camera));
        const bloom = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), mobile ? 0.16 : 0.3, 0.34, 0.92);
        composer.addPass(bloom);
        composer.addPass(new OutputPass());

        const world = new THREE.Group();
        scene.add(world);

        const concrete = new THREE.MeshStandardMaterial({ color: 0x0b1015, metalness: 0.05, roughness: 0.92 });
        const concreteLight = new THREE.MeshStandardMaterial({ color: 0x161d22, metalness: 0.06, roughness: 0.86 });
        const steel = new THREE.MeshStandardMaterial({ color: 0x18232b, metalness: 0.82, roughness: 0.34 });
        const panel = new THREE.MeshStandardMaterial({ color: 0x09131b, metalness: 0.52, roughness: 0.52 });
        const pipeSupply = new THREE.MeshStandardMaterial({ color: 0x71828c, metalness: 0.9, roughness: 0.27 });
        const pipeReturn = new THREE.MeshStandardMaterial({ color: 0x425864, metalness: 0.84, roughness: 0.33 });
        const copper = new THREE.MeshStandardMaterial({ color: 0x8b5b40, metalness: 0.9, roughness: 0.28 });
        const insulation = new THREE.MeshStandardMaterial({ color: 0x1b3440, metalness: 0.15, roughness: 0.64 });
        const safety = new THREE.MeshStandardMaterial({ color: 0x7b6a22, emissive: 0x2e2400, emissiveIntensity: 0.4, roughness: 0.62 });
        const warmMetal = new THREE.MeshStandardMaterial({ color: 0x53331f, metalness: 0.6, roughness: 0.45 });
        const cyanGlow = new THREE.MeshStandardMaterial({ color: 0x052f42, emissive: 0x00d9ff, emissiveIntensity: 2.5, metalness: 0.48, roughness: 0.22 });
        const blueGlow = new THREE.MeshStandardMaterial({ color: 0x051c35, emissive: 0x0879ff, emissiveIntensity: 1.8, metalness: 0.6, roughness: 0.24 });
        const electricGlow = new THREE.MeshStandardMaterial({ color: 0x302805, emissive: 0xffc928, emissiveIntensity: 2.0, metalness: 0.4, roughness: 0.3 });

        const unitBox = new THREE.BoxGeometry(1, 1, 1);
        const tankGeo = new THREE.CylinderGeometry(0.62, 0.62, 3.0, 20);
        const tankBaseGeo = new THREE.CylinderGeometry(0.74, 0.8, 0.2, 20);
        const tankCapGeo = new THREE.CylinderGeometry(0.22, 0.22, 0.16, 14);
        const motorGeo = new THREE.CylinderGeometry(0.34, 0.34, 0.9, 14);
        const pumpGeo = new THREE.CylinderGeometry(0.28, 0.28, 0.48, 14);
        const statusGeo = new THREE.SphereGeometry(0.045, 8, 8);

        function addBox(x: number, y: number, z: number, sx: number, sy: number, sz: number, material: THREE.Material, cast = false, receive = true) {
          const mesh = new THREE.Mesh(unitBox, material);
          mesh.position.set(x, y, z);
          mesh.scale.set(sx, sy, sz);
          mesh.castShadow = !mobile && cast;
          mesh.receiveShadow = receive;
          world.add(mesh);
          return mesh;
        }

        function makeTube(points: THREE.Vector3[], radius: number, material: THREE.Material, segments = 28) {
          const curve = new THREE.CatmullRomCurve3(points);
          const mesh = new THREE.Mesh(new THREE.TubeGeometry(curve, segments, radius, 8, false), material);
          mesh.receiveShadow = true;
          world.add(mesh);
          return mesh;
        }

        addBox(0, -0.09, 0, 70, 0.06, 52, concrete, false, true);
        if (!mobile) {
          const grid = new THREE.GridHelper(70, 70, 0x12384a, 0x091921);
          grid.position.y = 0.005;
          grid.material.transparent = true;
          grid.material.opacity = 0.08;
          world.add(grid);
        }

        // Functional slabs and walls reuse one box geometry.
        addBox(-6.0, 0.06, -5.4, 14.5, 0.12, 10.0, concreteLight);
        addBox(8.8, 0.06, -7.0, 9.4, 0.12, 6.6, concreteLight);
        addBox(9.6, 0.06, 1.7, 6.6, 0.12, 5.6, concreteLight);
        addBox(0, 0.07, 0.2, 7.2, 0.14, 7.2, concreteLight);
        addBox(-12.7, 2.2, -5.4, 0.2, 4.4, 10.0, panel, true);
        addBox(-6.0, 2.2, -10.3, 13.7, 4.4, 0.18, panel, true);
        addBox(8.8, 2.0, -10.2, 8.8, 4.0, 0.18, panel, true);
        addBox(13.3, 2.0, -7.0, 0.2, 4.0, 6.4, panel, true);
        addBox(12.9, 1.55, 1.7, 0.2, 3.1, 5.6, panel, true);

        // Safety / circulation lines.
        addBox(-5.8, 0.08, -1.4, 13.4, 0.018, 0.08, safety);
        addBox(8.8, 0.08, -3.5, 8.4, 0.018, 0.08, safety);
        addBox(4.0, 0.08, 4.6, 17.0, 0.018, 0.06, safety);

        // Instanced tank bank.
        const tankBases = new THREE.InstancedMesh(tankBaseGeo, concreteLight, 4);
        const tanks = new THREE.InstancedMesh(tankGeo, steel, 4);
        const tankCaps = new THREE.InstancedMesh(tankCapGeo, warmMetal, 4);
        const matrix = new THREE.Matrix4();
        [-9.7, -7.5, -5.3, -3.1].forEach((x, index) => {
          matrix.compose(new THREE.Vector3(x, 0.22, -7.7), new THREE.Quaternion(), new THREE.Vector3(1, 1, 1));
          tankBases.setMatrixAt(index, matrix);
          matrix.compose(new THREE.Vector3(x, 1.82, -7.7), new THREE.Quaternion(), new THREE.Vector3(1, index % 2 ? 1.09 : 1, 1));
          tanks.setMatrixAt(index, matrix);
          matrix.compose(new THREE.Vector3(x, index % 2 ? 3.54 : 3.39, -7.7), new THREE.Quaternion(), new THREE.Vector3(1, 1, 1));
          tankCaps.setMatrixAt(index, matrix);
        });
        tanks.castShadow = !mobile;
        tanks.receiveShadow = true;
        world.add(tankBases, tanks, tankCaps);

        // Instanced pump line.
        const pumpPlates = new THREE.InstancedMesh(unitBox, steel, 4);
        const motors = new THREE.InstancedMesh(motorGeo, panel, 4);
        const pumps = new THREE.InstancedMesh(pumpGeo, warmMetal, 4);
        const leds = new THREE.InstancedMesh(statusGeo, cyanGlow, 4);
        const rotZ = new THREE.Quaternion().setFromEuler(new THREE.Euler(0, 0, Math.PI / 2));
        [-9.0, -7.0, -5.0, -3.0].forEach((x, index) => {
          matrix.compose(new THREE.Vector3(x, 0.21, -3.2), new THREE.Quaternion(), new THREE.Vector3(1.55, 0.18, 1.05));
          pumpPlates.setMatrixAt(index, matrix);
          matrix.compose(new THREE.Vector3(x - 0.2, 0.67, -3.2), rotZ, new THREE.Vector3(1, 1, 1));
          motors.setMatrixAt(index, matrix);
          matrix.compose(new THREE.Vector3(x + 0.58, 0.67, -3.2), rotZ, new THREE.Vector3(1, 1, 1));
          pumps.setMatrixAt(index, matrix);
          matrix.compose(new THREE.Vector3(x + 0.58, 0.84, -2.78), new THREE.Quaternion(), new THREE.Vector3(1, 1, 1));
          leds.setMatrixAt(index, matrix);
        });
        motors.castShadow = !mobile;
        pumps.castShadow = !mobile;
        world.add(pumpPlates, motors, pumps, leds);

        // Mechanical rack and HVAC spine: shared box geometry, no duplicate BoxGeometry allocations.
        [-11.5, -8.1, -4.7, -1.3].forEach((x) => {
          addBox(x, 2.22, -5.9, 0.12, 4.2, 0.12, steel, true);
          addBox(x, 2.55, -5.9, 0.12, 0.12, 1.35, steel, true);
          addBox(x, 3.65, -5.9, 0.12, 0.12, 1.35, steel, true);
        });
        [-8.8, -4.4, 0, 4.4, 8.8].forEach((x) => {
          addBox(x, 2.87, 3.25, 0.12, 5.5, 0.12, steel, true);
          addBox(x, 5.45, 3.25, 0.12, 0.12, 2.0, steel, true);
        });
        addBox(0, 5.45, 3.25, 18.0, 0.12, 0.12, steel, true);

        // Indoor module and outdoor pad.
        addBox(5.0, 1.17, 0.6, 2.6, 2.1, 2.05, panel, true);
        addBox(6.32, 1.17, 0.6, 0.04, 1.45, 1.25, steel);
        const indoorRing = new THREE.Mesh(new THREE.TorusGeometry(0.48, 0.035, 8, 36), cyanGlow);
        indoorRing.position.set(3.68, 1.3, 0.6);
        indoorRing.rotation.y = Math.PI / 2;
        world.add(indoorRing);
        addBox(9.6, 0.22, 1.7, 3.5, 0.2, 2.8, concreteLight);
        addBox(9.6, 0.39, 1.7, 2.9, 0.14, 2.15, steel);
        addBox(9.6, 0.08, 0.0, 3.8, 0.018, 0.06, safety);
        addBox(9.6, 0.08, 3.4, 3.8, 0.018, 0.06, safety);

        // Electrical bay and protected operating aisle.
        addBox(8.8, 0.24, -8.15, 7.5, 0.24, 1.8, steel);
        addBox(8.8, 2.82, -7.65, 7.6, 0.12, 0.68, steel, true);
        addBox(8.8, 2.81, -8.02, 7.1, 0.025, 0.03, electricGlow);
        [-3.4, -1.7, 0, 1.7, 3.4].forEach((x) => addBox(8.8 + x, 3.2, -7.65, 0.07, 0.8, 0.07, steel, true));
        [-3.2, 0, 3.2].forEach((x) => addBox(8.8 + x, 0.67, -3.9, 0.12, 1.1, 0.12, warmMetal, true));
        addBox(8.8, 1.12, -3.9, 6.5, 0.12, 0.12, steel, true);

        const pipeNetwork = new THREE.Group();
        const ductNetwork = new THREE.Group();
        const airconNetwork = new THREE.Group();
        const electricalNetwork = new THREE.Group();
        world.add(pipeNetwork, ductNetwork, airconNetwork, electricalNetwork);

        let settledAssets = 0;
        const settleAsset = () => {
          settledAssets += 1;
          if (settledAssets === 4 && renderer.shadowMap.enabled) {
            renderer.shadowMap.needsUpdate = true;
            requestAnimationFrame(() => { renderer.shadowMap.autoUpdate = false; });
          }
        };

        const pipeManager = new THREE.LoadingManager();
        pipeManager.setURLModifier((url) => url.includes('/textures/') ? PIXEL : url);
        new GLTFLoader(pipeManager).load(PIPE_ASSET_URL, (gltf) => {
          const source = new Map<string, THREE.Object3D>();
          gltf.scene.children.forEach((child) => source.set(child.name, child));
          const addPipe = (name: string, position: [number, number, number], rotation: [number, number, number], scale: number, material: THREE.Material) => {
            const original = source.get(name); if (!original) return;
            const piece = original.clone(true);
            piece.position.set(...position); piece.rotation.set(...rotation); piece.scale.setScalar(scale);
            piece.traverse((object: THREE.Object3D) => { if (object instanceof THREE.Mesh) { object.material = material; object.castShadow = false; object.receiveShadow = true; } });
            pipeNetwork.add(piece);
          };
          [-10.8, -7.4, -4.0, -0.6].forEach((x) => {
            addPipe('modular_industrial_pipes_01_pipe02', [x, 3.55, -6.15], [0, 0, Math.PI / 2], 1.35, pipeSupply);
            addPipe('modular_industrial_pipes_01_pipe02', [x, 2.45, -5.75], [0, 0, Math.PI / 2], 1.35, pipeReturn);
          });
          [-9.7, -7.5, -5.3, -3.1].forEach((x, index) => addPipe('modular_industrial_pipes_01_pipe01', [x, 2.0, -7.3], [0, 0, 0], 1.1, index % 2 ? pipeReturn : pipeSupply));
          [-9.0, -6.8, -4.6, -2.4].forEach((x, index) => addPipe('modular_industrial_pipes_01_pipe01', [x, 1.45, -4.2], [0, Math.PI / 2, Math.PI / 2], 0.95, index % 2 ? pipeReturn : pipeSupply));
          addPipe('modular_industrial_pipes_01_pipe05', [-11.45, 3.5, -6.1], [0, 0, Math.PI / 2], 1.15, pipeSupply);
          addPipe('modular_industrial_pipes_01_pipe05', [-11.45, 2.4, -5.7], [Math.PI, 0, Math.PI / 2], 1.15, pipeReturn);
          if (pipeStatus) pipeStatus.textContent = 'READY';
          settleAsset();
        }, undefined, (error) => { console.error('Phase 2.9 mechanical network failed', error); if (pipeStatus) pipeStatus.textContent = 'ERROR'; settleAsset(); });

        new GLTFLoader().load(HVAC_ASSET_URL, (gltf) => {
          const source = new Map<string, THREE.Object3D>();
          gltf.scene.children.forEach((child) => source.set(child.name, child));
          const addDuct = (name: string, position: [number, number, number], rotation: [number, number, number], scale = 1) => {
            const original = source.get(name); if (!original) return;
            const piece = original.clone(true);
            piece.position.set(...position); piece.rotation.set(...rotation); piece.scale.setScalar(scale);
            piece.traverse((object: THREE.Object3D) => { if (object instanceof THREE.Mesh) { object.castShadow = false; object.receiveShadow = true; } });
            ductNetwork.add(piece);
          };
          [-8.8, -5.3, -1.8, 1.7, 5.2, 8.7].forEach((x) => addDuct('modular_airduct_circular_triple', [x, 5.05, 3.25], [0, Math.PI / 2, 0], 1.52));
          addDuct('modular_airduct_circular_fan', [0, 5.05, 3.25], [0, Math.PI / 2, 0], 1.48);
          addDuct('modular_airduct_circular_smooth_bend_quater', [4.2, 5.05, 3.15], [0, Math.PI, Math.PI / 2], 1.52);
          addDuct('modular_airduct_circular_smooth_triple', [4.2, 5.05, 1.2], [0, 0, 0], 1.48);
          addDuct('modular_airduct_circular_smooth_bend_quater', [4.2, 2.95, 0.65], [Math.PI / 2, 0, 0], 1.5);
          if (hvacStatus) hvacStatus.textContent = 'READY';
          settleAsset();
        }, undefined, (error) => { console.error('Phase 2.9 HVAC network failed', error); if (hvacStatus) hvacStatus.textContent = 'ERROR'; settleAsset(); });

        const airconManager = new THREE.LoadingManager();
        airconManager.setURLModifier((url) => url.includes('_rusted_') ? PIXEL : url);
        new GLTFLoader(airconManager).load(AIRCON_ASSET_URL, (gltf) => {
          const clean = gltf.scene.getObjectByName('exterior_aircon_unit');
          if (!clean) { if (airconStatus) airconStatus.textContent = 'ERROR'; settleAsset(); return; }
          const unit = clean.clone(true);
          unit.position.set(9.6, 0.55, 1.7); unit.rotation.y = -Math.PI / 2; unit.scale.setScalar(2.15);
          unit.traverse((object: THREE.Object3D) => { if (object instanceof THREE.Mesh) { object.castShadow = !mobile; object.receiveShadow = true; } });
          airconNetwork.add(unit);
          if (airconStatus) airconStatus.textContent = 'READY';
          settleAsset();
        }, undefined, (error) => { console.error('Phase 2.9 exterior HVAC unit failed', error); if (airconStatus) airconStatus.textContent = 'ERROR'; settleAsset(); });

        new GLTFLoader().load(ELECTRICAL_ASSET_URL, (gltf) => {
          const cabinet = gltf.scene;
          cabinet.traverse((object: THREE.Object3D) => { if (object instanceof THREE.Mesh) { object.castShadow = !mobile; object.receiveShadow = true; } });
          [-2.8, -1.4, 0, 1.4, 2.8].forEach((x, index) => {
            const unit = cabinet.clone(true);
            unit.position.set(8.8 + x, 0.36, -8.15); unit.rotation.y = Math.PI; unit.scale.setScalar(index === 2 ? 1.4 : 1.3);
            electricalNetwork.add(unit);
          });
          if (electricalStatus) electricalStatus.textContent = 'READY';
          settleAsset();
        }, undefined, (error) => { console.error('Phase 2.9 electrical bay failed', error); if (electricalStatus) electricalStatus.textContent = 'ERROR'; settleAsset(); });

        // Refrigeration circuit: lower tessellation, same visual hierarchy.
        makeTube([new THREE.Vector3(6.25, 1.0, 0.4), new THREE.Vector3(7.2, 1.2, 0.4), new THREE.Vector3(8.1, 1.0, 0.8), new THREE.Vector3(9.0, 1.0, 1.35)], 0.045, copper, 24);
        makeTube([new THREE.Vector3(6.25, 1.18, 0.65), new THREE.Vector3(7.15, 1.38, 0.65), new THREE.Vector3(8.0, 1.2, 1.05), new THREE.Vector3(9.0, 1.18, 1.55)], 0.075, insulation, 24);

        // Procedural Core remains temporary until Phase 3.
        const core = new THREE.Group();
        world.add(core);
        const corePlinth = new THREE.Mesh(new THREE.CylinderGeometry(2.15, 2.5, 0.42, 40), steel); corePlinth.position.y = 0.35; core.add(corePlinth);
        const coreBody = new THREE.Mesh(new THREE.CylinderGeometry(0.7, 0.92, 4.3, 32), steel); coreBody.position.y = 2.65; core.add(coreBody);
        const energy = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 3.5, 18), cyanGlow); energy.position.y = 2.7; core.add(energy);
        const rings: THREE.Mesh[] = [];
        [1.25, 2.35, 3.45, 4.5].forEach((y, index) => {
          const ring = new THREE.Mesh(new THREE.TorusGeometry(1.04 + index * 0.055, 0.03, 6, 48), index % 2 ? blueGlow : cyanGlow);
          ring.rotation.x = Math.PI / 2; ring.position.y = y; core.add(ring); rings.push(ring);
        });
        const halo = new THREE.Mesh(new THREE.TorusGeometry(1.85, 0.045, 8, 60), cyanGlow); halo.rotation.x = Math.PI / 2; halo.position.y = 0.65; core.add(halo);
        const beam = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.055, 12, 8), new THREE.MeshBasicMaterial({ color: 0x42dfff, transparent: true, opacity: 0.22, depthWrite: false }));
        beam.position.y = 7; core.add(beam);

        function createConnection(start: THREE.Vector3, end: THREE.Vector3, height: number, material: THREE.Material = cyanGlow) {
          const mid = start.clone().lerp(end, 0.5); mid.y += height;
          const curve = new THREE.CatmullRomCurve3([start, mid, end]);
          world.add(new THREE.Mesh(new THREE.TubeGeometry(curve, 20, 0.016, 6, false), material));
          const pulse = new THREE.Mesh(new THREE.SphereGeometry(0.045, 8, 8), material); world.add(pulse);
          return { curve, pulse, offset: Math.random() };
        }
        const connections = [
          createConnection(new THREE.Vector3(-1.1, 0.72, -0.4), new THREE.Vector3(-6.0, 1.2, -4.4), 1.0),
          createConnection(new THREE.Vector3(0.7, 1.0, 0.6), new THREE.Vector3(3.6, 4.7, 3.25), 1.5),
          createConnection(new THREE.Vector3(1.0, 0.9, 0.1), new THREE.Vector3(9.2, 1.2, 1.7), 1.1),
          createConnection(new THREE.Vector3(0.8, 0.75, -0.8), new THREE.Vector3(8.8, 1.4, -7.5), 1.35, electricGlow),
        ];

        // Practical lighting. Only the directional key casts a shadow map.
        scene.add(new THREE.HemisphereLight(0x6f9eb4, 0x020407, 1.08));
        const key = new THREE.DirectionalLight(0xc7e3ee, 2.45);
        key.position.set(-10, 15, 8);
        key.castShadow = !mobile;
        key.shadow.mapSize.set(1024, 1024);
        key.shadow.camera.near = 1;
        key.shadow.camera.far = 45;
        key.shadow.camera.left = -18;
        key.shadow.camera.right = 18;
        key.shadow.camera.top = 18;
        key.shadow.camera.bottom = -18;
        scene.add(key);
        const mechanicalLight = new THREE.PointLight(0xffa55c, 7.5, 15, 2); mechanicalLight.position.set(-6.5, 5, -5.5); scene.add(mechanicalLight);
        const hvacLight = new THREE.PointLight(0x8eddf2, 6.4, 15, 2); hvacLight.position.set(1.5, 6.5, 3.2); scene.add(hvacLight);
        const climateLight = new THREE.PointLight(0xb5eaff, 5.5, 10, 2); climateLight.position.set(9.5, 3.5, 1.7); scene.add(climateLight);
        const electricalLight = new THREE.PointLight(0xffb95c, 8.2, 12, 2); electricalLight.position.set(8.8, 4, -7.6); scene.add(electricalLight);
        const coreLight = new THREE.PointLight(0x00d9ff, mobile ? 9 : 16, 13, 1.7); coreLight.position.set(0, 3, 0); scene.add(coreLight);

        // Shared luminaires.
        const warmLamp = new THREE.MeshBasicMaterial({ color: 0xffd8a0 });
        [-10.5, -6.3, -2.1].forEach((x) => addBox(x, 4.15, -8.9, 1.1, 0.06, 0.18, warmLamp));
        [6.0, 8.8, 11.6].forEach((x) => addBox(x, 3.7, -9.1, 1.0, 0.06, 0.18, warmLamp));

        const particleCount = mobile ? 45 : 120;
        const positions = new Float32Array(particleCount * 3);
        for (let i = 0; i < particleCount; i += 1) {
          positions[i * 3] = (Math.random() - 0.5) * 52;
          positions[i * 3 + 1] = Math.random() * 9 + 0.4;
          positions[i * 3 + 2] = (Math.random() - 0.5) * 38;
        }
        const particleGeometry = new THREE.BufferGeometry();
        particleGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        const particles = new THREE.Points(particleGeometry, new THREE.PointsMaterial({ color: 0x7cb6c7, size: 0.017, transparent: true, opacity: 0.12, depthWrite: false }));
        world.add(particles);

        const cameraPath = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-17, 8.5, 20), new THREE.Vector3(-13.5, 5.6, 10), new THREE.Vector3(-11.2, 3.2, -1),
          new THREE.Vector3(-9, 2.8, -5), new THREE.Vector3(-3.5, 4.3, -2), new THREE.Vector3(-2, 6.5, 5.8),
          new THREE.Vector3(6.5, 5.3, 6.5), new THREE.Vector3(12.8, 3.5, 3.8), new THREE.Vector3(13, 3.3, -6.5),
          new THREE.Vector3(8, 3, -11.5), new THREE.Vector3(4, 5.7, -7.5), new THREE.Vector3(7, 7, 12.5),
        ]);
        const targetPath = new THREE.CatmullRomCurve3([
          new THREE.Vector3(0, 2, 0), new THREE.Vector3(-4, 2, -2), new THREE.Vector3(-6, 1.4, -3.4),
          new THREE.Vector3(-6, 2, -7), new THREE.Vector3(-1, 2.2, 0), new THREE.Vector3(0, 4.8, 3.2),
          new THREE.Vector3(5, 2, 0.7), new THREE.Vector3(9.6, 1.4, 1.7), new THREE.Vector3(8.8, 1.5, -7.5),
          new THREE.Vector3(8.8, 1.6, -8), new THREE.Vector3(0, 2.8, 0), new THREE.Vector3(0, 2.8, 0),
        ]);

        const state = { progress: 0 };
        const chapters = Array.from(document.querySelectorAll('.chapter'));
        ScrollTrigger.create({
          trigger: '#story', start: 'top top', end: 'bottom bottom', scrub: reducedMotion ? false : 1.1,
          onUpdate: (self) => {
            state.progress = self.progress;
            const active = Math.min(chapters.length - 1, Math.floor(self.progress * chapters.length));
            chapters.forEach((chapter, index) => chapter.classList.toggle('active', index === active));
          },
        });

        function applyDpr(next: number) {
          qualityDpr = THREE.MathUtils.clamp(next, dprFloor, Math.min(window.devicePixelRatio, dprCap));
          renderer.setPixelRatio(qualityDpr);
          renderer.setSize(window.innerWidth, window.innerHeight, false);
          composer.setSize(window.innerWidth, window.innerHeight);
          if (dprEl) dprEl.textContent = qualityDpr.toFixed(2);
        }
        applyDpr(qualityDpr);

        const clock = new THREE.Clock();
        let frames = 0;
        let fpsStart = performance.now();
        let qualityWindowStart = performance.now();
        let qualityFrames = 0;
        let stableHighWindows = 0;
        let raf = 0;
        let visible = true;

        function render(now = performance.now()) {
          const elapsed = clock.getElapsedTime();
          const progress = reducedMotion ? 0.9 : THREE.MathUtils.clamp(state.progress, 0.001, 0.999);
          camera.position.lerp(cameraPath.getPointAt(progress), reducedMotion ? 1 : 0.07);
          camera.lookAt(targetPath.getPointAt(progress));
          core.rotation.y = elapsed * 0.03;
          halo.rotation.z = elapsed * 0.1;
          rings.forEach((ring, index) => { ring.rotation.z = elapsed * (0.07 + index * 0.012) * (index % 2 ? -1 : 1); });
          particles.rotation.y = elapsed * 0.0015;
          connections.forEach(({ curve, pulse, offset }, index) => { pulse.position.copy(curve.getPointAt((elapsed * (0.085 + index * 0.01) + offset) % 1)); });

          composer.render();
          frames += 1;
          qualityFrames += 1;

          if (now - fpsStart >= 1000) {
            const fps = Math.round((frames * 1000) / (now - fpsStart));
            if (fpsEl) fpsEl.textContent = String(fps);
            if (callsEl) callsEl.textContent = renderer.info.render.calls.toLocaleString();
            if (trisEl) trisEl.textContent = renderer.info.render.triangles.toLocaleString();
            frames = 0;
            fpsStart = now;
          }

          if (!reducedMotion && now - qualityWindowStart >= 2500) {
            const avgFps = (qualityFrames * 1000) / (now - qualityWindowStart);
            if (avgFps < 48 && qualityDpr > dprFloor + 0.02) {
              stableHighWindows = 0;
              applyDpr(qualityDpr - 0.08);
            } else if (avgFps > 58 && qualityDpr < Math.min(window.devicePixelRatio, dprCap) - 0.02) {
              stableHighWindows += 1;
              if (stableHighWindows >= 2) { applyDpr(qualityDpr + 0.05); stableHighWindows = 0; }
            } else {
              stableHighWindows = 0;
            }
            qualityFrames = 0;
            qualityWindowStart = now;
          }

          if (visible) raf = requestAnimationFrame(render);
        }

        function resize() {
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setSize(window.innerWidth, window.innerHeight, false);
          composer.setSize(window.innerWidth, window.innerHeight);
          applyDpr(qualityDpr);
        }

        window.addEventListener('resize', resize, { passive: true });
        document.addEventListener('visibilitychange', () => {
          visible = !document.hidden;
          if (visible) {
            cancelAnimationFrame(raf);
            clock.getDelta();
            frames = 0;
            qualityFrames = 0;
            fpsStart = performance.now();
            qualityWindowStart = fpsStart;
            render();
          }
        });

        render();
      }
    </script>
  </body>
</html>


---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
const base=import.meta.env.BASE_URL;
const links={home:`${base}preview-v4/home/`,product:`${base}preview-v4/producto/`,solutions:`${base}preview-v4/soluciones/`,apps:`${base}preview-v4/apps/`,sectors:`${base}preview-v4/sectores/`,resources:`${base}preview-v4/recursos/`,blog:`${base}preview-v4/blog/`,company:`${base}preview-v4/empresa/`,demo:`${base}preview-v4/demo/`,plans:`${base}preview-v4/precios/`,contact:`${base}preview-v4/contacto/`,access:`${base}preview-v4/acceso/`,security:`${base}preview-v4/seguridad/`,privacy:`${base}preview-v4/privacidad/`};
const fieldPhoto=`${base}media/v4/home-maintenance-tablet.webp`;
const qrPhoto=`${base}media/v4/app-qr-mobile.webp`;
const dashboard=`${base}media/v4/home-dashboard-premium.webp`;
const groups=[
 {title:'Vender el producto',copy:'Las pantallas que explican qué hace IsiVoltPro y por qué importa.',items:[['01','Home V4','La propuesta comercial completa: producto, fotografía, conocimiento y CTA.',links.home,'Principal'],['02','Producto V4','Contexto, activos, OT, histórico y trabajo técnico conectado.',links.product,'Producto'],['03','Soluciones V4','Problemas reales convertidos en flujos de trabajo.',links.solutions,'Soluciones'],['04','Apps V4','App Mantenimiento, QR/NFC y operación en campo.',links.apps,'Campo']]},
 {title:'Demostrar encaje',copy:'Páginas para que cada visitante reconozca su operación y profundice.',items:[['05','Sectores V4','Mantenedoras, instalaciones propias, electricidad, climatización y multisede.',links.sectors,'Sectores'],['06A','Recursos V4','Guías y conocimiento práctico como capa de confianza.',links.resources,'Conocimiento'],['06B','Blog + Noticias V4','Actualidad técnica con fuente, fecha y contexto.',links.blog,'Actualidad'],['07','Empresa + confianza','Visión, método, transparencia y límites verificables.',links.company,'Confianza']]},
 {title:'Convertir sin fricción',copy:'Del interés a una decisión clara, sin formularios ficticios ni promesas vacías.',items:[['08A','Demo V4','Recorrido aviso → OT → campo → cierre → histórico.',links.demo,'Demo'],['08B','Planes V4','Autónomo, Equipo y Empresa por encaje operativo.',links.plans,'Planes'],['08C','Contacto V4','Experiencia comercial preparada para el canal real.',links.contact,'Contacto']]},
 {title:'Confianza y acceso',copy:'Superficies que separan web comercial, privacidad, seguridad y acceso privado.',items:[['09A','Acceso V4','Entrada central conceptual sin simular autenticación.',links.access,'Acceso'],['09B','Seguridad V4','Backend como autoridad, aislamiento y mínimo privilegio.',links.security,'Seguridad'],['09C','Privacidad V4','Minimización, finalidad, retención y transparencia.',links.privacy,'Privacidad']]},
];
---
<!doctype html><html lang="es"><head><V3Seo title="Preview V4 · IsiVoltPro" description="Laboratorio no indexado para revisar la evolución visual y comercial de IsiVoltPro antes de sustituir las páginas públicas." path={`${base}preview-v4/`} noindex={true}/><style is:inline>
.hub{min-height:72vh;padding:72px 0 94px;background:radial-gradient(circle at 78% 8%,rgba(109,74,255,.13),transparent 28%),radial-gradient(circle at 92% 46%,rgba(36,197,140,.09),transparent 22%),#fff}.hero-grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(440px,1.08fr);gap:48px;align-items:center}.hub h1{max-width:820px;margin:18px 0;font:800 clamp(48px,5.8vw,76px)/.98 Manrope,sans-serif;letter-spacing:-.06em}.lead{max-width:760px;margin:0;color:#67738a;font-size:18px;line-height:1.72}.status-row{display:flex;flex-wrap:wrap;gap:9px;margin-top:22px}.status{display:inline-flex;align-items:center;gap:8px;padding:8px 11px;border-radius:999px;background:#edf9f5;color:#168965;font-size:11px;font-weight:900}.status:before{content:'';width:8px;height:8px;border-radius:50%;background:#24c58c}.status.secondary{background:#f2efff;color:#6544e8}.status.secondary:before{background:#7a5af8}.hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}.visual{position:relative;min-height:470px}.photo{position:absolute;inset:0 18% 10% 0;overflow:hidden;border-radius:30px;background:#eef2f7;box-shadow:0 30px 82px rgba(45,59,98,.16)}.photo img{width:100%;height:100%;object-fit:cover;display:block}.photo:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(11,20,48,.42))}.dash{position:absolute;right:0;bottom:0;width:62%;padding:10px;border-radius:24px;background:rgba(255,255,255,.92);box-shadow:0 24px 64px rgba(42,51,91,.2);backdrop-filter:blur(12px)}.dash img{display:block;width:100%;border-radius:17px}.visual-badge{position:absolute;left:18px;bottom:28px;z-index:3;padding:9px 12px;border-radius:999px;background:rgba(13,23,48,.84);color:#fff;font-size:10px;font-weight:850}.phase{margin-top:62px;padding:28px;border:1px solid #e5e9f2;border-radius:28px;background:linear-gradient(120deg,#0e1830,#1b2d58 58%,#342676);color:#fff;display:grid;grid-template-columns:1fr auto;gap:28px;align-items:center;box-shadow:0 24px 64px rgba(30,42,82,.12)}.phase small{display:block;color:#b9c7e5;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.phase h2{margin:8px 0 8px;font-size:30px;letter-spacing:-.04em}.phase p{margin:0;color:#c8d3e8;line-height:1.6}.phase .btn{background:#fff;color:#18233f;border-color:#fff}.group{margin-top:54px}.group-head{display:grid;grid-template-columns:1fr .8fr;gap:28px;align-items:end;margin-bottom:20px}.group-head h2{margin:0;font:800 clamp(34px,4vw,50px)/1.02 Manrope,sans-serif;letter-spacing:-.045em}.group-head p{margin:0;color:#758197;line-height:1.65}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.card{display:flex;flex-direction:column;min-height:260px;padding:24px;border:1px solid #e6e9f1;border-radius:24px;background:#fff;box-shadow:0 16px 42px rgba(54,64,102,.065);transition:transform .16s ease,box-shadow .16s ease}.card:hover{transform:translateY(-3px);box-shadow:0 22px 54px rgba(54,64,102,.10)}.card small{display:block;color:#7f8aa0;font-weight:800;letter-spacing:.07em;text-transform:uppercase}.tag{display:inline-flex;width:max-content;margin-top:14px;padding:6px 9px;border-radius:999px;background:#f2efff;color:#6544e8;font-size:9px;font-weight:900;letter-spacing:.06em;text-transform:uppercase}.card h3{margin:14px 0 9px;font-size:23px;letter-spacing:-.025em}.card p{margin:0;color:#738097;line-height:1.62;font-size:13px}.card .btn{margin-top:auto;padding-top:18px;align-self:flex-start}.field-band{margin-top:56px;display:grid;grid-template-columns:1fr 1fr;gap:18px}.field-card{position:relative;min-height:330px;overflow:hidden;border-radius:28px;box-shadow:0 20px 54px rgba(45,59,98,.12)}.field-card img{width:100%;height:100%;object-fit:cover;display:block}.field-card:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(10,18,40,.78))}.field-copy{position:absolute;z-index:2;left:24px;right:24px;bottom:22px;color:#fff}.field-copy small{font-weight:850;letter-spacing:.07em;text-transform:uppercase;color:#cdd9ef}.field-copy h3{margin:7px 0 5px;font-size:26px}.field-copy p{margin:0;max-width:520px;color:#dce4f1;line-height:1.55}.note{margin-top:30px;padding:18px 20px;border:1px dashed #d8deea;border-radius:18px;background:#fafbfe;color:#6e7a91;line-height:1.65}.note strong{color:#2c3954}@media(max-width:1080px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-grid{grid-template-columns:1fr}.visual{max-width:780px}.group-head{grid-template-columns:1fr}}@media(max-width:760px){.hub{padding:54px 0 74px}.hub h1{font-size:clamp(42px,12.5vw,60px)}.lead{font-size:16px}.visual{min-height:390px}.photo{inset:0 10% 12% 0}.dash{width:70%}.phase{grid-template-columns:1fr;padding:24px 20px}.grid,.field-band{grid-template-columns:1fr}.card{min-height:0}.group{margin-top:42px}.group-head{gap:10px}.field-card{min-height:285px}.hero-actions .btn{width:100%;justify-content:center}}@media(max-width:430px){.visual{min-height:330px}.photo{inset:0 4% 13% 0;border-radius:22px}.dash{width:74%;padding:7px;border-radius:18px}.dash img{border-radius:13px}.visual-badge{left:12px;bottom:18px}.field-copy{left:18px;right:18px;bottom:18px}.field-copy h3{font-size:23px}}@media(prefers-reduced-motion:reduce){.card{transition:none}.card:hover{transform:none}}
</style></head><body><V3CommercialHeader/><main class="hub"><div class="page-shell"><section class="hero-grid"><div><span class="eyebrow">Laboratorio visual V4 · No indexado</span><h1>Ya no es un listado de pruebas.<br/><span class="gradient-text">Es la futura web completa.</span></h1><p class="lead">Revisa IsiVoltPro como una experiencia real de venta: producto, fotografías de mantenimiento, conocimiento técnico, planes, demo, confianza y acceso. La web pública estable sigue separada hasta aprobar este pase.</p><div class="status-row"><span class="status">14 pantallas V4 disponibles</span><span class="status secondary">Fase 10 · revisión final</span></div><div class="hero-actions"><a class="btn btn--primary" href={links.home}>Entrar en la Home V4 →</a><a class="btn" href={links.demo}>Ver Demo V4</a></div></div><div class="visual" aria-label="Vista previa visual de IsiVoltPro V4"><figure class="photo"><img src={fieldPhoto} alt="Técnico de mantenimiento trabajando con una tablet en una instalación técnica" width="836" height="470" loading="eager"/></figure><div class="dash"><img src={dashboard} alt="Vista conceptual del dashboard premium de IsiVoltPro" width="900" height="675" loading="eager"/></div><span class="visual-badge">Mantenimiento real + producto digital</span></div></section><section class="phase"><div><small>Fase actual</small><h2>10 · Revisión final V4</h2><p>Estamos cerrando navegación, móvil, imágenes reales, rendimiento, claims y coherencia visual antes de decidir qué pasa a producción.</p></div><a class="btn" href={links.home}>Revisar desde Home →</a></section>{groups.map((group)=><section class="group"><div class="group-head"><h2>{group.title}</h2><p>{group.copy}</p></div><div class="grid">{group.items.map(([n,title,copy,href,tag])=><article class="card"><small>{n} · V4</small><span class="tag">{tag}</span><h3>{title}</h3><p>{copy}</p><a class="btn" href={href}>Abrir pantalla →</a></article>)}</div></section>)}<section class="field-band"><article class="field-card"><img src={fieldPhoto} alt="Técnico revisando una instalación con una tablet" width="836" height="470" loading="lazy"/><div class="field-copy"><small>Entorno real</small><h3>El software tiene que vivir donde ocurre el mantenimiento.</h3><p>La V4 refuerza progresivamente la conexión entre producto y trabajo técnico.</p></div></article><article class="field-card"><img src={qrPhoto} alt="Técnico identificando un equipo mediante QR con un teléfono móvil" width="700" height="525" loading="lazy"/><div class="field-copy"><small>Campo + QR/NFC</small><h3>El contexto debe llegar hasta el activo.</h3><p>Identificar, actuar, documentar y conservar el histórico sin volver a empezar de cero.</p></div></article></section><div class="note"><strong>Esta zona sigue siendo de revisión.</strong> Fases 0.5–9 están construidas; la Fase 10 es el pase final de navegación, fotografía, móvil, rendimiento y publicación.</div></div></main><V3CommercialFooter/></body></html>
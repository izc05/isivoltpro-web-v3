        const mechanicalLight = new THREE.PointLight(0xffa55c,7.2,15,2); mechanicalLight.position.set(-6.5,5,-5.5); scene.add(mechanicalLight);
        const hvacLight = new THREE.PointLight(0x8eddf2,5.7,15,2); hvacLight.position.set(1.5,6.5,3.2); scene.add(hvacLight);
        const climateLight = new THREE.PointLight(0xb5eaff,5.1,10,2); climateLight.position.set(9.5,3.5,1.7); scene.add(climateLight);
        const electricalLight = new THREE.PointLight(0xffb95c,7.8,12,2); electricalLight.position.set(8.8,4,-7.6); scene.add(electricalLight);
        const waterLight = new THREE.PointLight(0x3b9cff,3.4,9,2); waterLight.position.set(-8.7,2.5,4.9); scene.add(waterLight);


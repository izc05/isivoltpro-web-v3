---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
import { resourceGuides } from '../../data/v3-commercial';

export function getStaticPaths() {
  return Object.entries(resourceGuides).map(([slug, guide]) => ({ params: { slug }, props: { guide, slug } }));
}

const { guide, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
const contact = `${base}contacto/`;
const resources = `${base}recursos/`;
const journeyVisual = `${base}media/ruta-recursos-isivoltpro.svg`;
const fieldVisual = `${base}media/flujo-campo-isivoltpro.svg`;
const previewPoints = guide.points.slice(0, 3);
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title={`${guide.title} · IsiVoltPro`} description={guide.description} path={`${base}recursos/${slug}/`} />
  <style is:inline>
    .guide-hero{padding:76px 0 68px;background:radial-gradient(circle at 78% 30%,rgba(102,83,220,.13),transparent 28%),radial-gradient(circle at 92% 70%,rgba(43,184,142,.09),transparent 22%),#fff}.guide-hero__grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:62px;align-items:center}.guide-hero h1{margin:14px 0 18px;font:800 clamp(43px,4.8vw,67px)/1 var(--v3-font-display,system-ui);letter-spacing:-.055em}.guide-hero p{max-width:590px;color:#717d91;line-height:1.72}.guide-workspace{position:relative;min-height:430px}.guide-window{position:absolute;inset:18px 20px 28px 12px;border:1px solid #e3e7f0;border-radius:24px;background:#fff;box-shadow:0 30px 75px rgba(57,65,111,.14);overflow:hidden}.guide-window__bar{height:43px;display:flex;align-items:center;gap:6px;padding:0 14px;border-bottom:1px solid #edf0f5}.guide-window__bar i{width:7px;height:7px;border-radius:50%;background:#d9deea}.guide-window__body{display:grid;grid-template-columns:108px 1fr;height:calc(100% - 43px)}.guide-side{padding:17px 10px;background:#fafbfe;border-right:1px solid #edf0f5}.guide-side b{display:block;margin-bottom:16px;font-size:10px}.guide-side span{display:block;margin:8px 0;padding:7px;border-radius:7px;color:#818b9d;font-size:8px}.guide-side span:nth-of-type(3){background:#f0edff;color:#6854d8;font-weight:800}.guide-main{padding:18px}.guide-main__head{display:flex;justify-content:space-between;gap:12px;align-items:center}.guide-main__head strong{font-size:16px}.guide-main__head small{padding:6px 9px;border-radius:999px;background:#eaf9f3;color:#168f69;font-weight:800}.guide-progress{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:15px 0}.guide-progress div{padding:10px;border:1px solid #eceef4;border-radius:10px}.guide-progress small{display:block;color:#929baa;font-size:7px}.guide-progress b{display:block;margin-top:4px;font-size:15px}.guide-list{display:grid;gap:7px}.guide-list div{display:grid;grid-template-columns:24px 1fr auto;align-items:center;gap:8px;padding:9px;border:1px solid #edf0f5;border-radius:9px;font-size:8px}.guide-list b{display:grid;place-items:center;width:23px;height:23px;border-radius:7px;background:#f2efff;color:#6854d8}.guide-list span{color:#667287;font-weight:700}.guide-list em{font-style:normal;color:#159f71}.guide-chip{position:absolute;right:0;bottom:0;padding:11px 14px;border:1px solid #e5e8f0;border-radius:14px;background:#fff;box-shadow:0 14px 34px rgba(50,59,103,.13);color:#202a3d;font-size:10px;font-weight:800}.guide-chip small{display:block;margin-top:3px;color:#8b95a6;font-size:7px;font-weight:600}.guide-visual-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:20px;align-items:stretch}.guide-visual-card{padding:20px;border:1px solid #e5e8f0;border-radius:24px;background:#fff;box-shadow:0 14px 36px rgba(54,64,103,.06)}.guide-visual-card img{display:block;width:100%;height:auto;border-radius:15px}.guide-check{display:grid;gap:10px}.guide-check article{display:grid;grid-template-columns:34px 1fr;gap:11px;align-items:start;padding:13px;border:1px solid #edf0f5;border-radius:13px;background:#fafbfe}.guide-check b{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:#f1efff;color:#6544e8}.guide-check strong{display:block;margin:1px 0 4px;font-size:13px}.guide-check p{margin:0;color:#7b8698;font-size:11px;line-height:1.45}@media(max-width:900px){.guide-hero__grid,.guide-visual-grid{grid-template-columns:1fr}.guide-workspace{min-height:390px}}@media(max-width:580px){.guide-hero{padding:54px 0}.guide-hero h1{font-size:clamp(39px,12vw,53px)}.guide-workspace{min-height:345px}.guide-window{inset:12px 4px 24px}.guide-window__body{grid-template-columns:68px 1fr}.guide-side{padding:12px 5px}.guide-main{padding:12px}.guide-progress{grid-template-columns:1fr 1fr}.guide-progress div:last-child{display:none}.guide-list div{grid-template-columns:22px 1fr}.guide-list em{display:none}.guide-chip{right:4px}}
  </style>
</head>
<body>
<V3CommercialHeader />
<main class="page-main">
  <section class="guide-hero"><div class="page-shell guide-hero__grid"><div><span class="eyebrow">Guía práctica IsiVoltPro</span><h1>{guide.title}</h1><p>{guide.description}</p><div class="page-hero__actions"><a class="btn" href={resources}>← Todos los recursos</a><a class="btn btn--primary" href={contact}>Verlo aplicado en una demo →</a></div></div><div class="guide-workspace" aria-label="Vista conceptual de la guía"><div class="guide-window"><div class="guide-window__bar"><i></i><i></i><i></i></div><div class="guide-window__body"><aside class="guide-side"><b>IsiVoltPro</b><span>Inicio</span><span>Producto</span><span>Recursos</span><span>Guías</span><span>Demo</span></aside><div class="guide-main"><div class="guide-main__head"><strong>Playbook práctico</strong><small>Aplicable hoy</small></div><div class="guide-progress"><div><small>Lectura</small><b>4 min</b></div><div><small>Pasos</small><b>{guide.points.length}</b></div><div><small>Enfoque</small><b>Campo</b></div></div><div class="guide-list">{previewPoints.map(([heading], index) => <div><b>{index + 1}</b><span>{heading}</span><em>Revisar</em></div>)}</div></div></div></div><span class="guide-chip">Sin software obligatorio<small>Empieza por mejorar el proceso</small></span></div></div></section>

  <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Paso a paso</span><h2>Lo esencial,<br/><span class="gradient-text">sin burocracia.</span></h2></div><p>Estas pautas están pensadas para autónomos y equipos pequeños. No requieren implantar IsiVoltPro para ser útiles.</p></div><div class="feature-grid">{guide.points.map(([heading, text], index) => <article class="feature-card"><i>{String(index + 1).padStart(2,'0')}</i><h3>{heading}</h3><p>{text}</p></article>)}</div></div></section>

  <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Del consejo al trabajo</span><h2>Una guía sirve cuando<br/><span class="gradient-text">puedes aplicarla mañana.</span></h2></div><p>La idea es pasar de principios generales a una secuencia concreta que puedas probar sobre un aviso, una OT, un activo o un pequeño piloto.</p></div><div class="guide-visual-grid"><article class="guide-visual-card"><img src={journeyVisual} alt="Ruta práctica desde avisos y órdenes de trabajo hasta activos, QR y piloto" loading="lazy" width="960" height="540" /></article><div class="guide-check"><article><b>01</b><div><strong>Elige un caso real</strong><p>No empieces por migrar todo. Escoge una situación repetitiva y visible.</p></div></article><article><b>02</b><div><strong>Reduce campos</strong><p>Conserva solo la información que ayuda a actuar o entender después qué ocurrió.</p></div></article><article><b>03</b><div><strong>Prueba en campo</strong><p>Comprueba el flujo con móvil, fotos y contexto en el lugar donde sucede el trabajo.</p></div></article><article><b>04</b><div><strong>Mide si mejora</strong><p>Si añade más pasos de los que elimina, simplifica antes de ampliar.</p></div></article></div></div><div class="guide-visual-card" style="margin-top:20px"><img src={fieldVisual} alt="Flujo de campo desde un aviso hasta el histórico útil de una intervención" loading="lazy" width="960" height="540" /></div></div></section>

  <section class="page-section page-section--soft"><div class="page-shell"><div class="callout"><div><h2>{guide.takeaway}</h2><p>IsiVoltPro intenta convertir este principio en un flujo digital sencillo: registrar una vez, reutilizar el contexto y conservar lo que será útil después.</p></div><a class="btn btn--primary" href={contact}>Solicitar demo →</a></div></div></section>
</main>
<V3CommercialFooter />
</body></html>
---
const base = import.meta.env.BASE_URL;
const home = base;
const product = `${base}producto/`;
const modules = `${base}aplicaciones/`;
const sectors = `${base}sectores/`;
const pricing = `${base}precios/`;
const resources = `${base}recursos/`;
const access = `${base}acceso/`;
const contact = `${base}contacto/`;
---
<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href={home} aria-label="IsiVoltPro, inicio">
      <i class="brand__icon" aria-hidden="true"></i>
      <span>IsiVoltPro</span>
    </a>
    <nav class="nav" aria-label="Navegación principal">
      <a href={product}>Producto</a>
      <a href={modules}>Módulos</a>
      <a href={sectors}>Sectores</a>
      <a href={pricing}>Planes</a>
      <a href={resources}>Recursos</a>
    </nav>
    <div class="header-actions">
      <a class="btn" href={access}>Acceder</a>
      <a class="btn btn--primary" href={contact}>Solicitar demo <span>→</span></a>
      <a class="btn mobile-menu" href={modules} aria-label="Ver módulos">☰</a>
    </div>
  </div>
</header>

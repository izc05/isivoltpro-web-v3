---
const base = import.meta.env.BASE_URL;
const phase67Url = `${base}lab-3d-phase67/`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#02060b" />
    <title>IsiVoltPro · Fase 6.8 · Aplicaciones</title>
  </head>
  <body>
    <main class="phase-loader">
      <div class="phase-loader__mark" aria-hidden="true"><i></i><i></i><i></i></div>
      <p>ISIVOLTPRO</p>
      <strong>Preparando Fase 6.8</strong>
      <span>APLICACIONES · UN ECOSISTEMA CONECTADO</span>
      <noscript><a href={phase67Url}>Abrir Fase 6.7</a></noscript>
    </main>

    <script is:inline define:vars={{ phase67Url }}>
      const applicationsMarkup = `
        <section class="applications" id="aplicaciones" aria-labelledby="applications-title">
          <div class="applications__head">
            <div>
              <p class="eyebrow"><i></i> APLICACIONES ISIVOLTPRO</p>
              <h2 id="applications-title">DISTINTAS HERRAMIENTAS.<br /><em>UN MISMO CONTEXTO.</em></h2>
            </div>
            <div class="applications__copy">
              <p class="applications__lead">IsiVoltPro no se plantea como una colección de aplicaciones aisladas. Cada módulo trabaja sobre la misma instalación, los mismos activos y el mismo histórico técnico.</p>
              <p>La persona entra por la tarea que necesita realizar, pero la información que genera vuelve al contexto común del ecosistema.</p>
            </div>
          </div>

          <div class="applications-map" aria-label="Mapa de aplicaciones IsiVoltPro">
            <div class="applications-map__core">
              <span>ECOSISTEMA</span>
              <strong>ISIVOLTPRO</strong>
              <small>CONTEXTO COMPARTIDO</small>
            </div>
            <div class="applications-map__rail">
              <span>INSTALACIÓN</span><i></i><span>ACTIVOS</span><i></i><span>TRABAJO</span><i></i><span>HISTÓRICO</span><i></i><span>INTELIGENCIA</span>
            </div>
          </div>

          <div class="applications-grid">
            <article class="app-card app-card--assets">
              <div class="app-card__top"><span>01</span><i class="app-icon app-icon--asset" aria-hidden="true"><b></b><b></b><b></b></i></div>
              <div class="app-card__body">
                <small>BASE DEL CONTEXTO</small>
                <h3>ACTIVOS</h3>
                <p>Identifica cada equipo dentro de su instalación, ubicación y sistema técnico para que el resto del trabajo tenga una referencia común.</p>
                <ul><li>Identidad y código</li><li>Ubicación y sistema</li><li>Estado y criticidad</li><li>Documentación vinculada</li></ul>
              </div>
              <div class="app-card__foot"><span>ACTIVO → CONTEXTO</span><b>FUTURA PÁGINA DE APLICACIÓN</b></div>
            </article>

            <article class="app-card app-card--maintenance">
              <div class="app-card__top"><span>02</span><i class="app-icon app-icon--maintenance" aria-hidden="true"><b></b><b></b><b></b></i></div>
              <div class="app-card__body">
                <small>PLANIFICACIÓN Y CUIDADO</small>
                <h3>MANTENIMIENTO</h3>
                <p>Organiza preventivos, correctivos, revisiones y próximas actuaciones manteniendo siempre la relación con el activo real.</p>
                <ul><li>Preventivo</li><li>Correctivo</li><li>Revisiones</li><li>Próximas actuaciones</li></ul>
              </div>
              <div class="app-card__foot"><span>PLAN → ACTIVO → ACTUACIÓN</span><b>FUTURA PÁGINA DE APLICACIÓN</b></div>
            </article>

            <article class="app-card app-card--workorders">
              <div class="app-card__top"><span>03</span><i class="app-icon app-icon--work" aria-hidden="true"><b></b><b></b><b></b></i></div>
              <div class="app-card__body">
                <small>EJECUCIÓN OPERATIVA</small>
                <h3>ÓRDENES DE TRABAJO</h3>
                <p>Convierte una necesidad técnica en trabajo trazable: prioridad, responsable, intervención, evidencias y cierre.</p>
                <ul><li>Prioridad y estado</li><li>Asignación técnica</li><li>Intervención</li><li>Cierre trazable</li></ul>
              </div>
              <div class="app-card__foot"><span>INCIDENCIA → OT → CIERRE</span><b>FUTURA PÁGINA DE APLICACIÓN</b></div>
            </article>

            <article class="app-card app-card--inspections">
              <div class="app-card__top"><span>04</span><i class="app-icon app-icon--inspection" aria-hidden="true"><b></b><b></b><b></b></i></div>
              <div class="app-card__body">
                <small>CONTROL Y VERIFICACIÓN</small>
                <h3>INSPECCIONES</h3>
                <p>Reúne comprobaciones, listas de verificación, observaciones y resultados alrededor del equipo o instalación inspeccionada.</p>
                <ul><li>Checklists</li><li>Observaciones</li><li>Resultado</li><li>Evidencias</li></ul>
              </div>
              <div class="app-card__foot"><span>REVISAR → REGISTRAR → TRAZAR</span><b>FUTURA PÁGINA DE APLICACIÓN</b></div>
            </article>

            <article class="app-card app-card--docs">
              <div class="app-card__top"><span>05</span><i class="app-icon app-icon--docs" aria-hidden="true"><b></b><b></b><b></b></i></div>
              <div class="app-card__body">
                <small>MEMORIA TÉCNICA</small>
                <h3>DOCUMENTACIÓN</h3>
                <p>Centraliza planos, manuales, informes, fotografías y evidencias sin separarlos del activo o trabajo al que pertenecen.</p>
                <ul><li>Planos y manuales</li><li>Informes</li><li>Fotografías</li><li>Versiones y contexto</li></ul>
              </div>
              <div class="app-card__foot"><span>DOCUMENTO → ACTIVO → HISTÓRICO</span><b>FUTURA PÁGINA DE APLICACIÓN</b></div>
            </article>

            <article class="app-card app-card--organization">
              <div class="app-card__top"><span>06</span><i class="app-icon app-icon--org" aria-hidden="true"><b></b><b></b><b></b></i></div>
              <div class="app-card__body">
                <small>PERSONAS Y ACCESO</small>
                <h3>USUARIOS Y ORGANIZACIONES</h3>
                <p>Estructura quién pertenece a cada organización, qué función desempeña y desde qué contexto accede al ecosistema.</p>
                <ul><li>Organizaciones</li><li>Miembros</li><li>Roles</li><li>Acceso por contexto</li></ul>
              </div>
              <div class="app-card__foot"><span>ORGANIZACIÓN → PERSONA → ROL</span><b>FUTURA PÁGINA DE APLICACIÓN</b></div>
            </article>

            <article class="app-card app-card--ai">
              <div class="app-card__top"><span>07</span><i class="app-icon app-icon--ai" aria-hidden="true"><b></b><b></b><b></b></i></div>
              <div class="app-card__body">
                <small>CAPA TRANSVERSAL</small>
                <h3>ISIVOLTPRO AI</h3>
                <p>La capa de asistencia se apoya en el contexto técnico conectado para ayudar a consultar información, interpretar documentación y preparar futuras decisiones.</p>
                <ul><li>Consulta contextual</li><li>Documentación técnica</li><li>Histórico operativo</li><li>Asistencia al técnico</li></ul>
              </div>
              <div class="app-card__foot"><span>CONTEXTO → CONSULTA → ASISTENCIA</span><b>CAPACIDAD EN DESARROLLO</b></div>
            </article>
          </div>

          <div class="applications-flow">
            <div class="applications-flow__copy">
              <span>UNA SOLA OPERACIÓN TÉCNICA</span>
              <strong>LAS APLICACIONES CAMBIAN.<br />EL CONTEXTO PERMANECE.</strong>
              <p>Una inspección puede generar una observación. La observación puede convertirse en una OT. La OT actúa sobre un activo. El cierre incorpora fotografías y documentos. Todo termina alimentando el mismo histórico.</p>
            </div>
            <div class="applications-flow__steps" aria-label="Ejemplo de relación entre aplicaciones">
              <article><span>01</span><b>INSPECCIÓN</b><small>Detecta</small></article><i>→</i>
              <article><span>02</span><b>OT</b><small>Organiza</small></article><i>→</i>
              <article><span>03</span><b>ACTIVO</b><small>Contextualiza</small></article><i>→</i>
              <article><span>04</span><b>DOCUMENTACIÓN</b><small>Evidencia</small></article><i>→</i>
              <article><span>05</span><b>HISTÓRICO</b><small>Conserva</small></article>
            </div>
          </div>

          <div class="applications-next">
            <span>ESTRUCTURA PREPARADA PARA FASES POSTERIORES</span>
            <p>Cada aplicación tendrá más adelante su propia página, interfaz y explicación específica. En esta Home solo presentamos cómo encajan dentro del Ecosistema IsiVoltPro.</p>
            <b>HOME → APLICACIÓN → DETALLE DE PRODUCTO</b>
          </div>
        </section>`;

      const applicationsStyles = `
        .applications{padding:130px clamp(20px,5vw,92px) 155px;background:radial-gradient(circle at 76% 18%,rgba(0,139,232,.08),transparent 28%),linear-gradient(180deg,#02070b,#04111a 48%,#02070b);border-top:1px solid rgba(105,169,197,.08)}
        .applications__head,.applications-map,.applications-grid,.applications-flow,.applications-next{width:min(1480px,100%);margin-left:auto;margin-right:auto}
        .applications__head{display:grid;grid-template-columns:1fr .58fr;gap:clamp(50px,8vw,130px);align-items:end;margin-bottom:66px}
        .applications__head h2{margin:0;font-family:'Barlow Condensed',Inter,sans-serif;font-size:clamp(58px,5.8vw,98px);line-height:.87;font-weight:650;letter-spacing:-.04em}
        .applications__head h2 em{color:transparent;font-style:normal;-webkit-text-stroke:1px rgba(133,221,255,.72);text-shadow:0 0 34px rgba(0,145,255,.12)}
        .applications__copy{border-left:1px solid rgba(27,207,255,.22);padding-left:28px}.applications__copy p{margin:0 0 13px;color:#8198a3;font-size:12px;line-height:1.8}.applications__copy .applications__lead{color:#d4e4eb;font-size:15px}
        .applications-map{position:relative;display:grid;grid-template-columns:240px 1fr;align-items:center;gap:34px;margin-bottom:24px;padding:24px 28px;border:1px solid rgba(27,207,255,.17);background:linear-gradient(90deg,rgba(0,116,204,.12),rgba(5,17,25,.8));overflow:hidden}.applications-map::after{content:'';position:absolute;right:-100px;top:-180px;width:400px;height:400px;border-radius:50%;background:#078dff;filter:blur(90px);opacity:.07}
        .applications-map__core{display:grid;gap:4px;padding-right:26px;border-right:1px solid rgba(109,185,217,.14)}.applications-map__core span,.applications-map__core small{color:#587784;font-size:6px;font-weight:850;letter-spacing:.16em}.applications-map__core strong{font-family:'Barlow Condensed',Inter,sans-serif;font-size:31px;line-height:.95}.applications-map__core small{color:#47b9df}
        .applications-map__rail{position:relative;z-index:1;display:grid;grid-template-columns:auto 1fr auto 1fr auto 1fr auto 1fr auto;align-items:center;gap:12px}.applications-map__rail span{color:#9ab1bb;font-size:7px;font-weight:850;letter-spacing:.12em;white-space:nowrap}.applications-map__rail i{height:1px;background:linear-gradient(90deg,rgba(27,207,255,.15),rgba(27,207,255,.52),rgba(27,207,255,.15));position:relative}.applications-map__rail i::after{content:'';position:absolute;right:0;top:50%;width:5px;height:5px;border-radius:50%;background:#1bcfff;box-shadow:0 0 8px rgba(27,207,255,.55);transform:translateY(-50%)}
        .applications-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}.app-card{grid-column:span 4;display:flex;flex-direction:column;min-height:440px;border:1px solid rgba(112,186,219,.13);background:linear-gradient(160deg,rgba(8,22,32,.96),rgba(3,10,16,.94));overflow:hidden;transition:transform .25s ease,border-color .25s ease,background .25s ease}.app-card:hover{transform:translateY(-3px);border-color:rgba(79,203,250,.26);background:linear-gradient(160deg,rgba(9,27,40,.98),rgba(3,11,18,.96))}.app-card--ai{grid-column:span 12;min-height:0;display:grid;grid-template-columns:105px 1fr 340px;align-items:stretch;background:linear-gradient(100deg,rgba(0,102,194,.18),rgba(6,22,33,.94) 40%,rgba(11,32,45,.92))}
        .app-card__top{height:98px;display:flex;align-items:flex-start;justify-content:space-between;padding:22px 22px 0;border-bottom:1px solid rgba(104,178,207,.08);background:radial-gradient(circle at 82% 30%,rgba(0,146,255,.1),transparent 34%)}.app-card__top>span{color:#456674;font-size:7px;font-weight:900;letter-spacing:.15em}.app-icon{position:relative;width:42px;height:42px;display:block}.app-icon b{position:absolute;display:block;border:1px solid rgba(80,204,250,.55);box-shadow:0 0 12px rgba(0,151,255,.08)}
        .app-icon--asset b:nth-child(1){inset:5px;transform:rotate(30deg)}.app-icon--asset b:nth-child(2){inset:12px;transform:rotate(30deg)}.app-icon--asset b:nth-child(3){width:4px;height:4px;left:19px;top:19px;border-radius:50%;background:#1bcfff}
        .app-icon--maintenance b:nth-child(1){width:30px;height:6px;left:6px;top:18px;transform:rotate(-45deg)}.app-icon--maintenance b:nth-child(2){width:12px;height:12px;right:3px;top:2px;border-radius:50%}.app-icon--maintenance b:nth-child(3){width:12px;height:12px;left:3px;bottom:2px;border-radius:50%}
        .app-icon--work b:nth-child(1){inset:5px 9px}.app-icon--work b:nth-child(2){left:14px;right:14px;top:13px;height:1px}.app-icon--work b:nth-child(3){left:14px;right:14px;top:23px;height:1px}
        .app-icon--inspection b:nth-child(1){inset:5px 8px}.app-icon--inspection b:nth-child(2){width:9px;height:4px;left:14px;top:14px;border-width:0 0 1px 1px;transform:rotate(-45deg)}.app-icon--inspection b:nth-child(3){width:13px;height:1px;right:8px;bottom:10px}
        .app-icon--docs b:nth-child(1){inset:4px 9px}.app-icon--docs b:nth-child(2){width:13px;height:1px;left:14px;top:15px}.app-icon--docs b:nth-child(3){width:13px;height:1px;left:14px;top:24px}
        .app-icon--org b:nth-child(1){width:12px;height:12px;left:15px;top:3px;border-radius:50%}.app-icon--org b:nth-child(2){width:24px;height:12px;left:9px;bottom:5px;border-radius:14px 14px 3px 3px}.app-icon--org b:nth-child(3){width:6px;height:6px;right:2px;top:8px;border-radius:50%;background:#1bcfff}
        .app-icon--ai b:nth-child(1){inset:5px;border-radius:50%}.app-icon--ai b:nth-child(2){inset:12px;border-radius:50%}.app-icon--ai b:nth-child(3){width:4px;height:4px;left:19px;top:19px;border-radius:50%;background:#1bcfff;box-shadow:0 0 16px #1bcfff}
        .app-card__body{padding:24px 24px 20px;flex:1}.app-card__body small{color:#4c7586;font-size:6px;font-weight:850;letter-spacing:.16em}.app-card__body h3{margin:9px 0 15px;font-family:'Barlow Condensed',Inter,sans-serif;font-size:36px;line-height:.91;letter-spacing:-.02em}.app-card__body p{min-height:84px;margin:0 0 20px;color:#8299a4;font-size:10px;line-height:1.72}.app-card__body ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:8px}.app-card__body li{position:relative;padding-left:13px;color:#9ab0b9;font-size:8px;line-height:1.5}.app-card__body li::before{content:'';position:absolute;left:0;top:5px;width:4px;height:4px;background:#1bcfff;box-shadow:0 0 7px rgba(27,207,255,.35)}
        .app-card__foot{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 22px;border-top:1px solid rgba(104,178,207,.09);background:rgba(2,10,16,.42)}.app-card__foot span{color:#6ec9e8;font-size:6px;font-weight:850;letter-spacing:.09em}.app-card__foot b{color:#465f6b;font-size:5px;letter-spacing:.1em;text-align:right}
        .app-card--ai .app-card__top{height:auto;padding:25px;align-items:center;border-right:1px solid rgba(104,178,207,.09);border-bottom:0}.app-card--ai .app-card__body{padding:28px 34px}.app-card--ai .app-card__body p{min-height:0;max-width:720px}.app-card--ai .app-card__body ul{grid-template-columns:repeat(4,auto);justify-content:start;gap:22px}.app-card--ai .app-card__foot{display:grid;align-content:center;justify-items:end;padding:25px 30px;border-top:0;border-left:1px solid rgba(104,178,207,.09)}.app-card--ai .app-card__foot span{font-size:7px}.app-card--ai .app-card__foot b{margin-top:8px;color:#6d91a0}
        .applications-flow{display:grid;grid-template-columns:.62fr 1.38fr;gap:45px;align-items:center;margin-top:44px;padding:34px;border:1px solid rgba(42,190,243,.17);background:linear-gradient(100deg,rgba(0,104,192,.12),rgba(3,16,24,.78))}.applications-flow__copy>span{display:block;margin-bottom:9px;color:#538192;font-size:7px;font-weight:850;letter-spacing:.17em}.applications-flow__copy>strong{font-family:'Barlow Condensed',Inter,sans-serif;font-size:31px;line-height:.94}.applications-flow__copy p{margin:14px 0 0;color:#7c949f;font-size:10px;line-height:1.7}.applications-flow__steps{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr auto 1fr;align-items:center}.applications-flow__steps article{display:grid;justify-items:center;gap:4px;text-align:center;padding:15px 8px;border:1px solid rgba(90,181,217,.12);background:rgba(4,16,24,.66)}.applications-flow__steps article span{color:#436a79;font-size:5px}.applications-flow__steps article b{font-size:8px;letter-spacing:.08em}.applications-flow__steps article small{color:#6c8995;font-size:6px}.applications-flow__steps>i{padding:0 7px;color:#438ca8;font-style:normal;font-size:12px}
        .applications-next{margin-top:16px;display:grid;grid-template-columns:.8fr 1.4fr 1fr;gap:30px;align-items:center;padding:22px 26px;border:1px solid rgba(106,178,207,.1);background:#051019}.applications-next span{color:#558394;font-size:6px;font-weight:850;letter-spacing:.15em}.applications-next p{margin:0;color:#728b96;font-size:9px;line-height:1.65}.applications-next b{color:#a1bdc8;font-size:7px;letter-spacing:.1em;text-align:right}
        @media(max-width:1100px){.app-card{grid-column:span 6}.app-card--ai{grid-column:span 12}.applications-flow{grid-template-columns:1fr}.applications-map{grid-template-columns:1fr}.applications-map__core{border-right:0;border-bottom:1px solid rgba(109,185,217,.14);padding:0 0 18px}.applications-map__rail{overflow-x:auto;padding-bottom:5px}}
        @media(max-width:760px){.applications{padding:90px 20px 100px}.applications__head{grid-template-columns:1fr;gap:28px}.applications__head h2{font-size:clamp(50px,14vw,72px)}.applications-map{padding:20px}.applications-map__rail{grid-template-columns:auto 28px auto 28px auto 28px auto 28px auto;gap:8px}.app-card{grid-column:span 12;min-height:0}.app-card--ai{display:flex}.app-card--ai .app-card__top{height:92px;border-right:0;border-bottom:1px solid rgba(104,178,207,.09)}.app-card--ai .app-card__body{padding:24px}.app-card--ai .app-card__body ul{grid-template-columns:1fr 1fr;gap:8px}.app-card--ai .app-card__foot{display:flex;justify-content:space-between;border-left:0;border-top:1px solid rgba(104,178,207,.09);padding:14px 22px}.app-card__body p{min-height:0}.applications-flow{padding:24px 18px}.applications-flow__steps{grid-template-columns:1fr}.applications-flow__steps>i{transform:rotate(90deg);padding:5px}.applications-next{grid-template-columns:1fr}.applications-next b{text-align:left}}
      `;

      async function buildPhase68() {
        try {
          const response = await fetch(phase67Url, { cache: 'no-cache' });
          if (!response.ok) throw new Error(`Fase 6.7: ${response.status}`);
          const html = await response.text();
          const parsed = new DOMParser().parseFromString(html, 'text/html');

          parsed.title = 'IsiVoltPro · Fase 6.8 · Aplicaciones';
          const description = parsed.querySelector('meta[name="description"]');
          if (description) description.setAttribute('content', 'Aplicaciones IsiVoltPro para activos, mantenimiento, órdenes de trabajo, inspecciones, documentación, organizaciones y asistencia técnica conectadas por un mismo contexto.');

          const nav = parsed.querySelector('.nav');
          if (nav && !nav.querySelector('a[href="#aplicaciones"]')) {
            const link = parsed.createElement('a');
            link.href = '#aplicaciones';
            link.textContent = 'Aplicaciones';
            nav.appendChild(link);
          }

          const bridge = parsed.querySelector('.bridge');
          if (!bridge) throw new Error('No se encontró el punto de inserción de Fase 6.7');
          const template = parsed.createElement('template');
          template.innerHTML = applicationsMarkup.trim();
          bridge.parentNode.insertBefore(template.content, bridge);

          const style = parsed.createElement('style');
          style.textContent = applicationsStyles;
          parsed.head.appendChild(style);

          document.replaceChild(parsed.documentElement, document.documentElement);
        } catch (error) {
          console.error('[ISIVOLTPRO] No se pudo componer Fase 6.8', error);
          document.querySelector('.phase-loader')?.classList.add('phase-loader--error');
          const fallback = document.createElement('a');
          fallback.href = phase67Url;
          fallback.textContent = 'Abrir Fase 6.7';
          document.querySelector('.phase-loader')?.appendChild(fallback);
        }
      }

      buildPhase68();
    </script>
  </body>
</html>

<style>
  :global(html), :global(body) { margin: 0; min-width: 320px; min-height: 100%; background: #02060b; color: #f6fbff; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  .phase-loader { min-height: 100svh; display: grid; place-content: center; justify-items: center; gap: 9px; background: radial-gradient(circle at 50% 42%, rgba(0, 122, 255, .13), transparent 26%), #02060b; }
  .phase-loader__mark { width: 32px; display: grid; gap: 4px; margin-bottom: 16px; transform: skewY(-26deg); }
  .phase-loader__mark i { height: 6px; background: linear-gradient(90deg, #087dff, #1bcfff); box-shadow: 0 0 16px rgba(27, 207, 255, .24); }
  .phase-loader p { margin: 0; font-size: 14px; font-weight: 800; letter-spacing: .18em; }
  .phase-loader strong { font-size: 20px; }
  .phase-loader span { color: #607985; font-size: 8px; font-weight: 800; letter-spacing: .17em; }
  .phase-loader a { margin-top: 18px; color: #1bcfff; font-size: 11px; }
</style>

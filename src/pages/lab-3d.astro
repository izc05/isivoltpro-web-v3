---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#02040a" />
    <meta name="description" content="ISIVOLTPRO experimental industrial 3D experience." />
    <title>ISIVOLTPRO · 3D Lab</title>
  </head>

  <body>
    <div id="boot" aria-hidden="true">
      <div class="boot-mark"><span></span><span></span><span></span></div>
      <p>ISIVOLTPRO / 3D LAB</p>
      <strong id="boot-value">00</strong>
      <div class="boot-line"><i id="boot-progress"></i></div>
    </div>

    <canvas id="webgl" aria-hidden="true"></canvas>

    <header class="lab-header">
      <a class="brand" href={base} aria-label="Back to ISIVOLTPRO home">
        <span class="brand-mark"><i></i><i></i><i></i></span>
        <span>ISIVOLT<strong>PRO</strong></span>
      </a>
      <div class="lab-state"><i></i> 3D LAB / ONLINE</div>
      <a class="back" href={base}>BACK TO HOME</a>
    </header>

    <aside class="progress-rail" aria-hidden="true">
      <span>01</span>
      <div><i id="rail-progress"></i></div>
      <span>05</span>
    </aside>

    <main id="story">
      <section class="chapter chapter-intro" data-chapter="0">
        <div class="copy">
          <p class="eyebrow">INDUSTRIAL DIGITAL TWIN</p>
          <h1>The installation<br />becomes visible.</h1>
          <p class="body-copy">A first technical prototype for the next ISIVOLTPRO home experience.</p>
          <span class="scroll-hint">SCROLL TO ENTER <i>↓</i></span>
        </div>
      </section>

      <section class="chapter chapter-core" data-chapter="1">
        <div class="copy right-copy">
          <p class="index">02 / CORE</p>
          <p class="eyebrow">CENTRAL INTELLIGENCE</p>
          <h2>One core.<br />Every system.</h2>
          <p class="body-copy">Technical data converges in one operational layer, connected in real time.</p>
        </div>
      </section>

      <section class="chapter chapter-energy" data-chapter="2">
        <div class="copy">
          <p class="index">03 / ENERGY</p>
          <p class="eyebrow">ELECTRICAL INFRASTRUCTURE</p>
          <h2>Power becomes<br />information.</h2>
          <p class="body-copy">Distribution, protection, consumption and anomalies represented as a living network.</p>
        </div>
      </section>

      <section class="chapter chapter-systems" data-chapter="3">
        <div class="copy right-copy">
          <p class="index">04 / SYSTEMS</p>
          <p class="eyebrow">HVAC · WATER · ASSETS</p>
          <h2>Connected beyond<br />electricity.</h2>
          <p class="body-copy">The digital facility extends across mechanical systems, water, assets and maintenance.</p>
        </div>
      </section>

      <section class="chapter chapter-end" data-chapter="4">
        <div class="copy end-copy">
          <p class="index">05 / ISIVOLTPRO</p>
          <p class="eyebrow">ONE OPERATIONAL SYSTEM</p>
          <h2>See the whole facility.<br />Act on what matters.</h2>
          <a class="lab-button" href={base}>RETURN TO CURRENT HOME <span>→</span></a>
        </div>
      </section>
    </main>

    <div id="no-webgl" hidden>
      <strong>3D unavailable</strong>
      <p>This experiment needs WebGL. The current ISIVOLTPRO home remains available.</p>
      <a href={base}>Return home</a>
    </div>

    <script>
      import * as THREE from 'three';
      import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
      import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
      import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';
      import { OutputPass } from 'three/examples/jsm/postprocessing/OutputPass.js';
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const canvas = document.querySelector('#webgl');
      const boot = document.querySelector('#boot');
      const bootValue = document.querySelector('#boot-value');
      const bootProgress = document.querySelector('#boot-progress');
      const railProgress = document.querySelector('#rail-progress');
      const noWebgl = document.querySelector('#no-webgl');

      const supportsWebGL = (() => {
        try {
          const test = document.createElement('canvas');
          return Boolean(test.getContext('webgl2') || test.getContext('webgl'));
        } catch {
          return false;
        }
      })();

      if (!supportsWebGL || !(canvas instanceof HTMLCanvasElement)) {
        if (canvas) canvas.remove();
        if (boot) boot.remove();
        if (noWebgl instanceof HTMLElement) noWebgl.hidden = false;
      } else {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const mobile = window.matchMedia('(max-width: 760px)').matches;

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: false,
          alpha: false,
          powerPreference: 'high-performance',
          stencil: false,
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, mobile ? 1.25 : 1.65));
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 0.85;
        renderer.shadowMap.enabled = !mobile;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;

        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x02040a);
        scene.fog = new THREE.FogExp2(0x02040a, 0.032);

        const camera = new THREE.PerspectiveCamera(42, window.innerWidth / window.innerHeight, 0.1, 120);
        camera.position.set(-12, 7, 17);

        const composer = new EffectComposer(renderer);
        composer.addPass(new RenderPass(scene, camera));
        const bloom = new UnrealBloomPass(
          new THREE.Vector2(window.innerWidth, window.innerHeight),
          mobile ? 0.45 : 0.72,
          0.5,
          0.82,
        );
        composer.addPass(bloom);
        composer.addPass(new OutputPass());

        const world = new THREE.Group();
        scene.add(world);

        const darkMetal = new THREE.MeshStandardMaterial({ color: 0x111925, metalness: 0.72, roughness: 0.38 });
        const darkPanel = new THREE.MeshStandardMaterial({ color: 0x07101a, metalness: 0.48, roughness: 0.52 });
        const concrete = new THREE.MeshStandardMaterial({ color: 0x0a0e14, metalness: 0.08, roughness: 0.88 });
        const cyan = new THREE.Color(0x00d9ff);
        const blue = new THREE.Color(0x0879ff);
        const warm = new THREE.Color(0xffb35c);

        const cyanGlow = new THREE.MeshStandardMaterial({
          color: 0x063b50,
          emissive: cyan,
          emissiveIntensity: 3.2,
          metalness: 0.5,
          roughness: 0.22,
        });
        const blueGlow = new THREE.MeshStandardMaterial({
          color: 0x031b38,
          emissive: blue,
          emissiveIntensity: 2.4,
          metalness: 0.62,
          roughness: 0.24,
        });
        const warmGlow = new THREE.MeshStandardMaterial({
          color: 0x3b2311,
          emissive: warm,
          emissiveIntensity: 1.8,
          roughness: 0.35,
        });

        const floor = new THREE.Mesh(new THREE.PlaneGeometry(58, 42), concrete);
        floor.rotation.x = -Math.PI / 2;
        floor.position.y = -0.05;
        floor.receiveShadow = true;
        world.add(floor);

        const grid = new THREE.GridHelper(58, 58, 0x17455b, 0x0b1c27);
        grid.position.y = 0.01;
        grid.material.transparent = true;
        grid.material.opacity = 0.25;
        world.add(grid);

        function makeBuilding(x: number, z: number, w: number, d: number, h: number) {
          const group = new THREE.Group();
          group.position.set(x, 0, z);

          const body = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), darkPanel);
          body.position.y = h / 2;
          body.castShadow = true;
          body.receiveShadow = true;
          group.add(body);

          const top = new THREE.Mesh(new THREE.BoxGeometry(w * 0.82, 0.12, d * 0.82), darkMetal);
          top.position.y = h + 0.08;
          group.add(top);

          const strip = new THREE.Mesh(new THREE.BoxGeometry(w * 0.72, 0.055, 0.04), cyanGlow);
          strip.position.set(0, h * 0.72, d / 2 + 0.025);
          group.add(strip);

          const ledCount = Math.max(2, Math.round(w / 1.1));
          for (let i = 0; i < ledCount; i += 1) {
            const led = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.08, 0.035), i % 3 === 0 ? warmGlow : cyanGlow);
            led.position.set(-w * 0.34 + (i / Math.max(1, ledCount - 1)) * w * 0.68, h * 0.38, d / 2 + 0.03);
            group.add(led);
          }

          world.add(group);
          return group;
        }

        const modules = [
          makeBuilding(-7.6, -3.8, 5.5, 4.4, 3.2),
          makeBuilding(-7.1, 4.7, 6.1, 4.8, 2.5),
          makeBuilding(7.4, -4.6, 5.2, 5.0, 3.8),
          makeBuilding(7.1, 4.4, 6.2, 4.3, 2.9),
          makeBuilding(0.0, 8.2, 6.8, 3.1, 2.2),
        ];

        // Mechanical silhouettes: tanks, ducts and pump skids.
        for (let i = 0; i < 7; i += 1) {
          const tank = new THREE.Mesh(new THREE.CylinderGeometry(0.5 + (i % 2) * 0.16, 0.5 + (i % 2) * 0.16, 2.3 + (i % 3) * 0.35, 24), darkMetal);
          tank.position.set(-3.8 + i * 1.3, 1.15, -8.0 + (i % 2) * 0.8);
          tank.castShadow = true;
          world.add(tank);
        }

        for (let i = 0; i < 5; i += 1) {
          const pump = new THREE.Group();
          const basePlate = new THREE.Mesh(new THREE.BoxGeometry(1.25, 0.18, 0.8), darkMetal);
          basePlate.position.y = 0.09;
          pump.add(basePlate);
          const motor = new THREE.Mesh(new THREE.CylinderGeometry(0.28, 0.28, 0.72, 18), darkPanel);
          motor.rotation.z = Math.PI / 2;
          motor.position.set(-0.15, 0.48, 0);
          pump.add(motor);
          const status = new THREE.Mesh(new THREE.SphereGeometry(0.055, 10, 10), cyanGlow);
          status.position.set(0.5, 0.42, 0.32);
          pump.add(status);
          pump.position.set(2.7 + i * 1.45, 0, 8.1 - (i % 2) * 1.15);
          world.add(pump);
        }

        // CORE
        const core = new THREE.Group();
        core.position.set(0, 0, 0);
        world.add(core);

        const plinth = new THREE.Mesh(new THREE.CylinderGeometry(2.25, 2.55, 0.45, 64), darkMetal);
        plinth.position.y = 0.22;
        plinth.receiveShadow = true;
        core.add(plinth);

        const coreBody = new THREE.Mesh(new THREE.CylinderGeometry(0.72, 0.96, 4.4, 48), darkMetal);
        coreBody.position.y = 2.65;
        coreBody.castShadow = true;
        core.add(coreBody);

        const energyColumn = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 3.55, 28), cyanGlow);
        energyColumn.position.y = 2.7;
        core.add(energyColumn);

        const coreCap = new THREE.Mesh(new THREE.CylinderGeometry(0.98, 0.72, 0.4, 48), darkMetal);
        coreCap.position.y = 4.9;
        core.add(coreCap);

        const rings: THREE.Mesh[] = [];
        [1.2, 2.35, 3.5, 4.55].forEach((y, index) => {
          const ring = new THREE.Mesh(new THREE.TorusGeometry(1.08 + index * 0.06, 0.035, 10, 72), index % 2 ? blueGlow : cyanGlow);
          ring.rotation.x = Math.PI / 2;
          ring.position.y = y;
          core.add(ring);
          rings.push(ring);
        });

        const halo = new THREE.Mesh(new THREE.TorusGeometry(2.0, 0.055, 12, 96), cyanGlow);
        halo.rotation.x = Math.PI / 2;
        halo.position.y = 0.55;
        core.add(halo);

        const beacon = new THREE.PointLight(0x00d9ff, mobile ? 18 : 28, 16, 1.65);
        beacon.position.set(0, 3.0, 0);
        core.add(beacon);

        const beam = new THREE.Mesh(
          new THREE.CylinderGeometry(0.09, 0.3, 16, 20, 1, true),
          new THREE.MeshBasicMaterial({ color: 0x00d9ff, transparent: true, opacity: 0.16, blending: THREE.AdditiveBlending, depthWrite: false }),
        );
        beam.position.y = 10.5;
        core.add(beam);

        const ambient = new THREE.HemisphereLight(0x6ebfe0, 0x02050b, 1.35);
        scene.add(ambient);

        const key = new THREE.DirectionalLight(0xa9dfff, 3.2);
        key.position.set(-7, 13, 9);
        key.castShadow = !mobile;
        if (key.shadow) {
          key.shadow.mapSize.set(1024, 1024);
          key.shadow.camera.left = -18;
          key.shadow.camera.right = 18;
          key.shadow.camera.top = 18;
          key.shadow.camera.bottom = -18;
        }
        scene.add(key);

        const warmLight = new THREE.PointLight(0xffa85b, 9, 17, 2);
        warmLight.position.set(-8, 5, -5);
        scene.add(warmLight);

        function createConnection(start: THREE.Vector3, end: THREE.Vector3, height = 1.0) {
          const mid = start.clone().lerp(end, 0.5);
          mid.y += height;
          const curve = new THREE.CatmullRomCurve3([start, mid, end]);
          const tube = new THREE.Mesh(
            new THREE.TubeGeometry(curve, 36, 0.025, 8, false),
            cyanGlow,
          );
          world.add(tube);

          const pulse = new THREE.Mesh(new THREE.SphereGeometry(0.065, 12, 12), cyanGlow);
          world.add(pulse);
          return { curve, pulse, offset: Math.random() };
        }

        const connections = [
          createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(-7.6, 0.65, -3.8), 1.4),
          createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(-7.1, 0.65, 4.7), 1.1),
          createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(7.4, 0.65, -4.6), 1.6),
          createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(7.1, 0.65, 4.4), 1.25),
          createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(0, 0.65, 8.2), 1.0),
        ];

        const particleCount = mobile ? 260 : 620;
        const particlePositions = new Float32Array(particleCount * 3);
        for (let i = 0; i < particleCount; i += 1) {
          particlePositions[i * 3] = (Math.random() - 0.5) * 44;
          particlePositions[i * 3 + 1] = Math.random() * 10 + 0.3;
          particlePositions[i * 3 + 2] = (Math.random() - 0.5) * 32;
        }
        const particleGeometry = new THREE.BufferGeometry();
        particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
        const particles = new THREE.Points(
          particleGeometry,
          new THREE.PointsMaterial({ color: 0x5fcde8, size: 0.025, transparent: true, opacity: 0.38, depthWrite: false }),
        );
        world.add(particles);

        const cameraPath = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-13.5, 7.8, 18.0),
          new THREE.Vector3(-7.5, 5.7, 12.5),
          new THREE.Vector3(2.8, 5.0, 11.5),
          new THREE.Vector3(10.8, 4.1, 3.4),
          new THREE.Vector3(8.0, 3.3, -7.6),
          new THREE.Vector3(1.0, 5.0, -12.3),
        ]);

        const targetPath = new THREE.CatmullRomCurve3([
          new THREE.Vector3(0, 1.8, 0),
          new THREE.Vector3(0, 2.7, 0),
          new THREE.Vector3(-4.8, 1.7, -2.6),
          new THREE.Vector3(4.5, 1.6, -1.0),
          new THREE.Vector3(0, 2.2, 3.2),
          new THREE.Vector3(0, 3.0, 0),
        ]);

        const state = { progress: 0 };
        const chapterEls = Array.from(document.querySelectorAll('.chapter'));

        ScrollTrigger.create({
          trigger: '#story',
          start: 'top top',
          end: 'bottom bottom',
          scrub: reducedMotion ? false : 1.1,
          onUpdate: (self) => {
            state.progress = self.progress;
            if (railProgress instanceof HTMLElement) railProgress.style.height = `${Math.round(self.progress * 100)}%`;
            const active = Math.min(chapterEls.length - 1, Math.floor(self.progress * chapterEls.length));
            chapterEls.forEach((el, index) => el.classList.toggle('active', index === active));
          },
        });

        chapterEls[0]?.classList.add('active');

        const clock = new THREE.Clock();
        let raf = 0;
        let visible = true;

        function render() {
          const elapsed = clock.getElapsedTime();
          const progress = reducedMotion ? 0.15 : THREE.MathUtils.clamp(state.progress, 0.001, 0.999);
          const camPos = cameraPath.getPointAt(progress);
          const target = targetPath.getPointAt(progress);
          camera.position.lerp(camPos, reducedMotion ? 1 : 0.075);
          camera.lookAt(target);

          core.rotation.y = elapsed * 0.055;
          halo.rotation.z = elapsed * 0.18;
          rings.forEach((ring, index) => {
            ring.rotation.z = elapsed * (0.12 + index * 0.025) * (index % 2 ? -1 : 1);
          });
          particles.rotation.y = elapsed * 0.004;

          connections.forEach(({ curve, pulse, offset }, index) => {
            const t = (elapsed * (0.11 + index * 0.009) + offset) % 1;
            pulse.position.copy(curve.getPointAt(t));
          });

          modules.forEach((module, index) => {
            module.position.y = Math.sin(elapsed * 0.5 + index) * 0.012;
          });

          composer.render();
          if (visible) raf = requestAnimationFrame(render);
        }

        function resize() {
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, window.innerWidth <= 760 ? 1.25 : 1.65));
          renderer.setSize(window.innerWidth, window.innerHeight);
          composer.setSize(window.innerWidth, window.innerHeight);
        }

        window.addEventListener('resize', resize, { passive: true });
        document.addEventListener('visibilitychange', () => {
          visible = !document.hidden;
          if (visible) {
            cancelAnimationFrame(raf);
            clock.getDelta();
            render();
          }
        });

        const bootState = { value: 0 };
        gsap.to(bootState, {
          value: 100,
          duration: reducedMotion ? 0.2 : 1.65,
          ease: 'power2.inOut',
          onUpdate: () => {
            const value = Math.round(bootState.value);
            if (bootValue) bootValue.textContent = String(value).padStart(2, '0');
            if (bootProgress instanceof HTMLElement) bootProgress.style.width = `${value}%`;
          },
          onComplete: () => {
            if (boot instanceof HTMLElement) boot.classList.add('done');
          },
        });

        render();
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #fff;
    background: #02040a;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: #02040a; }
  html { overflow-x: hidden; }
  body { min-width: 320px; overflow-x: hidden; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }

  #webgl {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    display: block;
  }

  #webgl::after { content: ''; position: fixed; inset: 0; }

  body::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(2,4,10,.42) 0%, transparent 35%, transparent 67%, rgba(2,4,10,.3) 100%),
      linear-gradient(180deg, rgba(2,4,10,.12), transparent 54%, rgba(2,4,10,.54)),
      radial-gradient(circle at 50% 46%, transparent 0 42%, rgba(2,4,10,.24) 75%, rgba(2,4,10,.58) 100%);
  }

  #boot {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    background: #02040a;
    transition: opacity .7s ease, visibility .7s ease;
  }

  #boot.done { opacity: 0; visibility: hidden; }
  #boot p { margin: 8px 0 0; color: #7f9aaa; font-size: 10px; font-weight: 700; letter-spacing: .24em; }
  #boot strong { font-size: clamp(48px, 8vw, 92px); font-weight: 300; line-height: 1; letter-spacing: -.06em; }
  .boot-line { width: min(260px, 58vw); height: 1px; background: rgba(255,255,255,.12); overflow: hidden; }
  .boot-line i { display: block; width: 0; height: 100%; background: #00dcff; box-shadow: 0 0 16px #00dcff; }

  .boot-mark, .brand-mark { display: grid; gap: 4px; width: 33px; }
  .boot-mark span, .brand-mark i { height: 4px; border-radius: 10px; background: #fff; transform: skewX(-25deg); }
  .boot-mark span:nth-child(2), .brand-mark i:nth-child(2) { width: 80%; }
  .boot-mark span:nth-child(3), .brand-mark i:nth-child(3) { width: 63%; background: #00dcff; }

  .lab-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    height: 76px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 clamp(22px, 4.5vw, 74px);
    border-bottom: 1px solid rgba(125,187,211,.11);
    background: linear-gradient(180deg, rgba(2,4,10,.76), rgba(2,4,10,.08));
    backdrop-filter: blur(8px);
  }

  .brand { justify-self: start; display: flex; align-items: center; gap: 11px; font-size: 17px; letter-spacing: .04em; }
  .brand strong { color: #00dcff; }
  .lab-state, .back { color: #8aa0ae; font-size: 9px; font-weight: 700; letter-spacing: .18em; }
  .lab-state { display: flex; align-items: center; gap: 9px; }
  .lab-state i { width: 6px; height: 6px; border-radius: 50%; background: #00dcff; box-shadow: 0 0 12px #00dcff; }
  .back { justify-self: end; transition: color .2s ease; }
  .back:hover { color: #fff; }

  .progress-rail {
    position: fixed;
    right: clamp(20px, 2.4vw, 42px);
    top: 50%;
    z-index: 10;
    height: 240px;
    transform: translateY(-45%);
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    gap: 10px;
    color: #708592;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .1em;
  }
  .progress-rail div { position: relative; width: 1px; height: 100%; background: rgba(113,169,194,.18); overflow: hidden; }
  .progress-rail i { position: absolute; inset: 0 0 auto; display: block; width: 1px; height: 0; background: #00dcff; box-shadow: 0 0 9px #00dcff; }

  #story { position: relative; z-index: 2; }
  .chapter { min-height: 100svh; position: relative; display: flex; align-items: center; padding: 100px clamp(30px, 7vw, 116px) 70px; }
  .chapter:nth-child(even) { justify-content: flex-end; }

  .copy { width: min(620px, 50vw); opacity: .16; transform: translateY(24px); transition: opacity .6s ease, transform .6s ease; }
  .chapter.active .copy { opacity: 1; transform: translateY(0); }
  .right-copy { text-align: right; display: flex; flex-direction: column; align-items: flex-end; }

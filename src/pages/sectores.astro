---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const demo = `${base}demo/`;
const experience = `${base}experiencia/`;
const sectorVisual = `${base}media/sectores-operacion.svg`;
const sectorUrl = (slug: string) => `${base}sectores/${slug}/`;
---
<!doctype html><html lang="es"><head><V3Seo title="Sectores · IsiVoltPro" description="IsiVoltPro para autónomos técnicos, pequeñas empresas mantenedoras, negocios con instalaciones propias y operaciones multisede." path={`${base}sectores/`} />
<style is:inline>
.board-sectors{background:#fff;overflow:hidden}.board-sectors .page-shell{width:min(1180px,calc(100% - 44px))}.sectors-hero{position:relative;padding:82px 0 56px;background:radial-gradient(circle at 84% 35%,rgba(82,108,237,.11),transparent 26%),radial-gradient(circle at 92% 55%,rgba(54,197,150,.12),transparent 20%),#fff}.sectors-hero__grid{display:grid;grid-template-columns:.86fr 1.14fr;gap:72px;align-items:center}.board-kicker{display:inline-flex;padding:7px 10px;border:1px solid #ebedf4;border-radius:999px;color:#6d7485;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.sectors-hero h1{margin:15px 0 17px;font:800 clamp(48px,4.8vw,68px)/1 var(--v3-font-display,system-ui);letter-spacing:-.06em}.sectors-hero h1 span{display:block;color:transparent;background:linear-gradient(90deg,#6857df,#4ba7d2 52%,#34bd8e);-webkit-background-clip:text;background-clip:text}.sectors-hero p{max-width:535px;color:#727d90;line-height:1.7}.sectors-hero .btn--primary{background:#111827;border-color:#111827;color:#fff}.sector-ui{position:relative;min-height:390px}.sector-ui__main{position:absolute;inset:32px 34px 38px 42px;border:1px solid #e5e9f2;border-radius:24px;background:rgba(255,255,255,.94);box-shadow:0 28px 70px rgba(62,69,113,.14);padding:20px;overflow:hidden}.sector-ui__main::after{content:'';position:absolute;right:-80px;bottom:-100px;width:260px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(67,196,148,.22),rgba(96,92,230,.09) 52%,transparent 74%)}.sector-ui__bar{display:flex;align-items:center;justify-content:space-between;padding-bottom:14px;border-bottom:1px solid #edf0f5}.sector-ui__bar strong{font-size:12px}.sector-ui__bar small{font-size:8px;color:#949cab}.sector-ui__map{display:grid;grid-template-columns:1fr 120px;gap:14px;margin-top:17px}.sector-ui__list{display:grid;gap:9px}.sector-ui__list span{height:39px;border:1px solid #ebedf3;border-radius:11px;background:linear-gradient(90deg,#fff,#f7f8fc)}.sector-ui__visual{overflow:hidden;border-radius:14px;background:#f4f7fb}.sector-ui__visual img{width:100%;height:100%;object-fit:cover}.sector-float{position:absolute;z-index:3;width:52px;height:52px;display:grid;place-items:center;border:1px solid #e5e8f0;border-radius:17px;background:#fff;box-shadow:0 15px 34px rgba(60,68,107,.14);font-size:20px}.sector-float--a{right:6px;top:18px;color:#d657aa}.sector-float--b{right:14px;bottom:30px;color:#26ae7d}.sector-float--c{left:11px;bottom:58px;color:#5e67df}
.sector-cards-section{padding:48px 0 0}.sector-cards{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}.sector-board-card{position:relative;min-height:240px;overflow:hidden;border-radius:16px;background:#202b40;color:#fff;box-shadow:0 15px 34px rgba(37,48,78,.12);text-decoration:none}.sector-board-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.9)}.sector-board-card:nth-child(1) img{object-position:5% 50%}.sector-board-card:nth-child(2) img{object-position:22% 50%}.sector-board-card:nth-child(3) img{object-position:42% 50%}.sector-board-card:nth-child(4) img{object-position:62% 50%}.sector-board-card:nth-child(5) img{object-position:80% 50%}.sector-board-card:nth-child(6) img{object-position:96% 50%}.sector-board-card::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(13,23,42,.05),rgba(13,23,42,.78))}.sector-board-card__copy{position:absolute;z-index:2;left:0;right:0;bottom:0;padding:17px}.sector-board-card h3{margin:0;font-size:14px}.sector-board-card p{margin:6px 0 0;color:#e4e8ef;font-size:9px;line-height:1.45}.sector-board-card small{display:block;margin-top:10px;color:#fff;font-size:8px;font-weight:800}
.sector-strip{margin-top:44px;padding:35px 0;background:linear-gradient(105deg,#7252d7,#5b70e6 34%,#3caad3 64%,#2fc58d);color:#fff}.sector-strip__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}.sector-stat small{display:block;color:rgba(255,255,255,.72);font-size:8px}.sector-stat strong{display:block;margin-top:5px;font-size:27px}.sector-stat span{display:block;margin-top:4px;color:rgba(255,255,255,.83);font-size:9px}
.sector-story{padding:72px 0;background:#fff}.sector-story__grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}.sector-story__media{padding:12px;border:1px solid #e7eaf2;border-radius:26px;background:#fff;box-shadow:0 22px 58px rgba(54,64,102,.10)}.sector-story__media img{display:block;width:100%;border-radius:19px}.sector-story h2{margin:12px 0 15px;font:800 clamp(34px,4vw,52px)/1.03 var(--v3-font-display,system-ui);letter-spacing:-.055em}.sector-story p{color:#737e91;line-height:1.7}.sector-proof{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin:22px 0}.sector-proof article{padding:15px;border:1px solid #e8ebf2;border-radius:14px}.sector-proof strong{display:block;font-size:11px}.sector-proof small{display:block;margin-top:5px;color:#818b9d;font-size:9px;line-height:1.4}
.sector-final{padding:0 0 72px}.sector-final .callout{background:linear-gradient(120deg,#f3f6ff,#f3f0ff 48%,#eefaf5)}
@media(max-width:980px){.sectors-hero__grid,.sector-story__grid{grid-template-columns:1fr}.sector-cards{grid-template-columns:repeat(3,1fr)}.sector-ui{min-height:360px}}@media(max-width:620px){.board-sectors .page-shell{width:min(100% - 28px,1180px)}.sectors-hero{padding:58px 0 42px}.sectors-hero h1{font-size:clamp(43px,12vw,56px)}.sector-ui{min-height:310px}.sector-ui__main{inset:25px 12px 28px 18px}.sector-cards{grid-template-columns:1fr 1fr}.sector-board-card{min-height:190px}.sector-strip__grid{grid-template-columns:1fr 1fr}.sector-proof{grid-template-columns:1fr}}@media(max-width:400px){.sector-cards{grid-template-columns:1fr}.sector-strip__grid{grid-template-columns:1fr}}
</style></head><body><V3CommercialHeader />
<main class="board-sectors">
<section class="sectors-hero"><div class="page-shell sectors-hero__grid"><div><span class="board-kicker">Sectores</span><h1>Soluciones adaptadas<span>a tu forma de trabajar.</span></h1><p>El mismo núcleo de IsiVoltPro se presenta de forma distinta según trabajes solo, coordines un pequeño equipo, mantengas instalaciones propias o tengas varias ubicaciones.</p><div class="page-hero__actions"><a class="btn btn--primary" href={demo}>Solicitar demo</a><a class="btn" href="#perfiles">Ver perfiles</a></div></div><div class="sector-ui" aria-label="Interfaz conceptual adaptada a distintos perfiles"><div class="sector-ui__main"><div class="sector-ui__bar"><strong>IsiVoltPro · operación</strong><small>Vista conceptual</small></div><div class="sector-ui__map"><div class="sector-ui__list"><span></span><span></span><span></span><span></span></div><div class="sector-ui__visual"><img src={sectorVisual} alt="Representación conceptual de diferentes operaciones de mantenimiento"/></div></div></div><span class="sector-float sector-float--a" aria-hidden="true">⌁</span><span class="sector-float sector-float--b" aria-hidden="true">✓</span><span class="sector-float sector-float--c" aria-hidden="true">▣</span></div></div></section>
<section class="sector-cards-section" id="perfiles"><div class="page-shell"><div class="sector-cards">
<a class="sector-board-card" href={sectorUrl('autonomos-tecnicos')}><img src={sectorVisual} alt="" aria-hidden="true"/><div class="sector-board-card__copy"><h3>Autónomos</h3><p>Clientes, equipos y trabajos desde el móvil.</p><small>Ver solución →</small></div></a>
<a class="sector-board-card" href={sectorUrl('empresas-mantenedoras')}><img src={sectorVisual} alt="" aria-hidden="true"/><div class="sector-board-card__copy"><h3>Mantenedoras</h3><p>Avisos, técnicos y cierres coordinados.</p><small>Ver solución →</small></div></a>
<a class="sector-board-card" href={sectorUrl('instalaciones-propias')}><img src={sectorVisual} alt="" aria-hidden="true"/><div class="sector-board-card__copy"><h3>Instalaciones propias</h3><p>Activos, incidencias y preventivos.</p><small>Ver solución →</small></div></a>
<a class="sector-board-card" href={sectorUrl('climatizacion-frio')}><img src={sectorVisual} alt="" aria-hidden="true"/><div class="sector-board-card__copy"><h3>Climatización y frío</h3><p>Equipos, revisiones y documentación técnica.</p><small>Ver solución →</small></div></a>
<a class="sector-board-card" href={sectorUrl('instalaciones-electricas')}><img src={sectorVisual} alt="" aria-hidden="true"/><div class="sector-board-card__copy"><h3>Electricidad</h3><p>Cuadros, defectos, actuaciones e histórico.</p><small>Ver solución →</small></div></a>
<a class="sector-board-card" href={sectorUrl('multisede')}><img src={sectorVisual} alt="" aria-hidden="true"/><div class="sector-board-card__copy"><h3>Multisede</h3><p>Ubicaciones separadas y visibles.</p><small>Ver solución →</small></div></a>
</div></div><div class="sector-strip"><div class="page-shell sector-strip__grid"><div class="sector-stat"><small>Perfiles comerciales</small><strong>6</strong><span>Casos de uso diferenciados</span></div><div class="sector-stat"><small>Contexto operativo</small><strong>1</strong><span>Histórico compartido por activo</span></div><div class="sector-stat"><small>Acceso</small><strong>Web + móvil</strong><span>Trabajo de oficina y campo</span></div><div class="sector-stat"><small>Demo pública</small><strong>0</strong><span>Datos reales de clientes</span></div></div></div></section>
<section class="sector-story"><div class="page-shell sector-story__grid"><div class="sector-story__media"><img src={sectorVisual} alt="Cuatro escenarios conceptuales: autónomo, pequeño equipo, instalaciones propias y operación multisede."/></div><div><span class="board-kicker">Una plataforma, distintas operaciones</span><h2>Que la herramienta se adapte a tu negocio.</h2><p>No necesitas aprender una forma artificial de mantener. Ubicación, activo, aviso, técnico, evidencias e histórico permanecen conectados aunque cambie la forma en la que se organiza el trabajo.</p><div class="sector-proof"><article><strong>Visuales conceptuales</strong><small>La web identifica claramente los datos de demostración.</small></article><article><strong>Implantación gradual</strong><small>Se empieza por el problema concreto y se amplía cuando aporta valor.</small></article></div><div class="page-hero__actions"><a class="btn btn--primary" href={experience}>Probar IsiVoltPro →</a></div></div></div></section>
<section class="sector-final"><div class="page-shell"><div class="callout"><div><h2>¿Quieres verlo aplicado a tu forma de trabajar?</h2><p>Recorre la experiencia con datos ficticios y después elige el perfil que más se acerque a tu operación.</p></div><a class="btn btn--primary" href={demo}>Solicitar demo →</a></div></div></section>
</main><V3CommercialFooter /></body></html>
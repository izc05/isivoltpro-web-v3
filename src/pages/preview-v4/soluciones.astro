---
import photoPayload from '../../../public/media/v4/hvac-inspection-tablet.webp.b64?raw';
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const demo = `${base}preview-v4/demo/`;
const apps = `${base}preview-v4/apps/`;
const product = `${base}preview-v4/producto/`;
const sectors = `${base}preview-v4/sectores/`;
const photo = `data:image/webp;base64,${photoPayload.trim()}`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Soluciones V4 · IsiVoltPro" description="Vista previa de Soluciones V4: problemas reales de mantenimiento convertidos en flujos de trabajo claros, trazables y conectados." path={`${base}preview-v4/soluciones/`} noindex={true} />
  <style is:inline>
    .strip{background:#111827;color:#fff;border-bottom:1px solid #273246}.strip .page-shell{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:12px}.strip a{color:#dfe7ff;font-weight:800}.hero{padding:88px 0 72px;background:radial-gradient(circle at 82% 12%,rgba(109,74,255,.12),transparent 28%),radial-gradient(circle at 92% 63%,rgba(36,197,140,.09),transparent 22%),#fff}.hero-grid{display:grid;grid-template-columns:minmax(0,.88fr) minmax(500px,1.12fr);gap:56px;align-items:center}.hero h1{margin:18px 0 19px;font:800 clamp(52px,5.7vw,80px)/.98 Manrope,sans-serif;letter-spacing:-.064em}.hero p{max-width:650px;margin:0;color:#68748a;font-size:18px;line-height:1.72}.actions{display:flex;flex-wrap:wrap;gap:11px;margin-top:28px}.photo{position:relative;overflow:hidden;border-radius:32px;background:#eef2f7;box-shadow:0 32px 84px rgba(45,59,98,.15)}.photo img{display:block;width:100%;height:470px;object-fit:cover}.photo figcaption{position:absolute;left:18px;bottom:18px;padding:9px 12px;border-radius:999px;background:rgba(17,24,39,.78);color:#fff;font-size:10px;font-weight:800;backdrop-filter:blur(8px)}.pain-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}.pain{padding:26px;border:1px solid #e6eaf2;border-radius:24px;background:#fff;box-shadow:0 12px 34px rgba(54,64,102,.055)}.pain span{display:inline-flex;width:38px;height:38px;align-items:center;justify-content:center;border-radius:12px;background:#f2efff;color:#6544e8;font-weight:900}.pain:nth-child(2) span{background:#eef6ff;color:#3973d6}.pain:nth-child(3) span{background:#eaf9f3;color:#168965}.pain:nth-child(4) span{background:#fff3e9;color:#cf6e2c}.pain h3{margin:18px 0 8px;font-size:22px}.pain p{margin:0;color:#748096;line-height:1.65}.flow{display:grid;grid-template-columns:repeat(5,1fr);gap:11px}.flow article{position:relative;padding:23px 20px;border:1px solid #e6eaf2;border-radius:22px;background:#fff}.flow article:not(:last-child):after{content:'→';position:absolute;right:-13px;top:50%;z-index:2;width:26px;height:26px;display:grid;place-items:center;border:1px solid #e4e8f1;border-radius:50%;background:#fff;color:#8793a9;transform:translateY(-50%)}.flow b{color:#5d60d9;font-size:11px}.flow strong{display:block;margin-top:16px;font-size:18px}.flow small{display:block;margin-top:7px;color:#7b879b;line-height:1.5}.solution-band{display:grid;grid-template-columns:.95fr 1.05fr;gap:32px;align-items:center;padding:42px;border-radius:32px;background:linear-gradient(125deg,#0b1430,#162653 58%,#30256e);color:#fff}.solution-band h2{margin:0;font:800 clamp(38px,4.6vw,60px)/1.03 Manrope,sans-serif;letter-spacing:-.052em}.solution-band p{margin:14px 0 0;color:#c6d0e7;line-height:1.72}.solution-list{display:grid;gap:10px}.solution-list div{padding:16px 18px;border:1px solid rgba(255,255,255,.13);border-radius:16px;background:rgba(255,255,255,.06)}.solution-list strong{display:block;font-size:15px}.solution-list small{display:block;margin-top:5px;color:#c4cee4;line-height:1.5}.fit{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.fit article{padding:25px;border:1px solid #e6eaf2;border-radius:23px;background:linear-gradient(180deg,#fff,#fbfcff)}.fit h3{margin:0 0 8px;font-size:21px}.fit p{margin:0;color:#748096;line-height:1.62}.cta{display:grid;grid-template-columns:1fr auto;gap:28px;align-items:center;padding:42px;border-radius:32px;background:linear-gradient(115deg,#f2f7ff,#f3efff 48%,#effaf6)}.cta h2{margin:0;font:800 clamp(34px,4vw,52px)/1.04 Manrope,sans-serif;letter-spacing:-.05em}.cta p{margin:12px 0 0;color:#68748a;line-height:1.65}@media(max-width:980px){.hero-grid,.solution-band,.cta{grid-template-columns:1fr}.hero-grid{gap:38px}.photo{max-width:760px}.fit{grid-template-columns:1fr 1fr}.flow{grid-template-columns:repeat(2,1fr)}.flow article:after{display:none}}@media(max-width:680px){.hero{padding:60px 0 48px}.hero h1{font-size:clamp(44px,13vw,62px)}.photo img{height:330px}.pain-grid,.fit,.flow{grid-template-columns:1fr}.solution-band,.cta{padding:28px 22px}.strip .page-shell{padding:8px 0;flex-direction:column;align-items:flex-start;gap:4px}}
  </style>
</head>
<body>
  <V3CommercialHeader />
  <div class="strip"><div class="page-shell"><strong>Preview V4 · Soluciones</strong><span>Problema → flujo → resultado · <a href={`${base}preview-v4/`}>Mapa V4</a></span></div></div>
  <main class="page-main">
    <section class="hero"><div class="page-shell hero-grid"><div><span class="eyebrow">Empieza por el problema, no por el software</span><h1>Menos perseguir información.<br/><span class="gradient-text">Más mantener con contexto.</span></h1><p>IsiVoltPro organiza problemas cotidianos de mantenimiento —avisos dispersos, trabajos abiertos, revisiones olvidadas o históricos incompletos— dentro de un flujo común que acompaña al técnico desde el aviso hasta el cierre.</p><div class="actions"><a class="btn btn--primary" href={demo}>Contar mi caso →</a><a class="btn" href={product}>Ver cómo funciona</a></div></div><figure class="photo"><img src={photo} alt="Técnico de climatización inspeccionando maquinaria de una sala técnica con una tablet" width="600" height="338" loading="eager"/><figcaption>Climatización · revisión técnica en campo</figcaption></figure></div></section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Problemas que reconoces al instante</span><h2>La web debe hablar primero<br/><span class="gradient-text">de lo que te hace perder tiempo.</span></h2></div><p>La V4 deja de presentar una lista de módulos como punto de entrada y empieza por situaciones de trabajo que una empresa o un técnico puede identificar en segundos.</p></div><div class="pain-grid"><article class="pain"><span>01</span><h3>“Los avisos me llegan por todas partes”</h3><p>Convierte llamadas, notas y mensajes en una entrada visible con ubicación, activo, prioridad, descripción y evidencias.</p></article><article class="pain"><span>02</span><h3>“No sé qué trabajos siguen abiertos”</h3><p>Responsable, estado y próxima acción quedan visibles sin depender de llamadas constantes para reconstruir la situación.</p></article><article class="pain"><span>03</span><h3>“Las revisiones dependen de acordarme”</h3><p>Periodicidades y tareas preventivas pasan a formar parte del trabajo planificado y quedan documentadas cuando se ejecutan.</p></article><article class="pain"><span>04</span><h3>“Vuelvo al equipo y empiezo de cero”</h3><p>El activo conserva averías, preventivos, fotos, documentos y actuaciones para que la siguiente intervención empiece con contexto.</p></article></div></div></section>

    <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Un mismo flujo operativo</span><h2>Del aviso al histórico,<br/><span class="gradient-text">sin perder la historia por el camino.</span></h2></div><p>No importa si el trabajo nace de una incidencia, una revisión o una tarea planificada. La información debe permanecer conectada.</p></div><div class="flow"><article><b>01</b><strong>Detectar</strong><small>Entra el aviso o la necesidad de mantenimiento.</small></article><article><b>02</b><strong>Organizar</strong><small>Se identifica ubicación, activo, prioridad y responsable.</small></article><article><b>03</b><strong>Actuar</strong><small>El técnico trabaja con información y documentación útil.</small></article><article><b>04</b><strong>Documentar</strong><small>Fotos, notas, tiempos y resultado quedan en el trabajo.</small></article><article><b>05</b><strong>Conservar</strong><small>El cierre alimenta el histórico del activo.</small></article></div></div></section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="solution-band"><div><span class="eyebrow" style="color:#bcd1ff">Una solución conectada</span><h2>No arregles un problema creando otro silo.</h2><p>Avisos, OT, activos, preventivo, QR/NFC y documentación tienen sentido cuando comparten contexto. La V4 vende esa continuidad antes que el número de funciones.</p><div class="actions"><a class="btn btn--primary" href={apps} style="background:#fff;color:#172036">Ver Apps V4 →</a></div></div><div class="solution-list"><div><strong>Avisos + OT</strong><small>Lo que entra se convierte en trabajo trazable.</small></div><div><strong>Activo + histórico</strong><small>Cada intervención aporta información para la siguiente.</small></div><div><strong>QR/NFC + móvil</strong><small>El contexto llega al lugar donde está el equipo.</small></div><div><strong>Preventivo + evidencias</strong><small>Planificar y demostrar lo realizado forman parte del mismo flujo.</small></div></div></div></div></section>

    <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Encaje comercial</span><h2>La solución cambia según<br/><span class="gradient-text">cómo trabajas hoy.</span></h2></div><p>No todas las operaciones necesitan la misma profundidad. La web debe ayudar a reconocer el punto de partida adecuado.</p></div><div class="fit"><article><h3>Autónomos técnicos</h3><p>Ordenar avisos, trabajos y activos sin desplegar una herramienta sobredimensionada.</p></article><article><h3>Empresas mantenedoras</h3><p>Coordinar técnicos, clientes, ubicaciones y trabajos con un contexto compartido.</p></article><article><h3>Instalaciones propias</h3><p>Controlar activos, preventivo, incidencias, documentación e histórico interno.</p></article></div><div class="actions" style="justify-content:center"><a class="btn" href={sectors}>Ver Sectores V4 →</a></div></div></section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="cta"><div><h2>Cuéntanos dónde se pierde hoy la información.</h2><p>La demo debe empezar por ese problema concreto y enseñar únicamente el flujo que aporta valor a tu operación.</p></div><div class="actions" style="margin-top:0"><a class="btn btn--primary" href={demo}>Solicitar demo →</a><a class="btn" href={product}>Ver Producto V4</a></div></div></div></section>
  </main>
  <V3CommercialFooter />
</body>
</html>
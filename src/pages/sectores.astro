---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const demo = `${base}demo/`;
const experience = `${base}experiencia/`;
const sectorVisual = `${base}media/sectores-operacion.svg`;
const sectorCardsVisual = `${base}media/sectores-escenas.svg`;
const sectorUrl = (slug: string) => `${base}sectores/${slug}/`;
const solutions = `${base}soluciones/`;
---
<!doctype html><html lang="es"><head><V3Seo title="Sectores de mantenimiento · IsiVoltPro" description="Problemas, riesgos y prioridades de mantenimiento en climatización, electricidad, instalaciones propias, empresas mantenedoras y operaciones multisede." path={`${base}sectores/`} />
<style is:inline>
.board-sectors{background:#fff;overflow:hidden}.board-sectors .page-shell{width:min(1180px,calc(100% - 44px))}.sectors-hero{position:relative;padding:88px 0 72px;background:radial-gradient(circle at 82% 27%,rgba(92,83,226,.13),transparent 28%),radial-gradient(circle at 95% 56%,rgba(48,194,145,.11),transparent 20%),#fff}.sectors-hero__grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:76px;align-items:center}.board-kicker{display:inline-flex;padding:7px 10px;border:1px solid #ebedf4;border-radius:999px;color:#6d7485;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.sectors-hero h1{margin:15px 0 17px;font:800 clamp(50px,5vw,72px)/.98 var(--v3-font-display,system-ui);letter-spacing:-.062em}.sectors-hero h1 span{display:block;color:transparent;background:linear-gradient(90deg,#6857df,#4ba7d2 52%,#34bd8e);-webkit-background-clip:text;background-clip:text}.sectors-hero p{max-width:535px;color:#727d90;font-size:15px;line-height:1.72}.sectors-hero .btn--primary{background:#111827;border-color:#111827;color:#fff}.sector-ui{position:relative;min-height:450px}.sector-ui::before{content:'';position:absolute;inset:8% -4% 0 12%;border-radius:42px;background:linear-gradient(135deg,rgba(95,85,226,.14),rgba(54,168,209,.08) 50%,rgba(48,193,143,.12));filter:blur(28px)}.sector-ui__main{position:absolute;inset:28px 24px 28px 38px;border:1px solid #e4e8f1;border-radius:28px;background:rgba(255,255,255,.94);box-shadow:0 32px 82px rgba(62,69,113,.16);padding:0;overflow:hidden;backdrop-filter:blur(14px)}.sector-ui__bar{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid #edf0f5}.sector-ui__bar strong{font-size:12px}.sector-ui__bar small{font-size:8px;color:#949cab}.sector-ui__workspace{display:grid;grid-template-columns:116px 1fr;min-height:350px}.sector-ui__nav{padding:18px 12px;background:#10182f;color:#b7c0d6}.sector-ui__nav strong{display:block;margin:0 8px 16px;color:#fff;font-size:10px}.sector-ui__nav span{display:block;margin:5px 0;padding:8px 9px;border-radius:9px;font-size:8px}.sector-ui__nav span:first-of-type{background:linear-gradient(90deg,rgba(67,101,255,.28),rgba(109,74,255,.22));color:#fff}.sector-ui__content{padding:18px;background:linear-gradient(180deg,#fff,#f9fbff)}.sector-ui__kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.sector-ui__kpi{padding:12px;border:1px solid #e8ebf2;border-radius:13px;background:#fff}.sector-ui__kpi small{display:block;color:#8992a2;font-size:7px}.sector-ui__kpi strong{display:block;margin-top:4px;font-size:17px}.sector-ui__map{display:grid;grid-template-columns:1fr 150px;gap:12px;margin-top:12px}.sector-ui__list{display:grid;gap:8px}.sector-ui__list span{height:42px;border:1px solid #ebedf3;border-radius:11px;background:linear-gradient(90deg,#fff,#f7f8fc)}.sector-ui__visual{overflow:hidden;border-radius:14px;background:#f4f7fb}.sector-ui__visual img{width:100%;height:100%;object-fit:cover}.sector-float{position:absolute;z-index:3;padding:10px 12px;border:1px solid #e5e8f0;border-radius:15px;background:#fff;box-shadow:0 15px 34px rgba(60,68,107,.14);font-size:9px;font-weight:800}.sector-float small{display:block;margin-top:3px;color:#8c95a5;font-size:7px;font-weight:600}.sector-float--a{right:-8px;top:14px;color:#d657aa}.sector-float--b{right:0;bottom:18px;color:#26ae7d}.sector-float--c{left:0;bottom:64px;color:#5e67df}
.sector-cards-section{padding:64px 0 0}.sector-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.sector-board-card{position:relative;min-height:250px;overflow:hidden;border:1px solid #e5e9f2;border-radius:22px;background:#fff;color:#111827;box-shadow:0 18px 44px rgba(37,48,78,.10);text-decoration:none}.sector-board-card img{position:absolute;right:0;top:0;width:52%;height:100%;object-fit:cover;filter:saturate(.9) contrast(1.01)}.sector-board-card:nth-child(1) img{object-position:0% 50%}.sector-board-card:nth-child(2) img{object-position:20% 50%}.sector-board-card:nth-child(3) img{object-position:40% 50%}.sector-board-card:nth-child(4) img{object-position:60% 50%}.sector-board-card:nth-child(5) img{object-position:80% 50%}.sector-board-card:nth-child(6) img{object-position:100% 50%}.sector-board-card::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#fff 0 47%,rgba(255,255,255,.94) 57%,rgba(255,255,255,.12) 100%);z-index:1}.sector-board-card__copy{position:absolute;z-index:2;left:0;top:0;bottom:0;width:58%;display:flex;flex-direction:column;justify-content:flex-end;padding:22px}.sector-board-card h3{margin:0;font-size:17px}.sector-board-card p{margin:7px 0 0;color:#707b8f;font-size:10px;line-height:1.5}.sector-board-card small{display:block;margin-top:12px;color:#6356d8;font-size:9px;font-weight:800}.sector-strip{margin:50px 0 0;padding:0;background:transparent}.sector-strip__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:18px;border:1px solid #e7eaf2;border-radius:24px;background:linear-gradient(120deg,#f5f8ff,#f4f1ff 48%,#effaf6);box-shadow:0 18px 44px rgba(54,64,102,.07)}.sector-stat{padding:15px 16px;border-radius:16px;background:rgba(255,255,255,.74)}.sector-stat small{display:block;color:#7c8698;font-size:8px}.sector-stat strong{display:block;margin-top:5px;color:#182238;font-size:23px}.sector-stat span{display:block;margin-top:4px;color:#7d8798;font-size:9px}.sector-story{padding:78px 0;background:#fff}.sector-story__grid{display:grid;grid-template-columns:1.05fr .95fr;gap:54px;align-items:center}.sector-story__media{padding:13px;border:1px solid #e7eaf2;border-radius:28px;background:#fff;box-shadow:0 26px 68px rgba(54,64,102,.11);transform:perspective(1100px) rotateY(2deg)}.sector-story__media img{display:block;width:100%;border-radius:20px}.sector-story h2{margin:12px 0 15px;font:800 clamp(36px,4vw,54px)/1.02 var(--v3-font-display,system-ui);letter-spacing:-.055em}.sector-story p{color:#737e91;line-height:1.7}.sector-proof{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin:22px 0}.sector-proof article{padding:16px;border:1px solid #e8ebf2;border-radius:16px;background:linear-gradient(180deg,#fff,#fbfcff)}.sector-proof strong{display:block;font-size:11px}.sector-proof small{display:block;margin-top:5px;color:#818b9d;font-size:9px;line-height:1.4}.sector-final{padding:0 0 76px}.sector-final .callout{background:linear-gradient(120deg,#f3f6ff,#f3f0ff 48%,#eefaf5)}
@media(max-width:980px){.sectors-hero__grid,.sector-story__grid{grid-template-columns:1fr}.sector-cards{grid-template-columns:repeat(2,1fr)}.sector-ui{min-height:430px}.sector-story__media{transform:none}}@media(max-width:620px){.board-sectors .page-shell{width:min(100% - 28px,1180px)}.sectors-hero{padding:58px 0 50px}.sectors-hero h1{font-size:clamp(43px,12vw,58px)}.sector-ui{min-height:360px}.sector-ui__main{inset:18px 2px 18px 12px}.sector-ui__workspace{grid-template-columns:82px 1fr;min-height:292px}.sector-ui__nav{padding:14px 8px}.sector-ui__content{padding:12px}.sector-ui__kpis{grid-template-columns:1fr 1fr}.sector-ui__kpi:nth-child(3){display:none}.sector-ui__map{grid-template-columns:1fr 96px}.sector-float{display:none}.sector-cards{grid-template-columns:1fr}.sector-board-card{min-height:210px}.sector-strip__grid{grid-template-columns:1fr 1fr}.sector-proof{grid-template-columns:1fr}}@media(max-width:400px){.sector-strip__grid{grid-template-columns:1fr}}
.sector-hero-photo{position:relative;margin:0;overflow:hidden;border-radius:30px;background:#e9edf3;box-shadow:0 30px 76px rgba(44,55,92,.16)}.sector-hero-photo img{display:block;width:100%;height:470px;object-fit:cover}.sector-hero-photo figcaption{position:absolute;left:18px;bottom:18px;padding:10px 13px;border-radius:999px;background:rgba(11,24,50,.84);color:#fff;font-size:11px;font-weight:800}
</style></head><body><V3CommercialHeader />
<main class="board-sectors">
<section class="sectors-hero"><div class="page-shell sectors-hero__grid"><div><span class="board-kicker">Sectores</span><h1>Cada instalación tiene<span>sus propios riesgos.</span></h1><p>No se mantiene igual una cámara frigorífica, un cuadro eléctrico, una sala de bombas o una red de edificios. Analizamos cada entorno desde sus equipos, fallos, obligaciones y condiciones de trabajo.</p><div class="page-hero__actions"><a class="btn btn--primary" href="#perfiles">Explorar sectores</a><a class="btn" href={solutions}>Problemas de mantenimiento</a></div></div><figure class="sector-hero-photo"><img src={`${base}media/v5/electrical-maintenance-inspection.webp`} alt="Electricista realizando una inspección segura en un cuadro eléctrico" width="1400" height="1050" loading="eager" decoding="async"/><figcaption>Mantenimiento eléctrico · inspección y seguridad</figcaption></figure></div></section>
<section class="sector-cards-section" id="perfiles"><div class="page-shell"><div class="sector-cards">
<a class="sector-board-card" href={sectorUrl('autonomos-tecnicos')}><img src={`${base}media/v5/maintenance-hvac-inspection.webp`} alt="Técnico inspeccionando una instalación de climatización"/><div class="sector-board-card__copy"><h3>Autónomos</h3><p>Diagnóstico, desplazamientos y relación directa con el cliente.</p><small>Ver sector →</small></div></a>
<a class="sector-board-card" href={sectorUrl('empresas-mantenedoras')}><img src={`${base}media/v5/maintenance-planning-team.webp`} alt="Equipo de mantenimiento coordinando trabajos"/><div class="sector-board-card__copy"><h3>Mantenedoras</h3><p>Prioridades, técnicos, materiales y cierres coordinados.</p><small>Ver sector →</small></div></a>
<a class="sector-board-card" href={sectorUrl('instalaciones-propias')}><img src={`${base}media/v5/preventive-planning-pump-room.webp`} alt="Planificación preventiva en una sala de bombas"/><div class="sector-board-card__copy"><h3>Instalaciones propias</h3><p>Fiabilidad, continuidad, seguridad y coste del ciclo de vida.</p><small>Ver sector →</small></div></a>
<a class="sector-board-card" href={sectorUrl('climatizacion-frio')}><img src={`${base}media/v5/maintenance-hvac-inspection.webp`} alt="Inspección de una unidad de tratamiento de aire"/><div class="sector-board-card__copy"><h3>Climatización y frío</h3><p>Rendimiento, refrigerante, filtros, presiones y calidad ambiental.</p><small>Ver sector →</small></div></a>
<a class="sector-board-card" href={sectorUrl('instalaciones-electricas')}><img src={`${base}media/v5/electrical-maintenance-inspection.webp`} alt="Inspección técnica de un cuadro eléctrico"/><div class="sector-board-card__copy"><h3>Electricidad</h3><p>Seguridad, protecciones, conexiones, medidas y defectos recurrentes.</p><small>Ver sector →</small></div></a>
<a class="sector-board-card" href={sectorUrl('multisede')}><img src={`${base}media/v5/maintenance-planning-team.webp`} alt="Profesionales planificando mantenimiento de varias instalaciones"/><div class="sector-board-card__copy"><h3>Multisede</h3><p>Estándares comunes sin perder el contexto de cada centro.</p><small>Ver sector →</small></div></a>
</div></div><div class="sector-strip"><div class="page-shell sector-strip__grid"><div class="sector-stat"><small>Perfiles comerciales</small><strong>6</strong><span>Casos de uso diferenciados</span></div><div class="sector-stat"><small>Contexto operativo</small><strong>1</strong><span>Histórico compartido por activo</span></div><div class="sector-stat"><small>Acceso</small><strong>Web + móvil</strong><span>Trabajo de oficina y campo</span></div><div class="sector-stat"><small>Demo pública</small><strong>0</strong><span>Datos reales de clientes</span></div></div></div></section>
<section class="sector-story"><div class="page-shell sector-story__grid"><div class="sector-story__media"><img src={`${base}media/v5/maintenance-hvac-inspection.webp`} alt="Técnico diagnosticando el estado de una instalación de climatización"/></div><div><span class="board-kicker">Distintas operaciones, distintos problemas</span><h2>El contexto técnico cambia la decisión.</h2><p>La criticidad, el entorno, la disponibilidad de repuestos, la normativa y el impacto de una parada determinan cómo debe planificarse y ejecutarse cada mantenimiento.</p><div class="sector-proof"><article><strong>Riesgo específico</strong><small>Cada instalación exige medidas y competencias adecuadas.</small></article><article><strong>Ciclo de vida</strong><small>Mantener también es decidir cuándo reparar, renovar o rediseñar.</small></article></div><div class="page-hero__actions"><a class="btn btn--primary" href={solutions}>Explorar problemas →</a></div></div></div></section>
<section class="sector-final"><div class="page-shell"><div class="callout"><div><h2>¿Quieres verlo aplicado a tu forma de trabajar?</h2><p>Recorre la experiencia con datos ficticios y después elige el perfil que más se acerque a tu operación.</p></div><a class="btn btn--primary" href={demo}>Solicitar demo →</a></div></div></section>
</main><V3CommercialFooter /></body></html>

---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const demo = `${base}demo/`;
const contact = `${base}contacto/`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Selector de necesidades · IsiVoltPro" description="Descubre qué capacidades de IsiVoltPro encajan mejor con tu forma de trabajar y prueba una experiencia QR demostrativa sin registro ni envío de datos." path={`${base}selector/`} />
  <style is:inline>
    .selector-shell{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:24px;align-items:start}.selector-panel,.result-panel,.qr-panel{border:1px solid var(--line);border-radius:30px;background:#fff;box-shadow:var(--shadow-soft)}.selector-panel{padding:30px}.selector-panel h2,.result-panel h2,.qr-panel h2{margin:8px 0 12px;font-size:clamp(30px,4vw,46px);letter-spacing:-.04em;line-height:1.04}.selector-panel>p,.result-panel>p,.qr-panel>p{margin:0;color:var(--muted);line-height:1.65}.question{margin-top:26px;padding-top:24px;border-top:1px solid #e7ebf3}.question legend{padding:0;font-size:14px;font-weight:900;color:#293750}.options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:13px}.option{position:relative}.option input{position:absolute;opacity:0;pointer-events:none}.option label{min-height:54px;display:flex;align-items:center;padding:13px 15px;border:1px solid #dfe5ef;border-radius:16px;background:#fff;color:#4c5871;font-weight:800;cursor:pointer;transition:.2s ease}.option input:checked+label{border-color:#9ab2ff;background:#f3f6ff;color:#2349c3;box-shadow:0 8px 22px rgba(50,75,150,.08)}.option input:focus-visible+label{outline:3px solid rgba(62,103,246,.25);outline-offset:2px}.selector-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}.selector-button{min-height:48px;padding:0 18px;border:0;border-radius:14px;background:#17223a;color:#fff;font:inherit;font-weight:900;cursor:pointer}.selector-button--soft{background:#eef3ff;color:#3152c9}.result-panel{padding:30px;background:linear-gradient(145deg,#fff 0%,#f8fbff 58%,#f8f5ff 100%);position:sticky;top:90px}.result-badge{display:inline-flex;align-items:center;gap:8px;padding:8px 11px;border-radius:999px;background:#edf9f4;color:#11865f;font-size:12px;font-weight:900}.result-badge:before{content:"";width:8px;height:8px;border-radius:50%;background:#22b983}.recommendation{margin-top:24px;padding:22px;border:1px solid #e1e7f1;border-radius:22px;background:#fff}.recommendation h3{margin:0;font-size:23px}.recommendation p{margin:8px 0 0;color:var(--muted);line-height:1.6}.module-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:18px}.module-chip{padding:13px 14px;border-radius:15px;background:#f6f8fc;border:1px solid #e7ebf3}.module-chip strong{display:block;font-size:13px}.module-chip small{display:block;margin-top:4px;color:#748098;line-height:1.4}.result-note{margin-top:18px;color:#6d7890;font-size:12px;line-height:1.55}.qr-wrap{display:grid;grid-template-columns:.85fr 1.15fr;gap:24px;align-items:center}.qr-panel{padding:32px}.qr-demo{display:grid;grid-template-columns:180px 1fr;gap:22px;align-items:center;margin-top:25px}.qr-code{width:180px;aspect-ratio:1;display:grid;grid-template-columns:repeat(11,1fr);gap:3px;padding:14px;border-radius:20px;background:#fff;border:1px solid #dfe5ef;box-shadow:0 16px 38px rgba(37,53,91,.1)}.qr-code span{border-radius:2px;background:transparent}.qr-code span.on{background:#17223a}.asset-card{padding:20px;border-radius:20px;background:#f7f9fd;border:1px solid #e5eaf2}.asset-card small{display:block;color:#748098}.asset-card strong{display:block;margin:5px 0 14px;font-size:24px;letter-spacing:-.02em}.asset-meta{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.asset-meta div{padding:11px;border-radius:13px;background:#fff}.asset-meta b{display:block;font-size:12px}.asset-meta span{display:block;margin-top:3px;color:#7a8498;font-size:11px}.scan-result{margin-top:14px;padding:14px 16px;border-radius:15px;background:#edf9f4;color:#176d55;font-weight:800;line-height:1.5}.scan-result[hidden]{display:none}.feature-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.feature-card{padding:25px;border:1px solid var(--line);border-radius:24px;background:#fff}.feature-card b{font-size:12px;color:var(--blue)}.feature-card h3{margin:15px 0 8px;font-size:20px}.feature-card p{margin:0;color:var(--muted);line-height:1.6}.noscript-note{padding:15px;border-radius:15px;background:#fff7e8;color:#72531b}.page-hero__actions{flex-wrap:wrap}@media(max-width:900px){.selector-shell,.qr-wrap{grid-template-columns:1fr}.result-panel{position:static}.feature-grid{grid-template-columns:1fr 1fr}}@media(max-width:680px){.selector-panel,.result-panel,.qr-panel{padding:22px}.options,.module-list,.feature-grid{grid-template-columns:1fr}.qr-demo{grid-template-columns:1fr}.qr-code{width:min(180px,100%);margin:auto}.asset-meta{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.option label{transition:none}}
  </style>
</head>
<body>
<V3CommercialHeader />
<main class="page-main">
  <section class="page-hero"><div class="page-shell page-hero__grid"><div><span class="eyebrow">Encuentra tu punto de entrada</span><h1>No empieces por módulos.<br/><span class="gradient-text">Empieza por tu problema.</span></h1><p>Responde tres preguntas y la web te propone un punto de partida orientativo. Todo ocurre en tu navegador: esta herramienta no guarda ni envía respuestas.</p><div class="page-hero__actions"><a class="btn btn--primary" href="#selector">Probar selector →</a><a class="btn" href="#qr-demo">Probar QR</a></div></div><div class="page-hero__visual" aria-hidden="true"><div class="page-orbit"></div><div class="page-core">ENCAJE<small>3 PREGUNTAS → 1 RUTA</small></div><div class="page-pill page-pill--a">Equipo<small>Solo o coordinado</small></div><div class="page-pill page-pill--b">Problema<small>Qué quieres ordenar</small></div><div class="page-pill page-pill--c">Campo<small>Cómo trabajas</small></div><div class="page-pill page-pill--d">Ruta<small>Por dónde empezar</small></div></div></div></section>

  <section class="page-section" id="selector"><div class="page-shell"><div class="selector-shell"><form class="selector-panel" data-needs-selector><span class="eyebrow">Selector de necesidades</span><h2>Tu realidad primero.</h2><p>No sustituye una demo ni configura una cuenta. Solo traduce necesidades habituales a capacidades de IsiVoltPro.</p>
    <fieldset class="question"><legend>1. ¿Cómo trabajas?</legend><div class="options"><div class="option"><input id="team-solo" type="radio" name="team" value="solo" checked><label for="team-solo">Trabajo solo</label></div><div class="option"><input id="team-small" type="radio" name="team" value="small"><label for="team-small">Equipo de 2–10</label></div><div class="option"><input id="team-medium" type="radio" name="team" value="medium"><label for="team-medium">Más de 10 personas</label></div><div class="option"><input id="team-owner" type="radio" name="team" value="owner"><label for="team-owner">Gestiono instalaciones propias</label></div></div></fieldset>
    <fieldset class="question"><legend>2. ¿Qué te duele más hoy?</legend><div class="options"><div class="option"><input id="pain-notices" type="radio" name="pain" value="notices" checked><label for="pain-notices">Avisos dispersos</label></div><div class="option"><input id="pain-assets" type="radio" name="pain" value="assets"><label for="pain-assets">Equipos sin histórico</label></div><div class="option"><input id="pain-preventive" type="radio" name="pain" value="preventive"><label for="pain-preventive">Preventivos difíciles</label></div><div class="option"><input id="pain-docs" type="radio" name="pain" value="docs"><label for="pain-docs">Fotos/documentos repartidos</label></div></div></fieldset>
    <fieldset class="question"><legend>3. En campo necesitas sobre todo…</legend><div class="options"><div class="option"><input id="field-mobile" type="radio" name="field" value="mobile" checked><label for="field-mobile">Rapidez desde móvil</label></div><div class="option"><input id="field-qr" type="radio" name="field" value="qr"><label for="field-qr">Abrir equipos con QR</label></div><div class="option"><input id="field-photos" type="radio" name="field" value="photos"><label for="field-photos">Fotos y evidencias</label></div><div class="option"><input id="field-control" type="radio" name="field" value="control"><label for="field-control">Coordinación y estados</label></div></div></fieldset>
    <div class="selector-actions"><button class="selector-button" type="submit">Ver mi ruta →</button><button class="selector-button selector-button--soft" type="reset">Reiniciar</button></div>
  </form><aside class="result-panel" aria-live="polite"><span class="result-badge">Orientación local · sin enviar datos</span><h2 data-result-title>Empieza por avisos + OT</h2><p data-result-copy>Centraliza lo que entra, conviértelo en trabajo visible y deja un cierre útil para la siguiente intervención.</p><div class="recommendation"><h3>Capacidades recomendadas</h3><div class="module-list" data-module-list><div class="module-chip"><strong>Avisos</strong><small>Un único punto de entrada.</small></div><div class="module-chip"><strong>Órdenes de trabajo</strong><small>Asignación, estado y cierre.</small></div><div class="module-chip"><strong>Móvil</strong><small>Consulta y actualización en campo.</small></div><div class="module-chip"><strong>Histórico</strong><small>Lo hecho queda asociado.</small></div></div></div><p class="result-note">Resultado demostrativo, no una recomendación contractual. El alcance real se valida durante piloto/demo.</p><div class="selector-actions"><a class="btn btn--primary" href={demo}>Ver demo de 60 segundos →</a><a class="btn" href={contact}>Hablar de mi caso</a></div></aside></div></div></section>

  <section class="page-section page-section--soft" id="qr-demo"><div class="page-shell"><div class="qr-wrap"><div><span class="eyebrow">Experiencia QR · demostración</span><h2>Un equipo físico puede abrir<br/><span class="gradient-text">su contexto digital.</span></h2><p>Esta simulación enseña la idea sin crear códigos reales ni conectarse a ningún activo. En producción, el QR/NFC apuntaría a una ficha autorizada con permisos y trazabilidad.</p></div><div class="qr-panel"><span class="eyebrow">Activo ficticio</span><h2>CLIMA-003</h2><p>Unidad interior · Oficina 03 · ejemplo local.</p><div class="qr-demo"><div class="qr-code" aria-label="Patrón QR demostrativo no escaneable" data-qr-grid></div><div class="asset-card"><small>Activo</small><strong>Split Oficina 03</strong><div class="asset-meta"><div><b>Estado</b><span>Operativo</span></div><div><b>Próximo preventivo</b><span>12 sep 2026</span></div><div><b>Última OT</b><span>Filtro sustituido</span></div><div><b>Ubicación</b><span>Oficina 03</span></div></div><button class="selector-button" type="button" data-scan-qr style="margin-top:14px">Simular escaneo →</button><div class="scan-result" data-scan-result hidden>QR leído · ficha CLIMA-003 abierta. El técnico vería aquí histórico, documentación y acciones permitidas.</div></div></div><p class="result-note">El patrón mostrado es intencionadamente no escaneable: evita confundir una demo comercial con un identificador real.</p></div></div></div></section>

  <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Por qué aporta valor</span><h2>Interacción útil,<br/><span class="gradient-text">no efectos por decorar.</span></h2></div><p>Estas experiencias explican en segundos cómo cambiaría el trabajo diario, sin añadir dependencias pesadas ni pedir datos antes de tiempo.</p></div><div class="feature-grid"><article class="feature-card"><b>01 · ENCAJE</b><h3>La web se adapta al problema</h3><p>El visitante llega antes a la capacidad que le importa y no tiene que interpretar todo el catálogo.</p></article><article class="feature-card"><b>02 · CAMPO</b><h3>El QR se entiende al verlo</h3><p>No solo contamos qué hace: simulamos la transición de etiqueta física a contexto técnico.</p></article><article class="feature-card"><b>03 · PRIVACIDAD</b><h3>Sin datos ni cuentas ficticias</h3><p>La interacción ocurre localmente en el navegador y está claramente etiquetada como demostración.</p></article></div></div></section>

  <noscript><section class="page-section"><div class="page-shell"><p class="noscript-note">El selector interactivo necesita JavaScript. La página sigue explicando la función QR y puedes continuar a la demo o contacto sin activarlo.</p></div></section></noscript>
</main>
<V3CommercialFooter />
<script is:inline>
  (() => {
    const form = document.querySelector('[data-needs-selector]');
    const title = document.querySelector('[data-result-title]');
    const copy = document.querySelector('[data-result-copy]');
    const list = document.querySelector('[data-module-list]');
    const recipes = {
      notices: ['Empieza por avisos + OT','Centraliza lo que entra, conviértelo en trabajo visible y deja un cierre útil para la siguiente intervención.',[['Avisos','Un único punto de entrada.'],['Órdenes de trabajo','Asignación, estado y cierre.'],['Móvil','Consulta y actualización en campo.'],['Histórico','Lo hecho queda asociado.']]],
      assets: ['Empieza por activos + histórico','Ordena equipos e instalaciones para que cada intervención empiece con contexto, no desde cero.',[['Activos','Ficha técnica por equipo.'],['QR/NFC','Acceso rápido en campo.'],['Documentación','Manuales, fotos y evidencias.'],['Histórico','OT y cambios asociados.']]],
      preventive: ['Empieza por preventivo + activos','Pasa de calendarios dispersos a tareas recurrentes vinculadas con equipos y responsables.',[['Preventivo','Frecuencias y próximas tareas.'],['Activos','Qué hay que mantener.'],['Órdenes de trabajo','Ejecución trazable.'],['Avisos','Desviaciones e incidencias.']]],
      docs: ['Empieza por documentación + activos','Junta fotos, documentos y contexto técnico alrededor del equipo o instalación donde realmente se necesitan.',[['Documentación','Archivos asociados.'],['Activos','Contexto común.'],['Fotos','Evidencia de campo.'],['Órdenes de trabajo','Motivo y resultado.']]]
    };
    const render = () => {
      if (!form || !title || !copy || !list) return;
      const data = new FormData(form);
      const pain = data.get('pain') || 'notices';
      const team = data.get('team');
      const field = data.get('field');
      const recipe = recipes[pain] || recipes.notices;
      let modules = [...recipe[2]];
      if (team === 'small' || team === 'medium' || field === 'control') modules[2] = ['Coordinación','Asignaciones y estados compartidos.'];
      if (field === 'qr') modules[2] = ['QR/NFC','Abrir el contexto del activo en campo.'];
      if (field === 'photos') modules[2] = ['Fotos','Evidencias asociadas a la intervención.'];
      title.textContent = recipe[0]; copy.textContent = recipe[1];
      list.innerHTML = modules.map(([name,desc]) => `<div class="module-chip"><strong>${name}</strong><small>${desc}</small></div>`).join('');
    };
    form?.addEventListener('submit', (event) => { event.preventDefault(); render(); title?.focus?.(); });
    form?.addEventListener('change', render);
    form?.addEventListener('reset', () => setTimeout(render,0));
    const grid = document.querySelector('[data-qr-grid]');
    if (grid) {
      const pattern = '1110001110010101010100111011100010100010111011011101010010001010111011101010001010101011100010111010100111011100010101001011111011100010100010101010101011101000111010101010111001010001111010010101010101110001110011101110001';
      [...pattern.slice(0,121)].forEach((bit) => { const cell = document.createElement('span'); if (bit === '1') cell.className='on'; grid.appendChild(cell); });
    }
    const scan = document.querySelector('[data-scan-qr]'); const result = document.querySelector('[data-scan-result]');
    scan?.addEventListener('click', () => { if (!result) return; result.hidden = false; scan.textContent = 'Ficha abierta ✓'; scan.setAttribute('aria-pressed','true'); });
    render();
  })();
</script>
</body>
</html>

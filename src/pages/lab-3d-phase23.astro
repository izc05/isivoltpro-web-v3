---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#02040a" />
    <meta name="description" content="ISIVOLTPRO phase 2.3 industrial 3D scene with a real modular pipe asset." />
    <title>ISIVOLTPRO · Phase 2.3</title>
  </head>
  <body>
    <canvas id="webgl" aria-hidden="true"></canvas>

    <header class="topbar">
      <a class="brand" href={base}>ISIVOLT<strong>PRO</strong></a>
      <span class="phase">FASE 2.3 / REAL ASSET IN SCENE</span>
      <a class="back" href={`${base}lab-3d/`}>BACK TO 3D LAB</a>
    </header>

    <aside class="metrics" aria-live="polite">
      <div><span>PIPE ASSET</span><strong id="asset-status">LOADING</strong></div>
      <div><span>FPS</span><strong id="fps">--</strong></div>
      <div><span>TRIS</span><strong id="tris">--</strong></div>
    </aside>

    <main id="story">
      <section class="chapter active">
        <div class="copy">
          <p class="eyebrow">INDUSTRIAL DIGITAL TWIN</p>
          <h1>The installation<br />becomes real.</h1>
          <p class="body-copy">Phase 2.3 places the first real industrial asset inside the cinematic scene.</p>
          <span class="scroll-hint">SCROLL TO INSPECT <i>↓</i></span>
        </div>
      </section>

      <section class="chapter">
        <div class="copy right-copy">
          <p class="index">02 / CORE</p>
          <p class="eyebrow">CENTRAL INTELLIGENCE</p>
          <h2>One core.<br />Every system.</h2>
          <p class="body-copy">The procedural Core stays unchanged while the surrounding facility gains real geometry.</p>
        </div>
      </section>

      <section class="chapter">
        <div class="copy">
          <p class="index">03 / MECHANICAL</p>
          <p class="eyebrow">REAL INDUSTRIAL GEOMETRY</p>
          <h2>Pipes become<br />infrastructure.</h2>
          <p class="body-copy">A CC0 modular industrial pipe kit is now part of the mechanical zone.</p>
        </div>
      </section>

      <section class="chapter">
        <div class="copy right-copy">
          <p class="index">04 / SCALE</p>
          <p class="eyebrow">DEPTH · LIGHT · PERFORMANCE</p>
          <h2>Built to live<br />inside the plant.</h2>
          <p class="body-copy">This checkpoint exists only to validate placement, lighting and frame-rate before more assets arrive.</p>
        </div>
      </section>

      <section class="chapter">
        <div class="copy end-copy">
          <p class="index">05 / CHECKPOINT</p>
          <p class="eyebrow">PHASE 2.3</p>
          <h2>One real asset.<br />Nothing else added.</h2>
          <a class="lab-button" href={`${base}lab-3d-pipes/`}>OPEN ISOLATED ASSET <span>→</span></a>
        </div>
      </section>
    </main>

    <script>
      import * as THREE from 'three';
      import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
      import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
      import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
      import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';
      import { OutputPass } from 'three/examples/jsm/postprocessing/OutputPass.js';
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const ASSET_URL = 'https://raw.githubusercontent.com/KrazIvan/GodotVR_Test/6dc918140151c3235406a3f616a765e11293285a/Ivan%20VR/models/props/pipe/modular_industrial_pipes_01_4k.gltf';
      const PIXEL = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Y9Zf6AAAAAASUVORK5CYII=';

      const canvas = document.querySelector('#webgl');
      const assetStatus = document.querySelector('#asset-status');
      const fpsEl = document.querySelector('#fps');
      const trisEl = document.querySelector('#tris');

      if (!(canvas instanceof HTMLCanvasElement)) throw new Error('3D canvas missing');

      const mobile = window.matchMedia('(max-width: 760px)').matches;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: false, powerPreference: 'high-performance', stencil: false });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, mobile ? 1.2 : 1.55));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 0.9;
      renderer.shadowMap.enabled = !mobile;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x02040a);
      scene.fog = new THREE.FogExp2(0x02040a, 0.031);

      const camera = new THREE.PerspectiveCamera(42, window.innerWidth / window.innerHeight, 0.1, 120);
      camera.position.set(-13, 7.5, 18);

      const composer = new EffectComposer(renderer);
      composer.addPass(new RenderPass(scene, camera));
      composer.addPass(new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), mobile ? 0.38 : 0.62, 0.48, 0.83));
      composer.addPass(new OutputPass());

      const world = new THREE.Group();
      scene.add(world);

      const darkMetal = new THREE.MeshStandardMaterial({ color: 0x111925, metalness: 0.72, roughness: 0.38 });
      const darkPanel = new THREE.MeshStandardMaterial({ color: 0x07101a, metalness: 0.48, roughness: 0.52 });
      const concrete = new THREE.MeshStandardMaterial({ color: 0x090e14, metalness: 0.08, roughness: 0.88 });
      const pipeMaterial = new THREE.MeshStandardMaterial({ color: 0x697780, metalness: 0.88, roughness: 0.3 });
      const pipeDetail = new THREE.MeshStandardMaterial({ color: 0x8d512b, metalness: 0.68, roughness: 0.38 });
      const cyanGlow = new THREE.MeshStandardMaterial({ color: 0x063b50, emissive: 0x00d9ff, emissiveIntensity: 3.0, metalness: 0.5, roughness: 0.22 });
      const blueGlow = new THREE.MeshStandardMaterial({ color: 0x031b38, emissive: 0x0879ff, emissiveIntensity: 2.2, metalness: 0.62, roughness: 0.24 });

      const floor = new THREE.Mesh(new THREE.PlaneGeometry(58, 42), concrete);
      floor.rotation.x = -Math.PI / 2;
      floor.position.y = -0.05;
      floor.receiveShadow = true;
      world.add(floor);

      const grid = new THREE.GridHelper(58, 58, 0x17455b, 0x0b1c27);
      grid.position.y = 0.01;
      grid.material.transparent = true;
      grid.material.opacity = 0.22;
      world.add(grid);

      function makeBuilding(x: number, z: number, w: number, d: number, h: number) {
        const group = new THREE.Group();
        group.position.set(x, 0, z);
        const body = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), darkPanel);
        body.position.y = h / 2;
        body.castShadow = !mobile;
        body.receiveShadow = true;
        group.add(body);
        const strip = new THREE.Mesh(new THREE.BoxGeometry(w * 0.7, 0.05, 0.04), cyanGlow);
        strip.position.set(0, h * 0.7, d / 2 + 0.025);
        group.add(strip);
        world.add(group);
        return group;
      }

      const modules = [
        makeBuilding(-7.6, -3.8, 5.5, 4.4, 3.2),
        makeBuilding(-7.1, 4.7, 6.1, 4.8, 2.5),
        makeBuilding(7.4, -4.6, 5.2, 5.0, 3.8),
        makeBuilding(7.1, 4.4, 6.2, 4.3, 2.9),
        makeBuilding(0, 8.2, 6.8, 3.1, 2.2),
      ];

      // Existing mechanical silhouettes stay in place for an honest before/after comparison.
      for (let i = 0; i < 6; i += 1) {
        const tank = new THREE.Mesh(new THREE.CylinderGeometry(0.48 + (i % 2) * 0.12, 0.48 + (i % 2) * 0.12, 2.2 + (i % 3) * 0.3, 20), darkMetal);
        tank.position.set(-3.8 + i * 1.28, 1.12, -8.2 + (i % 2) * 0.72);
        tank.castShadow = !mobile;
        world.add(tank);
      }

      // Support frame for the real pipe rack.
      const pipeRack = new THREE.Group();
      pipeRack.position.set(-4.8, 0, -5.65);
      world.add(pipeRack);
      [-2.6, 0, 2.6].forEach((x) => {
        const post = new THREE.Mesh(new THREE.BoxGeometry(0.13, 4.4, 0.13), darkMetal);
        post.position.set(x, 2.2, 0.25);
        pipeRack.add(post);
      });
      [1.05, 2.25, 3.45].forEach((y) => {
        const beam = new THREE.Mesh(new THREE.BoxGeometry(5.5, 0.11, 0.11), darkMetal);
        beam.position.set(0, y, 0.25);
        pipeRack.add(beam);
      });
      const rackLight = new THREE.Mesh(new THREE.BoxGeometry(5.0, 0.035, 0.035), cyanGlow);
      rackLight.position.set(0, 4.1, 0.25);
      pipeRack.add(rackLight);

      const manager = new THREE.LoadingManager();
      manager.setURLModifier((url) => url.includes('/textures/') ? PIXEL : url);
      const loader = new GLTFLoader(manager);

      loader.load(
        ASSET_URL,
        (gltf) => {
          const root = gltf.scene;
          root.traverse((object) => {
            if (object instanceof THREE.Mesh) {
              const materialName = Array.isArray(object.material)
                ? object.material.map((material) => material.name).join(' ')
                : object.material?.name ?? '';
              object.material = materialName.includes('group02') ? pipeDetail : pipeMaterial;
              object.castShadow = !mobile;
              object.receiveShadow = true;
            }
          });

          root.updateMatrixWorld(true);
          const initialBox = new THREE.Box3().setFromObject(root);
          const size = initialBox.getSize(new THREE.Vector3());
          const dominant = Math.max(size.x, size.y, size.z, 0.001);
          root.scale.setScalar(5.15 / dominant);
          root.updateMatrixWorld(true);

          const fitted = new THREE.Box3().setFromObject(root);
          const center = fitted.getCenter(new THREE.Vector3());
          root.position.x -= center.x;
          root.position.z -= center.z;
          root.position.y += 0.5 - fitted.min.y;
          root.rotation.y = -0.08;
          pipeRack.add(root);

          if (assetStatus) assetStatus.textContent = 'READY';
        },
        undefined,
        (error) => {
          console.error('Phase 2.3 pipe asset failed to load', error);
          if (assetStatus) assetStatus.textContent = 'ERROR';
        },
      );

      // CORE unchanged in concept.
      const core = new THREE.Group();
      world.add(core);
      const plinth = new THREE.Mesh(new THREE.CylinderGeometry(2.25, 2.55, 0.45, 56), darkMetal);
      plinth.position.y = 0.22;
      core.add(plinth);
      const coreBody = new THREE.Mesh(new THREE.CylinderGeometry(0.72, 0.96, 4.4, 42), darkMetal);
      coreBody.position.y = 2.65;
      core.add(coreBody);
      const energyColumn = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 3.55, 24), cyanGlow);
      energyColumn.position.y = 2.7;
      core.add(energyColumn);
      const rings: THREE.Mesh[] = [];
      [1.2, 2.35, 3.5, 4.55].forEach((y, index) => {
        const ring = new THREE.Mesh(new THREE.TorusGeometry(1.08 + index * 0.06, 0.035, 8, 64), index % 2 ? blueGlow : cyanGlow);
        ring.rotation.x = Math.PI / 2;
        ring.position.y = y;
        core.add(ring);
        rings.push(ring);
      });
      const halo = new THREE.Mesh(new THREE.TorusGeometry(2, 0.055, 10, 80), cyanGlow);
      halo.rotation.x = Math.PI / 2;
      halo.position.y = 0.55;
      core.add(halo);
      const beacon = new THREE.PointLight(0x00d9ff, mobile ? 15 : 25, 16, 1.65);
      beacon.position.set(0, 3, 0);
      core.add(beacon);

      scene.add(new THREE.HemisphereLight(0x6ebfe0, 0x02050b, 1.3));
      const key = new THREE.DirectionalLight(0xa9dfff, 3.1);
      key.position.set(-7, 13, 9);
      key.castShadow = !mobile;
      scene.add(key);
      const warm = new THREE.PointLight(0xffa85b, 8, 17, 2);
      warm.position.set(-8, 5, -5);
      scene.add(warm);
      const pipeAccent = new THREE.PointLight(0x00d9ff, 8, 11, 2);
      pipeAccent.position.set(-4.5, 3.5, -4.7);
      scene.add(pipeAccent);

      function createConnection(start: THREE.Vector3, end: THREE.Vector3, height = 1) {
        const mid = start.clone().lerp(end, 0.5);
        mid.y += height;
        const curve = new THREE.CatmullRomCurve3([start, mid, end]);
        const tube = new THREE.Mesh(new THREE.TubeGeometry(curve, 30, 0.025, 7, false), cyanGlow);
        world.add(tube);
        const pulse = new THREE.Mesh(new THREE.SphereGeometry(0.06, 10, 10), cyanGlow);
        world.add(pulse);
        return { curve, pulse, offset: Math.random() };
      }

      const connections = [
        createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(-7.6, 0.65, -3.8), 1.4),
        createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(-7.1, 0.65, 4.7), 1.1),
        createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(7.4, 0.65, -4.6), 1.6),
        createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(7.1, 0.65, 4.4), 1.25),
      ];

      const particleCount = mobile ? 180 : 420;
      const positions = new Float32Array(particleCount * 3);
      for (let i = 0; i < particleCount; i += 1) {
        positions[i * 3] = (Math.random() - 0.5) * 44;
        positions[i * 3 + 1] = Math.random() * 10 + 0.3;
        positions[i * 3 + 2] = (Math.random() - 0.5) * 32;
      }
      const particleGeometry = new THREE.BufferGeometry();
      particleGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      const particles = new THREE.Points(particleGeometry, new THREE.PointsMaterial({ color: 0x5fcde8, size: 0.025, transparent: true, opacity: 0.32, depthWrite: false }));
      world.add(particles);

      const cameraPath = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-13.5, 7.8, 18),
        new THREE.Vector3(-7.5, 5.7, 12.5),
        new THREE.Vector3(-5.8, 4.5, 5.0),
        new THREE.Vector3(-7.1, 3.5, -1.9),
        new THREE.Vector3(4.8, 4.0, -8.5),
        new THREE.Vector3(1.0, 5.0, -12.3),
      ]);
      const targetPath = new THREE.CatmullRomCurve3([
        new THREE.Vector3(0, 1.8, 0),
        new THREE.Vector3(0, 2.7, 0),
        new THREE.Vector3(-4.8, 2.2, -5.65),
        new THREE.Vector3(-4.8, 2.2, -5.65),
        new THREE.Vector3(0, 2.4, -2.5),
        new THREE.Vector3(0, 3, 0),
      ]);

      const state = { progress: 0 };
      const chapters = Array.from(document.querySelectorAll('.chapter'));
      ScrollTrigger.create({
        trigger: '#story',
        start: 'top top',
        end: 'bottom bottom',
        scrub: reducedMotion ? false : 1.05,
        onUpdate: (self) => {
          state.progress = self.progress;
          const active = Math.min(chapters.length - 1, Math.floor(self.progress * chapters.length));
          chapters.forEach((chapter, index) => chapter.classList.toggle('active', index === active));
        },
      });

      const clock = new THREE.Clock();
      let frames = 0;
      let fpsStart = performance.now();
      let raf = 0;
      let visible = true;

      function render(now = performance.now()) {
        const elapsed = clock.getElapsedTime();
        const progress = reducedMotion ? 0.48 : THREE.MathUtils.clamp(state.progress, 0.001, 0.999);
        const camPos = cameraPath.getPointAt(progress);
        const target = targetPath.getPointAt(progress);
        camera.position.lerp(camPos, reducedMotion ? 1 : 0.075);
        camera.lookAt(target);

        core.rotation.y = elapsed * 0.05;
        halo.rotation.z = elapsed * 0.16;
        rings.forEach((ring, index) => ring.rotation.z = elapsed * (0.11 + index * 0.02) * (index % 2 ? -1 : 1));
        particles.rotation.y = elapsed * 0.004;
        modules.forEach((module, index) => module.position.y = Math.sin(elapsed * 0.5 + index) * 0.01);
        connections.forEach(({ curve, pulse, offset }, index) => pulse.position.copy(curve.getPointAt((elapsed * (0.11 + index * 0.01) + offset) % 1)));

        composer.render();

        frames += 1;
        if (now - fpsStart >= 1000) {
          if (fpsEl) fpsEl.textContent = String(Math.round((frames * 1000) / (now - fpsStart)));
          if (trisEl) trisEl.textContent = renderer.info.render.triangles.toLocaleString();
          frames = 0;
          fpsStart = now;
        }

        if (visible) raf = requestAnimationFrame(render);
      }

      function resize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, window.innerWidth <= 760 ? 1.2 : 1.55));
        renderer.setSize(window.innerWidth, window.innerHeight);
        composer.setSize(window.innerWidth, window.innerHeight);
      }

      window.addEventListener('resize', resize, { passive: true });
      document.addEventListener('visibilitychange', () => {
        visible = !document.hidden;
        if (visible) {
          cancelAnimationFrame(raf);
          clock.getDelta();
          fpsStart = performance.now();
          frames = 0;
          render();
        }
      });

      render();
    </script>
  </body>
</html>

<style is:global>
  :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #fff; background: #02040a; color-scheme: dark; }
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: #02040a; overflow-x: hidden; }
  body { min-width: 320px; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  #webgl { position: fixed; inset: 0; width: 100%; height: 100%; display: block; z-index: 0; }
  body::after { content: ''; position: fixed; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgba(2,4,10,.45), transparent 34%, transparent 68%, rgba(2,4,10,.34)), linear-gradient(180deg, rgba(2,4,10,.12), transparent 54%, rgba(2,4,10,.58)), radial-gradient(circle at 50% 46%, transparent 0 42%, rgba(2,4,10,.24) 75%, rgba(2,4,10,.58) 100%); }
  .topbar { position: fixed; inset: 0 0 auto; z-index: 20; height: 74px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 clamp(22px, 4.5vw, 74px); border-bottom: 1px solid rgba(125,187,211,.11); background: linear-gradient(180deg, rgba(2,4,10,.78), rgba(2,4,10,.08)); backdrop-filter: blur(8px); }
  .brand { justify-self: start; font-size: 17px; font-weight: 700; letter-spacing: .04em; }
  .brand strong { color: #00dcff; }
  .phase, .back { color: #8aa0ae; font-size: 9px; font-weight: 800; letter-spacing: .16em; }
  .back { justify-self: end; }
  .metrics { position: fixed; z-index: 18; right: clamp(22px, 3vw, 48px); top: 96px; width: 170px; padding: 10px 13px; border: 1px solid rgba(126,187,211,.13); background: rgba(3,8,13,.62); backdrop-filter: blur(8px); }
  .metrics div { display: flex; justify-content: space-between; gap: 12px; padding: 5px 0; border-bottom: 1px solid rgba(126,187,211,.08); }
  .metrics div:last-child { border: 0; }
  .metrics span, .metrics strong { font-size: 8px; letter-spacing: .12em; }
  .metrics span { color: #667e8c; }
  .metrics strong { color: #00d9ff; }
  #story { position: relative; z-index: 3; }
  .chapter { min-height: 100vh; position: relative; display: flex; align-items: center; padding: 100px clamp(26px, 6vw, 104px) 60px; pointer-events: none; }
  .copy { width: min(650px, 48vw); opacity: .17; transform: translateY(22px); transition: opacity .55s ease, transform .55s ease; }
  .chapter.active .copy { opacity: 1; transform: translateY(0); }
  .right-copy { margin-left: auto; width: min(570px, 44vw); }
  .end-copy { width: min(760px, 68vw); }
  .eyebrow, .index { margin: 0 0 14px; color: #00d9ff; font-size: 9px; font-weight: 850; letter-spacing: .22em; }
  .index { color: #657c89; }
  h1, h2 { margin: 0; font-weight: 510; letter-spacing: -.06em; line-height: .91; }
  h1 { font-size: clamp(54px, 7vw, 118px); }
  h2 { font-size: clamp(48px, 6vw, 98px); }
  .body-copy { max-width: 490px; margin: 24px 0 0; color: #93a5af; font-size: 13px; line-height: 1.7; }
  .scroll-hint { display: inline-flex; gap: 13px; margin-top: 34px; color: #6f8591; font-size: 9px; font-weight: 800; letter-spacing: .16em; }
  .scroll-hint i { color: #00d9ff; font-style: normal; }
  .lab-button { pointer-events: auto; display: inline-flex; gap: 18px; margin-top: 30px; padding: 13px 17px; border: 1px solid rgba(0,217,255,.28); color: #dffaff; font-size: 9px; font-weight: 800; letter-spacing: .13em; }
  .lab-button span { color: #00d9ff; }
  @media (max-width: 760px) {
    .topbar { grid-template-columns: 1fr auto; padding: 0 18px; height: 66px; }
    .phase { display: none; }
    .brand { font-size: 14px; }
    .back { font-size: 7px; }
    .metrics { top: 78px; right: 14px; width: 138px; }
    .chapter { padding: 100px 22px 50px; align-items: flex-end; }
    .copy, .right-copy, .end-copy { width: min(100%, 560px); margin-left: 0; }
    h1 { font-size: clamp(48px, 15vw, 72px); }
    h2 { font-size: clamp(44px, 13vw, 66px); }
    .body-copy { max-width: 92%; font-size: 12px; }
  }
</style>

---
import '../styles/v3-commercial.css';
const base = import.meta.env.BASE_URL;
const accessUrl = `${base}acceso/`;
const contactUrl = `${base}contacto/`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content="IsiVoltPro ayuda a autónomos y pequeñas empresas a controlar clientes, activos, avisos, órdenes de trabajo, mantenimiento preventivo, documentación e histórico desde un solo lugar." />
    <title>IsiVoltPro · Mantenimiento fácil para autónomos y pequeñas empresas</title>
    <script is:inline>
      try {
        if (sessionStorage.getItem('isivoltpro-intro-seen') === '1') {
          document.documentElement.classList.add('skip-intro');
        }
      } catch (_) {}
    </script>
    <style is:inline>html.skip-intro .intro{display:none}</style>
  </head>
  <body class="intro-lock">
    <div class="intro" id="intro" aria-label="Presentación de IsiVoltPro">
      <div class="intro__grid" aria-hidden="true"></div>
      <div class="intro__nebula intro__nebula--a" aria-hidden="true"></div>
      <div class="intro__nebula intro__nebula--b" aria-hidden="true"></div>
      <button class="intro__skip" id="skip-intro" type="button">Saltar intro</button>
      <div class="intro__orbit" aria-hidden="true">
        <span class="intro__node">▣</span>
        <span class="intro__node">⚙</span>
        <span class="intro__node">✓</span>
        <span class="intro__node">⌁</span>
        <span class="intro__node">⌁</span>
        <span class="intro__node">▤</span>
      </div>
      <div class="intro__content">
        <p class="intro__label">ISIVOLTPRO · TRABAJO TÉCNICO CONECTADO</p>
        <div class="intro__core" aria-hidden="true">
          <div class="intro__mark"><span>V</span></div>
        </div>
        <h1>Conectando tu trabajo diario.</h1>
        <p class="intro__copy">Clientes, equipos, avisos, órdenes y mantenimiento dejan de vivir separados. Todo converge en un único lugar.</p>
        <p class="intro__status">Preparando tu entorno de control…</p>
        <div class="intro__bar" aria-hidden="true"><span></span></div>
      </div>
    </div>

    <header class="site-header">
      <div class="site-header__inner shell">
        <a class="brand" href="#inicio" aria-label="IsiVoltPro, inicio">
          <i class="brand__icon" aria-hidden="true"></i>
          <span>IsiVoltPro</span>
        </a>
        <nav class="nav" aria-label="Navegación principal">
          <a href="#producto">Producto</a>
          <a href="#modulos">Módulos</a>
          <a href="#para-quien">Para quién</a>
          <a href="#como-funciona">Cómo funciona</a>
          <a href="#planes">Planes</a>
        </nav>
        <div class="header-actions">
          <a class="btn" href={accessUrl}>Acceder</a>
          <a class="btn btn--primary" href={contactUrl}>Solicitar demo <span>→</span></a>
          <a class="btn mobile-menu" href="#modulos" aria-label="Abrir contenido">☰</a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero" id="inicio">
        <div class="hero__grid shell">
          <div class="hero__copy reveal">
            <span class="eyebrow">Para autónomos y pequeñas empresas</span>
            <h1>Menos papeleo.<br />Más trabajo <span class="gradient-text">bajo control.</span></h1>
            <p class="hero__lead">IsiVoltPro reúne <strong>clientes, equipos, avisos, órdenes de trabajo, preventivos, fotos y documentación</strong> para que puedas resolver el día a día sin depender de WhatsApp, hojas sueltas o varias aplicaciones.</p>
            <div class="hero__actions">
              <a class="btn btn--primary" href={contactUrl}>Solicitar una demo <span>→</span></a>
              <a class="btn" href="#como-funciona">Ver cómo funciona <span>↓</span></a>
            </div>
            <div class="hero__note"><span>✓</span> Empieza con lo que ya haces hoy. Sin cambiar tu forma de trabajar de golpe.</div>
          </div>

          <div class="product-stage reveal" id="producto" aria-label="Vista conceptual de IsiVoltPro">
            <div class="dashboard">
              <div class="dashboard__top">
                <div class="mini-brand"><i></i><span>IsiVoltPro</span></div>
                <small>Empresa Demo · Vista operativa</small>
              </div>
              <div class="dashboard__body">
                <aside class="dashboard__rail" aria-label="Módulos">
                  <span>⌂</span><span>▣</span><span>✓</span><span>⚙</span><span>▤</span><span>⌁</span>
                </aside>
                <div class="dashboard__main">
                  <div class="dashboard__hello">
                    <div><small>Resumen de hoy</small><h3>Buenos días, David</h3></div>
                    <small>23 agosto 2026</small>
                  </div>
                  <div class="kpis">
                    <article class="kpi"><small>OT abiertas</small><strong>12</strong><em>4 para hoy</em></article>
                    <article class="kpi"><small>Preventivos</small><strong>8</strong><em>Próximos 7 días</em></article>
                    <article class="kpi"><small>Incidencias</small><strong>3</strong><em>1 prioritaria</em></article>
                    <article class="kpi"><small>Activos</small><strong>124</strong><em>En seguimiento</em></article>
                  </div>
                  <div class="dashboard__lower">
                    <article class="panel">
                      <div class="panel__head"><strong>Actividad reciente</strong><a href="#como-funciona">Ver todas</a></div>
                      <div class="activity">
                        <div class="activity__row"><i class="dot"></i><span>Revisión climatizadora UTA-02</span><small>Finalizada</small></div>
                        <div class="activity__row"><i class="dot dot--orange"></i><span>Aviso · fuga de agua local 2</span><small>En curso</small></div>
                        <div class="activity__row"><i class="dot"></i><span>Cambio de luminaria · oficina</span><small>Cerrada</small></div>
                        <div class="activity__row"><i class="dot dot--pink"></i><span>Preventivo cuadro eléctrico QG-01</span><small>Mañana</small></div>
                      </div>
                    </article>
                    <article class="panel">
                      <div class="panel__head"><strong>Activo destacado</strong><a href="#modulos">Ficha</a></div>
                      <div class="asset-card">
                        <div><small>CLIMATIZACIÓN</small><h4>UTA-02</h4><p>Planta 1 · Zona técnica<br />Estado: Operativo<br />Próxima revisión: 02/09</p></div>
                        <div class="asset-visual" aria-hidden="true"></div>
                      </div>
                    </article>
                  </div>
                </div>
              </div>
            </div>

            <article class="floating-card floating-card--phone" aria-label="Aviso desde móvil">
              <div class="phone-head"><span>INC-0342</span><span>•••</span></div>
              <div class="phone-title">Fallo de climatización</div>
              <span class="phone-status">Prioridad alta</span>
              <div class="phone-meta">Cliente: Clínica Norte<br />Activo: UTA-02<br />Asignado: Juan</div>
            </article>

            <article class="floating-card floating-card--chart" aria-label="Órdenes completadas">
              <small>Trabajos cerrados</small><strong style="display:block;font-size:26px;margin-top:4px">28</strong>
              <div class="mini-chart">
                <svg viewBox="0 0 120 48" aria-hidden="true"><path d="M2 42 C20 38, 24 26, 38 31 S58 36, 65 21 S86 31, 94 17 S105 18, 118 5" fill="none" stroke="#24c58c" stroke-width="3" stroke-linecap="round"/></svg>
              </div>
            </article>

            <article class="floating-card floating-card--qr" aria-label="Código QR de activo">
              <div class="qr" aria-hidden="true">
                {Array.from({ length: 25 }).map(() => <i></i>)}
              </div>
              <small style="font-size:8px">Escanear activo</small>
            </article>
          </div>
        </div>
      </section>

      <section class="pain-strip" aria-label="Problemas que IsiVoltPro simplifica">
        <div class="pain-strip__grid shell">
          <article class="pain-item"><i>✉</i><strong>Menos avisos perdidos</strong><span>Convierte mensajes y llamadas en trabajo organizado.</span></article>
          <article class="pain-item"><i>▤</i><strong>Menos papel y Excel</strong><span>Fotos, documentos e histórico junto al equipo correcto.</span></article>
          <article class="pain-item"><i>⏱</i><strong>Menos revisiones olvidadas</strong><span>Sabes qué toca, cuándo y quién debe hacerlo.</span></article>
          <article class="pain-item"><i>✓</i><strong>Más tranquilidad</strong><span>Ves qué está pendiente, en curso y terminado.</span></article>
        </div>
      </section>

      <section class="section section--soft" id="modulos">
        <div class="shell">
          <div class="section-head reveal">
            <div><span class="eyebrow">Todo lo necesario, sin complicarlo</span><h2>Una plataforma para el <span class="gradient-text">trabajo real.</span></h2></div>
            <p>Empieza por los módulos que necesitas y amplía después. IsiVoltPro está pensado para acompañar a un profesional que trabaja solo y también a una pequeña empresa que coordina varios técnicos.</p>
          </div>
          <div class="modules-grid">
            <article class="module-card reveal" style="--accent:rgba(23,92,255,.10)"><i class="module-icon">▣</i><h3>Clientes y activos</h3><p>Organiza clientes, ubicaciones y equipos. Cada activo conserva sus datos, fotos, documentos e histórico.</p><small>Cliente → ubicación → equipo</small></article>
            <article class="module-card reveal" style="--accent:rgba(242,56,169,.10);--icon:#d52f99;--icon-bg:#fff0f8"><i class="module-icon">!</i><h3>Avisos y OT</h3><p>Registra una incidencia, conviértela en orden de trabajo, asigna a un técnico y sigue su estado hasta el cierre.</p><small>Aviso → OT → resolución</small></article>
            <article class="module-card reveal" style="--accent:rgba(36,197,140,.11);--icon:#159f71;--icon-bg:#eaf9f3"><i class="module-icon">⚙</i><h3>Mantenimiento</h3><p>Programa revisiones y preventivos sin llevar calendarios paralelos. Lo pendiente aparece donde toca.</p><small>Planificar → ejecutar → registrar</small></article>
            <article class="module-card reveal" style="--accent:rgba(255,139,61,.12);--icon:#e37427;--icon-bg:#fff4ea"><i class="module-icon">⌁</i><h3>QR / NFC</h3><p>Escanea el equipo desde el móvil y abre directamente su ficha, documentación, incidencias y actuaciones.</p><small>Escanear → identificar → actuar</small></article>
            <article class="module-card reveal" style="--accent:rgba(24,185,215,.11);--icon:#139db9;--icon-bg:#eafafd"><i class="module-icon">▤</i><h3>Fotos e informes</h3><p>Adjunta evidencias durante el trabajo y conserva informes y documentos dentro del historial técnico.</p><small>Trabajo documentado, siempre disponible</small></article>
            <article class="module-card reveal" style="--accent:rgba(109,74,255,.11);--icon:#6544e8;--icon-bg:#f2efff"><i class="module-icon">↗</i><h3>Control del negocio</h3><p>Consulta trabajos abiertos, carga pendiente y actividad del equipo sin perseguir información por varios canales.</p><small>Una vista clara para decidir</small></article>
          </div>
        </div>
      </section>

      <section class="section" id="para-quien">
        <div class="shell personas">
          <article class="persona-copy reveal">
            <span class="eyebrow">Crece sin montar un ERP</span>
            <h2>Hecho para quien <span class="gradient-text">trabaja de verdad.</span></h2>
            <p>IsiVoltPro no parte de una oficina ideal. Parte del técnico con el móvil en la mano, del autónomo que lleva varios clientes y de la pequeña empresa que necesita saber qué está pasando sin añadir burocracia.</p>
          </article>
          <div class="persona-list">
            <article class="persona-card reveal"><i>👤</i><h3>Autónomo</h3><p>Clientes, equipos, trabajos, fotografías y revisiones en un único sitio. Menos tiempo ordenando papeles al terminar el día.</p></article>
            <article class="persona-card reveal"><i>👥</i><h3>Pequeño equipo</h3><p>Asigna trabajo, comparte contexto y consulta el estado de cada OT sin depender de llamadas constantes.</p></article>
            <article class="persona-card reveal"><i>🔧</i><h3>Empresa mantenedora</h3><p>Gestiona varios clientes e instalaciones manteniendo cada histórico separado y accesible para quien corresponde.</p></article>
            <article class="persona-card reveal"><i>🏢</i><h3>Negocio con instalaciones</h3><p>Controla tus propios equipos, incidencias, proveedores y preventivos aunque no tengas un gran departamento técnico.</p></article>
          </div>
        </div>
      </section>

      <section class="section section--soft" id="como-funciona">
        <div class="shell">
          <div class="section-head reveal">
            <div><span class="eyebrow">Del problema a la solución</span><h2>Un flujo que cualquiera <span class="gradient-text">entiende.</span></h2></div>
            <p>El objetivo no es obligarte a rellenar más campos. Es que cada trabajo deje la información útil preparada para la próxima vez.</p>
          </div>
          <div class="workflow reveal">
            <div class="workflow__track">
              <article class="workflow-step"><i>1</i><strong>Cliente / activo</strong><small>Sabes dónde ocurre.</small></article>
              <article class="workflow-step" style="--step-bg:#fff0f4;--step-color:#e13972"><i>2</i><strong>Aviso</strong><small>Registras el problema.</small></article>
              <article class="workflow-step" style="--step-bg:#f2efff;--step-color:#6d4aff"><i>3</i><strong>OT</strong><small>Organizas el trabajo.</small></article>
              <article class="workflow-step" style="--step-bg:#ebf8ff;--step-color:#139db9"><i>4</i><strong>Técnico</strong><small>Ejecuta con contexto.</small></article>
              <article class="workflow-step" style="--step-bg:#eaf9f3;--step-color:#159f71"><i>5</i><strong>Cierre</strong><small>Fotos, tiempos, notas.</small></article>
              <article class="workflow-step" style="--step-bg:#fff5ea;--step-color:#e37427"><i>6</i><strong>Histórico</strong><small>Queda para siempre.</small></article>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="shell mobile-block">
          <div class="reveal">
            <span class="eyebrow">Pensado primero para el móvil</span>
            <h2>El trabajo ocurre fuera de la oficina. <span class="gradient-text">IsiVoltPro también.</span></h2>
            <p>El técnico puede llegar, escanear el equipo, consultar qué ocurrió antes, abrir o completar una OT y dejar la actuación documentada desde el teléfono.</p>
            <ul class="checks">
              <li>Escaneo QR / NFC del activo</li>
              <li>Órdenes asignadas y prioridades</li>
              <li>Fotos, notas y documentación</li>
              <li>Histórico disponible en campo</li>
            </ul>
          </div>
          <div class="phone-scene reveal" aria-label="Interfaz móvil conceptual">
            <div class="phone-orb" aria-hidden="true"></div>
            <div class="phone-device">
              <div class="phone-ui">
                <div class="phone-ui__top"><span>9:41</span><span>IsiVoltPro</span></div>
                <h3>Mi trabajo</h3><p>4 órdenes asignadas hoy</p>
                <article class="phone-task"><strong>OT-1247 · Cuadro QG-01</strong><small>Revisión general · Taller Norte</small><span>En curso</span></article>
                <article class="phone-task"><strong>OT-1248 · UTA-02</strong><small>Fallo de temperatura · Clínica Norte</small><span style="background:#fff0f4;color:#d83567">Prioritaria</span></article>
                <article class="phone-task"><strong>OT-1251 · Bomba ACS</strong><small>Preventivo · Hotel Centro</small><span style="background:#f2efff;color:#6544e8">Programada</span></article>
                <div class="phone-nav"><span>Inicio</span><span>OT</span><span>Escanear</span><span>Más</span></div>
              </div>
            </div>
            <div class="qr-card"><div class="qr" aria-hidden="true">{Array.from({ length: 25 }).map(() => <i></i>)}</div><small>QR del equipo</small></div>
          </div>
        </div>
      </section>

      <section class="section section--soft" id="planes">
        <div class="shell">
          <div class="plans-intro reveal">
            <span class="eyebrow">Empieza pequeño. Amplía cuando lo necesites.</span>
            <h2>Un IsiVoltPro para <span class="gradient-text">cada etapa.</span></h2>
            <p>La estructura comercial definitiva se validará con los primeros pilotos. La web deja ya preparada una oferta clara para profesional individual, equipo pequeño y empresa mantenedora.</p>
          </div>
          <div class="plan-grid">
            <article class="plan reveal"><h3>Autónomo</h3><p>Para profesionales que gestionan sus propios clientes y trabajos.</p><ul><li>Clientes y activos</li><li>OT y avisos</li><li>Preventivos</li><li>QR e histórico</li></ul><a class="btn" href={contactUrl}>Quiero probarlo</a></article>
            <article class="plan plan--featured reveal"><h3>Equipo</h3><p>Para pequeñas empresas que reparten trabajo entre varios técnicos.</p><ul><li>Todo lo de Autónomo</li><li>Usuarios y asignaciones</li><li>Vista de coordinación</li><li>Control de actividad</li></ul><a class="btn btn--primary" href={contactUrl}>Solicitar demo</a></article>
            <article class="plan reveal"><h3>Empresa</h3><p>Para mantenedoras con varios clientes, instalaciones y necesidades avanzadas.</p><ul><li>Multi-cliente / multi-sede</li><li>Roles y permisos</li><li>Módulos adicionales</li><li>Configuración y soporte</li></ul><a class="btn" href={contactUrl}>Hablar con nosotros</a></article>
          </div>
        </div>
      </section>

      <section class="final-cta">
        <div class="final-cta__inner shell reveal">
          <div><h2>Que el trabajo técnico deje de vivir en tu cabeza.</h2><p>Organiza el día a día, conserva el histórico y haz crecer tu negocio con más control.</p></div>
          <a class="btn" href={contactUrl}>Ver IsiVoltPro en una demo <span>→</span></a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="shell">
        <div class="footer__grid">
          <div><a class="brand" href="#inicio"><i class="brand__icon"></i><span>IsiVoltPro</span></a><p>Software práctico para organizar mantenimiento, activos y trabajo técnico en autónomos y pequeñas empresas.</p></div>
          <div><h4>Producto</h4><a href="#modulos">Módulos</a><br/><a href="#como-funciona">Cómo funciona</a><br/><a href="#planes">Planes</a></div>
          <div><h4>Para quién</h4><a href="#para-quien">Autónomos</a><br/><a href="#para-quien">Pequeñas empresas</a><br/><a href="#para-quien">Mantenedoras</a></div>
          <div><h4>IsiVoltPro</h4><a href={contactUrl}>Solicitar demo</a><br/><a href={accessUrl}>Acceder</a><br/><a href="#inicio">Volver arriba</a></div>
        </div>
        <div class="footer__bottom"><span>© 2026 IsiVoltPro · Concepto comercial V3</span><span>Privacidad · Cookies · Aviso legal</span></div>
      </div>
    </footer>

    <script is:inline>
      const intro = document.getElementById('intro');
      const skip = document.getElementById('skip-intro');
      const body = document.body;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let finished = false;

      const finishIntro = () => {
        if (finished) return;
        finished = true;
        try { sessionStorage.setItem('isivoltpro-intro-seen', '1'); } catch (_) {}
        intro?.classList.add('is-done');
        body.classList.remove('intro-lock');
        window.setTimeout(() => intro?.setAttribute('aria-hidden', 'true'), 750);
      };

      let seen = false;
      try { seen = sessionStorage.getItem('isivoltpro-intro-seen') === '1'; } catch (_) {}
      if (seen || reduced || document.documentElement.classList.contains('skip-intro')) {
        intro?.classList.add('is-done');
        body.classList.remove('intro-lock');
      } else {
        window.setTimeout(finishIntro, 3200);
      }
      skip?.addEventListener('click', finishIntro);

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

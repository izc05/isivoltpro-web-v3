---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
import { publishedV3BlogPosts, v3EditorialQueue, v3SocialAdaptations } from '../../data/v3-blog';
import {
  v3DailyCandidates,
  v3DailyEditorialCadence,
  v3DailyEditorialRules,
  v3EditorialSources,
} from '../../data/v3-daily-editorial';

const base = import.meta.env.BASE_URL;
const enabled = import.meta.env.PUBLIC_V3_CONTENT_ADMIN_PREVIEW === 'true';
const postBySlug = new Map(publishedV3BlogPosts.map((post) => [post.slug, post]));
const sourceById = new Map(v3EditorialSources.map((source) => [source.id, source]));
const formatDate = (value: string) => new Intl.DateTimeFormat('es-ES', { day: '2-digit', month: 'short' }).format(new Date(`${value.slice(0, 10)}T12:00:00`));
const typeLabel = {
  normativa: 'Normativa',
  actualidad: 'Actualidad',
  seguridad: 'Seguridad',
  energia: 'Energía',
  practico: 'Práctico',
  curiosidad: 'Curiosidad',
  radar: 'Radar',
} as const;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Blog y redes · Gestión de contenido · IsiVoltPro" description="Preview editorial del blog, radar diario y adaptaciones sociales de IsiVoltPro." path={`${base}gestion-contenido/blog/`} noindex={true} />
  <style is:inline>
    .editorial-page{padding:54px 0 84px;background:radial-gradient(circle at 82% 8%,rgba(100,82,219,.11),transparent 25%),linear-gradient(180deg,#fff,#f8faff);min-height:80vh}.editorial-shell{width:min(1180px,calc(100% - 32px));margin:0 auto}.editorial-head{display:grid;grid-template-columns:1.15fr .85fr;gap:32px;align-items:end;margin-bottom:24px}.editorial-head h1{margin:13px 0 14px;font:800 clamp(42px,6vw,68px)/.98 var(--v3-font-display,system-ui);letter-spacing:-.055em}.editorial-head p{margin:0;max-width:720px;color:#707b91;line-height:1.65}.editorial-lock{padding:18px 20px;border:1px solid #f0dfbd;border-radius:20px;background:#fff9ef;color:#6f4e1d}.editorial-lock strong{display:block;margin-bottom:6px}.editorial-lock small{line-height:1.5}.editorial-nav{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 20px}.editorial-nav a{padding:9px 12px;border:1px solid #e4e8f1;border-radius:999px;background:#fff;color:#4e5a72;text-decoration:none;font-size:11px;font-weight:850}.editorial-nav a:first-child{background:#111827;color:#fff;border-color:#111827}.editorial-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}.editorial-stat{padding:18px;border:1px solid #e7eaf2;border-radius:19px;background:#fff}.editorial-stat small{display:block;color:#8c96aa;font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.07em}.editorial-stat strong{display:block;margin-top:7px;font-size:28px}.editorial-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px}.editorial-panel{padding:22px;border:1px solid #e6eaf2;border-radius:24px;background:#fff;box-shadow:0 16px 46px rgba(52,63,105,.06)}.editorial-panel h2{margin:0 0 5px;font-size:25px}.editorial-panel>p{margin:0 0 18px;color:#79849a;font-size:12px;line-height:1.55}.post-list,.queue-list,.social-list,.source-list,.rule-list{display:grid;gap:10px}.post-row,.queue-row,.social-row,.source-row,.rule-row{padding:14px;border:1px solid #e9ecf3;border-radius:16px;background:linear-gradient(145deg,#fff,#fcfdff)}.row-top{display:flex;gap:10px;justify-content:space-between;align-items:flex-start}.row-top strong{font-size:13px;line-height:1.35}.pill{flex:0 0 auto;padding:5px 8px;border-radius:999px;background:#eaf8f2;color:#16845f;font-size:9px;font-weight:900;text-transform:uppercase}.pill.draft,.pill.idea{background:#f2f4f8;color:#6c768b}.pill.ready,.pill.verified{background:#eef3ff;color:#4261c8}.pill.review{background:#f4efff;color:#6950c8}.pill.blocked{background:#fff1ec;color:#a2512e}.pill.consulta{background:#fff7df;color:#8a6616}.post-row small,.queue-row small,.social-row small,.source-row small,.rule-row small{display:block;margin-top:6px;color:#8791a4;line-height:1.45}.channels{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.channels span{padding:5px 8px;border-radius:999px;background:#f3f5f9;color:#59647b;font-size:9px;font-weight:850}.caption-preview{margin-top:10px;padding:10px;border-radius:12px;background:#f7f9fd;color:#5d687f;font-size:10px;line-height:1.5}.cadence{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px}.cadence article{padding:12px;border:1px solid #e8ebf2;border-radius:15px;background:#fafbfe}.cadence b{display:block;color:#5749cc;font-size:10px}.cadence strong{display:block;margin:6px 0;font-size:11px}.cadence small{display:block;color:#8892a4;font-size:9px;line-height:1.4}.source-link{display:inline-flex;margin-top:8px;color:#5849ce;text-decoration:none;font-size:10px;font-weight:850}.preview-off{padding:28px;border-radius:22px;background:#111827;color:#fff}.preview-off p{color:#cbd5e1;line-height:1.6}.preview-off code{padding:3px 7px;border-radius:7px;background:#243047}@media(max-width:1020px){.cadence{grid-template-columns:repeat(4,1fr)}}@media(max-width:880px){.editorial-head,.editorial-grid{grid-template-columns:1fr}.editorial-stats{grid-template-columns:1fr 1fr}}@media(max-width:620px){.cadence{grid-template-columns:1fr 1fr}}@media(max-width:560px){.editorial-page{padding-top:38px}.editorial-head h1{font-size:clamp(40px,13vw,54px)}.row-top{display:grid}.editorial-stats{grid-template-columns:1fr}}
  </style>
</head>
<body>
<V3CommercialHeader />
<main class="editorial-page"><div class="editorial-shell"><section class="editorial-head"><div><span class="eyebrow">Workspace editorial</span><h1>Blog, radar diario y redes<br/><span class="gradient-text">en el mismo flujo.</span></h1><p>La nueva línea editorial combina actualidad española, normativa, seguridad, energía, casos prácticos y curiosidades. Cada pieza temporal conserva fuente, fecha de comprobación y estado antes de pasar a revisión.</p></div><aside class="editorial-lock"><strong>Publicación externa bloqueada</strong><small>Esta vista no contiene tokens ni llamadas a redes sociales. El futuro publicador deberá ejecutarse en backend autenticado y respetar aprobación administrativa.</small></aside></section><nav class="editorial-nav"><a href={`${base}gestion-contenido/`}>← Gestión general</a><a href="#radar">Radar diario</a><a href="#cadencia">Cadencia</a><a href="#fuentes">Fuentes</a><a href="#publicados">Blog</a><a href="#redes">Redes</a></nav>{enabled ? <><section class="editorial-stats"><article class="editorial-stat"><small>Blog publicado</small><strong>{publishedV3BlogPosts.length}</strong></article><article class="editorial-stat"><small>Radar diario</small><strong>{v3DailyCandidates.length}</strong></article><article class="editorial-stat"><small>Fuentes verificadas</small><strong>{v3EditorialSources.length}</strong></article><article class="editorial-stat"><small>Adaptaciones sociales</small><strong>{v3SocialAdaptations.length}</strong></article></section><div class="editorial-grid"><section class="editorial-panel" id="radar" style="grid-column:1/-1"><h2>Radar diario de mantenimiento</h2><p>Noticias y temas preparados con evidencia explícita. Una consulta se mantiene identificada como consulta; una contratación se usa como caso, no como obligación normativa.</p><div class="queue-list">{v3DailyCandidates.map((item) => { const source = item.sourceId ? sourceById.get(item.sourceId) : undefined; return <article class="queue-row"><div class="row-top"><strong>{item.title}</strong><span class={`pill ${item.status}`}>{item.status}</span></div><small>{formatDate(item.plannedFor)} · {typeLabel[item.type]} · {item.angle}</small><div class="channels"><span>{item.jurisdiction}</span>{item.regulationState && <span>{item.regulationState}</span>}{item.channels.map((channel) => <span>{channel}</span>)}</div>{source && <small>Fuente: {source.name} · comprobado {formatDate(item.checkedAt)}</small>}{item.sourceUrl && <a class="source-link" href={item.sourceUrl} rel="noreferrer">Abrir fuente original →</a>}</article>; })}</div></section><section class="editorial-panel" id="cadencia" style="grid-column:1/-1"><h2>Cadencia semanal</h2><p>La variedad está definida por diseño para evitar siete publicaciones seguidas sobre el mismo tema.</p><div class="cadence">{v3DailyEditorialCadence.map((slot) => <article><b>{slot.label}</b><strong>{typeLabel[slot.type]}</strong><small>{slot.promise}</small></article>)}</div></section><section class="editorial-panel" id="fuentes"><h2>Fuentes preferentes</h2><p>Primarias e institucionales antes que medios secundarios.</p><div class="source-list">{v3EditorialSources.map((source) => <article class="source-row"><div class="row-top"><strong>{source.name}</strong><span class="pill">{source.authority.replace('_',' ')}</span></div><small>{source.domain} · {source.jurisdiction}</small><div class="channels">{source.topics.slice(0,4).map((topic) => <span>{topic}</span>)}</div></article>)}</div></section><section class="editorial-panel"><h2>Reglas de verificación</h2><p>Condiciones mínimas antes de publicar.</p><div class="rule-list">{v3DailyEditorialRules.map((rule, index) => <article class="rule-row"><div class="row-top"><strong>{String(index + 1).padStart(2,'0')}</strong></div><small>{rule}</small></article>)}</div></section><section class="editorial-panel" id="publicados"><h2>Artículos publicados</h2><p>Contenido público con URL estable, SEO y enlaces internos.</p><div class="post-list">{publishedV3BlogPosts.map((post) => <article class="post-row"><div class="row-top"><strong>{post.title}</strong><span class="pill">publicado</span></div><small>{formatDate(post.publishedAt)} · {post.readMinutes} min · /blog/{post.slug}/</small><div class="channels">{post.keywords.slice(0, 3).map((keyword) => <span>{keyword}</span>)}</div></article>)}</div></section><section class="editorial-panel"><h2>Backlog evergreen</h2><p>Temas prácticos que no dependen de una noticia del día.</p><div class="queue-list">{v3EditorialQueue.map((item) => <article class="queue-row"><div class="row-top"><strong>{item.title}</strong><span class={`pill ${item.status}`}>{item.status}</span></div><small>{formatDate(item.plannedFor)} · {item.focus}</small><div class="channels">{item.channels.map((channel) => <span>{channel}</span>)}</div></article>)}</div></section><section class="editorial-panel" id="redes" style="grid-column:1/-1"><h2>Adaptaciones para redes</h2><p>Cada canal conserva copy propio; no se replica el mismo texto sin adaptar.</p><div class="social-list">{v3SocialAdaptations.map((item) => <article class="social-row"><div class="row-top"><strong>{postBySlug.get(item.postSlug)?.title ?? item.postSlug}</strong><span class={`pill ${item.status}`}>{item.status}</span></div><small>{item.publishAfter ? `Planificado: ${item.publishAfter}` : 'Sin fecha de publicación'}</small><div class="channels">{item.channels.map((channel) => <span>{channel}</span>)}</div><div class="caption-preview"><b>LinkedIn:</b> {item.captions.linkedin}</div></article>)}</div></section></div></> : <section class="preview-off"><h2>Preview editorial desactivado</h2><p>Para QA local utiliza <code>PUBLIC_V3_CONTENT_ADMIN_PREVIEW=true</code>. En producción seguirá desactivado hasta disponer de autenticación y backend de contenidos.</p></section>}</div></main>
<V3CommercialFooter />
</body>
</html>

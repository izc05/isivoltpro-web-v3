---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#02040a" />
    <meta name="description" content="ISIVOLTPRO phase 2.5 industrial 3D scene with real pipe and HVAC duct geometry." />
    <title>ISIVOLTPRO · Phase 2.5</title>
  </head>
  <body>
    <canvas id="webgl" aria-hidden="true"></canvas>

    <header class="topbar">
      <a class="brand" href={base}>ISIVOLT<strong>PRO</strong></a>
      <span class="phase">FASE 2.5 / HVAC NETWORK</span>
      <a class="back" href={`${base}lab-3d-phase24/`}>BACK TO 2.4</a>
    </header>

    <aside class="metrics" aria-live="polite">
      <div><span>PIPES</span><strong id="pipe-status">LOADING</strong></div>
      <div><span>HVAC</span><strong id="hvac-status">LOADING</strong></div>
      <div><span>REAL PIECES</span><strong id="piece-count">--</strong></div>
      <div><span>FPS</span><strong id="fps">--</strong></div>
      <div><span>TRIS</span><strong id="tris">--</strong></div>
    </aside>

    <main id="story">
      <section class="chapter active">
        <div class="copy">
          <p class="eyebrow">INDUSTRIAL DIGITAL TWIN</p>
          <h1>Two physical<br />systems. One plant.</h1>
          <p class="body-copy">The mechanical pipe network remains in place while a second real discipline enters the scene: HVAC.</p>
          <span class="scroll-hint">SCROLL THROUGH THE SYSTEMS <i>↓</i></span>
        </div>
      </section>

      <section class="chapter">
        <div class="copy right-copy">
          <p class="index">02 / MECHANICAL</p>
          <p class="eyebrow">SUPPLY · RETURN · PUMPS</p>
          <h2>Water stays<br />on the floor.</h2>
          <p class="body-copy">Real modular pipe geometry keeps serving the tanks and pump manifold from Phase 2.4.</p>
        </div>
      </section>

      <section class="chapter">
        <div class="copy">
          <p class="index">03 / HVAC</p>
          <p class="eyebrow">MAIN DUCT · BRANCHES · FAN</p>
          <h2>Air moves<br />above the plant.</h2>
          <p class="body-copy">A CC0 circular duct kit now forms an elevated trunk, branch lines, bends, supports and an inline fan.</p>
        </div>
      </section>

      <section class="chapter">
        <div class="copy right-copy">
          <p class="index">04 / LAYERS</p>
          <p class="eyebrow">PHYSICAL INFRASTRUCTURE</p>
          <h2>Systems occupy<br />different layers.</h2>
          <p class="body-copy">Mechanical services stay low while ventilation crosses overhead, giving the installation real technical depth.</p>
        </div>
      </section>

      <section class="chapter">
        <div class="copy end-copy">
          <p class="index">05 / CHECKPOINT</p>
          <p class="eyebrow">PHASE 2.5</p>
          <h2>Pipes + HVAC.<br />Nothing else added.</h2>
          <a class="lab-button" href={`${base}lab-3d-phase24/`}>COMPARE WITH 2.4 <span>→</span></a>
        </div>
      </section>
    </main>

    <div id="no-webgl" hidden>
      <strong>3D unavailable</strong>
      <p>This checkpoint needs WebGL.</p>
      <a href={base}>Return home</a>
    </div>

    <script>
      import * as THREE from 'three';
      import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
      import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
      import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
      import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';
      import { OutputPass } from 'three/examples/jsm/postprocessing/OutputPass.js';
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const PIPE_ASSET_URL = 'https://raw.githubusercontent.com/KrazIvan/GodotVR_Test/6dc918140151c3235406a3f616a765e11293285a/Ivan%20VR/models/props/pipe/modular_industrial_pipes_01_4k.gltf';
      const HVAC_ASSET_URL = 'https://raw.githubusercontent.com/Hona/daxship/d63856c6af9aba445a4fe8bf832d0e0ecf2572e5/apps/web/public/assets/models/environment/poly-haven/modular_airduct_circular_01/modular_airduct_circular_01_1k.gltf';
      const PIXEL = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Y9Zf6AAAAAASUVORK5CYII=';

      const canvas = document.querySelector('#webgl');
      const pipeStatus = document.querySelector('#pipe-status');
      const hvacStatus = document.querySelector('#hvac-status');
      const pieceCountEl = document.querySelector('#piece-count');
      const fpsEl = document.querySelector('#fps');
      const trisEl = document.querySelector('#tris');
      const noWebgl = document.querySelector('#no-webgl');

      const supportsWebGL = (() => {
        try {
          const test = document.createElement('canvas');
          return Boolean(test.getContext('webgl2') || test.getContext('webgl'));
        } catch {
          return false;
        }
      })();

      if (!supportsWebGL || !(canvas instanceof HTMLCanvasElement)) {
        if (canvas) canvas.remove();
        if (noWebgl instanceof HTMLElement) noWebgl.hidden = false;
      } else {
        const mobile = window.matchMedia('(max-width: 760px)').matches;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: false,
          powerPreference: 'high-performance',
          stencil: false,
        });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, mobile ? 1.1 : 1.45));
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 0.92;
        renderer.shadowMap.enabled = !mobile;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;

        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x02040a);
        scene.fog = new THREE.FogExp2(0x02040a, 0.027);

        const camera = new THREE.PerspectiveCamera(42, window.innerWidth / window.innerHeight, 0.1, 130);
        camera.position.set(-14, 8, 19);

        const composer = new EffectComposer(renderer);
        composer.addPass(new RenderPass(scene, camera));
        composer.addPass(new UnrealBloomPass(
          new THREE.Vector2(window.innerWidth, window.innerHeight),
          mobile ? 0.3 : 0.52,
          0.45,
          0.84,
        ));
        composer.addPass(new OutputPass());

        const world = new THREE.Group();
        scene.add(world);

        const darkMetal = new THREE.MeshStandardMaterial({ color: 0x111925, metalness: 0.74, roughness: 0.36 });
        const darkPanel = new THREE.MeshStandardMaterial({ color: 0x07101a, metalness: 0.5, roughness: 0.54 });
        const concrete = new THREE.MeshStandardMaterial({ color: 0x090e14, metalness: 0.08, roughness: 0.9 });
        const pipeSupply = new THREE.MeshStandardMaterial({ color: 0x71818b, metalness: 0.9, roughness: 0.28 });
        const pipeReturn = new THREE.MeshStandardMaterial({ color: 0x445863, metalness: 0.82, roughness: 0.34 });
        const valveMaterial = new THREE.MeshStandardMaterial({ color: 0x9a542d, metalness: 0.66, roughness: 0.38 });
        const cyanGlow = new THREE.MeshStandardMaterial({ color: 0x063b50, emissive: 0x00d9ff, emissiveIntensity: 3.0, metalness: 0.5, roughness: 0.22 });
        const blueGlow = new THREE.MeshStandardMaterial({ color: 0x031b38, emissive: 0x0879ff, emissiveIntensity: 2.15, metalness: 0.62, roughness: 0.24 });

        const floor = new THREE.Mesh(new THREE.PlaneGeometry(60, 44), concrete);
        floor.rotation.x = -Math.PI / 2;
        floor.position.y = -0.05;
        floor.receiveShadow = true;
        world.add(floor);

        const grid = new THREE.GridHelper(60, 60, 0x17455b, 0x0b1c27);
        grid.position.y = 0.01;
        grid.material.transparent = true;
        grid.material.opacity = 0.17;
        world.add(grid);

        function makeBuilding(x: number, z: number, w: number, d: number, h: number) {
          const group = new THREE.Group();
          group.position.set(x, 0, z);
          const body = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), darkPanel);
          body.position.y = h / 2;
          body.castShadow = !mobile;
          body.receiveShadow = true;
          group.add(body);
          const strip = new THREE.Mesh(new THREE.BoxGeometry(w * 0.68, 0.05, 0.04), cyanGlow);
          strip.position.set(0, h * 0.72, d / 2 + 0.025);
          group.add(strip);
          world.add(group);
          return group;
        }

        const modules = [
          makeBuilding(-8.3, -2.6, 5.0, 4.2, 3.1),
          makeBuilding(-7.5, 5.3, 5.8, 4.4, 2.6),
          makeBuilding(7.9, -4.8, 5.2, 5.0, 3.7),
          makeBuilding(7.3, 4.6, 6.0, 4.2, 2.8),
          makeBuilding(0.4, 8.4, 6.6, 3.0, 2.2),
        ];

        // Mechanical equipment retained from Phase 2.4.
        const tankGroup = new THREE.Group();
        tankGroup.position.set(-1.0, 0, -8.0);
        world.add(tankGroup);
        [-3.0, -1.45, 0.1, 1.65, 3.2].forEach((x, index) => {
          const tank = new THREE.Mesh(
            new THREE.CylinderGeometry(0.52 + (index % 2) * 0.08, 0.52 + (index % 2) * 0.08, 2.45 + (index % 3) * 0.22, 24),
            darkMetal,
          );
          tank.position.set(x, 1.28, 0);
          tank.castShadow = !mobile;
          tankGroup.add(tank);
          const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.23, 0.23, 0.16, 18), valveMaterial);
          cap.position.set(x, 2.56 + (index % 3) * 0.1, 0);
          tankGroup.add(cap);
        });

        const pumpGroup = new THREE.Group();
        pumpGroup.position.set(-0.6, 0, -4.1);
        world.add(pumpGroup);
        [-2.7, -0.9, 0.9, 2.7].forEach((x, index) => {
          const skid = new THREE.Group();
          const basePlate = new THREE.Mesh(new THREE.BoxGeometry(1.35, 0.18, 0.86), darkMetal);
          basePlate.position.y = 0.09;
          skid.add(basePlate);
          const motor = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.3, 0.8, 18), darkPanel);
          motor.rotation.z = Math.PI / 2;
          motor.position.set(-0.16, 0.5, 0);
          skid.add(motor);
          const head = new THREE.Mesh(new THREE.CylinderGeometry(0.23, 0.23, 0.42, 18), valveMaterial);
          head.rotation.z = Math.PI / 2;
          head.position.set(0.48, 0.5, 0);
          skid.add(head);
          const led = new THREE.Mesh(new THREE.SphereGeometry(0.05, 10, 10), index % 2 ? blueGlow : cyanGlow);
          led.position.set(0.5, 0.55, 0.35);
          skid.add(led);
          skid.position.x = x;
          pumpGroup.add(skid);
        });

        // Pipe rack retained as lower physical layer.
        const rack = new THREE.Group();
        rack.position.set(-4.7, 0, -6.1);
        world.add(rack);
        [-3.7, -1.25, 1.25, 3.7].forEach((x) => {
          const post = new THREE.Mesh(new THREE.BoxGeometry(0.12, 4.5, 0.12), darkMetal);
          post.position.set(x, 2.25, 0);
          rack.add(post);
        });
        [1.1, 2.35, 3.6].forEach((y) => {
          const beam = new THREE.Mesh(new THREE.BoxGeometry(7.6, 0.1, 0.1), darkMetal);
          beam.position.set(0, y, 0);
          rack.add(beam);
        });

        // HVAC support structure is deliberately light: real duct meshes remain the focus.
        const hvacFrame = new THREE.Group();
        world.add(hvacFrame);
        [-5.4, -1.8, 1.8, 5.4].forEach((x) => {
          const hanger = new THREE.Mesh(new THREE.BoxGeometry(0.06, 1.15, 0.06), darkMetal);
          hanger.position.set(x, 5.35, 2.55);
          hvacFrame.add(hanger);
          const cross = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.06, 0.06), darkMetal);
          cross.position.set(x, 4.8, 2.55);
          hvacFrame.add(cross);
        });

        // A procedural AHU gives the new duct network a credible destination without adding a second external asset.
        const ahu = new THREE.Group();
        ahu.position.set(5.6, 0, -0.8);
        world.add(ahu);
        const ahuBody = new THREE.Mesh(new THREE.BoxGeometry(3.2, 2.5, 2.3), darkPanel);
        ahuBody.position.y = 1.3;
        ahuBody.castShadow = !mobile;
        ahu.add(ahuBody);
        const ahuTop = new THREE.Mesh(new THREE.BoxGeometry(2.9, 0.12, 2.0), darkMetal);
        ahuTop.position.y = 2.62;
        ahu.add(ahuTop);
        const ahuRing = new THREE.Mesh(new THREE.TorusGeometry(0.58, 0.045, 10, 48), cyanGlow);
        ahuRing.position.set(-1.62, 1.35, 0);
        ahuRing.rotation.y = Math.PI / 2;
        ahu.add(ahuRing);

        let pipePieces = 0;
        let ductPieces = 0;
        const pipeNetwork = new THREE.Group();
        const ductNetwork = new THREE.Group();
        world.add(pipeNetwork, ductNetwork);

        function updatePieceCount() {
          if (pieceCountEl) pieceCountEl.textContent = String(pipePieces + ductPieces);
        }

        const pipeManager = new THREE.LoadingManager();
        pipeManager.setURLModifier((url) => url.includes('/textures/') ? PIXEL : url);
        const pipeLoader = new GLTFLoader(pipeManager);
        pipeLoader.load(
          PIPE_ASSET_URL,
          (gltf) => {
            const source = new Map<string, THREE.Object3D>();
            gltf.scene.children.forEach((child) => source.set(child.name, child));

            function addPipe(
              name: string,
              position: [number, number, number],
              rotation: [number, number, number],
              scale: number,
              material: THREE.Material,
            ) {
              const original = source.get(name);
              if (!original) return;
              const piece = original.clone(true);
              piece.position.set(...position);
              piece.rotation.set(...rotation);
              piece.scale.setScalar(scale);
              piece.traverse((object) => {
                if (object instanceof THREE.Mesh) {
                  object.material = material;
                  object.castShadow = !mobile;
                  object.receiveShadow = true;
                }
              });
              pipeNetwork.add(piece);
              pipePieces += 1;
            }

            [-7.4, -5.0, -2.6, -0.2].forEach((x) => {
              addPipe('modular_industrial_pipes_01_pipe02', [x, 3.45, -6.1], [0, 0, Math.PI / 2], 1.2, pipeSupply);
              addPipe('modular_industrial_pipes_01_pipe02', [x, 2.35, -5.78], [0, 0, Math.PI / 2], 1.2, pipeReturn);
            });
            [-3.95, -2.4, -0.85, 0.7, 2.25].forEach((x, index) => {
              addPipe('modular_industrial_pipes_01_pipe01', [x, 2.0, -7.15], [0, 0, 0], 1.0, index % 2 ? pipeReturn : pipeSupply);
            });
            [-3.2, -0.9, 1.4].forEach((x) => {
              addPipe('modular_industrial_pipes_01_pipe02', [x, 1.35, -4.4], [0, 0, Math.PI / 2], 1.08, pipeSupply);
            });
            addPipe('modular_industrial_pipes_01_pipe04', [-0.15, 3.35, -6.05], [Math.PI / 2, 0, Math.PI / 2], 1.06, valveMaterial);
            addPipe('modular_industrial_pipes_01_pipe04', [-0.2, 2.3, -5.75], [Math.PI / 2, Math.PI, Math.PI / 2], 1.06, valveMaterial);

            if (pipeStatus) pipeStatus.textContent = 'READY';
            updatePieceCount();
          },
          undefined,
          (error) => {
            console.error('Phase 2.5 pipe network failed to load', error);
            if (pipeStatus) pipeStatus.textContent = 'ERROR';
          },
        );

        const ductLoader = new GLTFLoader();
        ductLoader.load(
          HVAC_ASSET_URL,
          (gltf) => {
            const source = new Map<string, THREE.Object3D>();
            gltf.scene.children.forEach((child) => source.set(child.name, child));

            function addDuct(
              name: string,
              position: [number, number, number],
              rotation: [number, number, number],
              scale = 1.0,
            ) {
              const original = source.get(name);
              if (!original) return;
              const piece = original.clone(true);
              piece.position.set(...position);
              piece.rotation.set(...rotation);
              piece.scale.setScalar(scale);
              piece.traverse((object) => {
                if (object instanceof THREE.Mesh) {
                  object.castShadow = !mobile;
                  object.receiveShadow = true;
                  if (object.material instanceof THREE.MeshStandardMaterial) {
                    object.material = object.material.clone();
                    object.material.roughness = Math.max(0.32, object.material.roughness);
                    object.material.metalness = Math.max(0.58, object.material.metalness);
                  }
                }
              });
              ductNetwork.add(piece);
              ductPieces += 1;
            }

            // Elevated main trunk, aligned left-to-right above the plant.
            [-5.4, -2.7, 0.0, 2.7, 5.4].forEach((x) => {
              addDuct('modular_airduct_circular_triple', [x, 4.75, 2.55], [0, Math.PI / 2, 0], 1.48);
            });

            // Inline fan breaks the trunk visually and makes the system read as ventilation.
            addDuct('modular_airduct_circular_fan', [0.15, 4.75, 2.55], [0, Math.PI / 2, 0], 1.42);

            // Two real bends route branches away from the trunk.
            addDuct('modular_airduct_circular_smooth_bend_quater', [-3.1, 4.75, 2.45], [0, 0, Math.PI / 2], 1.5);
            addDuct('modular_airduct_circular_smooth_bend_quater', [3.15, 4.75, 2.45], [0, Math.PI, Math.PI / 2], 1.5);

            // Branches move toward the rear technical rooms and toward the AHU.
            addDuct('modular_airduct_circular_smooth_triple', [-3.1, 4.75, 0.7], [0, 0, 0], 1.42);
            addDuct('modular_airduct_circular_smooth_double', [-3.1, 4.75, -1.15], [0, 0, 0], 1.42);
            addDuct('modular_airduct_circular_smooth_triple', [3.15, 4.75, 0.7], [0, 0, 0], 1.42);
            addDuct('modular_airduct_circular_smooth_double', [3.15, 4.75, -1.15], [0, 0, 0], 1.42);

            // Vertical drop toward the AHU connection.
            addDuct('modular_airduct_circular_smooth_double', [4.85, 3.25, -0.75], [Math.PI / 2, 0, 0], 1.35);
            addDuct('modular_airduct_circular_smooth_bend_half', [4.85, 2.65, -0.8], [Math.PI / 2, Math.PI / 2, 0], 1.35);

            // Real braces/hangers make the main line feel installed rather than floating.
            [-5.4, -1.8, 1.8, 5.4].forEach((x) => {
              addDuct('modular_airduct_circular_brace', [x, 4.75, 2.55], [0, Math.PI / 2, 0], 1.45);
            });

            if (hvacStatus) hvacStatus.textContent = 'READY';
            updatePieceCount();
          },
          undefined,
          (error) => {
            console.error('Phase 2.5 HVAC network failed to load', error);
            if (hvacStatus) hvacStatus.textContent = 'ERROR';
          },
        );

        // CORE remains deliberately procedural until Phase 3.
        const core = new THREE.Group();
        world.add(core);
        const plinth = new THREE.Mesh(new THREE.CylinderGeometry(2.25, 2.55, 0.45, 56), darkMetal);
        plinth.position.y = 0.22;
        core.add(plinth);
        const coreBody = new THREE.Mesh(new THREE.CylinderGeometry(0.72, 0.96, 4.4, 42), darkMetal);
        coreBody.position.y = 2.65;
        core.add(coreBody);
        const energyColumn = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 3.55, 24), cyanGlow);
        energyColumn.position.y = 2.7;
        core.add(energyColumn);
        const rings: THREE.Mesh[] = [];
        [1.2, 2.35, 3.5, 4.55].forEach((y, index) => {
          const ring = new THREE.Mesh(new THREE.TorusGeometry(1.08 + index * 0.06, 0.035, 8, 64), index % 2 ? blueGlow : cyanGlow);
          ring.rotation.x = Math.PI / 2;
          ring.position.y = y;
          core.add(ring);
          rings.push(ring);
        });
        const halo = new THREE.Mesh(new THREE.TorusGeometry(2, 0.055, 10, 80), cyanGlow);
        halo.rotation.x = Math.PI / 2;
        halo.position.y = 0.55;
        core.add(halo);
        const beacon = new THREE.PointLight(0x00d9ff, mobile ? 13 : 22, 16, 1.65);
        beacon.position.set(0, 3, 0);
        core.add(beacon);

        scene.add(new THREE.HemisphereLight(0x6ebfe0, 0x02050b, 1.28));
        const key = new THREE.DirectionalLight(0xa9dfff, 3.0);
        key.position.set(-7, 13, 9);
        key.castShadow = !mobile;
        scene.add(key);
        const warm = new THREE.PointLight(0xffa85b, 7.5, 17, 2);
        warm.position.set(-8, 5, -5);
        scene.add(warm);
        const pipeAccent = new THREE.PointLight(0x00d9ff, 9, 13, 2);
        pipeAccent.position.set(-4.4, 3.7, -5.1);
        scene.add(pipeAccent);
        const hvacAccent = new THREE.PointLight(0x8bdcff, 11, 16, 2);
        hvacAccent.position.set(0.8, 6.0, 2.4);
        scene.add(hvacAccent);
        const ahuAccent = new THREE.PointLight(0xff9a54, 5.5, 9, 2);
        ahuAccent.position.set(5.0, 3.0, -1.0);
        scene.add(ahuAccent);

        function createConnection(start: THREE.Vector3, end: THREE.Vector3, height = 1) {
          const mid = start.clone().lerp(end, 0.5);
          mid.y += height;
          const curve = new THREE.CatmullRomCurve3([start, mid, end]);
          const tube = new THREE.Mesh(new THREE.TubeGeometry(curve, 28, 0.023, 7, false), cyanGlow);
          world.add(tube);
          const pulse = new THREE.Mesh(new THREE.SphereGeometry(0.058, 10, 10), cyanGlow);
          world.add(pulse);
          return { curve, pulse, offset: Math.random() };
        }

        const connections = [
          createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(-4.7, 1.2, -6.1), 1.2),
          createConnection(new THREE.Vector3(0, 0.65, 0), new THREE.Vector3(-0.6, 0.9, -4.1), 0.8),
          createConnection(new THREE.Vector3(0, 1.0, 0), new THREE.Vector3(0, 4.7, 2.55), 1.8),
          createConnection(new THREE.Vector3(0, 1.0, 0), new THREE.Vector3(5.6, 2.2, -0.8), 1.25),
        ];

        const particleCount = mobile ? 150 : 360;
        const positions = new Float32Array(particleCount * 3);
        for (let i = 0; i < particleCount; i += 1) {
          positions[i * 3] = (Math.random() - 0.5) * 44;
          positions[i * 3 + 1] = Math.random() * 10 + 0.3;
          positions[i * 3 + 2] = (Math.random() - 0.5) * 32;
        }
        const particleGeometry = new THREE.BufferGeometry();
        particleGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        const particles = new THREE.Points(
          particleGeometry,
          new THREE.PointsMaterial({ color: 0x5fcde8, size: 0.024, transparent: true, opacity: 0.28, depthWrite: false }),
        );
        world.add(particles);

        // Camera first reads the mechanical level, then rises to inspect HVAC.
        const cameraPath = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-14.5, 8.0, 19.0),
          new THREE.Vector3(-8.8, 5.8, 10.8),
          new THREE.Vector3(-7.0, 3.7, -1.8),
          new THREE.Vector3(-4.6, 4.8, -7.5),
          new THREE.Vector3(-5.2, 6.2, 4.8),
          new THREE.Vector3(2.4, 6.5, 7.0),
          new THREE.Vector3(9.5, 5.2, -0.5),
          new THREE.Vector3(2.0, 6.6, -10.5),
        ]);
        const targetPath = new THREE.CatmullRomCurve3([
          new THREE.Vector3(0, 2.0, 0),
          new THREE.Vector3(0, 2.7, 0),
          new THREE.Vector3(-4.6, 2.3, -6.0),
          new THREE.Vector3(-0.8, 1.4, -5.6),
          new THREE.Vector3(-2.5, 4.7, 2.5),
          new THREE.Vector3(1.8, 4.7, 1.8),
          new THREE.Vector3(5.3, 3.2, -0.8),
          new THREE.Vector3(0, 3.0, 0),
        ]);

        const state = { progress: 0 };
        const chapters = Array.from(document.querySelectorAll('.chapter'));
        ScrollTrigger.create({
          trigger: '#story',
          start: 'top top',
          end: 'bottom bottom',
          scrub: reducedMotion ? false : 1.05,
          onUpdate: (self) => {
            state.progress = self.progress;
            const active = Math.min(chapters.length - 1, Math.floor(self.progress * chapters.length));
            chapters.forEach((chapter, index) => chapter.classList.toggle('active', index === active));
          },
        });

        const clock = new THREE.Clock();
        let frames = 0;
        let fpsStart = performance.now();
        let raf = 0;
        let visible = true;

        function render(now = performance.now()) {
          const elapsed = clock.getElapsedTime();
          const progress = reducedMotion ? 0.56 : THREE.MathUtils.clamp(state.progress, 0.001, 0.999);
          const camPos = cameraPath.getPointAt(progress);
          const target = targetPath.getPointAt(progress);
          camera.position.lerp(camPos, reducedMotion ? 1 : 0.075);
          camera.lookAt(target);

          core.rotation.y = elapsed * 0.05;
          halo.rotation.z = elapsed * 0.16;
          rings.forEach((ring, index) => {
            ring.rotation.z = elapsed * (0.11 + index * 0.02) * (index % 2 ? -1 : 1);
          });
          particles.rotation.y = elapsed * 0.004;
          modules.forEach((module, index) => {
            module.position.y = Math.sin(elapsed * 0.5 + index) * 0.008;
          });
          connections.forEach(({ curve, pulse, offset }, index) => {
            pulse.position.copy(curve.getPointAt((elapsed * (0.11 + index * 0.01) + offset) % 1));
          });

          composer.render();

          frames += 1;
          if (now - fpsStart >= 1000) {
            if (fpsEl) fpsEl.textContent = String(Math.round((frames * 1000) / (now - fpsStart)));
            if (trisEl) trisEl.textContent = renderer.info.render.triangles.toLocaleString();
            frames = 0;
            fpsStart = now;
          }

          if (visible) raf = requestAnimationFrame(render);
        }

        function resize() {
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, window.innerWidth <= 760 ? 1.1 : 1.45));
          renderer.setSize(window.innerWidth, window.innerHeight);
          composer.setSize(window.innerWidth, window.innerHeight);
        }

        window.addEventListener('resize', resize, { passive: true });
        document.addEventListener('visibilitychange', () => {
          visible = !document.hidden;
          if (visible) {
            cancelAnimationFrame(raf);
            clock.getDelta();
            fpsStart = performance.now();
            frames = 0;
            render();
          }
        });

        render();
      }
    </script>
  </body>
</html>


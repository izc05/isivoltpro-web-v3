---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';

export function getStaticPaths() {
  return [
    { params: { section: 'precios' }, props: { title: 'Planes V4', eyebrow: 'Comprar sin complicaciones', lead: 'Revisaremos planes, alcance y crecimiento para explicar mejor qué incluye cada nivel y evitar sensación de suite sobredimensionada.', publicPath: 'precios/' } },
    { params: { section: 'acceso' }, props: { title: 'Acceso V4', eyebrow: 'Entrada clara y segura', lead: 'La futura pantalla de acceso mantendrá la separación entre la web comercial y las superficies privadas, sin fingir autenticación ni persistencia en GitHub Pages.', publicPath: 'acceso/' } },
    { params: { section: 'demo' }, props: { title: 'Demo V4', eyebrow: 'Conversión comercial', lead: 'La demo será una ruta corta y convincente para explicar qué verá el cliente, qué necesitamos conocer de su caso y cuál es el siguiente paso.', publicPath: 'demo/' } },
  ];
}

const { title, eyebrow, lead, publicPath } = Astro.props;
const base = import.meta.env.BASE_URL;
const previewRoot = `${base}preview-v4/`;
const publicUrl = `${base}${publicPath}`;
const homePreview = `${base}preview-v4/home/`;
const productPreview = `${base}preview-v4/producto/`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title={`${title} · IsiVoltPro`} description={lead} path={Astro.url.pathname} noindex={true} />
  <style is:inline>
    .v4p-strip{background:#111827;color:#fff;border-bottom:1px solid #263044}.v4p-strip .page-shell{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:12px}.v4p-strip a{color:#dfe7ff;font-weight:800}.v4p-hero{padding:92px 0 66px;background:radial-gradient(circle at 77% 10%,rgba(109,74,255,.12),transparent 28%),radial-gradient(circle at 91% 58%,rgba(36,197,140,.09),transparent 24%),#fff}.v4p-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(400px,.78fr);gap:54px;align-items:center}.v4p-hero h1{max-width:760px;margin:18px 0 18px;font:800 clamp(52px,6vw,80px)/.98 Manrope,sans-serif;letter-spacing:-.062em}.v4p-hero p{max-width:720px;margin:0;color:#67738a;font-size:18px;line-height:1.72}.v4p-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.v4p-board{padding:26px;border:1px solid #e6e9f1;border-radius:28px;background:linear-gradient(145deg,#fff,#f9faff);box-shadow:0 25px 70px rgba(54,64,102,.11)}.v4p-board small{display:block;color:#7f8aa0;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.v4p-board h2{margin:13px 0 10px;font-size:28px}.v4p-board p{margin:0;color:#748096;line-height:1.62}.v4p-list{display:grid;gap:10px;margin-top:20px}.v4p-list span{display:flex;gap:9px;align-items:flex-start;color:#3e4a63;font-size:13px;font-weight:700}.v4p-list span:before{content:'✓';color:#168965}.v4p-note{padding:38px 0 84px}.v4p-note__box{padding:24px;border:1px dashed #d9deea;border-radius:22px;background:#fafbfe;color:#67738a;line-height:1.7}.v4p-note__box strong{color:#26324a}@media(max-width:900px){.v4p-grid{grid-template-columns:1fr}}@media(max-width:680px){.v4p-hero{padding:62px 0 48px}.v4p-hero h1{font-size:clamp(44px,13vw,62px)}.v4p-strip .page-shell{padding:8px 0;align-items:flex-start;flex-direction:column;gap:4px}}
  </style>
</head>
<body>
  <V3CommercialHeader />
  <div class="v4p-strip"><div class="page-shell"><strong>Preview V4 · Pantalla en revisión</strong><span><a href={previewRoot}>Mapa completo V4</a></span></div></div>
  <main class="page-main">
    <section class="v4p-hero"><div class="page-shell v4p-grid"><div><span class="eyebrow">{eyebrow}</span><h1>{title}</h1><p>{lead}</p><div class="v4p-actions"><a class="btn btn--primary" href={homePreview}>Ver Home V4 →</a><a class="btn" href={productPreview}>Ver Producto V4</a></div></div><aside class="v4p-board"><small>Estado de esta pantalla</small><h2>Preparada para el siguiente pase</h2><p>No es una página final todavía. Está dentro de la navegación V4 para que puedas recorrer toda la web sin salir del laboratorio mientras la rediseñamos pantalla por pantalla.</p><div class="v4p-list"><span>Copy comercial específico</span><span>Fotografía técnica adecuada al contexto</span><span>UI realista donde aporte valor</span><span>CTA, móvil, SEO y rendimiento</span></div></aside></div></section>
    <section class="v4p-note"><div class="page-shell"><div class="v4p-note__box"><strong>Comparación:</strong> mientras trabajamos esta pantalla puedes abrir <a href={publicUrl}>la versión pública actual</a>. Cuando la V4 esté terminada, esta ruta dejará de ser un marcador y mostrará la propuesta completa antes de sustituir producción.</div></div></section>
  </main>
  <V3CommercialFooter />
</body>
</html>
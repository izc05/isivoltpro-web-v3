---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
const base=import.meta.env.BASE_URL;
const plans=`${base}preview-v4/precios/`;
const contact=`${base}preview-v4/contacto/`;
const pilot=`${base}piloto/`;
const product=`${base}preview-v4/producto/`;
const qrPhoto=`${base}media/v4/app-qr-mobile.webp`;
const steps=[
 ['01','Aviso','Qué ocurre, dónde, prioridad y activo relacionado.'],
 ['02','OT','Responsable, estado y contexto para actuar.'],
 ['03','Campo','QR/NFC, móvil, fotos, notas y materiales.'],
 ['04','Cierre','Resultado, evidencias y trabajo realizado.'],
 ['05','Histórico','La siguiente intervención no empieza de cero.'],
];
---
<!doctype html><html lang="es"><head>
<V3Seo title="Demo V4 · IsiVoltPro" description="Preview V4 de la experiencia de demo de IsiVoltPro: un recorrido corto por aviso, OT, trabajo en campo, cierre e histórico, sin recopilar datos personales." path={`${base}preview-v4/demo/`} noindex={true}/>
<style is:inline>
.strip{background:#0d1730;color:#fff}.strip .page-shell{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:12px}.strip a{color:#dfe7ff;font-weight:800}.hero{padding:86px 0 72px;background:radial-gradient(circle at 78% 12%,rgba(47,104,255,.13),transparent 28%),radial-gradient(circle at 91% 62%,rgba(228,57,167,.09),transparent 23%),#fff}.hero-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(480px,1.1fr);gap:58px;align-items:center}.hero h1{margin:18px 0 20px;font:800 clamp(52px,5.8vw,82px)/.97 Manrope,sans-serif;letter-spacing:-.065em}.hero p{max-width:660px;color:#68748a;font-size:18px;line-height:1.72}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.promise{padding:28px;border:1px solid #e5e9f2;border-radius:30px;background:linear-gradient(145deg,#fff,#f8faff);box-shadow:0 30px 80px rgba(50,61,105,.13)}.promise small{font-weight:900;color:#6652d9;text-transform:uppercase;letter-spacing:.08em}.promise h2{margin:13px 0 10px;font-size:31px;letter-spacing:-.04em}.promise p{margin:0;color:#748096;font-size:14px}.promise-list{display:grid;gap:11px;margin-top:20px}.promise-list span{padding:13px 14px;border:1px solid #e9ecf3;border-radius:14px;background:#fff;color:#425069;font-size:12px;font-weight:800}.promise-list span:before{content:'✓';margin-right:9px;color:#18a979}.paths{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.path{display:flex;flex-direction:column;padding:26px;border:1px solid #e5e9f2;border-radius:24px;background:#fff;box-shadow:0 15px 40px rgba(54,64,102,.06)}.path b{display:grid;place-items:center;width:40px;height:40px;border-radius:13px;background:#eef3ff;color:#3768e8}.path:nth-child(2) b{background:#f2edff;color:#8246da}.path:nth-child(3) b{background:#eafaf6;color:#169f83}.path h3{margin:17px 0 8px;font-size:22px}.path p{margin:0;color:#758197;line-height:1.6;font-size:13px}.path .btn{margin-top:auto;padding-top:12px}.journey{display:grid;grid-template-columns:repeat(5,1fr);gap:13px}.step{position:relative;padding:22px 18px;border:1px solid #e5e9f2;border-radius:22px;background:linear-gradient(180deg,#fff,#fbfcff);box-shadow:0 13px 34px rgba(54,64,102,.055)}.step b{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#eef3ff;color:#2f68ff}.step:nth-child(2) b{background:#f3edff;color:#8b42e8}.step:nth-child(3) b{background:#fff0f8;color:#e539a7}.step:nth-child(4) b{background:#fff2ec;color:#ff7845}.step:nth-child(5) b{background:#eafaf6;color:#159e86}.step strong{display:block;margin-top:18px;font-size:19px}.step small{display:block;margin-top:7px;color:#788499;line-height:1.5}.field{display:grid;grid-template-columns:1fr 1fr;gap:38px;align-items:center}.field-photo{position:relative;overflow:hidden;border-radius:30px;box-shadow:0 26px 68px rgba(45,59,98,.13)}.field-photo img{display:block;width:100%;height:410px;object-fit:cover}.field-photo span{position:absolute;left:18px;bottom:18px;padding:8px 11px;border-radius:999px;background:rgba(13,23,48,.82);color:#fff;font-size:10px;font-weight:850}.field-copy h2{margin:14px 0;font:800 clamp(38px,4.5vw,58px)/1.03 Manrope,sans-serif;letter-spacing:-.052em}.field-copy p{color:#718096;line-height:1.72}.guard{display:grid;grid-template-columns:1.05fr .95fr;gap:18px}.guard-main{padding:34px;border-radius:30px;background:linear-gradient(125deg,#0e1830,#1b2d58 58%,#342676);color:#fff}.guard-main h2{margin:14px 0 12px;font:800 clamp(36px,4.2vw,54px)/1.03 Manrope,sans-serif;letter-spacing:-.05em}.guard-main p{color:#c7d1e7;line-height:1.7}.guard-side{display:grid;gap:12px}.guard-side article{padding:22px;border:1px solid #e5e9f2;border-radius:22px;background:#fff}.guard-side strong{display:block}.guard-side p{margin:7px 0 0;color:#788499;font-size:12px;line-height:1.55}.cta{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;padding:40px;border-radius:30px;background:linear-gradient(115deg,#f2f7ff,#f4f0ff 48%,#effaf6)}.cta h2{margin:0;font:800 clamp(34px,4vw,50px)/1.04 Manrope,sans-serif;letter-spacing:-.048em}.cta p{margin:11px 0 0;color:#6f7b90;line-height:1.65}@media(max-width:980px){.hero-grid,.field,.guard,.cta{grid-template-columns:1fr}.journey{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.paths,.journey{grid-template-columns:1fr}.hero{padding:58px 0 48px}.hero h1{font-size:clamp(44px,13vw,62px)}.field-photo img{height:330px}.strip .page-shell{padding:8px 0;flex-direction:column;align-items:flex-start;gap:4px}.guard-main,.cta{padding:28px 22px}}
</style></head><body>
<V3CommercialHeader/>
<div class="strip"><div class="page-shell"><strong>Preview V4 · Fase 8 · Demo</strong><span>Ver → entender → decidir · <a href={`${base}preview-v4/`}>Mapa V4</a></span></div></div>
<main class="page-main">
<section class="hero"><div class="page-shell hero-grid"><div><span class="eyebrow">Una demo debe ayudarte a decidir</span><h1>Ve el flujo.<br/><span class="gradient-text">Sin registrarte ni dejar datos.</span></h1><p>Primero entiende cómo conecta IsiVoltPro un aviso con la orden, el técnico, las evidencias y el histórico. Después decides si tiene sentido hablar de tu caso.</p><div class="actions"><a class="btn btn--primary" href="#recorrido">Ver recorrido →</a><a class="btn" href={product}>Revisar Producto V4</a></div></div><aside class="promise"><small>Contrato de esta demo</small><h2>60 segundos para entender la idea.</h2><p>La preview no solicita datos personales ni simula que exista un canal comercial conectado cuando todavía no lo hay.</p><div class="promise-list"><span>Datos y ejemplos claramente ficticios</span><span>Sin alta, cookies comerciales ni tracking</span><span>Salida clara hacia piloto o contacto</span></div></aside></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Tres caminos, una decisión</span><h2>Elige cuánto quieres<br/><span class="gradient-text">profundizar ahora.</span></h2></div><p>No todo visitante necesita una llamada. La V4 separa exploración, piloto y contacto para reducir fricción.</p></div><div class="paths"><article class="path"><b>01</b><h3>Recorrido rápido</h3><p>Entiende aviso, OT, QR/NFC, cierre e histórico sin aportar ningún dato.</p><a class="btn" href="#recorrido">Ver el flujo →</a></article><article class="path"><b>02</b><h3>Piloto controlado</h3><p>Para validar un problema concreto con alcance, salida y criterios de éxito definidos.</p><a class="btn" href={pilot}>Cómo funciona un piloto →</a></article><article class="path"><b>03</b><h3>Hablar de tu caso</h3><p>La página de contacto explica qué información será útil cuando el canal real esté operativo.</p><a class="btn" href={contact}>Ver Contacto V4 →</a></article></div></div></section>
<section class="page-section" id="recorrido"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Recorrido de producto</span><h2>Del aviso al histórico.<br/><span class="gradient-text">El contexto viaja con el trabajo.</span></h2></div><p>Esta secuencia es la promesa central del producto: registrar una vez, trabajar con contexto y conservar lo aprendido.</p></div><div class="journey">{steps.map(([n,title,copy])=><article class="step"><b>{n}</b><strong>{title}</strong><small>{copy}</small></article>)}</div></div></section>
<section class="page-section page-section--soft"><div class="page-shell field"><figure class="field-photo"><img src={qrPhoto} alt="Técnico usando el móvil para identificar mediante QR un equipo de mantenimiento" loading="lazy" width="900" height="506"/><span>QR / NFC · contexto junto al activo</span></figure><div class="field-copy"><span class="eyebrow">La demo también debe parecerse al trabajo real</span><h2>Del escritorio al equipo que tienes delante.</h2><p>Una buena demostración no consiste en enseñar veinte menús. Debe mostrar qué cambia para el técnico y para quien coordina cuando ambos ven el mismo activo, la misma OT y el mismo histórico.</p><div class="actions"><a class="btn btn--primary" href={plans}>Ver Planes V4 →</a></div></div></div></section>
<section class="page-section"><div class="page-shell guard"><div class="guard-main"><span class="eyebrow">Conversión sin engaños</span><h2>No fingimos una infraestructura comercial que todavía no está conectada.</h2><p>Mientras el backend de captación no esté operativo, la preview explica el siguiente paso pero no almacena formularios, correos ni datos. La confianza también consiste en enseñar los límites actuales.</p></div><div class="guard-side"><article><strong>Formulario real: no activo</strong><p>La web estática no debe aparentar que envía solicitudes.</p></article><article><strong>Autenticación: separada</strong><p>La zona comercial no inventa sesiones ni acceso de clientes.</p></article><article><strong>Datos de demo: ejemplos</strong><p>Las cifras mostradas sirven para explicar interfaz, no son métricas de clientes.</p></article></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="cta"><div><h2>¿Te encaja el flujo?</h2><p>El siguiente paso es elegir el tamaño de implantación o revisar qué necesitaremos cuando activemos el canal de contacto real.</p></div><div class="actions" style="margin-top:0"><a class="btn btn--primary" href={plans}>Ver planes →</a><a class="btn" href={contact}>Contacto V4</a></div></div></div></section>
</main><V3CommercialFooter/></body></html>
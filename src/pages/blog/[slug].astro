---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
import { v3BlogCategoryLabel, v3BlogFeed } from '../../data/v3-blog-feed';

export function getStaticPaths() {
  return v3BlogFeed.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const blog = `${base}blog/`;
const formatDate = (value: string) => new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${value.slice(0, 10)}T12:00:00`));
const absoluteArticle = new URL(`${base}blog/${post.slug}/`, Astro.site ?? Astro.url.origin).toString();
const source = 'source' in post ? post.source : undefined;
const regulationState = 'regulationState' in post ? post.regulationState : undefined;
const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt,
  author: { '@type': 'Organization', name: post.author },
  publisher: { '@type': 'Organization', name: 'IsiVoltPro' },
  mainEntityOfPage: absoluteArticle,
  keywords: post.keywords.join(', '),
  ...(source ? { citation: source.url, isBasedOn: source.url } : {}),
});
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title={`${post.title} · IsiVoltPro`} description={post.description} path={`${base}blog/${post.slug}/`} />
  <script is:inline type="application/ld+json" set:html={articleSchema}></script>
  <style is:inline>
    .article-hero{padding:74px 0 52px;background:radial-gradient(circle at 80% 18%,rgba(101,83,220,.11),transparent 27%),radial-gradient(circle at 93% 65%,rgba(45,188,141,.08),transparent 20%),#fff}.article-shell{width:min(1060px,calc(100% - 32px));margin:0 auto}.article-head{display:grid;grid-template-columns:.92fr 1.08fr;gap:50px;align-items:center}.article-kicker{display:flex;gap:9px;flex-wrap:wrap;align-items:center;color:#6654da;font-size:10px;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.article-kicker time,.article-kicker span:last-child{color:#8b95a7;letter-spacing:0;text-transform:none}.article-hero h1{margin:14px 0 17px;font:800 clamp(43px,5vw,66px)/1 var(--v3-font-display,system-ui);letter-spacing:-.058em}.article-hero p{margin:0;color:#707c90;font-size:16px;line-height:1.72}.article-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.article-media{padding:14px;border:1px solid #e5e9f1;border-radius:28px;background:#fff;box-shadow:0 24px 65px rgba(56,65,104,.1)}.article-media img{display:block;width:100%;height:auto;border-radius:19px}.article-body{padding:64px 0 76px;background:#fff}.article-layout{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:54px;align-items:start}.article-copy{max-width:720px}.article-copy section+section{margin-top:46px}.article-copy h2{margin:0 0 14px;font-size:30px;line-height:1.08;letter-spacing:-.04em}.article-copy p{margin:0 0 14px;color:#4e5a70;font-size:16px;line-height:1.78}.article-copy ul{margin:18px 0 0;padding:0;list-style:none;display:grid;gap:11px}.article-copy li{display:grid;grid-template-columns:24px 1fr;gap:10px;color:#4f5b70;line-height:1.6}.article-copy li::before{content:'✓';display:grid;place-items:center;width:22px;height:22px;border-radius:7px;background:#ecf8f3;color:#15956c;font-size:11px;font-weight:900}.article-side{position:sticky;top:92px;display:grid;gap:14px}.article-panel{padding:18px;border:1px solid #e6eaf2;border-radius:20px;background:linear-gradient(145deg,#fff,#fafbff)}.article-panel--source{border-color:#dce8e3;background:linear-gradient(145deg,#fff,#f4fbf8)}.article-panel small{display:block;color:#929baa;font-size:9px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.article-panel strong{display:block;margin-top:7px;font-size:15px;line-height:1.35}.article-panel p{margin:7px 0 0;color:#778297;font-size:10px;line-height:1.5}.article-panel ul{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:8px}.article-panel a{color:#5748ce;text-decoration:none;font-size:12px;font-weight:800}.source-link{display:inline-flex!important;margin-top:11px}.source-state{display:inline-flex;margin-top:10px;padding:5px 8px;border-radius:999px;background:#fff3d9;color:#806018;font-size:9px;font-weight:900;text-transform:uppercase}.article-takeaway{margin-top:48px;padding:25px;border-radius:24px;background:#111827;color:#fff}.article-takeaway small{display:block;color:#9fb0d2;font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.article-takeaway h2{margin:8px 0 0;color:#fff;font-size:28px}.article-back{display:inline-flex;color:#5f51d2;text-decoration:none;font-size:12px;font-weight:900}@media(max-width:900px){.article-head,.article-layout{grid-template-columns:1fr}.article-side{position:static}.article-copy{max-width:none}}@media(max-width:580px){.article-hero{padding:52px 0 42px}.article-hero h1{font-size:clamp(39px,12vw,52px)}.article-body{padding-top:48px}.article-copy h2{font-size:27px}.article-copy p{font-size:15px}}
  </style>
</head>
<body>
<V3CommercialHeader />
<main class="page-main">
  <section class="article-hero"><div class="article-shell article-head"><div><div class="article-kicker"><span>{v3BlogCategoryLabel[post.category]}</span><time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time><span>{post.readMinutes} min de lectura</span></div><h1>{post.title}</h1><p>{post.excerpt}</p><div class="article-actions"><a class="btn" href={blog}>← Volver al blog</a><a class="btn btn--primary" href={`${base}experiencia/`}>Ver IsiVoltPro en acción →</a></div></div><div class="article-media"><img src={`${base}${post.image.replace(/^\/+/, '')}`} alt={post.imageAlt} width="960" height="540" /></div></div></section>

  <section class="article-body"><div class="article-shell article-layout"><article class="article-copy">{post.sections.map((section) => <section><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}</section>)}<aside class="article-takeaway"><small>Idea clave</small><h2>{post.takeaway}</h2></aside></article><aside class="article-side">{source && <div class="article-panel article-panel--source"><small>Fuente verificada</small><strong>{source.name}</strong><p>Fuente publicada: {formatDate(source.publishedAt)}<br/>Comprobada: {formatDate(source.checkedAt)}</p>{regulationState && <span class="source-state">{regulationState}</span>}<a class="source-link" href={source.url} rel="noreferrer">Abrir fuente original →</a></div>}<div class="article-panel"><small>Publicado por</small><strong>{post.author}</strong></div><div class="article-panel"><small>Seguir explorando</small><ul>{post.relatedRoutes.map((item) => <li><a href={`${base}${item.href.replace(/^\/+/, '')}`}>{item.label} →</a></li>)}</ul></div><a class="article-back" href={blog}>Ver todos los artículos →</a></aside></div></section>
</main>
<V3CommercialFooter />
</body>
</html>

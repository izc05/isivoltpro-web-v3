---
import '../styles/v4-entry-minimal.css';
import V3Brand from './V3Brand.astro';

interface Props {
  accessHref: string;
  demoHref: string;
}

const base = import.meta.env.BASE_URL;
const introArtwork = `${base}media/isivoltpro-entry-static-approved.webp`;
---
<div class="intro entry3d" id="intro" aria-label="Presentación de IsiVoltPro">
  <img
    class="entry3d__static-art"
    src={introArtwork}
    alt="Presentación visual de IsiVoltPro"
    width="1440"
    height="740"
    loading="eager"
    decoding="sync"
    fetchpriority="high"
  />
  <div class="entry3d__brand" aria-label="IsiVoltPro"><V3Brand context="intro" /></div>
  <button class="intro__skip entry3d__skip" id="skip-intro" type="button">Saltar intro</button>
</div>

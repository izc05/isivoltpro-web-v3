---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#02040a" />
    <meta name="description" content="ISIVOLTPRO phase 2.7 industrial 3D scene with real mechanical, HVAC, electrical and exterior HVAC equipment." />
    <title>ISIVOLTPRO · Phase 2.7</title>
  </head>
  <body>
    <canvas id="webgl" aria-hidden="true"></canvas>

    <header class="topbar">
      <a class="brand" href={base}>ISIVOLT<strong>PRO</strong></a>
      <span class="phase">FASE 2.7 / REAL HVAC EQUIPMENT</span>
      <a class="back" href={`${base}lab-3d-phase26/`}>BACK TO 2.6</a>
    </header>

    <aside class="metrics" aria-live="polite">
      <div><span>PIPES</span><strong id="pipe-status">LOADING</strong></div>
      <div><span>DUCTS</span><strong id="hvac-status">LOADING</strong></div>
      <div><span>HVAC UNIT</span><strong id="aircon-status">LOADING</strong></div>
      <div><span>ELECTRICAL</span><strong id="electrical-status">LOADING</strong></div>
      <div><span>REAL PIECES</span><strong id="piece-count">--</strong></div>
      <div><span>FPS</span><strong id="fps">--</strong></div>
      <div><span>TRIS</span><strong id="tris">--</strong></div>
    </aside>

    <main id="story">
      <section class="chapter active"><div class="copy">
        <p class="eyebrow">INDUSTRIAL DIGITAL TWIN</p>
        <h1>Infrastructure<br />becomes equipment.</h1>
        <p class="body-copy">Real pipe, duct and electrical assets remain while one real exterior HVAC machine enters the installation.</p>
        <span class="scroll-hint">SCROLL THROUGH THE PLANT <i>↓</i></span>
      </div></section>

      <section class="chapter"><div class="copy right-copy">
        <p class="index">02 / MECHANICAL</p><p class="eyebrow">PIPES · PUMPS · TANKS</p>
        <h2>Water remains<br />at plant level.</h2>
        <p class="body-copy">The modular mechanical network remains the lower physical service layer.</p>
      </div></section>

      <section class="chapter"><div class="copy">
        <p class="index">03 / AIR</p><p class="eyebrow">DUCTS · FAN · INDOOR MODULE</p>
        <h2>Ventilation stays<br />overhead.</h2>
        <p class="body-copy">The circular duct network remains separate from the refrigeration circuit.</p>
      </div></section>

      <section class="chapter"><div class="copy right-copy">
        <p class="index">04 / HVAC EQUIPMENT</p><p class="eyebrow">OUTDOOR UNIT · REFRIGERANT LINES</p>
        <h2>A real machine<br />enters the plant.</h2>
        <p class="body-copy">A clean CC0 exterior air-conditioning unit is installed on a service pad and linked to the indoor module by a two-line refrigeration circuit.</p>
      </div></section>

      <section class="chapter"><div class="copy">
        <p class="index">05 / ELECTRICAL</p><p class="eyebrow">DISTRIBUTION · PANELS · STATUS</p>
        <h2>Power keeps<br />its own bay.</h2>
        <p class="body-copy">The real utility cabinets from Phase 2.6 remain connected digitally to the Core.</p>
      </div></section>

      <section class="chapter"><div class="copy end-copy">
        <p class="index">06 / CHECKPOINT</p><p class="eyebrow">PHASE 2.7</p>
        <h2>Three systems.<br />Real HVAC equipment.</h2>
        <a class="lab-button" href={`${base}lab-3d-phase26/`}>COMPARE WITH 2.6 <span>→</span></a>
      </div></section>
    </main>

    <div id="no-webgl" hidden><strong>3D unavailable</strong><p>This checkpoint needs WebGL.</p><a href={base}>Return home</a></div>

    <script>
      import * as THREE from 'three';
      import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
      import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
      import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
      import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';
      import { OutputPass } from 'three/examples/jsm/postprocessing/OutputPass.js';
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const PIPE_ASSET_URL = 'https://raw.githubusercontent.com/KrazIvan/GodotVR_Test/6dc918140151c3235406a3f616a765e11293285a/Ivan%20VR/models/props/pipe/modular_industrial_pipes_01_4k.gltf';
      const HVAC_ASSET_URL = 'https://raw.githubusercontent.com/Hona/daxship/d63856c6af9aba445a4fe8bf832d0e0ecf2572e5/apps/web/public/assets/models/environment/poly-haven/modular_airduct_circular_01/modular_airduct_circular_01_1k.gltf';
      const ELECTRICAL_ASSET_URL = 'https://raw.githubusercontent.com/adamkhatib/PeakBrake/87be08e1b90a6cfc59cd7364488cdca9053a16a3/public/assets/3d/polyhaven/utility_box_01/utility_box_01_1k.gltf';
      const AIRCON_ASSET_URL = 'https://raw.githubusercontent.com/VoxogoBrusch/the-levels/1e7c37785504d23d9a2f669b3b922eac14cedb01/public/assets/models/exterior_aircon_unit/exterior_aircon_unit_1k.gltf';
      const PIXEL = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Y9Zf6AAAAAASUVORK5CYII=';

      const canvas = document.querySelector('#webgl');
      const pipeStatus = document.querySelector('#pipe-status');
      const hvacStatus = document.querySelector('#hvac-status');
      const airconStatus = document.querySelector('#aircon-status');
      const electricalStatus = document.querySelector('#electrical-status');
      const pieceCountEl = document.querySelector('#piece-count');
      const fpsEl = document.querySelector('#fps');
      const trisEl = document.querySelector('#tris');
      const noWebgl = document.querySelector('#no-webgl');

      const supportsWebGL = (() => {
        try {
          const test = document.createElement('canvas');
          return Boolean(test.getContext('webgl2') || test.getContext('webgl'));
        } catch { return false; }
      })();

      if (!supportsWebGL || !(canvas instanceof HTMLCanvasElement)) {
        if (canvas) canvas.remove();
        if (noWebgl instanceof HTMLElement) noWebgl.hidden = false;
      } else {
        const mobile = window.matchMedia('(max-width: 760px)').matches;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const renderer = new THREE.WebGLRenderer({ canvas, antialias: false, powerPreference: 'high-performance', stencil: false });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, mobile ? 1.0 : 1.35));
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 0.96;
        renderer.shadowMap.enabled = !mobile;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;

        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x02040a);
        scene.fog = new THREE.FogExp2(0x02040a, 0.025);
        const camera = new THREE.PerspectiveCamera(42, window.innerWidth / window.innerHeight, 0.1, 145);
        camera.position.set(-14, 8, 19);

        const composer = new EffectComposer(renderer);
        composer.addPass(new RenderPass(scene, camera));
        composer.addPass(new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), mobile ? 0.25 : 0.45, 0.42, 0.86));
        composer.addPass(new OutputPass());

        const world = new THREE.Group();
        scene.add(world);
        const darkMetal = new THREE.MeshStandardMaterial({ color: 0x111925, metalness: 0.74, roughness: 0.36 });
        const darkPanel = new THREE.MeshStandardMaterial({ color: 0x07101a, metalness: 0.5, roughness: 0.54 });
        const concrete = new THREE.MeshStandardMaterial({ color: 0x090e14, metalness: 0.08, roughness: 0.9 });
        const pipeSupply = new THREE.MeshStandardMaterial({ color: 0x71818b, metalness: 0.9, roughness: 0.28 });
        const pipeReturn = new THREE.MeshStandardMaterial({ color: 0x445863, metalness: 0.82, roughness: 0.34 });
        const copper = new THREE.MeshStandardMaterial({ color: 0x8d5b3e, metalness: 0.88, roughness: 0.3 });
        const insulated = new THREE.MeshStandardMaterial({ color: 0x1e3440, metalness: 0.25, roughness: 0.58 });
        const cyanGlow = new THREE.MeshStandardMaterial({ color: 0x063b50, emissive: 0x00d9ff, emissiveIntensity: 3.0, metalness: 0.5, roughness: 0.22 });
        const blueGlow = new THREE.MeshStandardMaterial({ color: 0x031b38, emissive: 0x0879ff, emissiveIntensity: 2.15, metalness: 0.62, roughness: 0.24 });
        const electricGlow = new THREE.MeshStandardMaterial({ color: 0x2b2506, emissive: 0xffc928, emissiveIntensity: 2.5, metalness: 0.42, roughness: 0.3 });

        const floor = new THREE.Mesh(new THREE.PlaneGeometry(64, 48), concrete);
        floor.rotation.x = -Math.PI / 2;
        floor.position.y = -0.05;
        floor.receiveShadow = true;
        world.add(floor);
        const grid = new THREE.GridHelper(64, 64, 0x17455b, 0x0b1c27);
        grid.position.y = 0.01;
        grid.material.transparent = true;
        grid.material.opacity = 0.15;
        world.add(grid);

        function makeBuilding(x: number, z: number, w: number, d: number, h: number) {
          const group = new THREE.Group();
          group.position.set(x, 0, z);
          const body = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), darkPanel);
          body.position.y = h / 2;
          body.castShadow = !mobile;
          body.receiveShadow = true;
          group.add(body);
          const strip = new THREE.Mesh(new THREE.BoxGeometry(w * 0.68, 0.05, 0.04), cyanGlow);
          strip.position.set(0, h * 0.72, d / 2 + 0.025);
          group.add(strip);
          world.add(group);
          return group;
        }

        const modules = [
          makeBuilding(-8.4, -2.4, 5.0, 4.2, 3.1), makeBuilding(-7.6, 5.4, 5.8, 4.4, 2.6),
          makeBuilding(8.1, -4.5, 5.4, 5.0, 3.7), makeBuilding(7.5, 4.7, 6.0, 4.2, 2.8), makeBuilding(0.4, 8.5, 6.6, 3.0, 2.2),
        ];

        const tankGroup = new THREE.Group();
        tankGroup.position.set(-1.0, 0, -8.0);
        world.add(tankGroup);
        [-3.0, -1.45, 0.1, 1.65, 3.2].forEach((x, index) => {
          const tank = new THREE.Mesh(new THREE.CylinderGeometry(0.52 + (index % 2) * 0.08, 0.52 + (index % 2) * 0.08, 2.45 + (index % 3) * 0.22, 24), darkMetal);
          tank.position.set(x, 1.28, 0);
          tank.castShadow = !mobile;
          tankGroup.add(tank);
        });

        const pumpGroup = new THREE.Group();
        pumpGroup.position.set(-0.6, 0, -4.1);
        world.add(pumpGroup);
        [-2.7, -0.9, 0.9, 2.7].forEach((x, index) => {
          const basePlate = new THREE.Mesh(new THREE.BoxGeometry(1.35, 0.18, 0.86), darkMetal);
          basePlate.position.set(x, 0.09, 0);
          pumpGroup.add(basePlate);
          const motor = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.3, 0.8, 18), darkPanel);
          motor.rotation.z = Math.PI / 2;
          motor.position.set(x - 0.16, 0.5, 0);
          pumpGroup.add(motor);
          const led = new THREE.Mesh(new THREE.SphereGeometry(0.05, 10, 10), index % 2 ? blueGlow : cyanGlow);
          led.position.set(x + 0.5, 0.55, 0.35);
          pumpGroup.add(led);
        });

        const indoorModule = new THREE.Group();
        indoorModule.position.set(4.7, 0, -0.7);
        world.add(indoorModule);
        const indoorBody = new THREE.Mesh(new THREE.BoxGeometry(2.25, 1.8, 1.8), darkPanel);
        indoorBody.position.y = 0.95;
        indoorBody.castShadow = !mobile;
        indoorModule.add(indoorBody);
        const indoorRing = new THREE.Mesh(new THREE.TorusGeometry(0.43, 0.035, 10, 42), cyanGlow);
        indoorRing.position.set(-1.14, 1.0, 0);
        indoorRing.rotation.y = Math.PI / 2;
        indoorModule.add(indoorRing);

        const hvacPad = new THREE.Group();
        hvacPad.position.set(8.2, 0, -0.8);
        world.add(hvacPad);
        const pad = new THREE.Mesh(new THREE.BoxGeometry(2.8, 0.18, 2.2), concrete);
        pad.position.y = 0.09;
        pad.receiveShadow = true;
        hvacPad.add(pad);
        const curb = new THREE.Mesh(new THREE.BoxGeometry(2.55, 0.12, 1.95), darkMetal);
        curb.position.y = 0.23;
        hvacPad.add(curb);
        const unitLed = new THREE.Mesh(new THREE.SphereGeometry(0.05, 10, 10), cyanGlow);
        unitLed.position.set(-1.0, 1.45, -0.8);
        hvacPad.add(unitLed);

        function makeServiceLine(points: THREE.Vector3[], radius: number, material: THREE.Material) {
          const curve = new THREE.CatmullRomCurve3(points);
          const line = new THREE.Mesh(new THREE.TubeGeometry(curve, 36, radius, 8, false), material);
          line.castShadow = !mobile;
          world.add(line);
        }
        makeServiceLine([new THREE.Vector3(5.8, .85, -.55), new THREE.Vector3(6.7, 1.15, -.45), new THREE.Vector3(7.35, 1.05, -.58), new THREE.Vector3(8, .9, -.6)], .035, copper);
        makeServiceLine([new THREE.Vector3(5.8, .68, -.82), new THREE.Vector3(6.65, .95, -.92), new THREE.Vector3(7.35, .88, -.92), new THREE.Vector3(8, .72, -.88)], .055, insulated);

        const electricalBay = new THREE.Group();
        electricalBay.position.set(7.1, 0, -7.3);
        world.add(electricalBay);
        const electricalPlinth = new THREE.Mesh(new THREE.BoxGeometry(5.8, .24, 2), darkMetal);
        electricalPlinth.position.y = .12;
        electricalBay.add(electricalPlinth);
        const tray = new THREE.Mesh(new THREE.BoxGeometry(5.6, .08, .55), darkMetal);
        tray.position.set(0, 2.45, .45);
        electricalBay.add(tray);
        const trayLine = new THREE.Mesh(new THREE.BoxGeometry(5.1, .025, .025), electricGlow);
        trayLine.position.set(0, 2.43, .14);
        electricalBay.add(trayLine);

        let pipePieces = 0;
        let ductPieces = 0;
        let airconPieces = 0;
        let electricalPieces = 0;
        const pipeNetwork = new THREE.Group();
        const ductNetwork = new THREE.Group();
        const airconNetwork = new THREE.Group();
        const electricalNetwork = new THREE.Group();
        world.add(pipeNetwork, ductNetwork, airconNetwork, electricalNetwork);
        function updatePieceCount() { if (pieceCountEl) pieceCountEl.textContent = String(pipePieces + ductPieces + airconPieces + electricalPieces); }

        const pipeManager = new THREE.LoadingManager();
        pipeManager.setURLModifier((url) => url.includes('/textures/') ? PIXEL : url);
        new GLTFLoader(pipeManager).load(PIPE_ASSET_URL, (gltf) => {
          const source = new Map<string, THREE.Object3D>();
          gltf.scene.children.forEach((child) => source.set(child.name, child));
          const addPipe = (name: string, position: [number, number, number], rotation: [number, number, number], scale: number, material: THREE.Material) => {
            const original = source.get(name); if (!original) return;
            const piece = original.clone(true);
            piece.position.set(...position); piece.rotation.set(...rotation); piece.scale.setScalar(scale);
            piece.traverse((object: THREE.Object3D) => { if (object instanceof THREE.Mesh) { object.material = material; object.castShadow = !mobile; object.receiveShadow = true; } });
            pipeNetwork.add(piece); pipePieces += 1;
          };
          [-7.4, -5, -2.6, -.2].forEach((x) => {
            addPipe('modular_industrial_pipes_01_pipe02', [x, 3.45, -6.1], [0, 0, Math.PI / 2], 1.2, pipeSupply);
            addPipe('modular_industrial_pipes_01_pipe02', [x, 2.35, -5.78], [0, 0, Math.PI / 2], 1.2, pipeReturn);
          });
          [-3.95, -2.4, -.85, .7, 2.25].forEach((x, index) => addPipe('modular_industrial_pipes_01_pipe01', [x, 2, -7.15], [0, 0, 0], 1, index % 2 ? pipeReturn : pipeSupply));
          if (pipeStatus) pipeStatus.textContent = 'READY'; updatePieceCount();
        }, undefined, (error) => { console.error('Phase 2.7 pipe network failed', error); if (pipeStatus) pipeStatus.textContent = 'ERROR'; });

        new GLTFLoader().load(HVAC_ASSET_URL, (gltf) => {
          const source = new Map<string, THREE.Object3D>();
          gltf.scene.children.forEach((child) => source.set(child.name, child));
          const addDuct = (name: string, position: [number, number, number], rotation: [number, number, number], scale = 1) => {
            const original = source.get(name); if (!original) return;
            const piece = original.clone(true);
            piece.position.set(...position); piece.rotation.set(...rotation); piece.scale.setScalar(scale);
            piece.traverse((object: THREE.Object3D) => { if (object instanceof THREE.Mesh) { object.castShadow = !mobile; object.receiveShadow = true; } });
            ductNetwork.add(piece); ductPieces += 1;
          };
          [-5.4, -2.7, 0, 2.7, 5.4].forEach((x) => addDuct('modular_airduct_circular_triple', [x, 4.75, 2.55], [0, Math.PI / 2, 0], 1.48));
          addDuct('modular_airduct_circular_fan', [.15, 4.75, 2.55], [0, Math.PI / 2, 0], 1.42);
          addDuct('modular_airduct_circular_smooth_bend_quater', [-3.1, 4.75, 2.45], [0, 0, Math.PI / 2], 1.5);
          addDuct('modular_airduct_circular_smooth_bend_quater', [3.15, 4.75, 2.45], [0, Math.PI, Math.PI / 2], 1.5);
          addDuct('modular_airduct_circular_smooth_triple', [-3.1, 4.75, .7], [0, 0, 0], 1.42);
          addDuct('modular_airduct_circular_smooth_triple', [3.15, 4.75, .7], [0, 0, 0], 1.42);
          if (hvacStatus) hvacStatus.textContent = 'READY'; updatePieceCount();
        }, undefined, (error) => { console.error('Phase 2.7 ducts failed', error); if (hvacStatus) hvacStatus.textContent = 'ERROR'; });

        const airconManager = new THREE.LoadingManager();
        airconManager.setURLModifier((url) => url.includes('_rusted_') ? PIXEL : url);
        new GLTFLoader(airconManager).load(AIRCON_ASSET_URL, (gltf) => {
          const clean = gltf.scene.getObjectByName('exterior_aircon_unit');
          if (!clean) { if (airconStatus) airconStatus.textContent = 'ERROR'; return; }
          const unit = clean.clone(true);
          unit.position.set(8.2, .95, -.8); unit.rotation.y = -Math.PI / 2; unit.scale.setScalar(1.85);
          unit.traverse((object: THREE.Object3D) => { if (object instanceof THREE.Mesh) { object.castShadow = !mobile; object.receiveShadow = true; } });
          airconNetwork.add(unit); airconPieces = 1;
          if (airconStatus) airconStatus.textContent = 'READY'; updatePieceCount();
        }, undefined, (error) => { console.error('Phase 2.7 HVAC unit failed', error); if (airconStatus) airconStatus.textContent = 'ERROR'; });

        new GLTFLoader().load(ELECTRICAL_ASSET_URL, (gltf) => {
          const cabinet = gltf.scene;
          cabinet.traverse((object: THREE.Object3D) => { if (object instanceof THREE.Mesh) { object.castShadow = !mobile; object.receiveShadow = true; } });
          [-2.25, -.75, .75, 2.25].forEach((x, index) => {
            const unit = cabinet.clone(true);
            unit.position.set(7.1 + x, .24, -7.35 + (index % 2) * .06); unit.rotation.y = Math.PI; unit.scale.setScalar(1.28);
            electricalNetwork.add(unit); electricalPieces += 1;
          });
          if (electricalStatus) electricalStatus.textContent = 'READY'; updatePieceCount();
        }, undefined, (error) => { console.error('Phase 2.7 electrical asset failed', error); if (electricalStatus) electricalStatus.textContent = 'ERROR'; });

        const core = new THREE.Group();
        world.add(core);
        const plinth = new THREE.Mesh(new THREE.CylinderGeometry(2.25, 2.55, .45, 56), darkMetal); plinth.position.y = .22; core.add(plinth);
        const coreBody = new THREE.Mesh(new THREE.CylinderGeometry(.72, .96, 4.4, 42), darkMetal); coreBody.position.y = 2.65; core.add(coreBody);
        const energyColumn = new THREE.Mesh(new THREE.CylinderGeometry(.22, .22, 3.55, 24), cyanGlow); energyColumn.position.y = 2.7; core.add(energyColumn);
        const rings: THREE.Mesh[] = [];
        [1.2, 2.35, 3.5, 4.55].forEach((y, index) => {
          const ring = new THREE.Mesh(new THREE.TorusGeometry(1.08 + index * .06, .035, 8, 64), index % 2 ? blueGlow : cyanGlow);
          ring.rotation.x = Math.PI / 2; ring.position.y = y; core.add(ring); rings.push(ring);
        });
        const halo = new THREE.Mesh(new THREE.TorusGeometry(2, .055, 10, 80), cyanGlow); halo.rotation.x = Math.PI / 2; halo.position.y = .55; core.add(halo);
        const beacon = new THREE.PointLight(0x00d9ff, mobile ? 12 : 21, 16, 1.65); beacon.position.set(0, 3, 0); core.add(beacon);

        scene.add(new THREE.HemisphereLight(0x6ebfe0, 0x02050b, 1.24));
        const key = new THREE.DirectionalLight(0xa9dfff, 3); key.position.set(-7, 13, 9); key.castShadow = !mobile; scene.add(key);
        const warm = new THREE.PointLight(0xffa85b, 7, 17, 2); warm.position.set(-8, 5, -5); scene.add(warm);
        const hvacAccent = new THREE.PointLight(0x8bdcff, 9.5, 16, 2); hvacAccent.position.set(.8, 6, 2.4); scene.add(hvacAccent);
        const equipmentAccent = new THREE.PointLight(0x9de8ff, 10.5, 12, 2); equipmentAccent.position.set(8, 3.2, -.3); scene.add(equipmentAccent);
        const electricalAccent = new THREE.PointLight(0xffca4a, 8, 11, 2); electricalAccent.position.set(7, 3.4, -6.6); scene.add(electricalAccent);

        function createConnection(start: THREE.Vector3, end: THREE.Vector3, height = 1, material: THREE.Material = cyanGlow) {
          const mid = start.clone().lerp(end, .5); mid.y += height;
          const curve = new THREE.CatmullRomCurve3([start, mid, end]);
          world.add(new THREE.Mesh(new THREE.TubeGeometry(curve, 28, .023, 7, false), material));
          const pulse = new THREE.Mesh(new THREE.SphereGeometry(.058, 10, 10), material); world.add(pulse);
          return { curve, pulse, offset: Math.random() };
        }
        const connections = [
          createConnection(new THREE.Vector3(0, .65, 0), new THREE.Vector3(-4.7, 1.2, -6.1), 1.2),
          createConnection(new THREE.Vector3(0, 1, 0), new THREE.Vector3(0, 4.7, 2.55), 1.8),
          createConnection(new THREE.Vector3(0, 1, 0), new THREE.Vector3(8.2, 1.45, -.8), 1.5),
          createConnection(new THREE.Vector3(0, .9, 0), new THREE.Vector3(7.1, 1.6, -7.3), 1.45, electricGlow),
        ];

        const particleCount = mobile ? 125 : 300;
        const positions = new Float32Array(particleCount * 3);
        for (let i = 0; i < particleCount; i += 1) {
          positions[i * 3] = (Math.random() - .5) * 48; positions[i * 3 + 1] = Math.random() * 10 + .3; positions[i * 3 + 2] = (Math.random() - .5) * 36;
        }
        const particleGeometry = new THREE.BufferGeometry();
        particleGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        const particles = new THREE.Points(particleGeometry, new THREE.PointsMaterial({ color: 0x5fcde8, size: .024, transparent: true, opacity: .24, depthWrite: false }));
        world.add(particles);

        const cameraPath = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-14.5, 8, 19), new THREE.Vector3(-8.8, 5.8, 10.8), new THREE.Vector3(-6.4, 3.8, -2),
          new THREE.Vector3(-4.5, 4.6, -7.8), new THREE.Vector3(-5, 6.2, 4.8), new THREE.Vector3(2.5, 6.5, 7),
          new THREE.Vector3(10.6, 4.4, 3.2), new THREE.Vector3(11.2, 3.3, -1.7), new THREE.Vector3(11, 3.3, -8.7), new THREE.Vector3(2, 6.6, -11),
        ]);
        const targetPath = new THREE.CatmullRomCurve3([
          new THREE.Vector3(0, 2, 0), new THREE.Vector3(0, 2.7, 0), new THREE.Vector3(-4.6, 2.3, -6),
          new THREE.Vector3(-.8, 1.4, -5.6), new THREE.Vector3(-2.5, 4.7, 2.5), new THREE.Vector3(1.8, 4.7, 1.8),
          new THREE.Vector3(6.4, 1.3, -.7), new THREE.Vector3(8.2, 1.25, -.8), new THREE.Vector3(7.1, 1.55, -7.3), new THREE.Vector3(0, 3, 0),
        ]);

        const state = { progress: 0 };
        const chapters = Array.from(document.querySelectorAll('.chapter'));
        ScrollTrigger.create({ trigger: '#story', start: 'top top', end: 'bottom bottom', scrub: reducedMotion ? false : 1.05, onUpdate: (self) => {
          state.progress = self.progress;
          const active = Math.min(chapters.length - 1, Math.floor(self.progress * chapters.length));
          chapters.forEach((chapter, index) => chapter.classList.toggle('active', index === active));
        }});

        const clock = new THREE.Clock();
        let frames = 0; let fpsStart = performance.now(); let raf = 0; let visible = true;
        function render(now = performance.now()) {
          const elapsed = clock.getElapsedTime();
          const progress = reducedMotion ? .66 : THREE.MathUtils.clamp(state.progress, .001, .999);
          camera.position.lerp(cameraPath.getPointAt(progress), reducedMotion ? 1 : .075);
          camera.lookAt(targetPath.getPointAt(progress));
          core.rotation.y = elapsed * .05; halo.rotation.z = elapsed * .16;
          rings.forEach((ring, index) => { ring.rotation.z = elapsed * (.11 + index * .02) * (index % 2 ? -1 : 1); });
          particles.rotation.y = elapsed * .004;
          modules.forEach((module, index) => { module.position.y = Math.sin(elapsed * .5 + index) * .008; });
          unitLed.scale.setScalar(.92 + Math.sin(elapsed * 2.2) * .08);
          connections.forEach(({ curve, pulse, offset }, index) => { pulse.position.copy(curve.getPointAt((elapsed * (.11 + index * .014) + offset) % 1)); });
          composer.render(); frames += 1;
          if (now - fpsStart >= 1000) {
            if (fpsEl) fpsEl.textContent = String(Math.round((frames * 1000) / (now - fpsStart)));
            if (trisEl) trisEl.textContent = renderer.info.render.triangles.toLocaleString();
            frames = 0; fpsStart = now;
          }
          if (visible) raf = requestAnimationFrame(render);
        }
        function resize() {
          camera.aspect = window.innerWidth / window.innerHeight; camera.updateProjectionMatrix();
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, window.innerWidth <= 760 ? 1 : 1.35));
          renderer.setSize(window.innerWidth, window.innerHeight); composer.setSize(window.innerWidth, window.innerHeight);
        }
        window.addEventListener('resize', resize, { passive: true });
        document.addEventListener('visibilitychange', () => {
          visible = !document.hidden;
          if (visible) { cancelAnimationFrame(raf); clock.getDelta(); fpsStart = performance.now(); frames = 0; render(); }
        });
        render();
      }
    </script>
  </body>
</html>


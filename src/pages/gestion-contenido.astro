---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
import { v3AdminPreview, v3ContentAdminContract } from '../data/v3-content-admin';
import { v4AdminAreas, v4AdminPolicy } from '../data/v4-web-admin';
import { assertSafeContentPreview, getContentCapabilitySnapshot } from '../lib/v3-content-management';

const base = import.meta.env.BASE_URL;
const enabled = import.meta.env.PUBLIC_V3_CONTENT_ADMIN_PREVIEW === 'true';
const { media, entries, revisions, social } = v3AdminPreview;
assertSafeContentPreview();
const contentCapabilities = getContentCapabilitySnapshot();
const publishedEntries = entries.filter((entry) => entry.status === 'published').length;
const reviewEntries = entries.filter((entry) => entry.status === 'review').length;
const publishedMedia = media.filter((item) => item.published).length;
const approvedSocial = social.filter((item) => item.status === 'approved').length;
const stateLabel = { 'ready-preview': 'Preview', partial: 'Parcial', 'backend-required': 'Backend' } as const;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Gestión de contenido y control V4 · IsiVoltPro" description="Centro de control seguro para gobernar contenido, oferta, SEO, medios, contactos y publicación de IsiVoltPro." path={`${base}gestion-contenido/`} noindex={true} />
  <style is:inline>
    .admin-page{min-height:80vh;padding:48px 0 86px;background:radial-gradient(circle at 82% 3%,rgba(91,76,223,.11),transparent 25%),linear-gradient(180deg,#fff,#f7f9fd)}
    .admin-shell{width:min(1180px,calc(100% - 32px));margin:auto}.admin-hero{display:grid;grid-template-columns:1.15fr .85fr;gap:24px;align-items:end;margin-bottom:20px}.admin-hero h1{margin:10px 0 14px;font:800 clamp(40px,5.5vw,68px)/.98 Manrope,sans-serif;letter-spacing:-.055em}.admin-hero p{max-width:720px;margin:0;color:#66718b;font-size:17px;line-height:1.65}
    .admin-status,.admin-panel,.admin-nav,.admin-metric{border:1px solid #e5e9f2;background:rgba(255,255,255,.97);box-shadow:0 18px 52px rgba(45,65,110,.07)}.admin-status{padding:20px;border-radius:22px}.admin-status strong{display:block;margin-bottom:6px}.admin-status small{color:#68738d;line-height:1.5}.admin-status__lock{display:inline-flex;margin-top:12px;padding:6px 9px;border-radius:999px;background:#eaf9f3;color:#16845f;font-size:10px;font-weight:900}
    .admin-overview{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px}.admin-metric{padding:16px;border-radius:18px}.admin-metric small{display:block;color:#8791a5;font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.admin-metric strong{display:block;margin-top:7px;font:800 28px/1 Manrope,sans-serif}.admin-metric span{display:block;margin-top:6px;color:#6f7990;font-size:11px;line-height:1.4}
    .admin-mobile-nav{display:none;gap:8px;overflow:auto;padding:0 0 12px}.admin-mobile-nav a,.control-tags span,.role-tags span{white-space:nowrap;border-radius:999px;font-size:10px;font-weight:800}.admin-mobile-nav a{padding:8px 11px;border:1px solid #e4e8f1;background:#fff;color:#47536d;text-decoration:none}
    .admin-grid{display:grid;grid-template-columns:220px 1fr;gap:20px}.admin-nav{align-self:start;position:sticky;top:88px;padding:14px;border-radius:22px}.admin-nav::before{content:'CENTRO DE CONTROL V4';display:block;padding:7px 9px 10px;color:#9aa3b5;font-size:9px;font-weight:900;letter-spacing:.1em}.admin-nav a{display:flex;gap:9px;align-items:center;padding:11px 12px;border-radius:11px;color:#27314a;text-decoration:none;font-size:13px;font-weight:750}.admin-nav a:first-of-type{background:#eef3ff;color:#175cff}.admin-nav span{width:22px;text-align:center}
    .admin-stack{display:grid;gap:18px}.admin-panel{padding:24px;border-radius:23px}.admin-panel__head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:18px}.admin-panel h2{margin:0 0 5px;font:800 27px/1.1 Manrope,sans-serif;letter-spacing:-.035em}.admin-panel p{margin:0;color:#6b7690;line-height:1.55}.admin-btn{border:0;border-radius:11px;padding:10px 13px;background:#175cff;color:#fff;font-weight:800}.admin-btn[disabled]{background:#e9edf5;color:#8c95a9;cursor:not-allowed}.admin-btn--ghost{background:#f2f5fa;color:#56617a}.admin-link{display:inline-flex;align-items:center;gap:6px;padding:9px 12px;border-radius:11px;background:#eef3ff;color:#175cff;text-decoration:none;font-size:12px;font-weight:850}
    .control-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.control-card{padding:15px;border:1px solid #e8ebf3;border-radius:16px;background:linear-gradient(180deg,#fff,#fbfcff)}.control-card__top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.control-card h3{margin:0;font-size:14px}.control-state{padding:5px 7px;border-radius:999px;background:#fff3e8;color:#a35c18;font-size:9px;font-weight:900}.control-card p{margin-top:8px;font-size:11px}.control-tags,.role-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}.control-tags span{padding:5px 7px;background:#f2f5fa;color:#59647e}.role-tags span{padding:4px 7px;background:#eef8f4;color:#247357}
    .content-table{display:grid;gap:8px}.content-row{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:13px;border:1px solid #e8ebf3;border-radius:14px}.content-row strong{display:block}.content-row small{display:block;margin-top:3px;color:#7a8499}.status-pill{padding:5px 8px;border-radius:999px;background:#edf8f3;color:#14845e;font-size:10px;font-weight:900;text-transform:uppercase}.status-pill.review{background:#fff4e8;color:#aa621b}
    .split-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.mini-card{padding:15px;border:1px solid #e8ebf3;border-radius:15px;background:#fbfcff}.mini-card strong{display:block;margin-bottom:5px}.mini-card small{color:#727d94;line-height:1.5}.upload-zone{display:block;margin-top:12px;padding:18px;border:1.5px dashed #cbd4e5;border-radius:15px;text-align:center;background:#fafbfe}.upload-zone input{display:none}.upload-zone strong{display:block;margin-bottom:4px}.upload-zone small{color:#78839a}
    .workflow{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.workflow-step{padding:13px;border:1px solid #e8ebf3;border-radius:14px;background:#f8faff}.workflow-step b{display:block;margin-bottom:4px;color:#175cff;font-size:11px}.workflow-step span{color:#6f7990;font-size:11px;line-height:1.45}
    .capability-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.capability-card{padding:13px;border:1px solid #e8ebf3;border-radius:14px;background:#fbfcff}.capability-card__top{display:flex;justify-content:space-between;gap:10px}.capability-card strong{font-size:11px}.capability-card p{margin-top:6px;font-size:10px}.capability-state{padding:4px 7px;border-radius:999px;background:#fff1ec;color:#a54d27;font-size:8px;font-weight:900;text-transform:uppercase}.capability-state.enabled{background:#eaf9f3;color:#16845f}.security-note{margin-top:14px;padding:14px 16px;border:1px solid #f1ddb8;border-radius:14px;background:#fff8ed;color:#704d1a;font-size:12px;line-height:1.55}.preview-off{margin-top:20px;padding:26px;border-radius:20px;background:#111827;color:#fff}.preview-off p{color:#cbd5e1;line-height:1.6}.preview-off code{padding:3px 6px;border-radius:6px;background:#243047}
    @media(max-width:960px){.admin-overview{grid-template-columns:repeat(2,1fr)}.control-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:840px){.admin-hero,.admin-grid,.split-grid{grid-template-columns:1fr}.admin-nav{display:none}.admin-mobile-nav{display:flex}.control-grid,.workflow,.capability-grid{grid-template-columns:1fr}.admin-panel{padding:18px}.admin-panel__head{display:grid}.admin-hero p{font-size:15px}}
    @media(max-width:520px){.admin-overview{grid-template-columns:1fr}.admin-page{padding-top:34px}.admin-hero h1{font-size:clamp(38px,12vw,52px)}}
  </style>
</head>
<body>
  <V3CommercialHeader />
  <main class="admin-page">
    <div class="admin-shell">
      <section class="admin-hero">
        <div><span class="eyebrow">Administración de la web</span><h1>Un centro para<br/><span class="gradient-text">controlarlo todo.</span></h1><p>V4 amplía el gestor editorial a un centro de control de IsiVoltPro: páginas, navegación, producto, módulos, sectores, precios, Blog y Noticias, recursos, medios, SEO, contactos, redes, publicación y seguridad.</p></div>
        <aside class="admin-status"><strong>Control real, secretos fuera de la web pública</strong><small>La interfaz ya define qué debe poder gobernarse. Las escrituras, usuarios, formularios, credenciales y publicación real se activarán únicamente detrás de autenticación y autorización backend.</small><span class="admin-status__lock">◈ Preview seguro · sin escrituras públicas</span></aside>
      </section>

      {enabled ? (
        <>
          <section class="admin-overview" aria-label="Resumen del centro de control">
            <article class="admin-metric"><small>Áreas controlables</small><strong>{v4AdminAreas.length}</strong><span>dominios definidos para V4</span></article>
            <article class="admin-metric"><small>Contenido</small><strong>{publishedEntries}</strong><span>piezas publicadas en el preview</span></article>
            <article class="admin-metric"><small>Revisión</small><strong>{reviewEntries}</strong><span>piezas pendientes de aprobación</span></article>
            <article class="admin-metric"><small>Biblioteca</small><strong>{publishedMedia}/{media.length}</strong><span>medios publicados y trazables</span></article>
          </section>

          <nav class="admin-mobile-nav" aria-label="Accesos rápidos de gestión"><a href="#control">Control</a><a href="#contenido">Contenido</a><a href="#medios">Medios</a><a href="#publicacion">Publicación</a><a href="#seguridad">Seguridad</a></nav>
          <div class="admin-grid">
            <nav class="admin-nav" aria-label="Gestión de contenido"><a href="#control"><span>⌘</span> Control general</a><a href="#contenido"><span>▤</span> Contenido</a><a href={`${base}gestion-contenido/blog/`}><span>✦</span> Blog y noticias</a><a href="#medios"><span>▧</span> Multimedia</a><a href="#publicacion"><span>↑</span> Publicación</a><a href="#seguridad"><span>◈</span> Seguridad</a></nav>

            <div class="admin-stack">
              <section class="admin-panel" id="control">
                <div class="admin-panel__head"><div><h2>Mapa de control V4</h2><p>El admin deja de ser solo editorial: cada área importante de la web tiene propietario, permisos y límite técnico definidos.</p></div><button class="admin-btn" type="button" disabled>Guardar ajustes</button></div>
                <div class="control-grid">{v4AdminAreas.map((domain) => <article class="control-card"><div class="control-card__top"><h3>{domain.label}</h3><span class="control-state">{stateLabel[domain.state]}</span></div><p>{domain.description}</p><div class="control-tags">{domain.controls.map((control) => <span>{control}</span>)}</div><div class="role-tags">{domain.roles.map((role) => <span>{role}</span>)}</div></article>)}</div>
              </section>

              <section class="admin-panel" id="contenido">
                <div class="admin-panel__head"><div><h2>Páginas, Blog y recursos</h2><p>Una misma cola editorial para cambiar mensajes, medios y estado sin editar Astro a mano.</p></div><div style="display:flex;gap:8px;flex-wrap:wrap"><a class="admin-link" href={`${base}gestion-contenido/blog/`}>Abrir Blog y Noticias</a><button class="admin-btn admin-btn--ghost" type="button" disabled>Nueva pieza</button></div></div>
                <div class="content-table">{entries.map((entry) => <article class="content-row"><div><strong>{entry.section}</strong><small>{entry.route} · {entry.title}</small></div><span class:list={["status-pill", entry.status === 'review' && 'review']}>{entry.status === 'published' ? 'Publicado' : 'Revisión'}</span></article>)}</div>
              </section>

              <section class="admin-panel" id="medios">
                <div class="admin-panel__head"><div><h2>Biblioteca multimedia</h2><p>Control de imágenes, vídeos y documentos con alt obligatorio, etiquetas y trazabilidad antes de publicar.</p></div><button class="admin-btn admin-btn--ghost" type="button" disabled>Subir archivo</button></div>
                <div class="split-grid"><article class="mini-card"><strong>{publishedMedia} recursos publicados</strong><small>{media.length} elementos registrados en total. Las piezas pueden reutilizarse sin duplicar archivos.</small></article><article class="mini-card"><strong>{revisions.length} revisiones trazables</strong><small>Publicaciones y cambios de medio quedan preparados para historial y restauración.</small></article></div>
                <label class="upload-zone"><input type="file" accept="image/jpeg,image/png,image/webp,image/avif" disabled/><strong>Añadir medio desde el admin</strong><small>JPEG, PNG, WebP o AVIF · máximo {Math.round(v3ContentAdminContract.limits.imageMaxBytes / 1024 / 1024)} MB · bloqueado hasta backend autenticado.</small></label>
              </section>

              <section class="admin-panel" id="publicacion">
                <div class="admin-panel__head"><div><h2>Publicación controlada</h2><p>V4 separa editar de publicar. Una versión debe pasar revisión, preview y QA antes de poder promocionarse.</p></div><button class="admin-btn" type="button" disabled>Publicar versión</button></div>
                <div class="workflow" aria-label="Flujo de publicación"><div class="workflow-step"><b>1 · Editar</b><span>Preparar contenido y ajustes.</span></div><div class="workflow-step"><b>2 · Revisar</b><span>Owner/Admin aprueba.</span></div><div class="workflow-step"><b>3 · Validar</b><span>Preview, enlaces, móvil y QA.</span></div><div class="workflow-step"><b>4 · Publicar</b><span>Solo con checks verdes.</span></div></div>
                <div class="split-grid" style="margin-top:10px"><article class="mini-card"><strong>Redes sociales</strong><small>{approvedSocial} publicación aprobada en el preview. La programación real seguirá requiriendo aprobación y worker backend.</small></article><article class="mini-card"><strong>Contactos y solicitudes</strong><small>Contacto, demo y piloto forman parte del control V4, pero sus datos nunca se guardarán en el frontend estático.</small></article></div>
                <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap"><button class="admin-btn admin-btn--ghost" type="button" disabled>Programar redes</button><button class="admin-btn admin-btn--ghost" type="button" disabled>Gestionar contactos</button></div>
              </section>

              <section class="admin-panel" id="seguridad">
                <h2>Seguridad y límites</h2><p>El panel puede mostrar todo el mapa de control sin convertir la web pública en un backend. Cualquier capacidad sensible permanece bloqueada hasta que exista una sesión administrativa real.</p>
                <div class="capability-grid" style="margin-top:14px">{contentCapabilities.map((item) => <article class="capability-card"><div class="capability-card__top"><strong>{item.label}</strong><span class:list={["capability-state", item.enabled && "enabled"]}>{item.enabled ? 'Activa' : 'Bloqueada'}</span></div><p>{item.boundary}</p></article>)}</div>
                <div class="security-note"><strong>Contrato V4:</strong> secretos en la web pública: {v4AdminPolicy.publicSiteStoresSecrets ? 'permitidos' : 'prohibidos'} · escrituras públicas: {v4AdminPolicy.publicSiteCanWriteAdminData ? 'permitidas' : 'prohibidas'} · publicación sin QA: {v4AdminPolicy.releaseRequiresGreenChecks ? 'prohibida' : 'permitida'}. El backend autenticado será la única autoridad para usuarios, permisos y cambios persistentes.</div>
              </section>
            </div>
          </div>
        </>
      ) : (
        <section class="preview-off"><strong>Vista administrativa bloqueada por defecto.</strong><p>El centro de control V4 y su contrato ya están definidos, pero un despliegue público normal no expone el workspace. Para QA aislado se habilita únicamente con <code>PUBLIC_V3_CONTENT_ADMIN_PREVIEW=true</code>.</p></section>
      )}
    </div>
  </main>
  <V3CommercialFooter />
</body>
</html>

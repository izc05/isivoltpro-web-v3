---
const base = import.meta.env.BASE_URL;
const brandMark = `${base}brand/isivoltpro-mark-v4.svg`;
---
<style is:inline>
  .page-footer{padding:50px 0 28px!important;color:#566176!important;background:#fff!important;border-top:1px solid #eceef4!important}
  .page-footer .brand{color:#11182b!important}.page-footer .brand__icon{width:34px;height:34px;display:block;object-fit:contain;border-radius:0;background:none!important;box-shadow:none!important;transform:none;filter:drop-shadow(0 7px 11px rgba(77,72,210,.12))}.page-footer .brand__word{display:inline-flex;align-items:baseline;color:#101a34}.page-footer .brand__word strong{font:inherit;font-weight:800;color:transparent;background:linear-gradient(100deg,#2563eb,#18b9d7 58%,#7c3aed);-webkit-background-clip:text;background-clip:text}
  .page-footer p{color:#7e8899!important;line-height:1.65}.page-footer h4{color:#172036!important}.page-footer a{color:#657086!important}.page-footer a:hover{color:#6255d9!important}
  .page-footer__bottom{margin-top:32px!important;padding-top:18px!important;border-top:1px solid #edf0f5!important;color:#929aa8!important}
  .page-footer__bottom a{display:inline;margin:0;color:#788295!important}.page-footer__bottom a:hover{text-decoration:underline;color:#6255d9!important}
  .footer-group{min-width:0}.footer-group summary{list-style:none;color:#172036;font-weight:800;cursor:default}.footer-group summary::-webkit-details-marker{display:none}.footer-group__links{display:grid;align-content:start}.footer-group__links a{display:block}
  :where(a,button,input,select,textarea,summary):focus-visible{outline:3px solid rgba(109,74,255,.24);outline-offset:3px}
  @media(min-width:841px){.footer-group__links{display:grid!important}.footer-group summary{pointer-events:none}.footer-group summary::after{display:none!important}}
  @media(max-width:840px){
    .page-footer{padding:34px 0 22px!important}.page-footer__grid{display:grid!important;grid-template-columns:1fr!important;gap:18px!important}
    .page-footer__grid>div:first-child p{max-width:540px;margin-bottom:2px}
    .footer-group{border-top:1px solid #edf0f5;padding-top:2px}.footer-group:last-of-type{border-bottom:1px solid #edf0f5;padding-bottom:2px}
    .footer-group summary{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 2px;cursor:pointer;font-size:15px}.footer-group summary::after{content:'+';display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:#f4f6fb;color:#59657d;font-size:18px;font-weight:500;transition:transform .18s ease,background .18s ease}.footer-group[open] summary::after{content:'−';background:#eef1ff;color:#6255d9}.footer-group:not([open]) .footer-group__links{display:none}.footer-group[open] .footer-group__links{display:grid;gap:0;padding:0 2px 12px}.footer-group__links a{padding:9px 0;border-top:1px solid #f3f4f8;font-size:14px}
    .page-footer__bottom{margin-top:20px!important;padding-top:16px!important;line-height:1.8;font-size:12px}
  }
  @media(prefers-reduced-motion:reduce){.footer-group summary::after{transition:none}}
</style>
<footer class="page-footer" aria-label="Pie de página">
  <div class="page-shell">
    <div class="page-footer__grid">
      <div><div class="brand"><img class="brand__icon" src={brandMark} alt="" width="34" height="34" loading="lazy" decoding="async"/><span class="brand__word">IsiVolt<strong>Pro</strong></span></div><p>Soluciones y aplicaciones para autónomos, pequeños equipos y empresas de mantenimiento: activos, avisos, OT, preventivos, documentación y trabajo de campo en un solo ecosistema.</p></div>
      <details class="footer-group"><summary>Producto y módulos</summary><nav class="footer-group__links" aria-label="Producto y módulos"><a href={`${base}producto/`}>Plataforma</a><a href={`${base}aplicaciones/`}>Módulos</a><a href={`${base}app-mantenimiento/`}>App Mantenimiento</a><a href={`${base}apps-especializadas/`}>Módulos especializados</a><a href={`${base}alcance/`}>Alcance del producto</a><a href={`${base}precios/`}>Precios</a></nav></details>
      <details class="footer-group"><summary>Soluciones</summary><nav class="footer-group__links" aria-label="Soluciones"><a href={`${base}soluciones/`}>Problemas que resolvemos</a><a href={`${base}sectores/`}>Por sector y actividad</a><a href={`${base}implantacion/`}>Implantación</a><a href={`${base}piloto/`}>Piloto y contratación</a><a href={`${base}demo/`}>Ver demo</a><a href={`${base}seguridad/`}>Seguridad y privacidad</a></nav></details>
      <details class="footer-group"><summary>Recursos, noticias y empresa</summary><nav class="footer-group__links" aria-label="Recursos, noticias y empresa"><a href={`${base}recursos/`}>Guías prácticas</a><a href={`${base}blog/`}>Blog y noticias</a><a href={`${base}faq/`}>Preguntas frecuentes</a><a href={`${base}empresa/`}>Quiénes somos</a><a href={`${base}contacto/`}>Contacto</a><a href={`${base}acceso/`}>Acceder</a></nav></details>
    </div>
    <div class="page-footer__bottom"><span>IsiVoltPro · Mantenimiento bajo control.</span> · <a href={`${base}privacidad/`}>Privacidad</a> · <a href={`${base}cookies/`}>Cookies</a> · <a href={`${base}aviso-legal/`}>Aviso legal</a></div>
  </div>
</footer>
---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const contact = `${base}contacto/`;
const product = `${base}producto/`;
const modules = `${base}aplicaciones/`;
const sectors = `${base}sectores/`;
const pricing = `${base}precios/`;
const faq = `${base}faq/`;
const moduleUrl = (slug: string) => `${base}modulos/${slug}/`;
const sectorUrl = (slug: string) => `${base}sectores/${slug}/`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="IsiVoltPro · Mantenimiento fácil para autónomos y pequeñas empresas" description="IsiVoltPro ayuda a autónomos y pequeñas empresas a controlar clientes, activos, avisos, órdenes de trabajo, mantenimiento preventivo, documentación e histórico desde un solo lugar." path={base} />
  <script is:inline>
    try {
      if (sessionStorage.getItem('isivoltpro-intro-seen') === '1') document.documentElement.classList.add('skip-intro');
    } catch (_) {}
  </script>
  <style is:inline>
    html.skip-intro .intro{display:none}
    .home-link-card{color:inherit;text-decoration:none}
    .home-link-card small{color:#5d6a87;font-weight:700}
    .home-more{display:flex;justify-content:center;margin-top:30px}
  </style>
</head>
<body class="intro-lock">
  <div class="intro" id="intro" aria-label="Presentación de IsiVoltPro">
    <div class="intro__grid" aria-hidden="true"></div>
    <div class="intro__nebula intro__nebula--a" aria-hidden="true"></div>
    <div class="intro__nebula intro__nebula--b" aria-hidden="true"></div>
    <button class="intro__skip" id="skip-intro" type="button">Saltar intro</button>
    <div class="intro__orbit" aria-hidden="true">
      <span class="intro__node">▣</span><span class="intro__node">⚙</span><span class="intro__node">✓</span><span class="intro__node">⌁</span><span class="intro__node">!</span><span class="intro__node">▤</span>
    </div>
    <div class="intro__content">
      <p class="intro__label">ISIVOLTPRO · TRABAJO TÉCNICO CONECTADO</p>
      <div class="intro__core" aria-hidden="true"><div class="intro__mark"><span>V</span></div></div>
      <h1>Conectando tu trabajo diario.</h1>
      <p class="intro__copy">Clientes, equipos, avisos, órdenes y mantenimiento dejan de vivir separados. Todo converge en un único lugar.</p>
      <p class="intro__status">Preparando tu entorno de control…</p>
      <div class="intro__bar" aria-hidden="true"><span></span></div>
    </div>
  </div>

  <V3CommercialHeader />

  <main>
    <section class="hero" id="inicio">
      <div class="hero__grid shell">
        <div class="hero__copy reveal">
          <span class="eyebrow">Para autónomos y pequeñas empresas</span>
          <h1>Menos papeleo.<br/>Más trabajo <span class="gradient-text">bajo control.</span></h1>
          <p class="hero__lead">IsiVoltPro reúne <strong>clientes, equipos, avisos, órdenes de trabajo, preventivos, fotos y documentación</strong> para resolver el día a día sin depender de WhatsApp, hojas sueltas o varias aplicaciones.</p>
          <div class="hero__actions"><a class="btn btn--primary" href={contact}>Solicitar una demo <span>→</span></a><a class="btn" href={product}>Conocer el producto</a></div>
          <div class="hero__note"><span>✓</span> Empieza por el problema que ya tienes hoy. Amplía solo cuando lo necesites.</div>
        </div>

        <div class="product-stage reveal" aria-label="Vista conceptual de IsiVoltPro">
          <div class="dashboard">
            <div class="dashboard__top"><div class="mini-brand"><i></i><span>IsiVoltPro</span></div><small>Interfaz conceptual · datos ilustrativos</small></div>
            <div class="dashboard__body">
              <aside class="dashboard__rail" aria-label="Módulos"><span>⌂</span><span>▣</span><span>✓</span><span>⚙</span><span>▤</span><span>⌁</span></aside>
              <div class="dashboard__main">
                <div class="dashboard__hello"><div><small>Resumen de trabajo</small><h3>Todo lo importante, visible</h3></div><small>Vista operativa</small></div>
                <div class="kpis"><article class="kpi"><small>OT abiertas</small><strong>12</strong><em>Ejemplo</em></article><article class="kpi"><small>Preventivos</small><strong>8</strong><em>Ejemplo</em></article><article class="kpi"><small>Incidencias</small><strong>3</strong><em>Ejemplo</em></article><article class="kpi"><small>Activos</small><strong>124</strong><em>Ejemplo</em></article></div>
                <div class="dashboard__lower">
                  <article class="panel"><div class="panel__head"><strong>Actividad reciente</strong><a href={moduleUrl('ordenes-de-trabajo')}>Ver OT</a></div><div class="activity"><div class="activity__row"><i class="dot"></i><span>Revisión climatizadora UTA-02</span><small>Finalizada</small></div><div class="activity__row"><i class="dot dot--orange"></i><span>Aviso · fuga de agua</span><small>En curso</small></div><div class="activity__row"><i class="dot"></i><span>Cambio de luminaria</span><small>Cerrada</small></div><div class="activity__row"><i class="dot dot--pink"></i><span>Preventivo cuadro QG-01</span><small>Programada</small></div></div></article>
                  <article class="panel"><div class="panel__head"><strong>Activo destacado</strong><a href={moduleUrl('activos')}>Ver activos</a></div><div class="asset-card"><div><small>CLIMATIZACIÓN</small><h4>UTA-02</h4><p>Planta 1 · Zona técnica<br/>Estado: Operativo<br/>Próxima revisión: programada</p></div><div class="asset-visual" aria-hidden="true"></div></div></article>
                </div>
              </div>
            </div>
          </div>
          <article class="floating-card floating-card--phone" aria-label="Aviso conceptual desde móvil"><div class="phone-head"><span>INC-0342</span><span>•••</span></div><div class="phone-title">Fallo de climatización</div><span class="phone-status">Prioridad alta</span><div class="phone-meta">Cliente: ejemplo<br/>Activo: UTA-02<br/>Asignación: técnica</div></article>
          <article class="floating-card floating-card--chart" aria-label="Indicador conceptual"><small>Trabajos cerrados</small><strong style="display:block;font-size:26px;margin-top:4px">28</strong><div class="mini-chart"><svg viewBox="0 0 120 48" aria-hidden="true"><path d="M2 42 C20 38, 24 26, 38 31 S58 36, 65 21 S86 31, 94 17 S105 18, 118 5" fill="none" stroke="#24c58c" stroke-width="3" stroke-linecap="round"/></svg></div></article>
          <article class="floating-card floating-card--qr" aria-label="Código QR conceptual"><div class="qr" aria-hidden="true">{Array.from({length:25}).map(() => <i></i>)}</div><small style="font-size:8px">Escanear activo</small></article>
        </div>
      </div>
    </section>

    <section class="pain-strip" aria-label="Problemas que IsiVoltPro simplifica"><div class="pain-strip__grid shell"><article class="pain-item"><i>✉</i><strong>Menos avisos perdidos</strong><span>Convierte mensajes y llamadas en trabajo organizado.</span></article><article class="pain-item"><i>▤</i><strong>Menos papel y Excel</strong><span>Fotos, documentos e histórico junto al equipo correcto.</span></article><article class="pain-item"><i>⏱</i><strong>Menos revisiones olvidadas</strong><span>Sabes qué toca y qué quedó pendiente.</span></article><article class="pain-item"><i>✓</i><strong>Más tranquilidad</strong><span>Ves qué está pendiente, en curso y terminado.</span></article></div></section>

    <section class="section section--soft" id="modulos"><div class="shell"><div class="section-head reveal"><div><span class="eyebrow">Todo lo necesario, sin complicarlo</span><h2>Una plataforma para el <span class="gradient-text">trabajo real.</span></h2></div><p>Cada módulo aborda un problema concreto y comparte el mismo contexto. Puedes entrar directamente en el que hoy te hace perder más tiempo.</p></div><div class="modules-grid">
      <a class="module-card home-link-card reveal" href={moduleUrl('activos')} style="--accent:rgba(23,92,255,.10)"><i class="module-icon">▣</i><h3>Clientes y activos</h3><p>Organiza ubicaciones y equipos con datos, fotos, documentos e histórico.</p><small>Ver activos →</small></a>
      <a class="module-card home-link-card reveal" href={moduleUrl('ordenes-de-trabajo')} style="--accent:rgba(109,74,255,.10);--icon:#6544e8;--icon-bg:#f2efff"><i class="module-icon">✓</i><h3>Órdenes de trabajo</h3><p>Del aviso al cierre con responsable, estado, evidencias y resultado.</p><small>Ver OT →</small></a>
      <a class="module-card home-link-card reveal" href={moduleUrl('mantenimiento-preventivo')} style="--accent:rgba(36,197,140,.11);--icon:#159f71;--icon-bg:#eaf9f3"><i class="module-icon">⚙</i><h3>Mantenimiento</h3><p>Convierte periodicidades en revisiones visibles y documentadas.</p><small>Ver preventivo →</small></a>
      <a class="module-card home-link-card reveal" href={moduleUrl('qr-nfc')} style="--accent:rgba(255,139,61,.12);--icon:#e37427;--icon-bg:#fff4ea"><i class="module-icon">⌁</i><h3>QR / NFC</h3><p>Escanea el equipo y abre el contexto correcto desde el móvil.</p><small>Ver QR / NFC →</small></a>
      <a class="module-card home-link-card reveal" href={moduleUrl('inspecciones')} style="--accent:rgba(24,185,215,.11);--icon:#139db9;--icon-bg:#eafafd"><i class="module-icon">☑</i><h3>Inspecciones</h3><p>Checklists, observaciones y evidencias dentro de un flujo trazable.</p><small>Ver inspecciones →</small></a>
      <a class="module-card home-link-card reveal" href={moduleUrl('documentacion')} style="--accent:rgba(242,56,169,.10);--icon:#d52f99;--icon-bg:#fff0f8"><i class="module-icon">▤</i><h3>Documentación</h3><p>Manuales, fotos e informes junto al activo y trabajo correctos.</p><small>Ver documentación →</small></a>
    </div><div class="home-more"><a class="btn" href={modules}>Explorar todos los módulos →</a></div></div></section>

    <section class="section" id="para-quien"><div class="shell personas"><article class="persona-copy reveal"><span class="eyebrow">Crece sin montar un ERP</span><h2>Hecho para quien <span class="gradient-text">trabaja de verdad.</span></h2><p>IsiVoltPro parte del técnico con el móvil en la mano, del autónomo que lleva varios clientes y de la pequeña empresa que necesita coordinar sin añadir burocracia.</p><div class="hero__actions"><a class="btn" href={sectors}>Ver todos los perfiles</a></div></article><div class="persona-list">
      <a class="persona-card home-link-card reveal" href={sectorUrl('autonomos-tecnicos')}><i>👤</i><h3>Autónomo</h3><p>Clientes, equipos, trabajos, fotografías y revisiones en un único sitio.</p><small>Ver solución →</small></a>
      <a class="persona-card home-link-card reveal" href={sectorUrl('empresas-mantenedoras')}><i>👥</i><h3>Pequeño equipo</h3><p>Asigna trabajo y comparte contexto sin depender de llamadas constantes.</p><small>Ver solución →</small></a>
      <a class="persona-card home-link-card reveal" href={sectorUrl('instalaciones-propias')}><i>🏢</i><h3>Instalaciones propias</h3><p>Controla equipos, incidencias y preventivos aunque externalices mantenimiento.</p><small>Ver solución →</small></a>
      <a class="persona-card home-link-card reveal" href={sectorUrl('multisede')}><i>📍</i><h3>Multisede</h3><p>Varias ubicaciones organizadas sin mezclar activos ni históricos.</p><small>Ver solución →</small></a>
    </div></div></section>

    <section class="section section--soft" id="como-funciona"><div class="shell"><div class="section-head reveal"><div><span class="eyebrow">Del problema a la solución</span><h2>Un flujo que cualquiera <span class="gradient-text">entiende.</span></h2></div><p>Cada trabajo reutiliza la información anterior. El objetivo no es rellenar más campos, sino que la siguiente intervención empiece con más contexto.</p></div><div class="workflow reveal"><div class="workflow__track"><article class="workflow-step"><i>1</i><strong>Cliente / activo</strong><small>Sabes dónde ocurre.</small></article><article class="workflow-step" style="--step-bg:#fff0f4;--step-color:#e13972"><i>2</i><strong>Aviso</strong><small>Registras el problema.</small></article><article class="workflow-step" style="--step-bg:#f2efff;--step-color:#6d4aff"><i>3</i><strong>OT</strong><small>Organizas el trabajo.</small></article><article class="workflow-step" style="--step-bg:#ebf8ff;--step-color:#139db9"><i>4</i><strong>Técnico</strong><small>Actúa con contexto.</small></article><article class="workflow-step" style="--step-bg:#eaf9f3;--step-color:#159f71"><i>5</i><strong>Cierre</strong><small>Resultado y evidencias.</small></article><article class="workflow-step" style="--step-bg:#fff5ea;--step-color:#e37427"><i>6</i><strong>Histórico</strong><small>Queda para después.</small></article></div></div></div></section>

    <section class="section"><div class="shell mobile-block"><div class="reveal"><span class="eyebrow">Pensado primero para el móvil</span><h2>El trabajo ocurre fuera de la oficina. <span class="gradient-text">IsiVoltPro también.</span></h2><p>Identifica el equipo, consulta qué ocurrió antes, trabaja sobre una OT y deja evidencia desde el lugar donde sucede.</p><ul class="checks"><li>Escaneo QR / NFC del activo</li><li>Órdenes asignadas y prioridades</li><li>Fotos, notas y documentación</li><li>Histórico disponible en campo</li></ul><div class="hero__actions"><a class="btn" href={product}>Ver experiencia de producto →</a></div></div><div class="phone-scene reveal" aria-label="Interfaz móvil conceptual"><div class="phone-orb" aria-hidden="true"></div><div class="phone-device"><div class="phone-ui"><div class="phone-ui__top"><span>9:41</span><span>IsiVoltPro</span></div><h3>Mi trabajo</h3><p>Órdenes asignadas</p><article class="phone-task"><strong>OT · Cuadro QG-01</strong><small>Revisión general</small><span>En curso</span></article><article class="phone-task"><strong>OT · UTA-02</strong><small>Fallo de temperatura</small><span style="background:#fff0f4;color:#d83567">Prioritaria</span></article><article class="phone-task"><strong>OT · Bomba ACS</strong><small>Preventivo</small><span style="background:#f2efff;color:#6544e8">Programada</span></article><div class="phone-nav"><span>Inicio</span><span>OT</span><span>Escanear</span><span>Más</span></div></div></div><div class="qr-card"><div class="qr" aria-hidden="true">{Array.from({length:25}).map(() => <i></i>)}</div><small>QR del equipo</small></div></div></div></section>

    <section class="section section--soft" id="planes"><div class="shell"><div class="plans-intro reveal"><span class="eyebrow">Empieza pequeño. Amplía cuando lo necesites.</span><h2>Un IsiVoltPro para <span class="gradient-text">cada etapa.</span></h2><p>Estamos validando una estructura para profesional individual, equipo pequeño y empresa. Los precios definitivos se fijarán con pilotos, no con cifras inventadas.</p></div><div class="plan-grid"><article class="plan reveal"><h3>Autónomo</h3><p>Para profesionales que gestionan sus propios clientes y trabajos.</p><ul><li>Clientes y activos</li><li>OT y avisos</li><li>Preventivos</li><li>QR e histórico</li></ul><a class="btn" href={pricing}>Ver enfoque</a></article><article class="plan plan--featured reveal"><h3>Equipo</h3><p>Para pequeñas empresas que reparten trabajo entre varios técnicos.</p><ul><li>Usuarios y asignaciones</li><li>Vista de coordinación</li><li>Control de actividad</li><li>Documentación compartida</li></ul><a class="btn btn--primary" href={contact}>Solicitar demo</a></article><article class="plan reveal"><h3>Empresa</h3><p>Para mantenedoras con varios clientes, ubicaciones y necesidades especializadas.</p><ul><li>Organización multisede</li><li>Roles y permisos</li><li>Módulos adicionales</li><li>Implantación</li></ul><a class="btn" href={pricing}>Ver estructura</a></article></div><div class="home-more"><a class="btn" href={faq}>Resolver dudas frecuentes →</a></div></div></section>

    <section class="final-cta"><div class="final-cta__inner shell reveal"><div><h2>Que el trabajo técnico deje de vivir en tu cabeza.</h2><p>Organiza el día a día, conserva el histórico y comprueba si IsiVoltPro puede reducir la fricción de tu negocio.</p></div><a class="btn" href={contact}>Ver IsiVoltPro en una demo <span>→</span></a></div></section>
  </main>

  <V3CommercialFooter />

  <script is:inline>
    const intro = document.getElementById('intro');
    const skip = document.getElementById('skip-intro');
    const body = document.body;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let finished = false;
    const finishIntro = () => {
      if (finished) return;
      finished = true;
      try { sessionStorage.setItem('isivoltpro-intro-seen','1'); } catch (_) {}
      intro?.classList.add('is-done');
      body.classList.remove('intro-lock');
      window.setTimeout(() => intro?.setAttribute('aria-hidden','true'), 750);
    };
    let seen = false;
    try { seen = sessionStorage.getItem('isivoltpro-intro-seen') === '1'; } catch (_) {}
    if (seen || reduced || document.documentElement.classList.contains('skip-intro')) {
      intro?.classList.add('is-done'); body.classList.remove('intro-lock');
    } else window.setTimeout(finishIntro, 3200);
    skip?.addEventListener('click', finishIntro);

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
      });
    }, { threshold: .12 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>
</body>
</html>
---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#02040a" />
    <meta name="description" content="ISIVOLTPRO phase 2.8 coherent industrial digital twin composition." />
    <title>ISIVOLTPRO · Phase 2.8</title>
  </head>
  <body>
    <canvas id="webgl" aria-hidden="true"></canvas>

    <header class="topbar">
      <a class="brand" href={base}>ISIVOLT<strong>PRO</strong></a>
      <span class="phase">FASE 2.8 / PLANT COMPOSITION</span>
      <a class="back" href={`${base}lab-3d-phase27/`}>BACK TO 2.7</a>
    </header>

    <aside class="metrics" aria-live="polite">
      <div><span>MECHANICAL</span><strong id="pipe-status">LOADING</strong></div>
      <div><span>HVAC</span><strong id="hvac-status">LOADING</strong></div>
      <div><span>HVAC UNIT</span><strong id="aircon-status">LOADING</strong></div>
      <div><span>ELECTRICAL</span><strong id="electrical-status">LOADING</strong></div>
      <div><span>REAL PIECES</span><strong id="piece-count">--</strong></div>
      <div><span>FPS</span><strong id="fps">--</strong></div>
      <div><span>TRIS</span><strong id="tris">--</strong></div>
    </aside>

    <main id="story">
      <section class="chapter active">
        <div class="copy">
          <p class="eyebrow">INDUSTRIAL DIGITAL TWIN</p>
          <h1>A plant.<br />Not a demo scene.</h1>
          <p class="body-copy">The same real assets are reorganised as one believable technical installation with service zones, access corridors and system hierarchy.</p>
          <span class="scroll-hint">ENTER THE PLANT <i>↓</i></span>
        </div>
      </section>

      <section class="chapter">
        <div class="copy right-copy">
          <p class="index">02 / MECHANICAL ROOM</p>
          <p class="eyebrow">TANKS · PUMPS · SUPPLY · RETURN</p>
          <h2>Equipment has<br />working space.</h2>
          <p class="body-copy">Headers run behind a dedicated pump line, tanks sit on a common slab and a clear maintenance aisle remains in front.</p>
        </div>
      </section>

      <section class="chapter">
        <div class="copy">
          <p class="index">03 / HVAC LEVEL</p>
          <p class="eyebrow">DUCTS · SUPPORTS · INDOOR MODULE</p>
          <h2>Air lives<br />above services.</h2>
          <p class="body-copy">The main circular duct follows a structural spine overhead, keeping the floor free and separating air distribution from refrigeration.</p>
        </div>
      </section>

      <section class="chapter">
        <div class="copy right-copy">
          <p class="index">04 / CLIMATE EQUIPMENT</p>
          <p class="eyebrow">OUTDOOR UNIT · REFRIGERANT CIRCUIT</p>
          <h2>The machine sits<br />where it belongs.</h2>
          <p class="body-copy">The exterior unit moves to a perimeter service pad with realistic clearance and a two-line refrigeration route back to the indoor module.</p>
        </div>
      </section>

      <section class="chapter">
        <div class="copy">
          <p class="index">05 / ELECTRICAL BAY</p>
          <p class="eyebrow">PANELS · CABLE TRAY · SAFE AISLE</p>
          <h2>Power has<br />a protected zone.</h2>
          <p class="body-copy">Real cabinets sit in a dedicated distribution bay with a front operating aisle, overhead tray and warmer practical lighting.</p>
        </div>
      </section>

      <section class="chapter">
        <div class="copy end-copy">
          <p class="index">06 / CORE</p>
          <p class="eyebrow">ONE INSTALLATION · ONE SYSTEM</p>
          <h2>Physical systems.<br />One operational view.</h2>
          <p class="body-copy">The Core stays visually central, but the plant now reads first as engineering and only then as digital technology.</p>
          <a class="lab-button" href={`${base}lab-3d-phase27/`}>COMPARE WITH 2.7 <span>→</span></a>
        </div>
      </section>
    </main>

    <div id="no-webgl" hidden>
      <strong>3D unavailable</strong>
      <p>This checkpoint needs WebGL.</p>
      <a href={base}>Return home</a>
    </div>

    <script>
      import * as THREE from 'three';
      import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
      import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
      import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
      import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';
      import { OutputPass } from 'three/examples/jsm/postprocessing/OutputPass.js';
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const PIPE_ASSET_URL = 'https://raw.githubusercontent.com/KrazIvan/GodotVR_Test/6dc918140151c3235406a3f616a765e11293285a/Ivan%20VR/models/props/pipe/modular_industrial_pipes_01_4k.gltf';
      const HVAC_ASSET_URL = 'https://raw.githubusercontent.com/Hona/daxship/d63856c6af9aba445a4fe8bf832d0e0ecf2572e5/apps/web/public/assets/models/environment/poly-haven/modular_airduct_circular_01/modular_airduct_circular_01_1k.gltf';
      const ELECTRICAL_ASSET_URL = 'https://raw.githubusercontent.com/adamkhatib/PeakBrake/87be08e1b90a6cfc59cd7364488cdca9053a16a3/public/assets/3d/polyhaven/utility_box_01/utility_box_01_1k.gltf';
      const AIRCON_ASSET_URL = 'https://raw.githubusercontent.com/VoxogoBrusch/the-levels/1e7c37785504d23d9a2f669b3b922eac14cedb01/public/assets/models/exterior_aircon_unit/exterior_aircon_unit_1k.gltf';
      const PIXEL = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Y9Zf6AAAAAASUVORK5CYII=';

      const canvas = document.querySelector('#webgl');
      const pipeStatus = document.querySelector('#pipe-status');
      const hvacStatus = document.querySelector('#hvac-status');
      const airconStatus = document.querySelector('#aircon-status');
      const electricalStatus = document.querySelector('#electrical-status');
      const pieceCountEl = document.querySelector('#piece-count');
      const fpsEl = document.querySelector('#fps');
      const trisEl = document.querySelector('#tris');
      const noWebgl = document.querySelector('#no-webgl');

      const supportsWebGL = (() => {
        try {
          const test = document.createElement('canvas');
          return Boolean(test.getContext('webgl2') || test.getContext('webgl'));
        } catch {
          return false;
        }
      })();

      if (!supportsWebGL || !(canvas instanceof HTMLCanvasElement)) {
        if (canvas) canvas.remove();
        if (noWebgl instanceof HTMLElement) noWebgl.hidden = false;
      } else {
        const mobile = window.matchMedia('(max-width: 760px)').matches;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: false,
          powerPreference: 'high-performance',
          stencil: false,
        });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, mobile ? 1.0 : 1.3));
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 0.93;
        renderer.shadowMap.enabled = !mobile;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;

        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x02050a);
        scene.fog = new THREE.FogExp2(0x02050a, 0.0225);

        const camera = new THREE.PerspectiveCamera(40, window.innerWidth / window.innerHeight, 0.1, 160);
        camera.position.set(-17, 8.5, 20);

        const composer = new EffectComposer(renderer);
        composer.addPass(new RenderPass(scene, camera));
        composer.addPass(new UnrealBloomPass(
          new THREE.Vector2(window.innerWidth, window.innerHeight),
          mobile ? 0.2 : 0.34,
          0.38,
          0.9,
        ));
        composer.addPass(new OutputPass());

        const world = new THREE.Group();
        scene.add(world);

        const concrete = new THREE.MeshStandardMaterial({ color: 0x0b1015, metalness: 0.05, roughness: 0.92 });
        const concreteLight = new THREE.MeshStandardMaterial({ color: 0x161d22, metalness: 0.06, roughness: 0.86 });
        const steel = new THREE.MeshStandardMaterial({ color: 0x18232b, metalness: 0.82, roughness: 0.34 });
        const panel = new THREE.MeshStandardMaterial({ color: 0x09131b, metalness: 0.52, roughness: 0.52 });
        const pipeSupply = new THREE.MeshStandardMaterial({ color: 0x71828c, metalness: 0.9, roughness: 0.27 });
        const pipeReturn = new THREE.MeshStandardMaterial({ color: 0x425864, metalness: 0.84, roughness: 0.33 });
        const copper = new THREE.MeshStandardMaterial({ color: 0x8b5b40, metalness: 0.9, roughness: 0.28 });
        const insulation = new THREE.MeshStandardMaterial({ color: 0x1b3440, metalness: 0.15, roughness: 0.64 });
        const safety = new THREE.MeshStandardMaterial({ color: 0x7b6a22, emissive: 0x2e2400, emissiveIntensity: 0.4, roughness: 0.62 });
        const warmMetal = new THREE.MeshStandardMaterial({ color: 0x53331f, metalness: 0.6, roughness: 0.45 });
        const cyanGlow = new THREE.MeshStandardMaterial({ color: 0x052f42, emissive: 0x00d9ff, emissiveIntensity: 2.5, metalness: 0.48, roughness: 0.22 });
        const blueGlow = new THREE.MeshStandardMaterial({ color: 0x051c35, emissive: 0x0879ff, emissiveIntensity: 1.8, metalness: 0.6, roughness: 0.24 });
        const electricGlow = new THREE.MeshStandardMaterial({ color: 0x302805, emissive: 0xffc928, emissiveIntensity: 2.0, metalness: 0.4, roughness: 0.3 });

        const floor = new THREE.Mesh(new THREE.PlaneGeometry(70, 52), concrete);
        floor.rotation.x = -Math.PI / 2;
        floor.position.y = -0.06;
        floor.receiveShadow = true;
        world.add(floor);

        const grid = new THREE.GridHelper(70, 70, 0x12384a, 0x091921);
        grid.position.y = 0.005;
        grid.material.transparent = true;
        grid.material.opacity = 0.1;
        world.add(grid);

        function addSlab(x: number, z: number, w: number, d: number, h = 0.12, material: THREE.Material = concreteLight) {
          const slab = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), material);
          slab.position.set(x, h / 2, z);
          slab.receiveShadow = true;
          world.add(slab);
          return slab;
        }

        function addWall(x: number, z: number, w: number, h: number, d = 0.16) {
          const wall = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), panel);
          wall.position.set(x, h / 2, z);
          wall.castShadow = !mobile;
          wall.receiveShadow = true;
          world.add(wall);
          return wall;
        }

        function addPost(x: number, y: number, z: number, height: number, material: THREE.Material = steel) {
          const post = new THREE.Mesh(new THREE.BoxGeometry(0.12, height, 0.12), material);
          post.position.set(x, y + height / 2, z);
          post.castShadow = !mobile;
          world.add(post);
          return post;
        }

        function addBeam(x: number, y: number, z: number, length: number, rotationY = 0) {
          const beam = new THREE.Mesh(new THREE.BoxGeometry(length, 0.12, 0.12), steel);
          beam.position.set(x, y, z);
          beam.rotation.y = rotationY;
          beam.castShadow = !mobile;
          world.add(beam);
          return beam;
        }

        function addSafetyStripe(x: number, z: number, w: number, d: number) {
          const stripe = new THREE.Mesh(new THREE.BoxGeometry(w, 0.018, d), safety);
          stripe.position.set(x, 0.075, z);
          world.add(stripe);
        }

        function makeTube(points: THREE.Vector3[], radius: number, material: THREE.Material) {
          const curve = new THREE.CatmullRomCurve3(points);
          const mesh = new THREE.Mesh(new THREE.TubeGeometry(curve, 42, radius, 10, false), material);
          mesh.castShadow = !mobile;
          mesh.receiveShadow = true;
          world.add(mesh);
          return mesh;
        }

        // Plant zoning: central Core plaza, mechanical room, HVAC spine, electrical bay and perimeter climate pad.
        addSlab(-6.0, -5.4, 14.5, 10.0);
        addSlab(8.8, -7.0, 9.4, 6.6);
        addSlab(9.6, 1.7, 6.6, 5.6);
        addSlab(0, 0.2, 7.2, 7.2, 0.14);

        addWall(-12.7, -5.4, 0.2, 4.4, 10.0);
        addWall(-6.0, -10.3, 13.7, 4.4, 0.18);
        addWall(8.8, -10.2, 8.8, 4.0, 0.18);
        addWall(13.3, -7.0, 0.2, 4.0, 6.4);
        addWall(12.9, 1.7, 0.2, 3.1, 5.6);

        // Service aisles and protection lines.
        addSafetyStripe(-5.8, -1.4, 13.4, 0.08);
        addSafetyStripe(8.8, -3.5, 8.4, 0.08);
        addSafetyStripe(4.0, 4.6, 17.0, 0.06);

        // Mechanical room: tank bank at rear, pumps at front, shared headers between them.
        const tankGroup = new THREE.Group();
        tankGroup.position.set(-6.4, 0.12, -7.7);
        world.add(tankGroup);
        [-3.3, -1.1, 1.1, 3.3].forEach((x, index) => {
          const base = new THREE.Mesh(new THREE.CylinderGeometry(0.72, 0.78, 0.2, 24), concreteLight);
          base.position.set(x, 0.1, 0);
          tankGroup.add(base);
          const tank = new THREE.Mesh(new THREE.CylinderGeometry(0.62, 0.62, 3.0 + (index % 2) * 0.28, 28), steel);
          tank.position.set(x, 1.7, 0);
          tank.castShadow = !mobile;
          tank.receiveShadow = true;
          tankGroup.add(tank);
          const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 0.16, 18), warmMetal);
          cap.position.set(x, 3.25 + (index % 2) * 0.14, 0);
          tankGroup.add(cap);
        });

        const pumpGroup = new THREE.Group();
        pumpGroup.position.set(-6.0, 0.12, -3.2);
        world.add(pumpGroup);
        [-3.0, -1.0, 1.0, 3.0].forEach((x, index) => {
          const skid = new THREE.Group();
          skid.position.x = x;
          const plate = new THREE.Mesh(new THREE.BoxGeometry(1.55, 0.18, 1.05), steel);
          plate.position.y = 0.09;
          skid.add(plate);
          const motor = new THREE.Mesh(new THREE.CylinderGeometry(0.34, 0.34, 0.9, 18), panel);
          motor.rotation.z = Math.PI / 2;
          motor.position.set(-0.2, 0.55, 0);
          motor.castShadow = !mobile;
          skid.add(motor);
          const pump = new THREE.Mesh(new THREE.CylinderGeometry(0.28, 0.28, 0.48, 18), warmMetal);
          pump.rotation.z = Math.PI / 2;
          pump.position.set(0.58, 0.55, 0);
          skid.add(pump);
          const led = new THREE.Mesh(new THREE.SphereGeometry(0.045, 10, 10), index === 2 ? electricGlow : cyanGlow);
          led.position.set(0.58, 0.72, 0.42);
          skid.add(led);
          pumpGroup.add(skid);
        });

        // Pipe rack support structure follows the rear wall and stays out of the operating aisle.
        [-11.5, -8.1, -4.7, -1.3].forEach((x) => {
          addPost(x, 0.12, -5.9, 4.2);
          addBeam(x, 2.55, -5.9, 1.35, Math.PI / 2);
          addBeam(x, 3.65, -5.9, 1.35, Math.PI / 2);
        });

        // HVAC structural spine over the central service corridor.
        [-8.8, -4.4, 0, 4.4, 8.8].forEach((x) => {
          addPost(x, 0.12, 3.25, 5.5);
          addBeam(x, 5.45, 3.25, 2.0, Math.PI / 2);
        });
        addBeam(0, 5.45, 3.25, 18.0, 0);

        // Indoor climate module below the HVAC spine.
        const indoorModule = new THREE.Group();
        indoorModule.position.set(5.0, 0.12, 0.6);
        world.add(indoorModule);
        const indoorBody = new THREE.Mesh(new THREE.BoxGeometry(2.6, 2.1, 2.05), panel);
        indoorBody.position.y = 1.1;
        indoorBody.castShadow = !mobile;
        indoorModule.add(indoorBody);
        const indoorAccess = new THREE.Mesh(new THREE.BoxGeometry(0.04, 1.45, 1.25), steel);
        indoorAccess.position.set(1.32, 1.05, 0);
        indoorModule.add(indoorAccess);
        const indoorRing = new THREE.Mesh(new THREE.TorusGeometry(0.48, 0.035, 10, 42), cyanGlow);
        indoorRing.position.set(-1.32, 1.18, 0);
        indoorRing.rotation.y = Math.PI / 2;
        indoorModule.add(indoorRing);

        // Perimeter outdoor unit pad: generous clearance and no fake duct connection.
        const hvacPad = new THREE.Group();
        hvacPad.position.set(9.6, 0.12, 1.7);
        world.add(hvacPad);
        const pad = new THREE.Mesh(new THREE.BoxGeometry(3.5, 0.2, 2.8), concreteLight);
        pad.position.y = 0.1;
        pad.receiveShadow = true;
        hvacPad.add(pad);
        const curb = new THREE.Mesh(new THREE.BoxGeometry(2.9, 0.14, 2.15), steel);
        curb.position.y = 0.26;
        hvacPad.add(curb);
        addSafetyStripe(9.6, 0.0, 3.8, 0.06);
        addSafetyStripe(9.6, 3.4, 3.8, 0.06);

        // Electrical bay: cabinet line with front operating aisle and overhead cable tray.
        const electricalBay = new THREE.Group();
        electricalBay.position.set(8.8, 0.12, -7.0);
        world.add(electricalBay);
        const electricalPlinth = new THREE.Mesh(new THREE.BoxGeometry(7.5, 0.24, 1.8), steel);
        electricalPlinth.position.set(0, 0.12, -1.15);
        electricalBay.add(electricalPlinth);
        const tray = new THREE.Mesh(new THREE.BoxGeometry(7.6, 0.12, 0.68), steel);
        tray.position.set(0, 2.7, -0.65);
        electricalBay.add(tray);
        const traySignal = new THREE.Mesh(new THREE.BoxGeometry(7.1, 0.025, 0.03), electricGlow);
        traySignal.position.set(0, 2.69, -1.02);
        electricalBay.add(traySignal);
        [-3.4, -1.7, 0, 1.7, 3.4].forEach((x) => {
          const hanger = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.8, 0.07), steel);
          hanger.position.set(x, 3.08, -0.65);
          electricalBay.add(hanger);
        });

        // Guard rail separates electrical operating aisle from the main circulation route.
        [-3.2, 0, 3.2].forEach((x) => addPost(8.8 + x, 0.12, -3.9, 1.1, warmMetal));
        addBeam(8.8, 1.12, -3.9, 6.5, 0);

        let pipePieces = 0;
        let ductPieces = 0;
        let airconPieces = 0;
        let electricalPieces = 0;
        const pipeNetwork = new THREE.Group();
        const ductNetwork = new THREE.Group();
        const airconNetwork = new THREE.Group();
        const electricalNetwork = new THREE.Group();
        world.add(pipeNetwork, ductNetwork, airconNetwork, electricalNetwork);

        function updatePieceCount() {
          if (pieceCountEl) pieceCountEl.textContent = String(pipePieces + ductPieces + airconPieces + electricalPieces);
        }

        const pipeManager = new THREE.LoadingManager();
        pipeManager.setURLModifier((url) => url.includes('/textures/') ? PIXEL : url);
        new GLTFLoader(pipeManager).load(
          PIPE_ASSET_URL,
          (gltf) => {
            const source = new Map<string, THREE.Object3D>();
            gltf.scene.children.forEach((child) => source.set(child.name, child));

            const addPipe = (
              name: string,
              position: [number, number, number],
              rotation: [number, number, number],
              scale: number,
              material: THREE.Material,
            ) => {
              const original = source.get(name);
              if (!original) return;
              const piece = original.clone(true);
              piece.position.set(...position);
              piece.rotation.set(...rotation);
              piece.scale.setScalar(scale);
              piece.traverse((object: THREE.Object3D) => {
                if (object instanceof THREE.Mesh) {
                  object.material = material;
                  object.castShadow = !mobile;
                  object.receiveShadow = true;
                }
              });
              pipeNetwork.add(piece);
              pipePieces += 1;
            };

            // Two believable rear headers.
            [-10.8, -7.4, -4.0, -0.6].forEach((x) => {
              addPipe('modular_industrial_pipes_01_pipe02', [x, 3.55, -6.15], [0, 0, Math.PI / 2], 1.35, pipeSupply);
              addPipe('modular_industrial_pipes_01_pipe02', [x, 2.45, -5.75], [0, 0, Math.PI / 2], 1.35, pipeReturn);
            });

            // Drops to tank bank.
            [-9.7, -7.5, -5.3, -3.1].forEach((x, index) => {
              addPipe('modular_industrial_pipes_01_pipe01', [x, 2.0, -7.3], [0, 0, 0], 1.1, index % 2 ? pipeReturn : pipeSupply);
            });

            // Pump manifold and end bends.
            [-9.0, -6.8, -4.6, -2.4].forEach((x, index) => {
              addPipe('modular_industrial_pipes_01_pipe01', [x, 1.45, -4.2], [0, Math.PI / 2, Math.PI / 2], 0.95, index % 2 ? pipeReturn : pipeSupply);
            });
            addPipe('modular_industrial_pipes_01_pipe05', [-11.45, 3.5, -6.1], [0, 0, Math.PI / 2], 1.15, pipeSupply);
            addPipe('modular_industrial_pipes_01_pipe05', [-11.45, 2.4, -5.7], [Math.PI, 0, Math.PI / 2], 1.15, pipeReturn);

            if (pipeStatus) pipeStatus.textContent = 'READY';
            updatePieceCount();
          },
          undefined,
          (error) => {
            console.error('Phase 2.8 mechanical network failed', error);
            if (pipeStatus) pipeStatus.textContent = 'ERROR';
          },
        );

        new GLTFLoader().load(
          HVAC_ASSET_URL,
          (gltf) => {
            const source = new Map<string, THREE.Object3D>();
            gltf.scene.children.forEach((child) => source.set(child.name, child));

            const addDuct = (
              name: string,
              position: [number, number, number],
              rotation: [number, number, number],
              scale = 1,
            ) => {
              const original = source.get(name);
              if (!original) return;
              const piece = original.clone(true);
              piece.position.set(...position);
              piece.rotation.set(...rotation);
              piece.scale.setScalar(scale);
              piece.traverse((object: THREE.Object3D) => {
                if (object instanceof THREE.Mesh) {
                  object.castShadow = !mobile;
                  object.receiveShadow = true;
                }
              });
              ductNetwork.add(piece);
              ductPieces += 1;
            };

            // Continuous main duct on the structural spine.
            [-8.8, -5.3, -1.8, 1.7, 5.2, 8.7].forEach((x) => {
              addDuct('modular_airduct_circular_triple', [x, 5.05, 3.25], [0, Math.PI / 2, 0], 1.52);
            });
            addDuct('modular_airduct_circular_fan', [0.0, 5.05, 3.25], [0, Math.PI / 2, 0], 1.48);

            // Branch to indoor module; no connection to outdoor condenser.
            addDuct('modular_airduct_circular_smooth_bend_quater', [4.2, 5.05, 3.15], [0, Math.PI, Math.PI / 2], 1.52);
            addDuct('modular_airduct_circular_smooth_triple', [4.2, 5.05, 1.2], [0, 0, 0], 1.48);
            addDuct('modular_airduct_circular_smooth_bend_quater', [4.2, 2.95, 0.65], [Math.PI / 2, 0, 0], 1.5);

            if (hvacStatus) hvacStatus.textContent = 'READY';
            updatePieceCount();
          },
          undefined,
          (error) => {
            console.error('Phase 2.8 HVAC network failed', error);
            if (hvacStatus) hvacStatus.textContent = 'ERROR';
          },
        );

        const airconManager = new THREE.LoadingManager();
        airconManager.setURLModifier((url) => url.includes('_rusted_') ? PIXEL : url);
        new GLTFLoader(airconManager).load(
          AIRCON_ASSET_URL,
          (gltf) => {
            const clean = gltf.scene.getObjectByName('exterior_aircon_unit');
            if (!clean) {
              if (airconStatus) airconStatus.textContent = 'ERROR';
              return;
            }
            const unit = clean.clone(true);
            unit.position.set(9.6, 0.55, 1.7);
            unit.rotation.y = -Math.PI / 2;
            unit.scale.setScalar(2.15);
            unit.traverse((object: THREE.Object3D) => {
              if (object instanceof THREE.Mesh) {
                object.castShadow = !mobile;
                object.receiveShadow = true;
              }
            });
            airconNetwork.add(unit);
            airconPieces = 1;
            if (airconStatus) airconStatus.textContent = 'READY';
            updatePieceCount();
          },
          undefined,
          (error) => {
            console.error('Phase 2.8 exterior HVAC unit failed', error);
            if (airconStatus) airconStatus.textContent = 'ERROR';
          },
        );

        new GLTFLoader().load(
          ELECTRICAL_ASSET_URL,
          (gltf) => {
            const cabinet = gltf.scene;
            cabinet.traverse((object: THREE.Object3D) => {
              if (object instanceof THREE.Mesh) {
                object.castShadow = !mobile;
                object.receiveShadow = true;
              }
            });

            [-2.8, -1.4, 0, 1.4, 2.8].forEach((x, index) => {
              const unit = cabinet.clone(true);
              unit.position.set(8.8 + x, 0.36, -8.15);
              unit.rotation.y = Math.PI;
              unit.scale.setScalar(index === 2 ? 1.4 : 1.3);
              electricalNetwork.add(unit);
              electricalPieces += 1;
            });

            if (electricalStatus) electricalStatus.textContent = 'READY';
            updatePieceCount();
          },
          undefined,
          (error) => {
            console.error('Phase 2.8 electrical bay failed', error);
            if (electricalStatus) electricalStatus.textContent = 'ERROR';
          },
        );

        // Refrigeration circuit: two physically separate lines between indoor and outdoor equipment.
        makeTube([
          new THREE.Vector3(6.25, 1.0, 0.4),
          new THREE.Vector3(7.2, 1.2, 0.4),
          new THREE.Vector3(8.1, 1.0, 0.8),
          new THREE.Vector3(9.0, 1.0, 1.35),
        ], 0.045, copper);
        makeTube([
          new THREE.Vector3(6.25, 1.18, 0.65),
          new THREE.Vector3(7.15, 1.38, 0.65),
          new THREE.Vector3(8.0, 1.2, 1.05),
          new THREE.Vector3(9.0, 1.18, 1.55),
        ], 0.075, insulation);

        // CORE remains procedural until Phase 3, but its surrounding plaza is now kept clear.
        const core = new THREE.Group();
        world.add(core);
        const corePlinth = new THREE.Mesh(new THREE.CylinderGeometry(2.15, 2.5, 0.42, 56), steel);
        corePlinth.position.y = 0.35;
        core.add(corePlinth);
        const coreBody = new THREE.Mesh(new THREE.CylinderGeometry(0.7, 0.92, 4.3, 42), steel);
        coreBody.position.y = 2.65;
        core.add(coreBody);
        const energy = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 3.5, 24), cyanGlow);
        energy.position.y = 2.7;
        core.add(energy);
        const rings: THREE.Mesh[] = [];
        [1.25, 2.35, 3.45, 4.5].forEach((y, index) => {
          const ring = new THREE.Mesh(new THREE.TorusGeometry(1.04 + index * 0.055, 0.03, 8, 64), index % 2 ? blueGlow : cyanGlow);
          ring.rotation.x = Math.PI / 2;
          ring.position.y = y;
          core.add(ring);
          rings.push(ring);
        });
        const halo = new THREE.Mesh(new THREE.TorusGeometry(1.85, 0.045, 10, 80), cyanGlow);
        halo.rotation.x = Math.PI / 2;
        halo.position.y = 0.65;
        core.add(halo);
        const beam = new THREE.Mesh(
          new THREE.CylinderGeometry(0.055, 0.055, 12, 12),
          new THREE.MeshBasicMaterial({ color: 0x42dfff, transparent: true, opacity: 0.24, depthWrite: false }),
        );
        beam.position.y = 7.0;
        core.add(beam);

        // Digital connections are secondary, thin and system-specific.
        function createConnection(
          start: THREE.Vector3,
          end: THREE.Vector3,
          height: number,
          material: THREE.Material = cyanGlow,
        ) {
          const mid = start.clone().lerp(end, 0.5);
          mid.y += height;
          const curve = new THREE.CatmullRomCurve3([start, mid, end]);
          const tube = new THREE.Mesh(new THREE.TubeGeometry(curve, 30, 0.018, 7, false), material);
          world.add(tube);
          const pulse = new THREE.Mesh(new THREE.SphereGeometry(0.05, 10, 10), material);
          world.add(pulse);
          return { curve, pulse, offset: Math.random() };
        }

        const connections = [
          createConnection(new THREE.Vector3(-1.1, 0.72, -0.4), new THREE.Vector3(-6.0, 1.2, -4.4), 1.0),
          createConnection(new THREE.Vector3(0.7, 1.0, 0.6), new THREE.Vector3(3.6, 4.7, 3.25), 1.5),
          createConnection(new THREE.Vector3(1.0, 0.9, 0.1), new THREE.Vector3(9.2, 1.2, 1.7), 1.1),
          createConnection(new THREE.Vector3(0.8, 0.75, -0.8), new THREE.Vector3(8.8, 1.4, -7.5), 1.35, electricGlow),
        ];

        // Lighting: mostly practical industrial light; digital blue remains an accent.
        scene.add(new THREE.HemisphereLight(0x6f9eb4, 0x020407, 1.1));
        const key = new THREE.DirectionalLight(0xc7e3ee, 2.5);
        key.position.set(-10, 15, 8);
        key.castShadow = !mobile;
        scene.add(key);

        const mechanicalLight = new THREE.PointLight(0xffa55c, 8.0, 15, 2.0);
        mechanicalLight.position.set(-6.5, 5.0, -5.5);
        scene.add(mechanicalLight);
        const hvacLight = new THREE.PointLight(0x8eddf2, 7.0, 15, 2.0);
        hvacLight.position.set(1.5, 6.5, 3.2);
        scene.add(hvacLight);
        const climateLight = new THREE.PointLight(0xb5eaff, 6.0, 10, 2.0);
        climateLight.position.set(9.5, 3.5, 1.7);
        scene.add(climateLight);
        const electricalLight = new THREE.PointLight(0xffb95c, 9.0, 12, 2.0);
        electricalLight.position.set(8.8, 4.0, -7.6);
        scene.add(electricalLight);
        const coreLight = new THREE.PointLight(0x00d9ff, mobile ? 10 : 18, 13, 1.7);
        coreLight.position.set(0, 3.0, 0);
        scene.add(coreLight);

        // Small practical ceiling luminaires in the two technical rooms.
        [-10.5, -6.3, -2.1].forEach((x) => {
          const lamp = new THREE.Mesh(new THREE.BoxGeometry(1.1, 0.06, 0.18), new THREE.MeshBasicMaterial({ color: 0xffd8a0 }));
          lamp.position.set(x, 4.15, -8.9);
          world.add(lamp);
        });
        [6.0, 8.8, 11.6].forEach((x) => {
          const lamp = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.06, 0.18), new THREE.MeshBasicMaterial({ color: 0xffd39a }));
          lamp.position.set(x, 3.7, -9.1);
          world.add(lamp);
        });

        const particleCount = mobile ? 90 : 220;
        const positions = new Float32Array(particleCount * 3);
        for (let i = 0; i < particleCount; i += 1) {
          positions[i * 3] = (Math.random() - 0.5) * 52;
          positions[i * 3 + 1] = Math.random() * 9 + 0.4;
          positions[i * 3 + 2] = (Math.random() - 0.5) * 38;
        }
        const particleGeometry = new THREE.BufferGeometry();
        particleGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        const particles = new THREE.Points(
          particleGeometry,
          new THREE.PointsMaterial({ color: 0x7cb6c7, size: 0.018, transparent: true, opacity: 0.16, depthWrite: false }),
        );
        world.add(particles);

        // Camera follows real service logic instead of orbiting random objects.
        const cameraPath = new THREE.CatmullRomCurve3([
          new THREE.Vector3(-17, 8.5, 20),
          new THREE.Vector3(-13.5, 5.6, 10.0),
          new THREE.Vector3(-11.2, 3.2, -1.0),
          new THREE.Vector3(-9.0, 2.8, -5.0),
          new THREE.Vector3(-3.5, 4.3, -2.0),
          new THREE.Vector3(-2.0, 6.5, 5.8),
          new THREE.Vector3(6.5, 5.3, 6.5),
          new THREE.Vector3(12.8, 3.5, 3.8),
          new THREE.Vector3(13.0, 3.3, -6.5),
          new THREE.Vector3(8.0, 3.0, -11.5),
          new THREE.Vector3(4.0, 5.7, -7.5),
          new THREE.Vector3(7.0, 7.0, 12.5),
        ]);
        const targetPath = new THREE.CatmullRomCurve3([
          new THREE.Vector3(0, 2.0, 0),
          new THREE.Vector3(-4.0, 2.0, -2.0),
          new THREE.Vector3(-6.0, 1.4, -3.4),
          new THREE.Vector3(-6.0, 2.0, -7.0),
          new THREE.Vector3(-1.0, 2.2, 0),
          new THREE.Vector3(0, 4.8, 3.2),
          new THREE.Vector3(5.0, 2.0, 0.7),
          new THREE.Vector3(9.6, 1.4, 1.7),
          new THREE.Vector3(8.8, 1.5, -7.5),
          new THREE.Vector3(8.8, 1.6, -8.0),
          new THREE.Vector3(0, 2.8, 0),
          new THREE.Vector3(0, 2.8, 0),
        ]);

        const state = { progress: 0 };
        const chapters = Array.from(document.querySelectorAll('.chapter'));
        ScrollTrigger.create({
          trigger: '#story',
          start: 'top top',
          end: 'bottom bottom',
          scrub: reducedMotion ? false : 1.1,
          onUpdate: (self) => {
            state.progress = self.progress;
            const active = Math.min(chapters.length - 1, Math.floor(self.progress * chapters.length));
            chapters.forEach((chapter, index) => chapter.classList.toggle('active', index === active));
          },
        });

        const clock = new THREE.Clock();
        let frames = 0;
        let fpsStart = performance.now();
        let raf = 0;
        let visible = true;

        function render(now = performance.now()) {
          const elapsed = clock.getElapsedTime();
          const progress = reducedMotion ? 0.9 : THREE.MathUtils.clamp(state.progress, 0.001, 0.999);
          camera.position.lerp(cameraPath.getPointAt(progress), reducedMotion ? 1 : 0.07);
          camera.lookAt(targetPath.getPointAt(progress));

          core.rotation.y = elapsed * 0.035;
          halo.rotation.z = elapsed * 0.12;
          rings.forEach((ring, index) => {
            ring.rotation.z = elapsed * (0.08 + index * 0.015) * (index % 2 ? -1 : 1);
          });
          particles.rotation.y = elapsed * 0.002;
          connections.forEach(({ curve, pulse, offset }, index) => {
            pulse.position.copy(curve.getPointAt((elapsed * (0.09 + index * 0.012) + offset) % 1));
          });

          composer.render();
          frames += 1;
          if (now - fpsStart >= 1000) {
            if (fpsEl) fpsEl.textContent = String(Math.round((frames * 1000) / (now - fpsStart)));
            if (trisEl) trisEl.textContent = renderer.info.render.triangles.toLocaleString();
            frames = 0;
            fpsStart = now;
          }
          if (visible) raf = requestAnimationFrame(render);
        }

        function resize() {
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, window.innerWidth <= 760 ? 1.0 : 1.3));
          renderer.setSize(window.innerWidth, window.innerHeight);
          composer.setSize(window.innerWidth, window.innerHeight);
        }

        window.addEventListener('resize', resize, { passive: true });
        document.addEventListener('visibilitychange', () => {
          visible = !document.hidden;
          if (visible) {
            cancelAnimationFrame(raf);
            clock.getDelta();
            frames = 0;
            fpsStart = performance.now();
            render();
          }
        });

        render();
      }
    </script>
  </body>
</html>


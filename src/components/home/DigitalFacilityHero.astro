---
import { heroApprovedImage } from '../../data/hero-approved-image';

const base = import.meta.env.BASE_URL;
const mediaSrc = `${base}video/hero-home-calidad-original.mp4`;
---
<section class="v2-hero" data-v2-hero aria-labelledby="v2-hero-title">
  <div class="v2-hero__stage" data-v2-stage>
    <video class="v2-hero__media" data-v2-backdrop muted playsinline preload="metadata" aria-hidden="true">
      <source src={mediaSrc} type="video/mp4" />
    </video>
    <img class="v2-hero__approved" src={heroApprovedImage} alt="" aria-hidden="true" />

    <div class="v2-hero__veil" aria-hidden="true"></div>
    <div class="v2-hero__grid" aria-hidden="true"></div>
    <div class="v2-hero__canvas" data-v2-canvas aria-hidden="true"></div>

    <header class="v2-hero__header shell">
      <a class="v2-brand" href={base} aria-label="IsiVoltPro">
        <span class="v2-brand__mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>ISIVOLT<strong>PRO</strong></span>
      </a>

      <nav class="v2-nav" aria-label="Navegación principal">
        <a href={`${base}ecosistema/`}>Ecosistema</a>
        <a href={`${base}aplicaciones/`}>Aplicaciones</a>
        <a href={`${base}mantenimiento/`}>Cómo funciona</a>
        <a href={`${base}recursos/`}>Recursos</a>
        <a href={`${base}empresa/`}>Empresa</a>
      </nav>

      <div class="v2-header__actions">
        <a class="v2-btn" href={`${base}acceso/`}>Acceder <span>↗</span></a>
        <a class="v2-btn v2-btn--blue v2-btn--demo" href={`${base}contacto/`}>Solicitar demo <span>→</span></a>
        <button class="v2-menu" type="button" aria-label="Abrir menú"><i></i><i></i><i></i></button>
      </div>
    </header>

    <div class="v2-hero__index" aria-hidden="true"><span>01</span><i></i></div>

    <div class="v2-hero__copy v2-hero__copy--left">
      <p class="v2-kicker">DIGITAL FACILITY</p>
      <h1 id="v2-hero-title">TODA TU<br />INSTALACIÓN</h1>
      <p class="v2-hero__lead">IsiVoltPro centraliza la operación, conecta tus equipos y conserva el contexto técnico de cada activo de tu instalación.</p>
    </div>

    <div class="v2-hero__copy v2-hero__copy--right">
      <h2>CONECTADA A<br /><span>UN SOLO SISTEMA</span></h2>
      <p class="v2-hero__tagline">GESTIÓN TÉCNICA · TRAZABILIDAD · CONTROL TOTAL</p>
      <div class="v2-hero__cta">
        <a class="v2-btn v2-btn--blue" href={`${base}contacto/`}>Solicitar demo <span>→</span></a>
        <a class="v2-btn" href={`${base}aplicaciones/`}>Descubrir aplicaciones <span>↗</span></a>
      </div>
    </div>

    <div class="v2-node v2-node--assets" aria-hidden="true"><span class="v2-node__icon">◇</span><strong>Activos</strong><small>Identidad · Estado</small></div>
    <div class="v2-node v2-node--maintenance" aria-hidden="true"><span class="v2-node__icon">▤</span><strong>Mantenimiento</strong><small>Planificación · Control</small></div>
    <div class="v2-node v2-node--inspection" aria-hidden="true"><span class="v2-node__icon">✓</span><strong>Preinspecciones BT</strong><small>Seguridad · Cumplimiento</small></div>
    <div class="v2-node v2-node--orders" aria-hidden="true"><span class="v2-node__icon">▧</span><strong>Órdenes de trabajo</strong><small>Asignación · Actuación</small></div>
    <div class="v2-node v2-node--tools" aria-hidden="true"><span class="v2-node__icon">▱</span><strong>Herramientas</strong><small>QR / NFC · Trazabilidad</small></div>

    <div class="v2-hero__system" aria-hidden="true"><i></i><span>ISIVOLTPRO CORE · ONLINE</span></div>
    <div class="v2-hero__scroll" aria-hidden="true"><span>SCROLL PARA EXPLORAR</span><i></i></div>

    <div class="v2-hero__band" aria-label="Capacidades IsiVoltPro">
      <div><span>01</span><strong>ACTIVOS</strong><small>Identidad · ubicación · estado</small></div>
      <div><span>02</span><strong>ÓRDENES DE TRABAJO</strong><small>Asignación · actuación · cierre</small></div>
      <div><span>03</span><strong>MANTENIMIENTO</strong><small>Planificación · revisión · control</small></div>
      <div><span>04</span><strong>HISTÓRICO</strong><small>Trazabilidad · evidencia · contexto</small></div>
    </div>
  </div>
</section>

<script>
  import { initHeroSceneV2 } from '../../scripts/hero-scene-v2';
  import { initHeroScrollV2 } from '../../scripts/hero-scroll-v2';
  import { initHeroMediaV2 } from '../../scripts/hero-media-v2';
  initHeroSceneV2();
  initHeroScrollV2();
  initHeroMediaV2();
</script>

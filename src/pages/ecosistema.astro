---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const contact = `${base}contacto/`;
const product = `${base}producto/`;
const experience = `${base}experiencia/`;
---
<!doctype html><html lang="es"><head><V3Seo title="Ecosistema · IsiVoltPro" description="El ecosistema IsiVoltPro conecta clientes, instalaciones, activos, avisos, órdenes de trabajo, documentación e histórico en una única base técnica." path={`${base}ecosistema/`} />
<style is:inline>
.eco-page{background:#fff;overflow:hidden}.eco-page .page-shell{width:min(1180px,calc(100% - 44px))}.eco-hero{padding:80px 0 76px;background:radial-gradient(circle at 76% 30%,rgba(99,84,225,.12),transparent 27%),radial-gradient(circle at 92% 66%,rgba(47,188,143,.1),transparent 21%),#fff}.eco-hero__grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:68px;align-items:center}.eco-hero h1{margin:14px 0 18px;font:800 clamp(49px,4.8vw,70px)/.98 var(--v3-font-display,system-ui);letter-spacing:-.062em}.eco-hero h1 span{display:block;color:transparent;background:linear-gradient(90deg,#6854dd,#52a0d7 52%,#2db78a);-webkit-background-clip:text;background-clip:text}.eco-hero p{max-width:535px;color:#727d91;line-height:1.72}.eco-hero .btn--primary{background:#111827;border-color:#111827;color:#fff}.eco-map{position:relative;min-height:455px}.eco-window{position:absolute;inset:18px 20px 28px 18px;border:1px solid #e3e7f0;border-radius:26px;background:#fff;box-shadow:0 31px 78px rgba(57,65,111,.14);overflow:hidden}.eco-window__bar{height:44px;display:flex;align-items:center;justify-content:space-between;padding:0 15px;border-bottom:1px solid #edf0f5}.eco-window__bar strong{font-size:10px}.eco-window__bar small{color:#929baa;font-size:8px}.eco-window__body{display:grid;grid-template-columns:104px 1fr;height:calc(100% - 44px)}.eco-side{padding:17px 10px;background:#fafbfe;border-right:1px solid #edf0f5}.eco-side b{display:block;margin:0 7px 15px;font-size:10px}.eco-side span{display:block;margin:5px 0;padding:7px 8px;border-radius:8px;color:#8790a0;font-size:8px}.eco-side span:first-of-type{background:#f0edff;color:#6854d8;font-weight:800}.eco-canvas{padding:18px}.eco-canvas__top{display:flex;align-items:center;justify-content:space-between;gap:12px}.eco-canvas__top strong{font-size:17px}.eco-canvas__top span{padding:6px 8px;border-radius:999px;background:#eaf9f3;color:#158e68;font-size:8px;font-weight:800}.eco-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:15px 0}.eco-kpis div{padding:10px;border:1px solid #eceef4;border-radius:10px}.eco-kpis small{display:block;color:#929baa;font-size:7px}.eco-kpis b{display:block;margin-top:3px;font-size:18px}.eco-asset{padding:12px;border:1px solid #e9edf3;border-radius:12px;background:#fbfcff}.eco-asset__head{display:flex;justify-content:space-between;align-items:center}.eco-asset__head strong{font-size:10px}.eco-asset__head span{color:#169870;font-size:8px;font-weight:800}.eco-links{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:10px}.eco-links div{padding:8px;border-radius:8px;background:#fff;border:1px solid #edf0f5}.eco-links small{display:block;color:#919aaa;font-size:6px}.eco-links b{display:block;margin-top:3px;font-size:9px}.eco-chip{position:absolute;z-index:3;padding:11px 13px;border:1px solid #e4e8f0;border-radius:15px;background:#fff;box-shadow:0 14px 34px rgba(52,61,102,.14)}.eco-chip strong{display:block;font-size:9px}.eco-chip small{display:block;margin-top:3px;color:#8b95a5;font-size:7px}.eco-chip--a{right:0;top:54px}.eco-chip--b{left:0;bottom:62px}.eco-chip--c{right:24px;bottom:4px}.eco-chip--a strong{color:#6652d7}.eco-chip--b strong{color:#159b70}.eco-chip--c strong{color:#2698b2}.eco-flow{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}.eco-step{position:relative;min-height:175px;padding:20px 16px;border:1px solid #e6e9f0;border-radius:20px;background:#fff;box-shadow:0 12px 30px rgba(52,63,101,.055)}.eco-step b{display:grid;width:31px;height:31px;place-items:center;border-radius:10px;background:#f0edff;color:#6753d8;font-size:9px}.eco-step strong{display:block;margin-top:22px;font-size:17px}.eco-step small{display:block;margin-top:7px;color:#7a8598;line-height:1.48;font-size:10px}.eco-step:not(:last-child)::after{content:'→';position:absolute;right:-12px;top:50%;z-index:2;width:24px;height:24px;display:grid;place-items:center;border:1px solid #e2e6ee;border-radius:50%;background:#fff;color:#8590a2}.eco-proof{display:grid;grid-template-columns:.95fr 1.05fr;gap:46px;align-items:center}.eco-proof__board{padding:18px;border:1px solid #e5e8f0;border-radius:26px;background:linear-gradient(145deg,#f9fbff,#f6f2ff 52%,#effaf6);box-shadow:0 22px 54px rgba(53,63,102,.09)}.eco-proof__card{padding:18px;border:1px solid #e8ebf2;border-radius:17px;background:#fff}.eco-proof__card+.eco-proof__card{margin-top:10px}.eco-proof__card small{display:block;color:#8d96a6;font-size:8px}.eco-proof__card strong{display:block;margin-top:5px;font-size:14px}.eco-proof__card p{margin:7px 0 0;color:#778296;font-size:10px;line-height:1.5}@media(max-width:980px){.eco-hero__grid,.eco-proof{grid-template-columns:1fr}.eco-flow{grid-template-columns:repeat(3,1fr)}.eco-step::after{display:none}}@media(max-width:580px){.eco-page .page-shell{width:min(100% - 28px,1180px)}.eco-hero{padding:57px 0}.eco-hero h1{font-size:clamp(42px,12vw,56px)}.eco-map{min-height:370px}.eco-window{inset:15px 6px 24px}.eco-window__body{grid-template-columns:72px 1fr}.eco-side{padding:12px 5px}.eco-canvas{padding:12px}.eco-kpis{grid-template-columns:1fr 1fr}.eco-kpis div:last-child{display:none}.eco-links{grid-template-columns:1fr 1fr}.eco-chip--b{display:none}.eco-flow{grid-template-columns:1fr 1fr}.eco-step{min-height:145px}}@media(max-width:390px){.eco-flow{grid-template-columns:1fr}}
</style></head><body><V3CommercialHeader /><main class="page-main eco-page">
<section class="eco-hero"><div class="page-shell eco-hero__grid"><div><span class="eyebrow">Una sola fuente de verdad</span><h1>Lo físico y lo digital,<span>siempre conectados.</span></h1><p>IsiVoltPro organiza el trabajo alrededor de un cliente, una instalación y sus activos. Avisos, OT, revisiones, fotos y documentos heredan ese contexto y construyen un histórico útil.</p><div class="page-hero__actions"><a class="btn btn--primary" href={product}>Ver el producto →</a><a class="btn" href={experience}>Probar el recorrido</a></div></div><div class="eco-map" aria-label="Mapa conceptual del ecosistema IsiVoltPro"><div class="eco-window"><div class="eco-window__bar"><strong>IsiVoltPro · contexto conectado</strong><small>Datos ficticios de demostración</small></div><div class="eco-window__body"><aside class="eco-side"><b>IsiVoltPro</b><span>Resumen</span><span>Clientes</span><span>Activos</span><span>Trabajo</span><span>Documentos</span></aside><div class="eco-canvas"><div class="eco-canvas__top"><strong>Climatizadora UTA-04</strong><span>Activo</span></div><div class="eco-kpis"><div><small>OT históricas</small><b>12</b></div><div><small>Documentos</small><b>4</b></div><div><small>Preventivos</small><b>3</b></div></div><div class="eco-asset"><div class="eco-asset__head"><strong>Todo alrededor del mismo activo</strong><span>Contexto listo</span></div><div class="eco-links"><div><small>AVISO</small><b>#148</b></div><div><small>OT</small><b>En curso</b></div><div><small>FOTOS</small><b>6</b></div><div><small>HISTÓRICO</small><b>Visible</b></div></div></div></div></div></div><div class="eco-chip eco-chip--a"><strong>Instalación</strong><small>Edificio Norte</small></div><div class="eco-chip eco-chip--b"><strong>Trabajo</strong><small>OT + evidencia</small></div><div class="eco-chip eco-chip--c"><strong>Histórico</strong><small>La información permanece</small></div></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Seis capas</span><h2>De la instalación<br/><span class="gradient-text">al conocimiento.</span></h2></div><p>El ecosistema evita que cada módulo cree su propia isla. Todo reutiliza la misma estructura de clientes, ubicaciones, activos y usuarios.</p></div><div class="eco-flow"><article class="eco-step"><b>01</b><strong>Instalación</strong><small>Edificio, local, nave o ubicación.</small></article><article class="eco-step"><b>02</b><strong>Activo</strong><small>Equipo o sistema concreto.</small></article><article class="eco-step"><b>03</b><strong>Trabajo</strong><small>Avisos, OT y revisiones.</small></article><article class="eco-step"><b>04</b><strong>Evidencia</strong><small>Fotos, notas e informes.</small></article><article class="eco-step"><b>05</b><strong>Histórico</strong><small>Qué ocurrió y cómo terminó.</small></article><article class="eco-step"><b>06</b><strong>Contexto</strong><small>Lo que verá el siguiente técnico.</small></article></div></div></section>
<section class="page-section"><div class="page-shell eco-proof"><div><span class="eyebrow">La diferencia</span><h2>No son aplicaciones juntas.<br/><span class="gradient-text">Son datos relacionados.</span></h2><p>Una OT aislada puede cerrar un trabajo. IsiVoltPro pretende que ese cierre mejore también la historia del activo, el mantenimiento del cliente y la información disponible para la siguiente intervención.</p><div class="page-hero__actions"><a class="btn btn--primary" href={contact}>Verlo sobre mi negocio →</a></div></div><div class="eco-proof__board"><article class="eco-proof__card"><small>IDENTIDAD</small><strong>Un activo, una referencia</strong><p>El mismo equipo aparece en avisos, OT, preventivos y documentos sin duplicarse.</p></article><article class="eco-proof__card"><small>REUTILIZACIÓN</small><strong>Escribir una vez, aprovechar después</strong><p>Ubicación, documentación e histórico acompañan al trabajo siguiente.</p></article><article class="eco-proof__card"><small>MEMORIA TÉCNICA</small><strong>Cada intervención deja conocimiento</strong><p>La próxima persona no empieza de cero delante del equipo.</p></article></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="callout"><div><h2>Empieza por un flujo pequeño. El ecosistema crece después.</h2><p>La arquitectura está pensada para añadir capacidades sin complicar la experiencia de quien solo necesita lo esencial.</p></div><a class="btn btn--primary" href={experience}>Probar IsiVoltPro →</a></div></div></section>
</main><V3CommercialFooter /></body></html>
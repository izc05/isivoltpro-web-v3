---
const base = import.meta.env.BASE_URL;
const heroImage = `${base}images/home/isivoltpro-industrial-core.webp`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="IsiVoltPro conecta activos, mantenimiento, órdenes de trabajo e histórico técnico en un único sistema."
    />
    <meta name="theme-color" content="#02060b" />
    <title>IsiVoltPro · Toda tu instalación conectada</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" href={heroImage} as="image" type="image/webp" />
  </head>

  <body>
    <main class="hero" aria-labelledby="hero-title">
      <img
        class="hero__background"
        src={heroImage}
        alt="Instalación industrial conectada mediante IsiVoltPro"
        width="1000"
        height="531"
        fetchpriority="high"
        decoding="async"
      />

      <div class="hero__shade" aria-hidden="true"></div>
      <div class="hero__vignette" aria-hidden="true"></div>
      <div class="hero__core-glow" aria-hidden="true"></div>
      <div class="hero__beam" aria-hidden="true"></div>

      <svg class="flow" viewBox="0 0 1600 900" preserveAspectRatio="none" aria-hidden="true">
        <path class="flow__base" d="M125 568 C330 548 405 510 548 486 S760 474 814 467" />
        <path class="flow__base" d="M814 467 C975 444 1085 390 1390 386" />
        <path class="flow__base" d="M814 467 C915 548 1085 605 1435 630" />
        <path class="flow__base" d="M814 467 C730 565 590 635 355 678" />
        <path class="flow__pulse flow__pulse--1" d="M125 568 C330 548 405 510 548 486 S760 474 814 467" />
        <path class="flow__pulse flow__pulse--2" d="M814 467 C975 444 1085 390 1390 386" />
        <path class="flow__pulse flow__pulse--3" d="M814 467 C915 548 1085 605 1435 630" />
        <path class="flow__pulse flow__pulse--4" d="M814 467 C730 565 590 635 355 678" />
      </svg>

      <div class="data-rain" aria-hidden="true">
        <i style="--x: 45%; --delay: -0.4s; --dur: 4.8s"></i>
        <i style="--x: 47%; --delay: -2.1s; --dur: 5.7s"></i>
        <i style="--x: 49%; --delay: -1.2s; --dur: 4.2s"></i>
        <i style="--x: 50.5%; --delay: -3.4s; --dur: 6.1s"></i>
        <i style="--x: 52%; --delay: -2.8s; --dur: 5.1s"></i>
        <i style="--x: 54%; --delay: -0.9s; --dur: 5.9s"></i>
      </div>

      <header class="topbar">
        <a class="brand" href={base} aria-label="IsiVoltPro inicio">
          <span class="brand__mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="brand__name">ISIVOLT<strong>PRO</strong></span>
        </a>

        <nav class="nav" aria-label="Navegación principal">
          <a href={`${base}ecosistema/`}>Ecosistema</a><b>•</b>
          <a href={`${base}aplicaciones/`}>Aplicaciones</a><b>•</b>
          <a href={`${base}mantenimiento/`}>Cómo funciona</a><b>•</b>
          <a href={`${base}empresa/`}>Empresa</a><b>•</b>
          <a href={`${base}recursos/`}>Recursos</a>
        </nav>

        <div class="topbar__actions">
          <a class="button button--ghost" href={`${base}acceso/`}>Acceder <span>↗</span></a>
          <a class="button button--primary" href={`${base}contacto/`}>Solicitar demo <span>→</span></a>
        </div>
      </header>

      <div class="hero__rail" aria-hidden="true">
        <span>01</span><i></i>
      </div>

      <section class="copy copy--left">
        <p class="kicker"><i></i>DIGITAL TWIN</p>
        <h1 id="hero-title">TODA TU<br />INSTALACIÓN</h1>
        <p class="lead">
          IsiVoltPro centraliza la operación, conecta tus equipos y optimiza el rendimiento de cada activo de tu instalación.
        </p>
        <div class="truth">
          <span class="truth__icon" aria-hidden="true">⌗</span>
          <div>
            <strong>UNA ÚNICA FUENTE DE VERDAD</strong>
            <p>Datos en tiempo real, trazabilidad y control total.</p>
          </div>
        </div>
      </section>

      <section class="copy copy--right" aria-label="Propuesta de valor">
        <h2>CONECTADA A<br /><em>UN SOLO<br />SISTEMA</em></h2>
        <p>
          Gestión técnica conectada, datos en tiempo real y control total de cada activo de tu instalación.
        </p>
      </section>

      <div class="node node--assets" aria-hidden="true">
        <i></i><strong>ACTIVOS</strong><small>IDENTIDAD · ESTADO</small>
      </div>
      <div class="node node--maintenance" aria-hidden="true">
        <i></i><strong>MANTENIMIENTO</strong><small>PLANIFICACIÓN · CONTROL</small>
      </div>
      <div class="node node--orders" aria-hidden="true">
        <i></i><strong>ÓRDENES DE TRABAJO</strong><small>ASIGNACIÓN · ACTUACIÓN</small>
      </div>
      <div class="node node--history" aria-hidden="true">
        <i></i><strong>HISTÓRICO</strong><small>TRAZABILIDAD · AUDITORÍA</small>
      </div>

      <div class="scroll" aria-hidden="true">
        <span>SCROLL TO EXPLORE</span>
        <i>↓</i>
      </div>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --blue: #087dff;
    --blue-bright: #1594ff;
    --cyan: #20b7ff;
    --ink: #02060b;
    --white: #f6f8fb;
    --muted: rgba(232, 238, 248, 0.72);
    font-family: 'Inter', system-ui, sans-serif;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }

  html,
  body {
    margin: 0;
    min-width: 320px;
    min-height: 100%;
    background: var(--ink);
    color: var(--white);
  }

  body { overflow-x: hidden; }
  a { color: inherit; text-decoration: none; }

  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: #02060b;
  }

  .hero__background {
    position: absolute;
    inset: 0;
    z-index: -7;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    filter: saturate(1.08) contrast(1.04) brightness(0.82);
    transform: scale(1.015);
  }

  .hero__shade,
  .hero__vignette,
  .hero__core-glow,
  .hero__beam {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__shade {
    z-index: -6;
    background:
      linear-gradient(90deg, rgba(1, 5, 11, 0.95) 0%, rgba(1, 5, 11, 0.69) 20%, rgba(1, 5, 11, 0.16) 43%, rgba(1, 5, 11, 0.08) 56%, rgba(1, 5, 11, 0.72) 82%, rgba(1, 5, 11, 0.94) 100%),
      linear-gradient(180deg, rgba(1, 5, 11, 0.70) 0%, transparent 24%, transparent 68%, rgba(1, 5, 11, 0.76) 100%);
  }

  .hero__vignette {
    z-index: -5;
    box-shadow: inset 0 0 180px 50px rgba(0, 0, 0, 0.72);
  }

  .hero__core-glow {
    z-index: -4;
    left: 42%;
    top: 33%;
    width: 18%;
    height: 32%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 137, 255, 0.28), rgba(0, 110, 255, 0.06) 45%, transparent 72%);
    filter: blur(18px);
    animation: corePulse 3.8s ease-in-out infinite;
  }

  .hero__beam {
    z-index: -3;
    left: 47.8%;
    right: auto;
    width: 5.5%;
    height: 53%;
    background: linear-gradient(90deg, transparent, rgba(28, 146, 255, 0.14), rgba(89, 191, 255, 0.34), rgba(28, 146, 255, 0.14), transparent);
    filter: blur(10px);
    transform-origin: bottom center;
    animation: beamPulse 4.4s ease-in-out infinite;
  }

  .flow {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mix-blend-mode: screen;
    opacity: 0.62;
  }

  .flow__base,
  .flow__pulse {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .flow__base {
    stroke: rgba(12, 108, 219, 0.21);
    stroke-width: 1.2;
  }

  .flow__pulse {
    stroke: rgba(54, 173, 255, 0.9);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 3 20 55 90;
    filter: drop-shadow(0 0 5px rgba(0, 139, 255, 0.9));
    animation: flowMove 5.4s linear infinite;
  }

  .flow__pulse--2 { animation-delay: -1.1s; animation-duration: 6.2s; }
  .flow__pulse--3 { animation-delay: -2.8s; animation-duration: 5.8s; }
  .flow__pulse--4 { animation-delay: -4.1s; animation-duration: 6.6s; }

  .data-rain {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .data-rain i {
    --x: 50%;
    --delay: 0s;
    --dur: 5s;
    position: absolute;
    left: var(--x);
    top: 43%;
    width: 2px;
    height: 18px;
    border-radius: 99px;
    background: linear-gradient(180deg, transparent, rgba(72, 185, 255, 0.95));
    box-shadow: 0 0 10px rgba(0, 132, 255, 0.8);
    opacity: 0;
    animation: dataRise var(--dur) linear var(--delay) infinite;
  }

  .topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    height: 110px;
    display: grid;
    grid-template-columns: 260px 1fr auto;
    align-items: center;
    gap: 30px;
    padding: 0 clamp(28px, 3.8vw, 72px);
    background: linear-gradient(180deg, rgba(1, 5, 11, 0.82), rgba(1, 5, 11, 0));
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    width: max-content;
  }

  .brand__mark {
    width: 29px;
    display: grid;
    gap: 4px;
    transform: skewY(-26deg);
  }

  .brand__mark i {
    display: block;
    height: 6px;
    border-radius: 2px;
    background: var(--blue);
    box-shadow: 0 0 18px rgba(0, 105, 255, 0.22);
  }

  .brand__name {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.24em;
  }

  .brand__name strong { color: var(--blue); }

  .nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(16px, 1.55vw, 29px);
  }

  .nav a {
    color: rgba(242, 246, 252, 0.72);
    font-size: 13px;
    transition: color 160ms ease, text-shadow 160ms ease;
  }

  .nav a:hover,
  .nav a:focus-visible {
    color: #fff;
    text-shadow: 0 0 16px rgba(0, 130, 255, 0.7);
  }

  .nav b {
    color: var(--blue);
    font-size: 12px;
  }

  .topbar__actions {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .button {
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 0 27px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  .button--ghost {
    border: 1px solid rgba(255, 255, 255, 0.19);
    background: rgba(2, 7, 13, 0.36);
  }

  .button--ghost span { color: var(--blue-bright); }

  .button--primary {
    min-width: 180px;
    background: linear-gradient(135deg, #006bff, #098cff);
    box-shadow: 0 0 34px rgba(0, 111, 255, 0.20);
  }

  .button--primary span { font-size: 19px; }

  .hero__rail {
    position: absolute;
    left: clamp(19px, 1.25vw, 26px);
    top: 46%;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--blue-bright);
    font-size: 11px;
    font-weight: 700;
  }

  .hero__rail i {
    display: block;
    width: 22px;
    height: 1px;
    background: linear-gradient(90deg, var(--blue), transparent);
  }

  .copy {
    position: absolute;
    z-index: 7;
  }

  .copy--left {
    left: clamp(58px, 6.6vw, 126px);
    top: 18.5%;
    width: min(38vw, 610px);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 34px;
    color: rgba(236, 242, 250, 0.52);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .kicker i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 14px var(--blue);
  }

  h1,
  h2 {
    font-family: 'Barlow Condensed', Impact, sans-serif;
    text-transform: uppercase;
    letter-spacing: -0.035em;
  }

  h1 {
    margin: 0;
    font-size: clamp(76px, 9.15vw, 174px);
    font-weight: 600;
    line-height: 0.82;
    color: #f2f3f5;
    text-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
  }

  .lead {
    max-width: 425px;
    margin: 31px 0 0 4px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
  }

  .truth {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 31px;
  }

  .truth__icon {
    width: 66px;
    height: 66px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid rgba(46, 135, 255, 0.25);
    border-radius: 50%;
    color: var(--blue-bright);
    background: rgba(2, 10, 19, 0.45);
    box-shadow: inset 0 0 0 8px rgba(14, 47, 86, 0.25), 0 0 26px rgba(0, 110, 255, 0.08);
    font-size: 25px;
  }

  .truth strong {
    display: block;
    color: rgba(245, 248, 253, 0.87);
    font-size: 10px;
    letter-spacing: 0.18em;
  }

  .truth p {
    max-width: 265px;
    margin: 11px 0 0;
    color: rgba(232, 238, 248, 0.62);
    font-size: 12px;
    line-height: 1.75;
  }

  .copy--right {
    right: clamp(55px, 5.1vw, 96px);
    top: 34%;
    width: min(31vw, 500px);
    text-align: right;
  }

  h2 {
    margin: 0;
    font-size: clamp(64px, 7vw, 132px);
    font-weight: 600;
    line-height: 0.84;
    color: #f3f4f6;
    text-shadow: 0 8px 35px rgba(0, 0, 0, 0.52);
  }

  h2 em {
    display: inline-block;
    color: var(--blue);
    font-style: normal;
    text-shadow: 0 0 32px rgba(0, 111, 255, 0.18);
  }

  .copy--right > p {
    max-width: 390px;
    margin: 24px 0 0 auto;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
  }

  .node {
    position: absolute;
    z-index: 6;
    display: grid;
    grid-template-columns: 8px auto;
    column-gap: 9px;
    row-gap: 4px;
    color: rgba(246, 249, 253, 0.87);
    text-shadow: 0 2px 15px rgba(0, 0, 0, 0.9);
  }

  .node i {
    grid-row: 1 / 3;
    width: 7px;
    height: 7px;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 13px rgba(0, 128, 255, 0.95);
  }

  .node strong {
    font-size: 10px;
    letter-spacing: 0.13em;
  }

  .node small {
    color: rgba(226, 233, 243, 0.42);
    font-size: 8px;
    letter-spacing: 0.06em;
  }

  .node--assets { top: 19%; left: 32.5%; }
  .node--maintenance { top: 19%; right: 18%; }
  .node--orders { left: 36%; bottom: 19%; }
  .node--history { right: 28%; bottom: 16.5%; }

  .scroll {
    position: absolute;
    z-index: 6;
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    color: rgba(235, 240, 248, 0.42);
    font-size: 8px;
    letter-spacing: 0.48em;
  }

  .scroll i {
    color: #fff;
    font-style: normal;
    font-size: 22px;
    line-height: 1;
    animation: scrollBounce 1.8s ease-in-out infinite;
  }

  @keyframes flowMove {
    to { stroke-dashoffset: -168; }
  }

  @keyframes corePulse {
    0%, 100% { opacity: 0.65; transform: scale(0.96); }
    50% { opacity: 1; transform: scale(1.08); }
  }

  @keyframes beamPulse {
    0%, 100% { opacity: 0.50; transform: scaleX(0.82); }
    50% { opacity: 0.92; transform: scaleX(1.18); }
  }

  @keyframes dataRise {
    0% { transform: translate3d(0, 18vh, 0); opacity: 0; }
    18% { opacity: 0.72; }
    78% { opacity: 0.38; }
    100% { transform: translate3d(0, -46vh, 0); opacity: 0; }
  }

  @keyframes scrollBounce {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50% { transform: translateY(5px); opacity: 1; }
  }

  @media (max-width: 1180px) {
    .topbar { grid-template-columns: auto 1fr auto; }
    .nav { display: none; }
    .copy--left { width: 46vw; }
    .copy--right { width: 35vw; }
    .node--assets { left: 39%; }
    .node--maintenance { right: 13%; }
  }

  @media (max-width: 780px) {
    .hero {
      min-height: 1000px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 128px 24px 74px;
    }

    .hero__background {
      object-position: 50% 50%;
      filter: saturate(1.08) contrast(1.05) brightness(0.67);
    }

    .hero__shade {
      background: linear-gradient(180deg, rgba(1,5,11,.90), rgba(1,5,11,.26) 30%, rgba(1,5,11,.28) 55%, rgba(1,5,11,.92) 100%);
    }

    .topbar {
      position: absolute;
      height: 96px;
      padding: 0 20px;
      grid-template-columns: 1fr auto;
    }

    .brand__name { font-size: 15px; }
    .topbar__actions .button--ghost { display: none; }
    .button--primary { min-width: 0; height: 42px; padding: 0 18px; font-size: 11px; }

    .copy {
      position: relative;
      inset: auto;
      width: 100%;
      text-align: left;
    }

    .copy--left { margin-top: 20px; }
    .copy--right { margin-top: auto; text-align: right; }

    h1 { font-size: clamp(74px, 22vw, 126px); }
    h2 { font-size: clamp(62px, 19vw, 106px); }
    .lead { max-width: 350px; }
    .copy--right > p { max-width: 330px; }

    .truth { display: none; }
    .node { display: none; }
    .hero__rail { display: none; }
    .scroll { bottom: 17px; }
    .flow { opacity: 0.35; }
    .hero__beam { left: 45%; width: 12%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow__pulse,
    .data-rain i,
    .hero__beam,
    .hero__core-glow,
    .scroll i { animation: none !important; }
  }
</style>

PUBLIC_SITE_URL=https://izc05.github.io
PUBLIC_BASE_PATH=/isivoltpro-web-v3

# Observabilidad comercial: apagada por defecto hasta cerrar privacidad y consentimiento.
# No activar estas variables solo por disponer de cuenta en el proveedor.
PUBLIC_TELEMETRY_ENABLED=false
PUBLIC_POSTHOG_KEY=
PUBLIC_SENTRY_DSN=

# Administración editorial V3: solo muestra la maqueta de QA.
# No habilita persistencia, autenticación ni publicación real.
PUBLIC_V3_CONTENT_ADMIN_PREVIEW=false

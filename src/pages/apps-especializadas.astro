---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const appMaintenance = `${base}app-mantenimiento/`;
const apps = `${base}aplicaciones/`;
const scope = `${base}alcance/`;
const demo = `${base}demo/`;
---
<!doctype html><html lang="es"><head>
<V3Seo title="Apps especializadas · IsiVoltPro" description="Líneas especializadas de IsiVoltPro para inspecciones, inventario, climatización y frío, instalaciones eléctricas, Legionella/ACS y asistencia técnica, con estado de integración claramente indicado." path={`${base}apps-especializadas/`} />
<style is:inline>
.special-page{background:#fff;overflow:hidden}.special-page .page-shell{width:min(1180px,calc(100% - 44px))}.special-hero{padding:78px 0 72px;background:radial-gradient(circle at 76% 38%,rgba(100,82,226,.13),transparent 27%),radial-gradient(circle at 91% 65%,rgba(43,184,142,.1),transparent 22%),#fff}.special-hero__grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:66px;align-items:center}.special-hero h1{margin:14px 0 18px;font:800 clamp(48px,4.7vw,68px)/.98 var(--v3-font-display,system-ui);letter-spacing:-.06em}.special-hero h1 span{display:block;color:transparent;background:linear-gradient(90deg,#6653dc,#5699db 52%,#2db88b);-webkit-background-clip:text;background-clip:text}.special-hero p{max-width:530px;color:#717d91;line-height:1.72}.special-hero .btn--primary{background:#111827;border-color:#111827;color:#fff}.special-workspace{position:relative;min-height:455px}.special-window{position:absolute;inset:18px 28px 28px 18px;border:1px solid #e3e7f0;border-radius:24px;background:#fff;box-shadow:0 30px 75px rgba(57,65,111,.14);overflow:hidden}.special-window__bar{height:43px;display:flex;align-items:center;gap:6px;padding:0 14px;border-bottom:1px solid #edf0f5}.special-window__bar i{width:7px;height:7px;border-radius:50%;background:#d9deea}.special-window__body{display:grid;grid-template-columns:115px 1fr;height:calc(100% - 43px)}.special-side{padding:18px 11px;background:#fafbfe;border-right:1px solid #edf0f5}.special-side b{display:block;margin-bottom:17px;font-size:10px}.special-side span{display:block;margin:8px 0;padding:7px;border-radius:7px;color:#818b9d;font-size:8px}.special-side span:first-of-type{background:#f0edff;color:#6854d8;font-weight:800}.special-main{padding:19px}.special-main__head{display:flex;justify-content:space-between;gap:15px;align-items:center}.special-main__head strong{font-size:17px}.special-main__head small{padding:6px 9px;border-radius:999px;background:#eaf9f3;color:#168f69;font-weight:800}.special-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:16px 0}.special-kpis div{padding:11px;border:1px solid #eceef4;border-radius:11px}.special-kpis small{display:block;color:#929baa;font-size:7px}.special-kpis b{display:block;margin-top:4px;font-size:18px}.special-list{display:grid;gap:7px}.special-list div{display:grid;grid-template-columns:1fr auto;align-items:center;padding:9px 10px;border:1px solid #edf0f5;border-radius:9px;font-size:8px}.special-list em{font-style:normal;color:#7b8597}.special-list span{padding:4px 6px;border-radius:999px;background:#f1efff;color:#6752d7;font-weight:800}.special-chip{position:absolute;z-index:3;display:grid;place-items:center;border:1px solid #e5e8f0;background:#fff;box-shadow:0 14px 34px rgba(50,59,103,.14)}.special-chip--hvac{right:0;top:53px;width:72px;height:72px;border-radius:21px;color:#169db8;font-size:26px}.special-chip--electric{left:0;bottom:70px;width:61px;height:61px;border-radius:18px;color:#dc7629;font-size:23px}.special-chip--check{right:25px;bottom:5px;width:125px;height:47px;border-radius:15px;color:#159f71;font-size:10px;font-weight:900}.special-chip--check small{display:block;color:#8b95a6;font-size:7px;font-weight:600}.app-status-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}.app-status{position:relative;min-height:330px;padding:25px;border:1px solid #e5e8f0;border-radius:25px;background:#fff;box-shadow:0 14px 36px rgba(54,64,103,.07);overflow:hidden}.app-status__top{display:flex;align-items:center;justify-content:space-between;gap:12px}.app-status i{width:45px;height:45px;display:grid;place-items:center;border-radius:14px;background:var(--tone,#eef3ff);color:var(--ink,#4e69d8);font-style:normal;font-weight:900;font-size:18px}.app-status__tag{padding:6px 9px;border-radius:999px;background:var(--tag-bg,#eaf9f3);color:var(--tag,#159f71);font-size:8px;font-weight:900;letter-spacing:.06em;text-transform:uppercase}.app-status h3{margin:18px 0 7px;font-size:20px;letter-spacing:-.035em}.app-status p{margin:0;color:#778296;line-height:1.6;font-size:13px}.app-preview{margin-top:18px;padding:12px;border:1px solid #eceff4;border-radius:13px;background:#fafbfe}.app-preview__head{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px;color:#6d778a;font-size:8px;font-weight:800}.app-preview__head span{color:var(--ink,#4e69d8)}.app-preview__rows{display:grid;gap:6px}.app-preview__rows div{display:grid;grid-template-columns:1fr auto;gap:8px;padding:7px 8px;border-radius:7px;background:#fff;color:#667287;font-size:8px}.app-preview__rows b{color:#202a3d}.status-legend{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.status-legend span{padding:8px 11px;border:1px solid #e6e9f0;border-radius:999px;background:#fff;color:#58657e;font-size:10px;font-weight:800}.rule-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.rule-grid article{padding:23px;border:1px solid #e5e8f0;border-radius:23px;background:#fff}.rule-grid b{color:#526bd5;font-size:11px}.rule-grid h3{margin:15px 0 7px;font-size:18px}.rule-grid p{margin:0;color:#758095;line-height:1.58;font-size:13px}.special-band{display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center;padding:40px;border-radius:32px;background:#111827;color:#fff}.special-band h2{margin:7px 0 10px;font-size:clamp(31px,4vw,50px);line-height:1.03;letter-spacing:-.05em}.special-band p{max-width:720px;color:#c4cee0;line-height:1.7}.special-band .btn{background:#fff;color:#14213d;border-color:#fff}@media(max-width:980px){.special-hero__grid{grid-template-columns:1fr}.app-status-grid{grid-template-columns:repeat(2,1fr)}.rule-grid{grid-template-columns:repeat(2,1fr)}.special-band{grid-template-columns:1fr}}@media(max-width:580px){.special-page .page-shell{width:min(100% - 28px,1180px)}.special-hero{padding:56px 0}.special-hero h1{font-size:clamp(42px,12vw,56px)}.special-workspace{min-height:370px}.special-window{inset:15px 8px 25px}.special-window__body{grid-template-columns:72px 1fr}.special-side{padding:14px 6px}.special-main{padding:13px}.special-kpis{grid-template-columns:1fr 1fr}.special-kpis div:last-child{display:none}.special-chip--hvac{width:54px;height:54px}.special-chip--electric{display:none}.special-chip--check{right:8px}.app-status-grid,.rule-grid{grid-template-columns:1fr}.app-status,.special-band{padding:22px}}
</style></head><body><V3CommercialHeader /><main class="page-main special-page">
<section class="special-hero"><div class="page-shell special-hero__grid"><div><span class="eyebrow">Especializar sin fragmentar</span><h1>Más profundidad cuando<span>tu actividad la necesita.</span></h1><p>IsiVoltPro parte de una base común y puede crecer hacia necesidades especializadas. Una app nueva reutiliza clientes, activos, usuarios e histórico; no crea otra isla de información.</p><div class="page-hero__actions"><a class="btn btn--primary" href={appMaintenance}>Empezar por App Mantenimiento →</a><a class="btn" href={scope}>Ver alcance y límites</a></div></div><div class="special-workspace" aria-label="Vista conceptual de apps especializadas conectadas"><div class="special-window"><div class="special-window__bar"><i></i><i></i><i></i></div><div class="special-window__body"><aside class="special-side"><b>IsiVoltPro</b><span>Resumen</span><span>Activos</span><span>Inspecciones</span><span>Inventario</span><span>Especializadas</span></aside><div class="special-main"><div class="special-main__head"><strong>Operación especializada</strong><small>Base compartida</small></div><div class="special-kpis"><div><small>Equipos</small><b>148</b></div><div><small>Revisiones</small><b>23</b></div><div><small>Incidencias</small><b>6</b></div></div><div class="special-list"><div><em>UTA · Zona técnica</em><span>HVAC</span></div><div><em>Cuadro QGBT-02</em><span>Eléctrica</span></div><div><em>Punto ACS · P-14</em><span>Control</span></div><div><em>Inspección mensual</em><span>Checklist</span></div></div></div></div></div><span class="special-chip special-chip--hvac" aria-hidden="true">❄</span><span class="special-chip special-chip--electric" aria-hidden="true">⚡</span><span class="special-chip special-chip--check" aria-hidden="true">✓ Evidencia lista<small>vinculada al activo</small></span></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Estado visible</span><h2>No todas las apps están<br/><span class="gradient-text">en la misma fase.</span></h2></div><p>Los estados distinguen lo que encaja ya en el núcleo de aquello cuyo alcance debe validarse antes de un piloto.</p></div><div class="app-status-grid">
<article class="app-status"><div class="app-status__top"><i>☑</i><span class="app-status__tag">Extensión del núcleo</span></div><h3>Inspecciones y checklists</h3><p>Revisiones, observaciones, defectos y evidencias vinculadas al activo.</p><div class="app-preview"><div class="app-preview__head">REVISIÓN BT <span>3/4</span></div><div class="app-preview__rows"><div><b>Identificación</b><span>✓</span></div><div><b>Protecciones</b><span>✓</span></div><div><b>Evidencia</b><span>2 fotos</span></div></div></div></article>
<article class="app-status" style="--tone:#fff0f8;--ink:#d52f99"><div class="app-status__top"><i>▥</i><span class="app-status__tag">Extensión del núcleo</span></div><h3>Inventario y materiales</h3><p>Existencias y consumos relacionados con el trabajo, sin convertirse en un ERP.</p><div class="app-preview"><div class="app-preview__head">MATERIAL <span>Stock</span></div><div class="app-preview__rows"><div><b>Filtro G4</b><span>18 ud.</span></div><div><b>Magnetotérmico</b><span>7 ud.</span></div><div><b>Consumido hoy</b><span>4 ud.</span></div></div></div></article>
<article class="app-status" style="--tone:#eafafd;--ink:#139db9;--tag-bg:#fff3e9;--tag:#d96c20"><div class="app-status__top"><i>❄</i><span class="app-status__tag">Integración progresiva</span></div><h3>Climatización y refrigeración</h3><p>Equipos HVAC/frío, averías, mantenimiento, datos técnicos y documentación.</p><div class="app-preview"><div class="app-preview__head">UTA-04 <span>En servicio</span></div><div class="app-preview__rows"><div><b>Preventivo</b><span>12 sep</span></div><div><b>Última OT</b><span>Cerrada</span></div><div><b>Documentos</b><span>4</span></div></div></div></article>
<article class="app-status" style="--tone:#fff3e9;--ink:#d96c20;--tag-bg:#fff3e9;--tag:#d96c20"><div class="app-status__top"><i>⚡</i><span class="app-status__tag">Integración progresiva</span></div><h3>Instalaciones eléctricas</h3><p>Cuadros, elementos, revisiones, fotografías, documentación y actuaciones.</p><div class="app-preview"><div class="app-preview__head">QGBT-02 <span>Activo</span></div><div class="app-preview__rows"><div><b>Revisión</b><span>Al día</span></div><div><b>Incidencias</b><span>1</span></div><div><b>Histórico</b><span>12 OT</span></div></div></div></article>
<article class="app-status" style="--tone:#eaf9f3;--ink:#159f71;--tag-bg:#fff3e9;--tag:#d96c20"><div class="app-status__top"><i>≈</i><span class="app-status__tag">Integración progresiva</span></div><h3>Legionella / ACS</h3><p>Controles, puntos, purgas, registros y evidencias vinculados a instalaciones.</p><div class="app-preview"><div class="app-preview__head">PUNTO P-14 <span>Programado</span></div><div class="app-preview__rows"><div><b>Control</b><span>Semanal</span></div><div><b>Último registro</b><span>22 ago</span></div><div><b>Evidencias</b><span>2</span></div></div></div></article>
<article class="app-status" style="--tone:#f2efff;--ink:#6544e8;--tag-bg:#f2efff;--tag:#6544e8"><div class="app-status__top"><i>✦</i><span class="app-status__tag">I+D / desarrollo</span></div><h3>IsiVoltPro AI</h3><p>Asistencia futura para consultar documentación e histórico técnico con contexto.</p><div class="app-preview"><div class="app-preview__head">ASISTENCIA <span>Concepto</span></div><div class="app-preview__rows"><div><b>Contexto</b><span>Activo</span></div><div><b>Fuentes</b><span>Documentos</span></div><div><b>Decisión crítica</b><span>Validar</span></div></div></div></article>
</div><div class="status-legend"><span>Extensión del núcleo = encaja en la arquitectura actual</span><span>Integración progresiva = validar alcance antes del piloto</span><span>I+D = no vender como disponible</span></div></div></section>
<section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Reglas para añadir una app</span><h2>Especializar sí.<br/><span class="gradient-text">Duplicar sistemas, no.</span></h2></div><p>Una nueva app solo tiene sentido si mejora el trabajo sin obligar a mantener clientes, equipos o históricos en dos sitios.</p></div><div class="rule-grid"><article><b>01</b><h3>Misma identidad</h3><p>Cliente, instalación y activo se reutilizan en cada especialidad.</p></article><article><b>02</b><h3>Mismos permisos</h3><p>Organización, usuario y rol gobiernan el acceso entre módulos.</p></article><article><b>03</b><h3>Mismo histórico</h3><p>Cada actuación enriquece un contexto técnico común.</p></article><article><b>04</b><h3>Valor comprobable</h3><p>Si añade pasos pero no elimina fricción, no entra en el núcleo.</p></article></div></div></section>
<section class="page-section page-section--soft"><div class="page-shell"><div class="special-band"><div><span class="eyebrow" style="color:#9eb6ff">Primero el núcleo</span><h2>La especialización llega después de controlar el trabajo diario.</h2><p>App Mantenimiento y las capacidades comunes forman el punto de partida. Las líneas especializadas se estudian según actividad, requisitos y madurez real.</p></div><div class="page-hero__actions"><a class="btn" href={demo}>Ver una demo →</a><a class="btn" href={apps}>Volver a Módulos</a></div></div></div></section>
</main><V3CommercialFooter /></body></html>
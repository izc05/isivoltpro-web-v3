---
import '../styles/v3-pages.css';
import V3CommercialHeader from '../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../components/V3CommercialFooter.astro';
import V3Seo from '../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const demo = `${base}demo/`;
const appMaintenance = `${base}app-mantenimiento/`;
const specialized = `${base}apps-especializadas/`;
const moduleUrl = (slug: string) => `${base}modulos/${slug}/`;
---
<!doctype html><html lang="es"><head>
<V3Seo title="Módulos · IsiVoltPro" description="Módulos de IsiVoltPro para activos, órdenes de trabajo, mantenimiento preventivo, QR/NFC, inventario, inspecciones y documentación." path={`${base}aplicaciones/`} />
<style is:inline>
.board-modules{background:#fff;overflow:hidden}.board-modules .page-shell{width:min(1180px,calc(100% - 44px))}.modules-hero{position:relative;padding:86px 0 82px;min-height:640px;background:radial-gradient(circle at 78% 35%,rgba(98,104,240,.14),transparent 29%),radial-gradient(circle at 94% 23%,rgba(51,197,150,.10),transparent 19%),radial-gradient(circle at 57% 5%,rgba(23,92,255,.06),transparent 20%),#fff}.modules-hero__grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:74px;align-items:center}.modules-hero h1{margin:15px 0 18px;font:800 clamp(50px,4.9vw,72px)/.98 var(--v3-font-display,system-ui);letter-spacing:-.064em}.modules-hero h1 span{display:block;color:transparent;background:linear-gradient(90deg,#6c58e3,#58a2dc 52%,#35be93);-webkit-background-clip:text;background-clip:text}.modules-hero p{max-width:530px;margin:0;color:#717d91;font-size:15px;line-height:1.72}.modules-hero .btn--primary{background:#111827;border-color:#111827;color:#fff}.board-kicker{display:inline-flex;padding:7px 10px;border:1px solid #ebedf4;border-radius:999px;color:#6d7485;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.module-stack{position:relative;min-height:475px}.module-stack::before{content:'';position:absolute;inset:12% -4% 2% 8%;border-radius:48px;background:linear-gradient(135deg,rgba(103,82,225,.16),rgba(62,163,213,.09) 48%,rgba(45,190,143,.13));filter:blur(30px)}.module-window{position:absolute;border:1px solid #e4e8f2;border-radius:24px;background:rgba(255,255,255,.95);box-shadow:0 30px 78px rgba(66,70,120,.15);overflow:hidden;backdrop-filter:blur(14px)}.module-window--back{inset:46px 2px 84px 88px;transform:rotate(3.5deg);opacity:.76}.module-window--mid{inset:25px 58px 58px 34px;transform:rotate(-2.4deg);opacity:.9}.module-window--front{inset:62px 20px 18px 62px;z-index:2;transform:rotate(.8deg)}.module-window__bar{height:46px;display:flex;align-items:center;gap:6px;padding:0 14px;border-bottom:1px solid #edf0f5}.module-window__bar i{width:7px;height:7px;border-radius:50%;background:#d9deea}.module-window__body{padding:18px}.module-window__body small{color:#929bad;font-size:8px}.module-window__body strong{display:block;margin-top:5px;font-size:18px}.module-mini-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:15px}.module-mini-kpis span{padding:10px;border:1px solid #eaedf3;border-radius:11px;background:linear-gradient(180deg,#fff,#f9faff)}.module-mini-kpis small{display:block;font-size:7px}.module-mini-kpis b{display:block;margin-top:4px;font-size:17px}.module-lines{display:grid;gap:8px;margin-top:14px}.module-lines span{height:27px;border-radius:9px;background:linear-gradient(90deg,#f4f6fb,#eef1f9)}.module-lines span:nth-child(2){width:84%}.module-lines span:nth-child(3){width:68%}.module-chip{position:absolute;z-index:4;min-width:54px;height:54px;padding:0 13px;display:grid;place-items:center;border:1px solid #e6e9f1;border-radius:17px;background:#fff;box-shadow:0 15px 34px rgba(60,67,108,.14);font-size:18px;font-weight:800}.module-chip--a{left:12px;top:96px;color:#7257dd}.module-chip--b{right:0;top:46px;color:#2bb17f}.module-chip--c{right:14px;bottom:26px;color:#db5ca8}.module-chip--d{left:62px;bottom:0;color:#4779df}
.modules-cards{padding:72px 0 82px;background:linear-gradient(180deg,#fbfcff,#f8faff);border-top:1px solid #f0f2f6}.modules-cards__head{display:grid;grid-template-columns:1fr .8fr;gap:52px;align-items:end;margin-bottom:38px}.modules-cards__head h2{margin:10px 0 0;font:800 clamp(34px,3.8vw,52px)/1.03 var(--v3-font-display,system-ui);letter-spacing:-.052em}.modules-cards__head p{margin:0;color:#7b8598;line-height:1.68}.board-module-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.board-module-card{position:relative;min-height:262px;padding:20px;border:1px solid #e7eaf2;border-radius:22px;background:#fff;box-shadow:0 15px 38px rgba(54,65,102,.07);color:inherit;text-decoration:none;overflow:hidden;transition:transform .2s ease,box-shadow .2s ease}.board-module-card:hover{transform:translateY(-5px);box-shadow:0 24px 52px rgba(54,65,102,.12)}.board-module-card__top{display:flex;align-items:center;justify-content:space-between;gap:10px}.board-module-card i{width:42px;height:42px;display:grid;place-items:center;border-radius:13px;background:#f1efff;color:#6e58dd;font-style:normal}.board-module-card__status{padding:5px 8px;border-radius:999px;background:#eef9f4;color:#23926c;font-size:7px;font-weight:850}.board-module-card:nth-child(2) i{background:#fff0f8;color:#d654a8}.board-module-card:nth-child(3) i{background:#eaf9f3;color:#22a977}.board-module-card:nth-child(4) i{background:#eef4ff;color:#4377dc}.board-module-card:nth-child(5) i{background:#fff3ea;color:#e57d35}.board-module-card:nth-child(6) i{background:#eef9fb;color:#2b9eb7}.board-module-card:nth-child(7) i{background:#f4efff;color:#8b56d7}.board-module-card h3{margin:15px 0 7px;font-size:16px}.board-module-card p{margin:0;color:#7c8698;font-size:10px;line-height:1.5}.module-preview{display:grid;gap:6px;margin-top:14px;padding:10px;border:1px solid #edf0f5;border-radius:12px;background:linear-gradient(180deg,#fbfcff,#f6f8fc)}.module-preview span{display:flex;align-items:center;justify-content:space-between;height:20px;padding:0 7px;border-radius:7px;background:#fff;color:#7e8797;font-size:7px}.module-preview b{color:#25324b;font-size:7px}.board-module-card small{display:block;margin-top:12px;color:#5e65ca;font-weight:800;font-size:9px}
.modules-proof{padding:24px 0 0;background:#fff}.modules-proof__strip{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:18px;border:1px solid #e8ebf3;border-radius:24px;background:#fff;box-shadow:0 18px 48px rgba(54,64,102,.07)}.modules-proof__strip div{padding:12px 14px;border-radius:14px;background:#fafbff}.modules-proof__strip small{display:block;color:#8a93a3;font-size:8px}.modules-proof__strip strong{display:block;margin-top:5px;font-size:15px}.modules-feature{padding:78px 0;background:#fff}.modules-feature__grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:56px;align-items:center}.modules-feature h2{margin:10px 0 15px;font:800 clamp(38px,4.1vw,56px)/1.02 var(--v3-font-display,system-ui);letter-spacing:-.057em}.modules-feature p{color:#707b90;line-height:1.72}.modules-feature__visual{position:relative;min-height:360px;border:1px solid #e7eaf2;border-radius:30px;background:linear-gradient(145deg,#f8faff,#f5f1ff 50%,#f0fbf6);box-shadow:0 26px 66px rgba(53,63,102,.11);overflow:hidden}.feature-dash{position:absolute;left:32px;top:32px;right:110px;bottom:32px;border:1px solid #e5e8f0;border-radius:20px;background:#fff;box-shadow:0 18px 40px rgba(52,62,100,.10);padding:20px}.feature-dash__bar{display:flex;align-items:center;justify-content:space-between}.feature-dash__bar strong{font-size:17px}.feature-dash__bar small{padding:5px 8px;border-radius:999px;background:#eef9f4;color:#23926c;font-size:7px}.feature-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:18px}.feature-kpis div{padding:13px;border:1px solid #eceef3;border-radius:12px}.feature-kpis small{display:block;color:#8f98a7;font-size:8px}.feature-kpis b{display:block;margin-top:6px;font-size:21px}.feature-list{display:grid;gap:7px;margin-top:12px}.feature-list span{display:grid;grid-template-columns:1fr auto;gap:8px;padding:9px 10px;border:1px solid #edf0f4;border-radius:10px;font-size:8px}.feature-list em{font-style:normal;color:#26936d}.feature-phone{position:absolute;right:20px;bottom:15px;width:136px;height:260px;padding:8px;border:6px solid #111827;border-radius:30px;background:#fff;box-shadow:0 20px 44px rgba(31,42,76,.20);transform:rotate(5deg)}.feature-phone img{width:100%;height:100%;object-fit:cover;border-radius:18px}.modules-final{padding:0 0 76px}.modules-final .callout{background:linear-gradient(120deg,#f3f6ff,#f4f0ff 48%,#eefaf5)}
@media(max-width:900px){.modules-hero__grid,.modules-feature__grid,.modules-cards__head{grid-template-columns:1fr}.module-stack{min-height:410px}.board-module-grid{grid-template-columns:repeat(2,1fr)}.modules-proof__strip{grid-template-columns:1fr 1fr}}@media(max-width:560px){.board-modules .page-shell{width:min(100% - 28px,1180px)}.modules-hero{padding:58px 0}.modules-hero h1{font-size:clamp(43px,12vw,56px)}.module-stack{min-height:340px}.module-window--back{inset:50px 2px 60px 40px}.module-window--mid{inset:25px 35px 40px 15px}.module-window--front{inset:50px 10px 20px 34px}.module-chip{min-width:45px;height:45px;padding:0 9px}.module-mini-kpis{grid-template-columns:1fr 1fr}.module-mini-kpis span:last-child{display:none}.board-module-grid,.modules-proof__strip{grid-template-columns:1fr}.modules-feature__visual{min-height:320px}.feature-dash{left:14px;right:72px}.feature-phone{right:6px;width:108px;height:214px}.feature-list span:nth-child(3){display:none}}
</style></head><body><V3CommercialHeader />
<main class="board-modules">
<section class="modules-hero"><div class="page-shell modules-hero__grid"><div><span class="board-kicker">Módulos</span><h1>Todo lo que necesitas.<span>En un solo lugar.</span></h1><p>Activos, órdenes de trabajo, mantenimiento preventivo, QR/NFC, inspecciones, inventario y documentación comparten el mismo contexto para que el trabajo no vuelva a fragmentarse.</p><div class="page-hero__actions"><a class="btn btn--primary" href={demo}>Solicitar demo</a><a class="btn" href="#modulos">Explorar módulos</a></div></div><div class="module-stack" aria-label="Ventanas conceptuales de módulos IsiVoltPro"><div class="module-window module-window--back"><div class="module-window__bar"><i></i><i></i><i></i></div><div class="module-window__body"><small>ACTIVOS</small><strong>Equipos e histórico</strong><div class="module-lines"><span></span><span></span><span></span></div></div></div><div class="module-window module-window--mid"><div class="module-window__bar"><i></i><i></i><i></i></div><div class="module-window__body"><small>MANTENIMIENTO</small><strong>Preventivos y revisiones</strong><div class="module-mini-kpis"><span><small>Hoy</small><b>8</b></span><span><small>Semana</small><b>21</b></span><span><small>Al día</small><b>94%</b></span></div></div></div><div class="module-window module-window--front"><div class="module-window__bar"><i></i><i></i><i></i></div><div class="module-window__body"><small>ORDEN DE TRABAJO</small><strong>OT-2026-0148 · En curso</strong><div class="module-mini-kpis"><span><small>Prioridad</small><b>Alta</b></span><span><small>Técnico</small><b>JR</b></span><span><small>Estado</small><b>68%</b></span></div><div class="module-lines"><span></span><span></span></div></div></div><span class="module-chip module-chip--a" aria-hidden="true">▣</span><span class="module-chip module-chip--b" aria-hidden="true">✓</span><span class="module-chip module-chip--c" aria-hidden="true">QR</span><span class="module-chip module-chip--d" aria-hidden="true">▤</span></div></div></section>
<section class="modules-cards" id="modulos"><div class="page-shell"><header class="modules-cards__head"><div><span class="board-kicker">Un solo contexto</span><h2>Ocho capacidades que trabajan juntas.</h2></div><p>En vez de ocho islas de información, cada módulo deja contexto útil para el siguiente. Las mini vistas representan cómo se conectaría el trabajo diario dentro de la plataforma.</p></header><div class="board-module-grid">
<a class="board-module-card" href={moduleUrl('activos')}><div class="board-module-card__top"><i>▣</i><span class="board-module-card__status">Base</span></div><h3>Activos</h3><p>Equipos, ubicaciones, fotos, documentos e histórico.</p><div class="module-preview"><span>UTA-02 <b>Operativo</b></span><span>Cuadro QGBT <b>3 OT</b></span><span>Bomba P-04 <b>Revisión</b></span></div><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('avisos-incidencias')}><div class="board-module-card__top"><i>!</i><span class="board-module-card__status">Entrada</span></div><h3>Avisos</h3><p>Incidencias claras con prioridad, contexto y evidencias.</p><div class="module-preview"><span>Climatización <b>Alta</b></span><span>Alumbrado <b>Media</b></span><span>Puerta técnica <b>Nueva</b></span></div><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('ordenes-de-trabajo')}><div class="board-module-card__top"><i>✓</i><span class="board-module-card__status">Operación</span></div><h3>Órdenes de trabajo</h3><p>Asignación, ejecución, seguimiento y cierre documentado.</p><div class="module-preview"><span>OT-0148 <b>En curso</b></span><span>OT-0147 <b>Pendiente</b></span><span>OT-0146 <b>Cerrada</b></span></div><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('mantenimiento-preventivo')}><div class="board-module-card__top"><i>⚙</i><span class="board-module-card__status">Plan</span></div><h3>Mantenimiento</h3><p>Preventivos, periodicidades y revisiones visibles.</p><div class="module-preview"><span>Mensual <b>8 tareas</b></span><span>Trimestral <b>12</b></span><span>Anual <b>4</b></span></div><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('qr-nfc')}><div class="board-module-card__top"><i>⌁</i><span class="board-module-card__status">Campo</span></div><h3>QR / NFC</h3><p>Acceso inmediato al activo desde el punto de trabajo.</p><div class="module-preview"><span>Escaneo <b>Activo</b></span><span>Ficha <b>Instantánea</b></span><span>Histórico <b>Disponible</b></span></div><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('inventario')}><div class="board-module-card__top"><i>▥</i><span class="board-module-card__status">Stock</span></div><h3>Inventario</h3><p>Materiales y herramientas vinculados a la operación.</p><div class="module-preview"><span>Filtros F7 <b>18</b></span><span>Contactores <b>7</b></span><span>Fusibles <b>32</b></span></div><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('inspecciones')}><div class="board-module-card__top"><i>☑</i><span class="board-module-card__status">Control</span></div><h3>Inspecciones</h3><p>Checklists, observaciones, fotografías y resultados.</p><div class="module-preview"><span>Checklist <b>12/14</b></span><span>Fotos <b>4</b></span><span>Observaciones <b>2</b></span></div><small>Descubrir más →</small></a>
<a class="board-module-card" href={moduleUrl('documentacion')}><div class="board-module-card__top"><i>▤</i><span class="board-module-card__status">Archivo</span></div><h3>Documentación</h3><p>Informes, manuales y archivos junto al contexto correcto.</p><div class="module-preview"><span>Manual.pdf <b>Activo</b></span><span>Informe.pdf <b>OT</b></span><span>Foto.jpg <b>Evidencia</b></span></div><small>Descubrir más →</small></a>
</div></div></section>
<section class="modules-proof"><div class="page-shell"><div class="modules-proof__strip"><div><small>Contexto</small><strong>1 activo · múltiples módulos</strong></div><div><small>Trabajo de campo</small><strong>Web + móvil</strong></div><div><small>Trazabilidad</small><strong>Aviso → OT → histórico</strong></div><div><small>Implantación</small><strong>Empieza por lo necesario</strong></div></div></div></section>
<section class="modules-feature"><div class="page-shell modules-feature__grid"><div><span class="board-kicker">Producto de entrada</span><h2>App Mantenimiento</h2><p>La puerta de entrada práctica a IsiVoltPro: avisos, OT, activos, preventivos, fotos y documentación alrededor de quien trabaja desde el móvil.</p><div class="page-hero__actions"><a class="btn btn--primary" href={appMaintenance}>Conocer la app →</a><a class="btn" href={specialized}>Apps especializadas</a></div></div><div class="modules-feature__visual"><div class="feature-dash"><div class="feature-dash__bar"><strong>Trabajo pendiente</strong><small>Sincronizado</small></div><div class="feature-kpis"><div><small>OT abiertas</small><b>12</b></div><div><small>Preventivos</small><b>8</b></div><div><small>Avisos</small><b>3</b></div></div><div class="feature-list"><span>OT-0148 · Climatización <em>En curso</em></span><span>Preventivo · Cuadro QGBT <em>Hoy</em></span><span>Aviso · Puerta técnica <em>Nuevo</em></span></div></div><div class="feature-phone"><img src={`${base}media/v4/field-technician-tablet-v2.webp`} alt="Técnico de mantenimiento consultando una orden de trabajo en una tablet"/></div></div></div></section>
<section class="modules-final"><div class="page-shell"><div class="callout"><div><h2>No necesitas activar todo.</h2><p>Empieza por el problema más urgente y amplía cuando IsiVoltPro ya forme parte del trabajo diario.</p></div><a class="btn btn--primary" href={demo}>Ver una demo orientada a mi caso →</a></div></div></section>
</main><V3CommercialFooter /></body></html>

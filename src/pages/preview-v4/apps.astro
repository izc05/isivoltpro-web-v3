---
import '../../styles/v3-pages.css';
import V3CommercialHeader from '../../components/V3CommercialHeader.astro';
import V3CommercialFooter from '../../components/V3CommercialFooter.astro';
import V3Seo from '../../components/V3Seo.astro';
const base = import.meta.env.BASE_URL;
const product = `${base}preview-v4/producto/`;
const solutions = `${base}preview-v4/soluciones/`;
const sectors = `${base}preview-v4/sectores/`;
const demo = `${base}preview-v4/demo/`;
const qrPhoto = `${base}media/v4/app-qr-mobile.webp`;
---
<!doctype html>
<html lang="es">
<head>
  <V3Seo title="Apps V4 · IsiVoltPro" description="Vista previa de Apps V4: App Mantenimiento, activos, QR/NFC, órdenes de trabajo y aplicaciones especializadas conectadas al trabajo técnico real." path={`${base}preview-v4/apps/`} noindex={true} />
  <style is:inline>
    .strip{background:#111827;color:#fff}.strip .page-shell{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:12px}.strip a{color:#dfe7ff;font-weight:800}.hero{padding:88px 0 72px;background:radial-gradient(circle at 80% 12%,rgba(109,74,255,.13),transparent 28%),radial-gradient(circle at 92% 65%,rgba(36,197,140,.10),transparent 22%),#fff}.hero-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(500px,1.1fr);gap:56px;align-items:center}.hero h1{margin:18px 0 19px;font:800 clamp(52px,5.8vw,80px)/.98 Manrope,sans-serif;letter-spacing:-.064em}.hero p{margin:0;max-width:650px;color:#68748a;font-size:18px;line-height:1.72}.actions{display:flex;flex-wrap:wrap;gap:11px;margin-top:28px}.photo{position:relative;overflow:hidden;border-radius:32px;background:#edf1f6;box-shadow:0 32px 84px rgba(45,59,98,.15)}.photo img{display:block;width:100%;height:470px;object-fit:cover}.photo figcaption{position:absolute;left:18px;bottom:18px;padding:9px 12px;border-radius:999px;background:rgba(17,24,39,.8);color:#fff;font-size:10px;font-weight:800;backdrop-filter:blur(8px)}.app-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:18px}.app-main,.app-side article{border:1px solid #e6eaf2;border-radius:26px;background:#fff;box-shadow:0 14px 38px rgba(54,64,102,.055)}.app-main{padding:30px}.app-main h3,.app-side h3{margin:14px 0 8px;font-size:26px}.app-main p,.app-side p{margin:0;color:#748096;line-height:1.65}.tag{display:inline-flex;padding:7px 10px;border-radius:999px;background:#f2efff;color:#6544e8;font-size:10px;font-weight:900;letter-spacing:.06em;text-transform:uppercase}.app-side{display:grid;gap:18px}.app-side article{padding:24px}.capabilities{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:24px}.cap{padding:20px;border-radius:20px;background:#f8faff}.cap strong{display:block;font-size:16px}.cap small{display:block;margin-top:6px;color:#7b879b;line-height:1.5}.flow{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.flow article{padding:24px;border:1px solid #e6eaf2;border-radius:22px;background:#fff}.flow b{color:#5c64dc;font-size:11px}.flow strong{display:block;margin-top:14px;font-size:19px}.flow small{display:block;margin-top:7px;color:#7b879b;line-height:1.5}.future{padding:40px;border-radius:32px;background:linear-gradient(125deg,#0b1430,#162653 58%,#30256e);color:#fff}.future h2{margin:0;font:800 clamp(38px,4.7vw,60px)/1.03 Manrope,sans-serif;letter-spacing:-.052em}.future p{max-width:760px;margin:14px 0 0;color:#c6d0e7;line-height:1.72}.future-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:26px}.future-grid article{padding:18px;border:1px solid rgba(255,255,255,.13);border-radius:17px;background:rgba(255,255,255,.06)}.future-grid strong{display:block}.future-grid small{display:block;margin-top:5px;color:#c4cee4;line-height:1.45}.cta{display:grid;grid-template-columns:1fr auto;gap:28px;align-items:center;padding:42px;border-radius:32px;background:linear-gradient(115deg,#f2f7ff,#f3efff 48%,#effaf6)}.cta h2{margin:0;font:800 clamp(34px,4vw,52px)/1.04 Manrope,sans-serif;letter-spacing:-.05em}.cta p{margin:12px 0 0;color:#68748a;line-height:1.65}@media(max-width:980px){.hero-grid,.app-grid,.cta{grid-template-columns:1fr}.capabilities,.future-grid{grid-template-columns:repeat(2,1fr)}.flow{grid-template-columns:repeat(2,1fr)}}@media(max-width:680px){.hero{padding:60px 0 48px}.hero h1{font-size:clamp(44px,13vw,62px)}.photo img{height:330px}.capabilities,.future-grid,.flow{grid-template-columns:1fr}.future,.cta{padding:28px 22px}.strip .page-shell{padding:8px 0;flex-direction:column;align-items:flex-start;gap:4px}}
  </style>
</head>
<body>
  <V3CommercialHeader />
  <div class="strip"><div class="page-shell"><strong>Preview V4 · Apps</strong><span>Campo + contexto + especialización · <a href={`${base}preview-v4/`}>Mapa V4</a></span></div></div>
  <main class="page-main">
    <section class="hero"><div class="page-shell hero-grid"><div><span class="eyebrow">La app debe acompañar al técnico</span><h1>El activo delante.<br/><span class="gradient-text">El contexto en la mano.</span></h1><p>La App Mantenimiento reúne lo esencial para trabajar en campo: identificar un equipo, consultar su historial, abrir o actualizar una OT, añadir evidencias y cerrar el trabajo sin reconstruir después lo ocurrido.</p><div class="actions"><a class="btn btn--primary" href={demo}>Ver una demo →</a><a class="btn" href={product}>Ver Producto V4</a></div></div><figure class="photo"><img src={qrPhoto} alt="Técnico escaneando con el móvil un código QR en un equipo de mantenimiento" width="700" height="525" loading="eager"/><figcaption>QR / NFC · contexto en el punto de trabajo</figcaption></figure></div></section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">App Mantenimiento como núcleo de campo</span><h2>Menos menús genéricos.<br/><span class="gradient-text">Más acciones que encajan con el trabajo.</span></h2></div><p>La V4 presenta primero el uso real de la aplicación y después las capacidades que lo hacen posible.</p></div><div class="app-grid"><article class="app-main"><span class="tag">App principal</span><h3>App Mantenimiento</h3><p>Para avisos, OT, activos, preventivo, evidencias y consulta rápida desde móvil o tablet. El objetivo es que el técnico tenga lo necesario antes, durante y después de la intervención.</p><div class="capabilities"><div class="cap"><strong>Avisos</strong><small>Entrada clara con ubicación y prioridad.</small></div><div class="cap"><strong>OT</strong><small>Estado, actuación, fotos y cierre.</small></div><div class="cap"><strong>Activos</strong><small>Ficha, histórico y documentación.</small></div><div class="cap"><strong>Preventivo</strong><small>Tareas planificadas y evidencias.</small></div></div></article><div class="app-side"><article><span class="tag">Acceso en campo</span><h3>QR / NFC</h3><p>Escanea el activo y abre directamente el contexto correcto, evitando búsquedas innecesarias en una lista larga de equipos.</p></article><article><span class="tag">Especialización</span><h3>Apps técnicas</h3><p>Electricidad, RITE, PCI, legionela y otras áreas pueden crecer sobre la misma base sin fragmentar el acceso ni la identidad del usuario.</p></article></div></div></div></section>

    <section class="page-section"><div class="page-shell"><div class="page-section__head"><div><span class="eyebrow">Flujo de campo</span><h2>Cuatro acciones que explican<br/><span class="gradient-text">mejor la app que veinte funciones.</span></h2></div><p>La experiencia comercial debe enseñar lo que realmente hace una persona en una intervención.</p></div><div class="flow"><article><b>01</b><strong>Identificar</strong><small>QR/NFC, búsqueda o ubicación llevan al activo correcto.</small></article><article><b>02</b><strong>Entender</strong><small>Histórico, aviso, documentos y prioridad aportan contexto.</small></article><article><b>03</b><strong>Intervenir</strong><small>La OT acompaña el trabajo y recoge notas y evidencias.</small></article><article><b>04</b><strong>Cerrar</strong><small>El resultado queda asociado al activo y alimenta el histórico.</small></article></div><div class="actions" style="justify-content:center"><a class="btn" href={solutions}>Ver Soluciones V4 →</a></div></div></section>

    <section class="page-section page-section--soft"><div class="page-shell"><div class="future"><span class="eyebrow" style="color:#bcd1ff">Un ecosistema, no cinco herramientas aisladas</span><h2>La especialización llega después de compartir una base sólida.</h2><p>Las aplicaciones especializadas pueden incorporar formularios, inspecciones, normativa o cálculos propios, pero deben mantener acceso, organizaciones, activos y contexto común.</p><div class="future-grid"><article><strong>Eléctricas</strong><small>Inspecciones, defectos, mediciones y documentación BT.</small></article><article><strong>RITE</strong><small>Revisiones, instalaciones térmicas y mantenimiento reglamentario.</small></article><article><strong>PCI</strong><small>Equipos, revisiones y trazabilidad de protección contra incendios.</small></article><article><strong>Legionella</strong><small>Controles, registros, puntos y seguimiento periódico.</small></article></div></div></div></section>

    <section class="page-section"><div class="page-shell"><div class="cta"><div><h2>Empieza por la App Mantenimiento. Amplía solo cuando aporte valor.</h2><p>La web debe hacer sencillo entender el primer paso y mostrar después cómo encajan las aplicaciones especializadas.</p></div><div class="actions" style="margin-top:0"><a class="btn btn--primary" href={demo}>Solicitar demo →</a><a class="btn" href={sectors}>Ver Sectores V4</a></div></div></div></section>
  </main>
  <V3CommercialFooter />
</body>
</html>
---
import HeroCore from './HeroCore.astro';
---
<section class="hero-v3 hero-v3--core" data-hero aria-labelledby="hero-title">
  <HeroCore />
  <div class="hero-v3__ambient" aria-hidden="true"></div>
  <div class="hero-v3__shade" aria-hidden="true"></div>

  <header class="hero-v3__header shell">
    <a class="hero-v3__brand" href="/isivoltpro-web-v3/" aria-label="IsiVoltPro">
      <span class="hero-v3__mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>ISIVOLT<span>PRO</span></span>
    </a>
    <nav class="hero-v3__nav" aria-label="Navegación principal">
      <a href="/isivoltpro-web-v3/ecosistema/">Ecosistema</a>
      <a href="/isivoltpro-web-v3/aplicaciones/">Aplicaciones</a>
      <a href="/isivoltpro-web-v3/mantenimiento/">Mantenimiento</a>
      <a href="/isivoltpro-web-v3/recursos/">Recursos</a>
      <a href="/isivoltpro-web-v3/empresa/">Empresa</a>
    </nav>
    <a class="hero-v3__demo" href="/isivoltpro-web-v3/contacto/">Solicitar demo <span>↗</span></a>
  </header>

  <div class="hero-v3__content shell">
    <div class="hero-v3__copy">
      <p class="hero-v3__eyebrow">CONTROL TOTAL · RENDIMIENTO REAL</p>
      <h2 id="hero-title">Toda tu instalación.<span>Un solo sistema.</span></h2>
      <p class="hero-v3__lead">Supervisa activos, mantenimiento, órdenes de trabajo y recursos técnicos desde una única plataforma conectada.</p>
      <div class="hero-v3__actions">
        <a class="hero-v3__primary" href="#plataforma">Explorar plataforma <span>→</span></a>
        <a class="hero-v3__secondary" href="/isivoltpro-web-v3/contacto/">Solicitar demo <span>↗</span></a>
      </div>
      <div class="hero-v3__trust" aria-label="Ventajas clave">
        <span><i></i>Operación conectada</span>
        <span><i></i>Trazabilidad completa</span>
        <span><i></i>Histórico técnico único</span>
      </div>
    </div>
  </div>

  <div class="hero-v3__scroll" aria-hidden="true"><span>DESCUBRIR</span><i></i></div>
</section>
